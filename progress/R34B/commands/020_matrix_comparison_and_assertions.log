PWD=/home/toolchain/development/libc++_replacement
COMMAND=bash -lc $'\nset -e\nprintf "=== pairwise output comparison after per-binary command header ===\\n"\nfor case_name in cancel exit real foreign cancel-no-catch exit-no-catch; do\n  g=progress/R34B/results/matrix/libstdcxx_${case_name}.log\n  c=progress/R34B/results/matrix/libcxx_${case_name}.log\n  diff -u <(tail -n +4 "$g") <(tail -n +4 "$c")\n  printf "%s\\tMATCH\\n" "$case_name"\ndone\nprintf "=== all exit codes ===\\n"\nawk -F "\\t" "NR>1{print \\$1,\\$2,\\$3,\\$4}" progress/R34B/tables/matrix_raw.tsv\n[ "$(awk -F "\\t" "NR>1 && (\\$3 != 0 || \\$4 != 0){n++} END{print n+0}" progress/R34B/tables/matrix_raw.tsv)" -eq 0 ]\nprintf "ALL_12_EXIT_ZERO=YES\\n"\nprintf "=== required event assertions ===\\n"\nfor stdlib in libcxx libstdcxx; do\n  rg -q "cancel:forced-handler" progress/R34B/results/matrix/${stdlib}_cancel.log\n  rg -q "cancel:join=PTHREAD_CANCELED" progress/R34B/results/matrix/${stdlib}_cancel.log\n  rg -q "exit:forced-handler" progress/R34B/results/matrix/${stdlib}_exit.log\n  rg -q "exit:join=0x2a" progress/R34B/results/matrix/${stdlib}_exit.log\n  rg -q "real:runtime_error:r34b-real" progress/R34B/results/matrix/${stdlib}_real.log\n  ! rg -q "real:forced-handler:MISROUTED|real:catch-all" progress/R34B/results/matrix/${stdlib}_real.log\n  rg -q "foreign:inner-catch:private_1=0:rethrow" progress/R34B/results/matrix/${stdlib}_foreign.log\n  rg -q "foreign:outer-catch" progress/R34B/results/matrix/${stdlib}_foreign.log\n  rg -q "foreign:after-catch:cleanup-count=1" progress/R34B/results/matrix/${stdlib}_foreign.log\n  rg -q "cancel-no-catch:join=PTHREAD_CANCELED" progress/R34B/results/matrix/${stdlib}_cancel-no-catch.log\n  rg -q "exit-no-catch:join=0x2a" progress/R34B/results/matrix/${stdlib}_exit-no-catch.log\n  printf "%s_REQUIRED_EVENTS=PASS\\n" "$stdlib"\ndone\nprintf "PAIRWISE_DIFFERENCES=0_OF_6_CASES\\n"\n' 
