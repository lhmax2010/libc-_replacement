   618	// 2.5.4 Rethrowing Exceptions
   619	/*  This routine can rethrow native or foreign exceptions.
   620	If the exception is native:
   621	* marks the exception object on top of the caughtExceptions stack
   622	  (in an implementation-defined way) as being rethrown.
   623	* If the caughtExceptions stack is empty, it calls terminate()
   624	  (see [C++FDIS] [except.throw], 15.1.8).
   625	* It then calls _Unwind_RaiseException which should not return
   626	   (terminate if it does).
   627	  Note:  exception_header may be masquerading as a __cxa_dependent_exception
   628	         and that's ok.
   629	*/
   630	void __cxa_rethrow() {
   631	    __cxa_eh_globals* globals = __cxa_get_globals();
   632	    __cxa_exception* exception_header = globals->caughtExceptions;
   633	    if (NULL == exception_header)
   634	        std::terminate();      // throw; called outside of a exception handler
   635	    bool native_exception = __isOurExceptionClass(&exception_header->unwindHeader);
   636	    if (native_exception)
   637	    {
   638	        //  Mark the exception as being rethrown (reverse the effects of __cxa_begin_catch)
   639	        exception_header->handlerCount = -exception_header->handlerCount;
   640	        globals->uncaughtExceptions += 1;
   641	        //  __cxa_end_catch will remove this exception from the caughtExceptions stack if necessary
   642	    }
   643	    else  // this is a foreign exception
   644	    {
   645	        // The only way to communicate to __cxa_end_catch that we've rethrown
   646	        //   a foreign exception, so don't delete us, is to pop the stack here
   647	        //   which must be empty afterwards.  Then __cxa_end_catch will do
   648	        //   nothing
   649	        globals->caughtExceptions = 0;
   650	    }
   651	#ifdef __USING_SJLJ_EXCEPTIONS__
   652	    _Unwind_SjLj_RaiseException(&exception_header->unwindHeader);
   653	#else
   654	    _Unwind_RaiseException(&exception_header->unwindHeader);
   655	#endif
   656	
   657	    //  If we get here, some kind of unwinding error has occurred.
   658	    //  There is some weird code generation bug happening with
   659	    //     Apple clang version 4.0 (tags/Apple/clang-418.0.2) (based on LLVM 3.1svn)
   660	    //     If we call failed_throw here.  Turns up with -O2 or higher, and -Os.
   661	    __cxa_begin_catch(&exception_header->unwindHeader);
   662	    if (native_exception)
   663	        std::__terminate(exception_header->terminateHandler);
   664	    // Foreign exception: can't get exception_header->terminateHandler
   665	    std::terminate();
   666	}
