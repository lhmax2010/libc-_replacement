COMMAND=bash -lc set\ -e\;\ git\ -C\ tmp/R29/work/pcre\ diff\ --\ packaging/pcre.spec\;\ rpmspec\ -P\ tmp/R29/work/pcre/packaging/pcre.spec\ \>/dev/null\;\ git\ -C\ tmp/R29/work/pcre\ add\ --\ packaging/pcre.spec\;\ git\ -C\ tmp/R29/work/pcre\ commit\ -m\ \"Isolate\ second\ autotools\ source\ tree\"\;\ git\ -C\ tmp/R29/work/pcre\ rev-parse\ HEAD\;\ git\ -C\ tmp/R29/work/pcre\ status\ --porcelain 
diff --git a/packaging/pcre.spec b/packaging/pcre.spec
index ceda636..42bde3e 100644
--- a/packaging/pcre.spec
