   619	                                          __ptrauth_scan_results_landingpad_key,
   620	                                          existingDiscriminator,
   621	                                          ptrauth_key_return_address,
   622	                                          stackPointer);
   623	  _Unwind_SetIP(context, newIP);
   624	#else
   625	  _Unwind_SetIP(context, results.landingPad);
   626	#endif
   627	}
