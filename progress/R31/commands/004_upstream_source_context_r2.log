   596	void
   597	set_registers(_Unwind_Exception* unwind_exception, _Unwind_Context* context,
   598	              const scan_results& results)
   599	{
   600	#if defined(__USING_SJLJ_EXCEPTIONS__) || defined(__WASM_EXCEPTIONS__)
