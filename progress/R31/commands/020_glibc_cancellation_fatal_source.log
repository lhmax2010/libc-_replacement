    29	# define FRAME_LEFT(frame, other, adj) \
    30	  ((uintptr_t) frame - adj >= (uintptr_t) other - adj)
    31	#elif _STACK_GROWS_UP
    32	# define FRAME_LEFT(frame, other, adj) \
    33	  ((uintptr_t) frame - adj <= (uintptr_t) other - adj)
    34	#else
