LABEL=curated_manifest
PWD=/home/toolchain/development/libc++_replacement
COMMAND=bash -o pipefail -c cd\ docs/progress/R11\ \&\&\ find\ .\ -type\ f\ \!\ -name\ MANIFEST.sha256\ -print0\ \|\ sort\ -z\ \|\ xargs\ -0\ sha256sum\ \>\ MANIFEST.sha256 
