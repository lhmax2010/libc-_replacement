28-// imitate gcc's header here:
29-# ifdef HIDE_EXPORTS
30:#  include_next <unwind.h>
31-# else
32-#  pragma GCC visibility push(default)
33:#  include_next <unwind.h>
34-#  pragma GCC visibility pop
35-# endif
