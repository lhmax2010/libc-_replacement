From dffe51106564d8db0a40b6ff7c01d6fcece816af Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Wed, 12 Aug 2026 21:43:57 +0800
Subject: [PATCH] Guard libstdc++ forced-unwind handler

Compile the __forced_unwind catch only when libstdc++ identifies itself through __GLIBCXX__. This keeps the cancellation guard for GNU libstdc++ while allowing the same source to compile with libc++.
---
 src/common/include/utils.h | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/common/include/utils.h b/src/common/include/utils.h
index 9bc66196..aa5c638d 100644
--- a/src/common/include/utils.h
+++ b/src/common/include/utils.h
@@ -67,8 +67,10 @@ template <class F>
 int try_catch(F &&f) {
     try {
         return std::forward<F>(f)();
+#if defined(__GLIBCXX__)
     } catch (abi::__forced_unwind &) {
         throw;
+#endif
     } catch (const Exception &e) {
         LogError("SecurityManager::Exception " << e.DumpToString());
         std::cerr << "SecurityManager::Exception " << e.DumpToString() << std::endl;
-- 
2.43.0

