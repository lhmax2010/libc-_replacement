From 5ba41186b38682290575ceff60143c9009e531f7 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Wed, 12 Aug 2026 21:43:57 +0800
Subject: [PATCH] Guard libstdc++ forced-unwind handler

Compile the __forced_unwind catch only when libstdc++ identifies itself through __GLIBCXX__. This keeps the cancellation guard for GNU libstdc++ while allowing the same header to compile with libc++.
---
 src/common/exceptions/TryCatch.h | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/common/exceptions/TryCatch.h b/src/common/exceptions/TryCatch.h
index 8eac4e1..ea0c529 100644
--- a/src/common/exceptions/TryCatch.h
+++ b/src/common/exceptions/TryCatch.h
@@ -62,6 +62,7 @@ int tryCatch(F &&f) {
     } catch (const std::exception &e) {
         LOGE_NOTHROW("%s", e.what());
         return CYNARA_API_UNKNOWN_ERROR;
+#if defined(__GLIBCXX__)
     } catch (const abi::__forced_unwind &) {
         /**
          * workaround for pthread_cancel, which cancels thread using this exception
@@ -69,6 +70,7 @@ int tryCatch(F &&f) {
          */
         LOGD_NOTHROW("We are 'gracefully' stopped by pthread_cancel");
         throw;
+#endif
     } catch (...) {
         LOGE_NOTHROW("Unexpected exception");
         return CYNARA_API_UNKNOWN_ERROR;
-- 
