docs/progress/R94/raw/004_locate_toolchain_override.command.txt:1:bash -lc $'\n  echo "[project configs]"\n  rg --files codes/qb/TIZEN/Tizen 2>/dev/null | rg "/(Tizen-Base|Tizen-Unified)(-Toolchain)?/project_config$" || true\n  echo "[override references in project configs]"\n  for f in codes/qb/TIZEN/Tizen/Tizen-Base/project_config codes/qb/TIZEN/Tizen/Tizen-Unified/project_config codes/qb/TIZEN/Tizen/Tizen-Base-Toolchain/project_config codes/qb/TIZEN/Tizen/Tizen-Unified-Toolchain/project_config; do\n    if test -f "$f"; then\n      echo "FILE=$f"\n      rg -n -C 4 "_toolchain_override|%_toolchain|%__cc(_clang|_gcc)?|%__cxx(_clang|_gcc)?" "$f" || true\n    else\n      echo "MISSING=$f"\n    fi\n  done\n  echo "[system definitions]"\n  for d in /usr/lib/build/configs /usr/lib/rpm /etc/rpm; do\n    if test -d "$d"; then rg -n --hidden --glob "!*~" "_toolchain_override" "$d" 2>/dev/null || true; fi\n  done\n  echo "[existing build roots/configs]"\n  for d in /home/toolchain/development/AI_Comparision/Codex_Workspace/GBS-ROOT-GCC-Evaluation tmp/GBS-ROOT; do\n    if test -d "$d"; then find "$d" -maxdepth 5 -type f \\( -name "project_config" -o -name "macros" -o -name "macros.*" \\) -print 2>/dev/null | head -n 200; fi\n  done\n' 
