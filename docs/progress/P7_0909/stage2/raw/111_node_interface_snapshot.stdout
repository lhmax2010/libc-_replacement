290: namespace StopFlags {
291: enum Flags : uint32_t {
292:   kNoFlags = 0,
293:   // Do not explicitly terminate the Isolate
294:   // when exiting the Environment.
295:   kDoNotTerminateIsolate = 1 << 0,
296: };
297: }  // namespace StopFlags
