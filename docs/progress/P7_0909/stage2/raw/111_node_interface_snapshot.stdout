376: enum OptionEnvvarSettings {
377:   // Allow the options to be set via the environment variable, like
378:   // `NODE_OPTIONS`.
379:   kAllowedInEnvvar = 0,
380:   // Disallow the options to be set via the environment variable, like
381:   // `NODE_OPTIONS`.
382:   kDisallowedInEnvvar = 1,
383: };
384: 
385: // Process the arguments and set up the per-process options.
386: // If the `settings` is set as OptionEnvvarSettings::kAllowedInEnvvar, the
387: // options that are allowed in the environment variable are processed. Options
388: // that are disallowed to be set via environment variable are processed as
389: // errors.
390: // Otherwise all the options that are disallowed (and those are allowed) to be
391: // set via environment variable are processed.
392: NODE_EXTERN int ProcessGlobalArgs(std::vector<std::string>* args,
393:                       std::vector<std::string>* exec_args,
394:                       std::vector<std::string>* errors,
395:                       OptionEnvvarSettings settings);
