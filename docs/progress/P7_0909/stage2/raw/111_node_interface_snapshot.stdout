299: class NODE_EXTERN InitializationResult {
300:  public:
301:   virtual ~InitializationResult() = default;
302: 
303:   // Returns a suggested process exit code.
304:   virtual int exit_code() const = 0;
305: 
306:   // Returns 'true' if initialization was aborted early due to errors.
307:   virtual bool early_return() const = 0;
308: 
309:   // Returns the parsed list of non-Node.js arguments.
310:   virtual const std::vector<std::string>& args() const = 0;
311: 
312:   // Returns the parsed list of Node.js arguments.
313:   virtual const std::vector<std::string>& exec_args() const = 0;
314: 
315:   // Returns an array of errors. Note that these may be warnings
316:   // whose existence does not imply a non-zero exit code.
317:   virtual const std::vector<std::string>& errors() const = 0;
318: 
319:   // If kNoInitializeNodeV8Platform was not specified, the global Node.js
320:   // platform instance.
321:   virtual MultiIsolatePlatform* platform() const = 0;
322: 
323:  private:
324:   InitializationResult() = default;
325:   friend class InitializationResultImpl;
326: };
