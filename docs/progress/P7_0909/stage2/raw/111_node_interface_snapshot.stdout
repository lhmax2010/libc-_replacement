328: // TODO(addaleax): Officially deprecate this and replace it with something
329: // better suited for a public embedder API.
330: NODE_EXTERN int Start(int argc, char* argv[]);
331: 
332: // Tear down Node.js while it is running (there are active handles
333: // in the loop and / or actively executing JavaScript code).
334: NODE_EXTERN int Stop(Environment* env,
335:                      StopFlags::Flags flags = StopFlags::kNoFlags);
336: 
337: // Set up per-process state needed to run Node.js. This will consume arguments
338: // from argv, fill exec_argv, and possibly add errors resulting from parsing
339: // the arguments to `errors`. The return value is a suggested exit code for the
340: // program; If it is 0, then initializing Node.js succeeded.
341: // This runs a subset of the initialization performed by
342: // InitializeOncePerProcess(), which supersedes this function.
343: // The subset is roughly equivalent to the one given by
344: // `ProcessInitializationFlags::kLegacyInitializeNodeWithArgsBehavior`.
345: NODE_DEPRECATED("Use InitializeOncePerProcess() instead",
346:                 NODE_EXTERN int InitializeNodeWithArgs(
347:                     std::vector<std::string>* argv,
348:                     std::vector<std::string>* exec_argv,
349:                     std::vector<std::string>* errors,
350:                     ProcessInitializationFlags::Flags flags =
351:                         ProcessInitializationFlags::kNoFlags));
352: 
353: // Set up per-process state needed to run Node.js. This will consume arguments
354: // from args, and return information about the initialization success,
355: // including the arguments split into argv/exec_argv, a list of potential
356: // errors encountered during initialization, and a potential suggested
357: // exit code.
358: NODE_EXTERN std::shared_ptr<InitializationResult> InitializeOncePerProcess(
359:     const std::vector<std::string>& args,
360:     ProcessInitializationFlags::Flags flags =
361:         ProcessInitializationFlags::kNoFlags);
362: // Undoes the initialization performed by InitializeOncePerProcess(),
363: // where cleanup is necessary.
364: NODE_EXTERN void TearDownOncePerProcess();
365: // Convenience overload for specifying multiple flags without having
366: // to worry about casts.
367: inline std::shared_ptr<InitializationResult> InitializeOncePerProcess(
368:     const std::vector<std::string>& args,
369:     std::initializer_list<ProcessInitializationFlags::Flags> list) {
370:   uint64_t flags_accum = ProcessInitializationFlags::kNoFlags;
371:   for (const auto flag : list) flags_accum |= static_cast<uint64_t>(flag);
372:   return InitializeOncePerProcess(
373:       args, static_cast<ProcessInitializationFlags::Flags>(flags_accum));
374: }
