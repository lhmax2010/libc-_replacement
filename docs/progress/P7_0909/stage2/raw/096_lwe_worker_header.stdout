20: #ifndef __LWE_WORKER__
21: #define __LWE_WORKER__
22: 
23: #ifndef LWE_EXPORT
24: #ifdef _MSC_VER
25: #define LWE_EXPORT __declspec(dllexport)
26: #else
27: #define LWE_EXPORT __attribute__((visibility("default")))
28: #endif
29: #endif
30: 
31: #include <string>
32: #include <functional>
33: 
34: namespace LWE {
35: 
36: enum class LWE_EXPORT WorkerProcessState {
37:     None,
38:     Terminated,
39: };
40: 
41: /**
42:  * \brief Perform initialization or cleanup of service worker.
43:  */
44: class LWE_EXPORT ServiceWorker {
45: public:
46:     /**
47:      * \brief Sets the preference for the engine version to be used.
48:      *
49:      * \param preferUpdatedVersion If true, an updated engine version will be
50:      * used if available.
51:      *
52:      * \remark Must be called before the Initialize.
53:      */
54:     static void SetVersionPreference(bool preferUpdatedVersion);
55: 
56:     /**
57:      * \brief Initialize service worker server.
58:      * Be sure to set the same data path as the lightweight web engine.
59:      *
60:      * \code{.cpp}
61:      *     LWE::ServiceWorker::Initialize("/tmp/Starfish_storage");
62:      * \endcode
63:      *
64:      * \param storageDirectoryPath Directory path for storage.
65:      *
66:      */
67:     static void Initialize(const std::string &storageDirectoryPath);
68: 
69:     /**
70:      * \brief Register callback that is called when the worker process state
71:      * changes.
72:      *
73:      * \code{.cpp}
74:      * LWE::ServiceWorker::RegisterOnStatusChangedHandler(
75:      *     [](LWE::WorkerProcessState state) {
76:      *         if (state == LWE::WorkerProcessState::Terminated) {
77:      *             printf("Terminated worker process\n");
78:      *         }
79:      *     }
80:      * );
81:      * \endcode
82:      *
83:      * \param cb state handling callback.
84:      *
85:      */
86:     static void RegisterOnStatusChangedHandler(
87:         const std::function<void(WorkerProcessState)> &cb);
88: 
89:     /**
90:      * \brief Perform lightweight web engine service worker cleanup.
91:      * Called once when the lightweight web engine service worker is no longer
92:      * in use.
93:      *
94:      * \code{.cpp}
95:      *     LWE::ServiceWorker::Finalize();
96:      * \endcode
97:      *
98:      */
99:     static void Finalize();
100: };
101: 
102: /**
103:  * \brief Perform initialization or cleanup of Shared worker.
104:  */
105: class LWE_EXPORT SharedWorker {
106: public:
107:     /**
108:      * \brief Sets the preference for the engine version to be used.
109:      *
110:      * \param preferUpdatedVersion If true, an updated engine version will be
111:      * used if available.
112:      *
113:      * \remark Must be called before the Initialize.
114:      */
115:     static void SetVersionPreference(bool preferUpdatedVersion);
116: 
117:     /**
118:      * \brief Initialize shared worker server.
119:      * Be sure to set the same data path as the lightweight web engine.
120:      *
121:      * \code{.cpp}
122:      *     LWE::SharedWorker::Initialize("/tmp/Starfish_storage");
123:      * \endcode
124:      *
125:      * \param storageDirectoryPath Directory path for storage.
126:      *
127:      */
128:     static void Initialize(const std::string &storageDirectoryPath);
129: 
130:     /**
131:      * \brief Register callback that is called when the worker process state
132:      * changes.
133:      *
134:      * \code{.cpp}
135:      * LWE::SharedWorker::RegisterOnStatusChangedHandler(
136:      *     [](LWE::WorkerProcessState state) {
137:      *         if (state == LWE::WorkerProcessState::Terminated) {
138:      *             printf("Terminated worker process\n");
139:      *         }
140:      *     }
141:      * );
142:      * \endcode
143:      *
144:      * \param cb state handling callback.
145:      *
146:      */
147:     static void RegisterOnStatusChangedHandler(
148:         const std::function<void(WorkerProcessState)> &cb);
149: 
150:     /**
151:      * \brief Perform lightweight web engine shared worker cleanup.
152:      * Called once when the lightweight web engine shared worker is no longer
153:      * in use.
154:      *
155:      * \code{.cpp}
156:      *     LWE::SharedWorker::Finalize();
157:      * \endcode
158:      *
159:      */
160:     static void Finalize();
161: };
162: 
163: } // namespace LWE
164: 
165: #endif
