6: #ifndef XWALK_EXTENSIONS_PUBLIC_XW_EXTENSION_ENTRYPOINTS_H_
7: #define XWALK_EXTENSIONS_PUBLIC_XW_EXTENSION_ENTRYPOINTS_H_
8: 
9: // NOTE: This file and interfaces marked as internal are not considered stable
10: // and can be modified in incompatible ways between Crosswalk versions.
11: 
12: #ifndef XWALK_EXTENSIONS_PUBLIC_XW_EXTENSION_H_
13: #error "You should include XW_Extension.h before this file"
14: #endif
15: 
16: #ifdef __cplusplus
17: extern "C" {
18: #endif
19: 
20: #define XW_INTERNAL_ENTRY_POINTS_INTERFACE_1 "XW_Internal_EntryPointsInterface_1"
21: #define XW_INTERNAL_ENTRY_POINTS_INTERFACE XW_INTERNAL_ENTRY_POINTS_INTERFACE_1
22: 
23: //
24: // XW_INTERNAL_ENTRY_POINTS_INTERFACE: provides a way for extensions to add
25: // more information about its implementation. For now, allow extensions to
26: // specify more objects that the access should cause the extension to be
27: // loaded.
28: //
29: 
30: struct XW_Internal_EntryPointsInterface_1 {
31:   // Register extra entry points for this extension. An "extra" entry points
32:   // are objects outside the implicit namespace for which the extension should
33:   // be loaded when they are touched.
34:   //
35:   // This function should be called only during XW_Initialize().
36:   void (*SetExtraJSEntryPoints)(XW_Extension extension, const char** entry_points);
37: };
38: 
39: typedef struct XW_Internal_EntryPointsInterface_1 XW_Internal_EntryPointsInterface;
40: 
41: #ifdef __cplusplus
42: }  // extern "C"
43: #endif
44: 
45: #endif  // XWALK_EXTENSIONS_PUBLIC_XW_EXTENSION_ENTRYPOINTS_H_
