4225:         /// </summary>
4226:         /// <since_tizen> 3 </since_tizen>
4227:         public string Name
4228:         {
4229:             get
4230:             {
4231:                 if (NUIApplication.IsUsingXaml)
4232:                 {
4233:                     return (string)GetValue(NameProperty);
4234:                 }
4235:                 else
4236:                 {
4237:                     return GetInternalName();
4238:                 }
4239:             }
4240:             set
4241:             {
