31: class EXPORT_API RemoteSurface : public IBufferEvent {
32:  public:
33:   enum Type {
34:     WIDGET = 0x1,
35:     WATCH = 0x2,
36:     UI = 0x4,
37:     COMPONENT_BASED = 0x8,
38:     ALL = WIDGET | WATCH | UI | COMPONENT_BASED
39:   };
40: 
41:   enum ChangedEventFilter {
42:     FILTER_NONE,
43:     FILTER_TBM,
44:     FILTER_IMAGE_FILE,
45:     FILTER_ALL
46:   };
47: 
48:   RemoteSurface(const std::string& id, Type type,
49:       std::shared_ptr<WlSurface> wl_surface, bool mock = false);
50:   RemoteSurface(int rid, const std::string& id, Type type,
51:       std::shared_ptr<WlSurface> wl_surface, bool mock = false);
52:   RemoteSurface(RemoteSurface&&) noexcept;
53:   RemoteSurface& operator=(RemoteSurface&&) noexcept;
54:   virtual ~RemoteSurface();
55: 
56:   const std::string& GetAppId() const;
57:   const std::string& GetInstId() const;
58:   int GetPid() const;
59:   int GetRid() const;
60:   Type GetType() const;
61:   bool IsFrozen() const;
62:   ITRS* GetRaw();
63:   ChangedEventFilter GetChangedEventFilter() const;
64:   void SendVisibility(bool visible);
65:   void SendTouchCancel();
66:   void SendMouseUp(int x, int y, unsigned int timestamp);
67:   void Bind(std::shared_ptr<WlSurface> surface);
68:   void Freeze(bool visible);
69:   void Thaw();
70:   virtual void SetChangedEventFilter(ChangedEventFilter filter);
71:   bool IsRemoteRender() const;
72:   void ClearRemoteRender();
73:   int SetRemoteRender();
74:   void SetBlock(bool is_block);
75:   virtual void Unbind();
76:   bool IsBound() const;
77:   bool SendKeyEvent(const input::KeyEventArgs& args);
78: 
79:   void OnBufferAdded(const std::string& appId,
80:                      const std::string& instId, int pid) override;
81:   void OnBufferRemoved(const std::string& appId,
82:                        const std::string& instId, int pid) override;
83:   void OnBufferChanged(int type, std::shared_ptr<WlBuffer> tbm, int fd,
84:                        uint32_t size, uint32_t time) override;
85:   void OnBind() override;
86: 
87:   static void SetDelayedResumingTime(uint32_t ms);
88:   static void InitManager();
89:   static void FiniManager();
90: 
91:  private:
92:   class Impl;
93:   std::unique_ptr<Impl> impl_;
94: };
