37: /**
38:  * @brief Stores a value of any type.
39:  *
40:  * Examples of use:
41:  * \code{.cpp}
42:  * Any uintVariable = 5u;
43:  * Any floatVariable( 4.5f );
44:  * Any strVariable( Dali::String( "Hello world" ) );
45:  * uintVariable = 1u;
46:  * uint32_t variable = AnyCast< uint32_t >( uintVariable );
47:  * if ( uintVariable.IsType< int >() )
48:  * \endcode
49:  * @SINCE_1_0.0
50:  */
51: class Any
