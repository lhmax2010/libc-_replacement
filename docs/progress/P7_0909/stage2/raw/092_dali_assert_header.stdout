84:   }
85: 
86:   /**
87:    * @brief Copy Constructor.
88:    * @SINCE_1_0.0
89:    * @param[in] any Any to be copied
90:    */
91:   Any(const Any& any)
92:   {
93:     // If container isn't empty then copy the container?
94:     if(nullptr != any.mContainer)
95:     {
96:       mContainer = any.mContainer->mCloneFunc(*any.mContainer);
97:     }
98:     else
99:     {
100:       // Otherwise mark new container as empty
101:       mContainer = nullptr;
102:     }
103:   }
104: 
105:   /**
106:    * @brief Move Constructor.
107:    * @SINCE_2_1.44
108:    * @param[in] any Any to be moved
109:    */
110:   Any(Any&& any) noexcept
111:   {
112:     mContainer = any.mContainer;
113: 
114:     // Remove input value's container.
115:     any.mContainer = nullptr;
116:   }
117: 
118:   /**
119:    * @brief Assigns a given value to the Any type.
120:    *
121:    * @SINCE_1_0.0
122:    * @param[in] value The given value
123:    * @return A reference to this
124:    * @note If the types are different, then the current container will be re-created.
125:    */
126:   template<typename Type>
127:   Any& operator=(const Type& value)
128:   {
129:     // If the container is empty then assign the new value
130:     if(nullptr == mContainer)
131:     {
132:       mContainer = new AnyContainerImpl<Type>(value);
133:     }
134:     else
135:     {
136:       // Check to see if this type is compatible with current container?
137:       if(mContainer->GetType() == TypeInfoIdFromTypeid<Type>())
138:       {
139:         // Same type so just set the new value
140:         static_cast<AnyContainerImpl<Type>*>(mContainer)->SetValue(value);
141:       }
142:       else
143:       {
144:         // Incompatible types, so delete old container and assign a new one with this type and value
145:         mContainer->mDeleteFunc(mContainer);
146:         mContainer = new AnyContainerImpl<Type>(value);
147:       }
148:     }
149:     return *this;
150:   }
151: 
