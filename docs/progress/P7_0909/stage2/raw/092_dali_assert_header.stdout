74:   /**
75:    * @brief Constructs a Any type with the given value.
76:    *
77:    * @SINCE_1_0.0
78:    * @param[in] value The given value
79:    */
80:   template<typename Type>
81:   Any(const Type& value)
82:   : mContainer(new AnyContainerImpl<Type>(value))
