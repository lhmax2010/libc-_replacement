137: // static
138: std::string Extension::GetRuntimeVariableString(const char* var_name) {
139:   ScopeLogger();
140:   if (!g_runtime) return "";
141: 
142:   const int result_len = 1024;
143:   std::vector<char> res(result_len + 1, 0);
144:   g_runtime->GetRuntimeVariableString(0, var_name, &res[0], result_len);
145:   LoggerI("GetRuntimeVariable: result %s: \"%s\"", var_name, &res[0]);
146:   return std::string(res.data());
147: }
148: 
149: std::string Extension::GetRuntimeVariable(const char* var_name, unsigned len) {
150:   ScopeLogger();
151:   if (!g_runtime) return "";
152: 
153:   std::vector<char> res(len + 1, 0);
154:   g_runtime->GetRuntimeVariableString(xw_extension_, var_name, &res[0], len);
155:   // crosswalk has used the double quote for the app_id from the first.
156:   // the n-wrt (new wrt) is using the double quote also.
157:   // but that's wrt and wrt-service's bug.
158:   // To keep compatibilities, two case of formats should be considered in webapi-plugins.
159:   // removing double quote to keep compatibilities with new and old wrt
160:   std::string value = std::string(res.data());
161:   if (0 == strncmp(var_name, "app_id", 6) && value.find('"', 0) != std::string::npos &&
162:       value.find('"', value.size() - 1) != std::string::npos) {
163:     value = value.erase(0, 1);
164:     value = value.erase(value.size() - 1, 1);
165:   }
166: 
167:   return value;
168: }
169: 
170: // static
171: void Extension::OnInstanceCreated(XW_Instance xw_instance, Instance* instance) {
172:   ScopeLogger();
173:   Assert(!g_core->GetInstanceData(xw_instance));
174:   if (!instance) return;
175:   instance->xw_instance_ = xw_instance;
176:   g_core->SetInstanceData(xw_instance, instance);
177:   instance->Initialize();
178: }
179: 
180: // static
181: void Extension::OnInstanceDestroyed(XW_Instance xw_instance) {
182:   ScopeLogger();
183:   Instance* instance = reinterpret_cast<Instance*>(g_core->GetInstanceData(xw_instance));
184:   if (!instance) return;
185:   instance->xw_instance_ = 0;
186:   delete instance;
187: }
188: 
189: // static
190: void Extension::HandleMessage(XW_Instance xw_instance, const char* msg) {
191:   ScopeLogger();
192:   Instance* instance = reinterpret_cast<Instance*>(g_core->GetInstanceData(xw_instance));
193:   if (!instance) return;
194:   instance->HandleMessage(msg);
195: }
196: 
197: void Extension::HandleBinaryMessage(XW_Instance xw_instance, const char* msg, size_t size) {
198:   ScopeLogger();
199:   Instance* instance = reinterpret_cast<Instance*>(g_core->GetInstanceData(xw_instance));
200:   if (!instance) {
201:     return;
202:   }
203:   // TODO maybe async version will be needed in future
204:   instance->HandleSyncBinaryMessage(msg, size);
205: }
206: 
207: // static
208: void Extension::HandleSyncMessage(XW_Instance xw_instance, const char* msg) {
209:   ScopeLogger();
210:   Instance* instance = reinterpret_cast<Instance*>(g_core->GetInstanceData(xw_instance));
211:   if (!instance) return;
212:   instance->HandleSyncMessage(msg);
213: }
214: 
215: // static
216: int32_t Extension::XW_Initialize(XW_Extension extension, XW_GetInterface get_interface,
217:                                  XW_Initialize_Func initialize,
218:                                  XW_CreatedInstanceCallback created_instance,
219:                                  XW_ShutdownCallback shutdown) {
220:   ScopeLogger();
221:   Assert(extension);
222: 
223:   if (!InitializeInterfaces(get_interface)) {
224:     return XW_ERROR;
225:   }
226: 
227:   g_xw_extension_ = extension;
228: 
229:   if (XW_ERROR == initialize(extension, get_interface)) {
230:     return XW_ERROR;
231:   }
232: 
233:   g_xw_extension_ = 0;
234: 
235:   using common::Extension;
236:   g_core->RegisterShutdownCallback(extension, shutdown);
237:   g_core->RegisterInstanceCallbacks(extension, created_instance, Extension::OnInstanceDestroyed);
238:   g_messaging->Register(extension, Extension::HandleMessage);
239:   g_sync_messaging->Register(extension, Extension::HandleSyncMessage);
240: 
