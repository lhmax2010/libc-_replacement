112:   std::string GetOperation() const {
113:     char* op = nullptr;
114:     int ret = app_control_get_operation(handle_, &op);
115:     if (ret != 0)
116:       return "";
117:     auto p = std::unique_ptr<char, decltype(std::free)*>(op, std::free);
118: 
119:     return p.get();
120:   }
