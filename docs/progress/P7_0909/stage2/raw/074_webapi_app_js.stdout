65: // helper functions ////////////////////////////////////////////////////
66: function _createApplicationControlData(object) {
67:     var ret;
68:     if (!T.isNullOrUndefined(object)) {
69:         ret = new tizen.ApplicationControlData(object.key, object.value);
70:     }
71:     return ret;
72: }
73: 
74: function _createApplicationControlDataArray(object) {
75:     var ret = [];
76:     if (!T.isNullOrUndefined(object) && T.isArray(object)) {
77:         object.forEach(function(o) {
78:             var data = _createApplicationControlData(o);
79:             if (!T.isNullOrUndefined(data)) {
80:                 ret.push(data);
81:             }
82:         });
83:     }
84:     return ret;
85: }
86: 
87: function _createApplicationControl(object) {
88:     var ret;
89:     if (!T.isNullOrUndefined(object)) {
90:         ret = new tizen.ApplicationControl(
91:             object.operation,
92:             object.uri,
93:             object.mime,
94:             object.category,
95:             _createApplicationControlDataArray(object.data)
96:         );
97:     }
98:     return ret;
99: }
100: 
101: function _createApplicationInformationArray(object) {
102:     var ret = [];
103:     if (!T.isNullOrUndefined(object) && T.isArray(object)) {
104:         object.forEach(function(o) {
105:             var data = new ApplicationInformation(o);
106:             if (!T.isNullOrUndefined(data)) {
107:                 ret.push(data);
108:             }
109:         });
110:     }
111:     return ret;
112: }
113: 
114: // class ApplicationManager ////////////////////////////////////////////////////
115: var ApplicationManager = function() {};
116: 
117: ApplicationManager.prototype.getCurrentApplication = function() {
118:     var result = native.callSync('ApplicationManagerGetCurrentApplication', {});
119: 
120:     if (native.isFailure(result)) {
121:         throw native.getErrorObject(result);
122:     } else {
123:         return new Application(native.getResultObject(result));
124:     }
125: };
126: 
