235: class LWE_EXPORT WebContainer {
236: public:
237:     // Function set for render to buffer
238:     static WebContainer* Create(unsigned width, unsigned height,
239:                                 float devicePixelRatio,
240:                                 const char* defaultFontName, const char* locale,
241:                                 const char* timezoneID);
242:     struct RenderInfo {
243:         void* updatedBufferAddress;
244:         size_t bufferStride;
245:     };
246: 
247:     struct ExternalImageInfo {
248:         void* imageAddress;
249:     };
250: 
251:     struct RenderResult {
252:         size_t updatedX;
253:         size_t updatedY;
254:         size_t updatedWidth;
255:         size_t updatedHeight;
256: 
257:         void* updatedBufferAddress;
258:         size_t bufferImageWidth;
259:         size_t bufferImageHeight;
260:     };
261: 
262:     struct WebContainerArguments {
263:         unsigned width;
264:         unsigned height;
265:         float devicePixelRatio;
266:         const char* defaultFontName;
267:         const char* locale;
268:         const char* timezoneID;
269:     };
270: 
271:     struct RendererGLConfiguration {
272:         std::function<void(WebContainer*)> onMakeCurrent;
273:         std::function<void(WebContainer*, bool mayNeedsSync)> onSwapBuffers;
274:         std::function<uintptr_t(WebContainer*)> onCreateSharedContext;
275:         std::function<bool(WebContainer*, uintptr_t)> onDestroyContext;
276:         std::function<bool(WebContainer*)> onClearCurrentContext;
277:         std::function<bool(WebContainer*, uintptr_t)> onMakeCurrentWithContext;
278:         std::function<void*(WebContainer*, const char*)> onGetProcAddress;
279:         std::function<bool(WebContainer*, const char*)> onIsSupportedExtension;
280:     };
281: 
282:     struct TransformationMatrix {
283:         double scaleX;
284:         double skewX;
285:         double translateX;
286:         double skewY;
287:         double scaleY;
288:         double translateY;
289:         double perspectiveX;
290:         double perspectiveY;
291:         double perspectiveScale;
292:     };
293: 
294:     void RegisterPreRenderingHandler(const std::function<RenderInfo(void)>& cb);
295:     void RegisterOnRenderedHandler(
296:         const std::function<void(WebContainer*,
297:                                  const RenderResult& renderResult)>& cb);
298: 
299:     static WebContainer* CreateWithPlatformImage(
300:         const WebContainerArguments& args,
301:         const std::function<ExternalImageInfo(void)>& prepareImageCb,
302:         const std::function<void(WebContainer*, bool needsFlush)>& flushCb);
303:     // <--- end of function set for render to buffer
304: 
305:     // Function set for render with OpenGL
306:     static WebContainer* CreateGL(const WebContainerArguments& args,
307:                                   const RendererGLConfiguration& config);
308: 
309:     static WebContainer* CreateGLWithPlatformImage(
310:         const WebContainerArguments& args,
311:         const RendererGLConfiguration& config,
312:         const std::function<ExternalImageInfo(void)>& prepareImageCb,
313:         const std::function<void(WebContainer*, bool needsFlush)>& flushCb);
314: 
315:     static WebContainer* CreateWebContainer(void* delegate);
316: 
317:     // <--- end of function set for render with OpenGL
318: 
319:     // Function set for headless
320:     static WebContainer* CreateHeadless(unsigned width, unsigned height,
321:                                         float devicePixelRatio,
322:                                         const char* defaultFontName,
323:                                         const char* locale,
324:                                         const char* timezoneID);
325:     // <--- end of function set for headless
326: 
327:     void AddIdleCallback(void (*callback)(void*), void* data);
328:     size_t AddTimeout(void (*callback)(void*), void* data, size_t timeoutInMS);
329:     void ClearTimeout(size_t handle);
330: 
331:     void RegisterCanRenderingHandler(
332:         const std::function<bool(WebContainer*)>& cb);
333: 
334:     Settings GetSettings();
335:     void LoadURL(const std::string& url);
336:     std::string GetURL();
337:     void LoadData(const std::string& data);
338:     void Reload();
