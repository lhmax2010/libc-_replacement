1: /**
2:  * @file  ewk_cookie_parser
3:  * @brief EWK Cookie Parser
4:  *
5:  * This class exposes the Chromium cookie parser. It allows
6:  * for ewk components to handle cookie-alike structures without
7:  * re-inventing the wheel.
8:  *
9:  * Copyright 2020 by Samsung Electronics, Inc.,
10:  *
11:  * This software is the confidential and proprietary information
12:  * of Samsung Electronics, Inc. ("Confidential Information").  You
13:  * shall not disclose such Confidential Information and shall use
14:  * it only in accordance with the terms of the license agreement
15:  * you entered into with Samsung.
16:  */
17: 
18: #ifndef __EWK_COOKIE_PARSER_H__
19: #define __EWK_COOKIE_PARSER_H__
20: 
21: #include <Ecore.h>
22: #include <tizen.h>
23: #include <string>
24: 
25: #ifdef __cplusplus
26: extern "C" {
27: #endif
28: 
29: /**
30:  * @addtogroup WEBVIEW
31:  */
32: 
33: /**
34:  * @brief This structure is used to return the contents of the parsed cookie.
35:  * This structure is used a bridge between the Chromium cookie handling code
36:  * and the calling application.
37:  */
38: struct EWKCookieContents {
39:   time_t expiry_date_utc;
40:   std::string domain;
41:   std::string name;
42:   std::string path;
43:   std::string value;
44: };
45: 
46: /**
47:  * @brief Parses a Cookie String and Returns the Contents.
48:  *
49:  * @details The application can use this function use the internal Cookie
50:  *          parsing code to decode cookie strings. This allows the calling
51:  *          application to manage non-standard cookies without effecting the
52:  *          security policies that have been set up in Chromium. These can be
53:  *          used for non-standard schemes the may want to use cookies.
54:  *
55:  *          The cookie is only treated as valid if it should be readably by a
56:  *          javascript function. I.e. if the HttpOnly and Secure flags are not
57:  *          set. It is the responsibility of the calling application to check to
58:  *          see if the cookies expiry_date has expired.
59:  *
60:  *          NOTE: if the cookie has an expiry_date == 0 then the cookie should
61:  *                be treated as a session cookie.
62:  *
63:  * @since_tizen 4.0
64:  *
65:  * @param[in]   cookie_str  The cookie string to be decoded.
66:  * @param[out]  cookie      The decoded cookie data.
67:  *
68:  * @return @c true if the cookie string is value, else false.
69:  */
70: EXPORT_API Eina_Bool ewk_parse_cookie(const std::string& cookie_str,
71:                                       EWKCookieContents& cookie);
72: 
73: #ifdef __cplusplus
74: }
75: #endif
76: 
77: #endif
