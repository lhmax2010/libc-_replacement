17: #ifndef TIZEN_APPFW_APP_HPP_
18: #define TIZEN_APPFW_APP_HPP_
19: 
20: #include <app.h>
21: 
22: #include <app_control.hpp>
23: #include <app_common.hpp>
24: 
25: namespace tizen_appfw {
26: 
27: class UiAppBase : public app_common::AppBase<
28:     decltype(ui_app_add_event_handler)*,
29:     decltype(ui_app_remove_event_handler)*> {
30:  public:
31:   using Remover = decltype(ui_app_remove_event_handler)*;
32: 
33:   UiAppBase()
34:       : AppBase(ui_app_add_event_handler, ui_app_remove_event_handler) {}
35: 
36:   virtual bool OnCreate() { return true; }
37:   virtual void OnTerminate() {}
38:   virtual void OnResume() {}
39:   virtual void OnPause() {}
40:   virtual void OnAppControl(const ReceivedAppControl& ctrl) {}
41: 
42:   int Run(int argc, char **argv) {
43:     ui_app_lifecycle_callback_s callback = {
44:       create : [](void* user_data) -> bool {
45:         UiAppBase* b = static_cast<UiAppBase*>(user_data);
46:         return b->OnCreate();
47:       },
48:       terminate : [](void* user_data) {
49:         UiAppBase* b = static_cast<UiAppBase*>(user_data);
50:         b->OnTerminate();
51:       },
52:       pause : [](void* user_data) {
53:         UiAppBase* b = static_cast<UiAppBase*>(user_data);
54:         b->OnPause();
55:       },
56:       resume : [](void* user_data) {
57:         UiAppBase* b = static_cast<UiAppBase*>(user_data);
58:         b->OnResume();
59:       },
60:       app_control : [](app_control_h app_control, void* user_data) {
61:         UiAppBase* b = static_cast<UiAppBase*>(user_data);
62:         b->OnAppControl(ReceivedAppControl(app_control));
63:       }
64:     };
65: 
66:     return ui_app_main(argc, argv, &callback, this);
67:   }
68: 
69:   void Exit() noexcept {
70:     ui_app_exit();
71:   }
72: };
73: 
74: }  // namespace tizen_appfw
75: 
76: #endif  // TIZEN_APPFW_APP_HPP_
