63: /**
64:  * @deprecated Deprecated since 10.0.
65:  * @brief Sends the orientation of the device.
66:  *
67:  * If orientation value is changed, orientationchanged event will occur.
68:  *
69:  * @since_tizen 2.4
70:  *
71:  * @param[in] o View object to receive orientation event.
72:  * @param[in] orientation The new orientation of the device. (degree)
73:  *
74:  * orientation will be 0 degrees when the device is oriented to natural position
75:  *                  ,-90 degrees when it's left side is at the top
76:  *                  , 90 degrees when it's right side is at the top
77:  *                  ,180 degrees when it is upside down.
78:  */
79: EXPORT_API void ewk_view_orientation_send(Evas_Object *o, int orientation) TIZEN_DEPRECATED_API;
