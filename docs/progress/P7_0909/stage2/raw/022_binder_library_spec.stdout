1: # NOTES
2: # This spec file is used to build DALi C# binder for different Tizen Profiles
3: # Current profiles are:  Mobile, TV, Common
4: #
5: # The profile variable is defined outside of the spec file in a build.conf file.
6: # It will contain the profile and whether or not to build with X11 or Wayland
7: #
8: # gbs will try to download the build.conf for the platform automatically from the repo location when
9: # performing a gbs build ( use gbs build -v to see it download location) E.g.
10: # http://download.tizen.org/snapshots/tizen/tv/tizen-tv/repos/arm-wayland/packages/repodata/xxxx-build.conf.gz
11: 
12: # This if statement is for backward compatibility with GBM/Obsolete build systems
13: %if "%{?profile}" != "mobile" && "%{?profile}" != "tv" && "%{?profile}" != "common"
14: %global __provides_exclude_from ^.*\\.(mobile|tv|common)$
15: %endif
16: 
17: %bcond_with wayland
18: 
19: #please update nui_internal_version below, if you changed version-check.cpp
20: %define nui_internal_version nui550
21: 
22: Name: dali2-csharp-binder
23: Summary: The DALI Csharp Binder
24: Version: 2.5.26
25: Release: 1
26: Group: uifw/graphic
27: License: Apache-2.0 and Zlib
28: Source: %{name}-%{version}.tar.xz
29: 
30: Requires(post): /sbin/ldconfig
31: Requires(postun): /sbin/ldconfig
32: 
33: %define tizen_platform_config_supported 1
34: BuildRequires:  pkgconfig(libtzplatform-config)
35: 
36: BuildRequires: pkgconfig
37: BuildRequires: cmake
38: BuildRequires: gawk
39: BuildRequires: pkgconfig(dali2-core)
40: BuildRequires: pkgconfig(dali2-adaptor)
41: BuildRequires: pkgconfig(dali2-toolkit)
42: BuildRequires: pkgconfig(dali2-scene3d)
43: BuildRequires: pkgconfig(dali2-physics-2d)
44: BuildRequires: pkgconfig(dali2-physics-3d)
45: BuildRequires: dali2-integration-devel
46: BuildRequires: dali2-adaptor-integration-devel
47: BuildRequires: dali2-toolkit-integration-devel
48: BuildRequires: dali2-scene3d-integration-devel
49: 
50: %if "%{_vd_cfg_product_type}" != "AUDIO" && "%{_vd_cfg_product_type}" !="AV"
51: %define rive_animation_view 1
52: BuildRequires: pkgconfig(dali2-extension-rive-animation-view)
53: %endif
54: 
55: 
56: BuildRequires: pkgconfig(widget_viewer_dali)
57: BuildRequires: pkgconfig(libtbm)
58: %if 0%{?tizen_version_major} < 11
59: BuildRequires: pkgconfig(ecore-wl2)
60: %endif
61: 
62: # For ASAN test
63: %if "%{vd_asan}" == "1" || "%{asan}" == "1"
64: BuildRequires: asan-force-options
65: BuildRequires: asan-build-env
66: BuildRequires: libasan
67: %endif
68: 
69: # for multiprofile
70: Requires:   %{name}-compat = %{version}-%{release}
71: Recommends: %{name}-profile_common = %{version}-%{release}
72: 
73: %description
74: dali-csharp-binder
75: 
76: ###########################################
77: # Dali csharp binder for profiles
78: ###########################################
79: 
80: # If the profile is selected, the line below is repquired.
81: # if mobile || "undefined"
82: %if "%{?profile}" != "tv" && "%{?profile}" != "common"
83: %package profile_mobile
84: Summary:        The DALi Tizen csharp binder for mobile
85: Provides:       %{name}-compat = %{version}-%{release}
86: Conflicts:      %{name}-profile_tv
87: Conflicts:      %{name}-profile_common
88: %description profile_mobile
89: The DALi Tizen csharp binder for mobile.
90: %endif
91: 
92: # If the profile is selected, the line below is repquired.
93: # if tv ||"undefined"
94: %if "%{?profile}" != "common" && "%{?profile}" != "mobile"
95: %package profile_tv
96: Summary:        The DALi Tizen csharp binder for tv
97: Provides:       %{name}-compat = %{version}-%{release}
98: Conflicts:      %{name}-profile_mobile
99: Conflicts:      %{name}-profile_common
100: %description profile_tv
101: The DALi Tizen csharp binder for tv.
102: %endif
103: 
104: # If the profile is selected, the line below is repquired.
105: # if common ||"undefined"
106: %if "%{?profile}" != "tv" && "%{?profile}" != "mobile"
107: # Currently Tizen Common we use does not have wayland extensions like xdg-shell
108: %package profile_common
109: %define tizen_2_2_compatibility 0
110: Summary:        The DALi Tizen csharp binder for common
111: Provides:       %{name}-compat = %{version}-%{release}
112: Conflicts:      %{name}-profile_mobile
113: Conflicts:      %{name}-profile_tv
114: %description profile_common
115: The DALi Tizen csharp binder for common.
116: %endif
117: 
118: 
119: ##############################
120: # devel
121: ##############################
122: %package devel
123: Summary: build dali csharp binder
124: Group: Development/Building
125: Requires: %{name} = %{version}-%{release}
126: 
127: %description devel
128: This package includes developer files common to all packages.
129: 
130: 
131: ##############################
132: # Dali Scene3D
133: ##############################
134: %package scene3d
135: Summary:    build dali csharp binder scene3d
136: Group:      System/Libraries
137: Requires:   %{name} = %{version}-%{release}
138: %description scene3d
139: Scene 3D for Dali
140: 
141: ##############################
142: # Dali Physics 2D
143: ##############################
144: %package physics2d
145: Summary:    build dali csharp binder physics2d
146: Group:      System/Libraries
147: Requires:   %{name} = %{version}-%{release}
148: %description physics2d
149: 2D Physics for Dali
150: 
151: ##############################
152: # Dali Physics 3D
153: ##############################
154: %package physics3d
155: Summary:    build dali csharp binder physics3d
156: Group:      System/Libraries
157: Requires:   %{name} = %{version}-%{release}
158: %description physics3d
159: 3D Physics for Dali
160: 
161: ##############################
162: # Dali Toolkit Demo
163: ##############################
164: %package toolkitdemo
165: Summary:    build dali csharp binder toolkit demo
166: Group:      System/Libraries
167: Requires:   %{name} = %{version}-%{release}
168: %description toolkitdemo
169: Toolkit Demo
170: 
171: ##############################
172: # Preparation
173: ##############################
174: %prep
175: %setup -q
176: 
177: # %define dali_data_rw_dir         %TZ_SYS_RO_SHARE/dali/
178: # %define dali_data_ro_dir         %TZ_SYS_RO_SHARE/dali/
179: 
180: ##############################
181: # Build
182: ##############################
183: %build
184: PREFIX+="/usr"
185: CXXFLAGS+=" -Wall -g -Os -fPIC"
186: LDFLAGS+=" -Wl,--rpath=%{_libdir} "
187: 
188: %if %{with wayland}
189: CFLAGS+=" -DWAYLAND"
190: CXXFLAGS+=" -DWAYLAND"
191: cmake_flags=" -DENABLE_WAYLAND=ON"
192: 
193: # Use this conditional when Tizen version is 5.x or greater
194: %if 0%{?tizen_version_major} >= 5
195: CXXFLAGS+=" -DOVER_TIZEN_VERSION_5"
196: 
197: # Need Ecore-Wayland2 when Tizen version is 5.x or greater, and less than 11.x
198: %if 0%{?tizen_version_major} < 11
199: CFLAGS+=" -DECORE_WL2 -DEFL_BETA_API_SUPPORT"
200: CXXFLAGS+=" -DECORE_WL2 -DEFL_BETA_API_SUPPORT"
201: cmake_flags+=" -DENABLE_ECORE_WAYLAND2=ON"
202: %endif
203: %endif
204: 
205: # Use this conditional when Tizen version is 7.x or greater
206: %if 0%{?tizen_version_major} >= 7
207: CXXFLAGS+=" -DOVER_TIZEN_VERSION_7"
208: %endif
209: 
210: %if 0%{?tizen_version_major} >= 10
211: CXXFLAGS+=" -DOVER_TIZEN_VERSION_10"
212: cmake_flags+=" -DENABLE_LEGACY_BINDER_BUILD=OFF"
213: %else
214: cmake_flags+=" -DENABLE_LEGACY_BINDER_BUILD=ON"
215: %endif
216: 
217: %endif
218: 
219: %if "%{vd_asan}" == "1" || "%{asan}" == "1"
220: CFLAGS+=" -fsanitize=address"
221: CXXFLAGS+=" -fsanitize=address"
222: LDFLAGS+=" -fsanitize=address"
223: %endif
224: 
225: %if 0%{?enable_debug}
226: cmake_flags+=" -DCMAKE_BUILD_TYPE=Debug"
227: %endif
228: 
229: %if 0%{?rive_animation_view}
230: cmake_flags+=" -DENABLE_RIVE_ANIMATION=ON"
231: %endif
232: 
233: # autogen
234: libtoolize --force
235: cd %{_builddir}/%{name}-%{version}/build/tizen
236: 
237: # DALI_DATA_RW_DIR="%{dali_data_rw_dir}" ; export DALI_DATA_RW_DIR
238: # DALI_DATA_RO_DIR="%{dali_data_ro_dir}"  ; export DALI_DATA_RO_DIR
239: %if 0%{?tizen_platform_config_supported}
240: TIZEN_PLATFORM_CONFIG_SUPPORTED="%{tizen_platform_config_supported}" ; export TIZEN_PLATFORM_CONFIG_SUPPORTED
241: %endif
242: 
243: cmake_flags+=" -DCMAKE_INSTALL_PREFIX=$PREFIX"
244: cmake_flags+=" -DCMAKE_INSTALL_LIBDIR=%{_libdir}"
245: cmake_flags+=" -DCMAKE_INSTALL_INCLUDEDIR=%{_includedir}"
246: cmake_flags+=" -DENABLE_TIZEN_MAJOR_VERSION=%{tizen_version_major}"
247: cmake_flags+=" -DENABLE_SCENE3D=ON"
248: cmake_flags+=" -DENABLE_PHYSICS_2D=ON"
249: cmake_flags+=" -DENABLE_PHYSICS_3D=ON"
250: cmake_flags+=" -DENABLE_WIDGET_VIEWER_DALI=ON"
251: cmake_flags+=" -DENABLE_TOOLKIT_DEMO=ON"
252: 
253: 
254: # Set up the build via Cmake
255: #######################################################################
256: # This is for backward-compatibility. This does not deteriorate 4.0 Configurability
257: # if mobile || "undefined"
258: %if "%{?profile}" != "tv" && "%{?profile}" != "common"
259: 
260: mkdir -p mobile
261: pushd mobile
262: 
263: cmake -DENABLE_PROFILE=MOBILE $cmake_flags ..
264: 
265: # Build.
266: make %{?jobs:-j%jobs}
267: popd
268: 
269: %endif
270: 
271: #######################################################################
272: # This is for backward-compatibility. This does not deteriorate 4.0 Configurability
273: # if tv ||"undefined"
274: %if "%{?profile}" != "common" && "%{?profile}" != "mobile"
275: 
276: mkdir -p tv
277: pushd tv
278: 
279: cmake -DENABLE_PROFILE=TV $cmake_flags ..
280: 
281: # Build.
282: make %{?jobs:-j%jobs}
283: popd
284: 
285: %endif
286: 
287: #######################################################################
288: # common
289: # This is for backward-compatibility. This does not deteriorate 4.0 Configurability
290: # if common ||"undefined"
291: %if "%{?profile}" != "tv" && "%{?profile}" != "mobile"
292: 
293: mkdir -p common
294: pushd common
295: 
296: cmake -DENABLE_PROFILE=COMMON $cmake_flags ..
297: 
298: # Build.
299: make %{?jobs:-j%jobs}
300: popd
301: 
302: %endif
303: 
304: ##############################
305: # Installation
306: ##############################
307: %install
308: rm -rf %{buildroot}
309: 
310: pushd %{_builddir}/%{name}-%{version}/build/tizen
311: 
312: # if mobile || "undefined"
313: %if "%{?profile}" != "tv" && "%{?profile}" != "common"
314: pushd mobile
315: %make_install
316: %if "%{?profile}" != "mobile"
317: pushd  %{buildroot}%{_libdir}
318: cp libdali2-csharp-binder.so.*.*.* libdali2-csharp-binder.so.mobile # If we're only building this profile, then there's no need to copy the lib
319: popd
320: make clean # So that we can gather symbol/size information for only one profile if we're building all profiles
321: %endif
322: popd
323: %endif
324: 
325: # if tv ||"undefined"
326: %if "%{?profile}" != "common" && "%{?profile}" != "mobile"
327: pushd tv
328: %make_install
329: %if "%{?profile}" != "tv"
330: pushd  %{buildroot}%{_libdir}
331: cp libdali2-csharp-binder.so.*.*.* libdali2-csharp-binder.so.tv # If we're only building this profile, then there's no need to copy the lib
332: popd
333: make clean # So that we can gather symbol/size information for only one profile if we're building all profiles
334: %endif
335: popd
336: %endif
337: 
338: # if common ||"undefined"
339: %if "%{?profile}" != "tv" && "%{?profile}" != "mobile"
340: pushd common
341: %make_install
342: # No clean so we can gather symbol/size information for the common profile
343: popd
344: %endif
345: 
346: ##############################
347: # Upgrade order:
348: # 1 - Pre Install new package
349: # 2 - Install new package
350: # 3 - Post install new package
351: # 4 - Pre uninstall old package
352: # 5 - Remove files not overwritten by new package
353: # 6 - Post uninstall old package
354: ##############################
355: 
356: %pre
357: exit 0
358: 
359: ##############################
360: #  Post Install new package
361: ##############################
362: %post
363: pushd %{_libdir}
364: for i in mobile tv; do [[ -f libdali2-csharp-binder.so.$i ]] && ln -sf libdali2-csharp-binder.so.$i libdali2-csharp-binder.so.2.0.0; done
365: popd
366: /sbin/ldconfig
367: exit 0
368: 
369: ##############################
370: #  Pre Uninstall old package
371: ##############################
372: %preun
373: exit 0
374: 
375: ##############################
376: #  Post Uninstall old package
377: ##############################
378: %postun
379: /sbin/ldconfig
380: exit 0
381: 
382: ##############################
383: # Mobile Profile Commands
384: # No need to create a symbolic link on install required if only building this profile
385: # if mobile || "undefined"
386: %if "%{?profile}" != "tv" && "%{?profile}" != "common"
387: %post profile_mobile
388: %if "%{?profile}" != "mobile"
389: pushd %{_libdir}
390: ln -sf libdali2-csharp-binder.so.mobile libdali2-csharp-binder.so.2.0.0
391: popd
392: %endif
393: /sbin/ldconfig
394: exit 0
395: 
396: %postun profile_mobile
397: /sbin/ldconfig
398: exit 0
399: %endif
400: 
401: ##############################
402: # TV Profile Commands
403: # No need to create a symbolic link on install required if only building this profile
404: # if tv ||"undefined"
405: %if "%{?profile}" != "common" && "%{?profile}" != "mobile"
406: %post profile_tv
407: %if "%{?profile}" != "tv"
408: pushd %{_libdir}
409: ln -sf libdali2-csharp-binder.so.tv libdali2-csharp-binder.so.2.0.0
410: popd
411: %endif
412: /sbin/ldconfig
413: exit 0
414: 
415: %postun profile_tv
416: /sbin/ldconfig
417: exit 0
418: %endif
419: 
420: ##############################
421: # Common Profile Commands
422: %if "%{?profile}" != "tv" && "%{?profile}" != "mobile"
423: %post profile_common
424: /sbin/ldconfig
425: exit 0
426: 
427: %postun profile_common
428: /sbin/ldconfig
429: exit 0
430: %endif
431: 
