104: const TypeInfoId& Any::GetType() const
105: {
106:   static const TypeInfoId voidType;
107:   return mContainer ? mContainer->GetType() : voidType;
108: }
109: 
110: Dali::String Any::DemangleTypeName(const char* mangledName)
111: {
112:   if(!mangledName || mangledName[0] == '\0')
113:   {
114:     return Dali::String();
115:   }
116: 
117:   // DemangleTypeInfoName returns a std::string. Capture it in a named local
118:   // variable before calling c_str() — calling c_str() on a temporary would
119:   // be undefined behaviour because the temporary is destroyed before the
120:   // Dali::String constructor completes.
121:   std::string demangled = Dali::Internal::DemangleTypeInfoName(mangledName);
122:   return Dali::String(demangled.c_str());
123: }
124: 
125: void Any::AssertAlways(const char* assertMessage)
126: {
127:   DALI_LOG_ERROR_NOFN(assertMessage);
128:   throw Dali::DaliException(assertMessage, "");
129: }
