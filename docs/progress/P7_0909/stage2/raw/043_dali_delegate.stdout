45:    * @param[in] functorPtr The functor to call
46:    */
47:   static void Dispatch(void* functorPtr)
48:   {
49:     // "downcast" the functor type back to the correct one
50:     T* functor = reinterpret_cast<T*>(functorPtr);
51:     (*functor)();
52:   }
53: };
