55: /**
56:  * @brief Dispatcher to delete a functor object.
57:  * @SINCE_1_0.0
58:  */
59: template<typename T>
60: struct FunctorDestroyer
61: {
62:   /**
63:    * @brief Dispatcher to delete an object.
64:    * @SINCE_1_0.0
65:    * @param[in] functorPtr A functor object to delete
66:    */
67:   static void Delete(void* functorPtr)
68:   {
69:     // FunctorDelegate owns the object but we're the only one who knows the real type so need
70:     // to delete by "downcasting" from void* to the correct type
71:     delete reinterpret_cast<T*>(functorPtr);
72:   }
73: };
