75: /**
76:  * @brief Used to connect a void() functor to a signal via BaseObject::SignalConnect().
77:  * @SINCE_1_0.0
78:  */
79: class DALI_CORE_API FunctorDelegate
80: {
81: public:
82:   /**
83:    * @brief Constructor which copies a function object.
84:    *
85:    * @SINCE_1_0.0
86:    * @param[in] functor The functor object to move, either a class with operator() or a C function
87:    * @return A pointer to the new function object
88:    */
89:   template<typename T>
90:   static FunctorDelegate* New(T&& functor)
91:   {
92:     return new FunctorDelegate(reinterpret_cast<void*>(new T(std::move(functor))), // heap allocate the functor
93:                                reinterpret_cast<FunctorDelegate::Dispatcher>(&FunctorDispatcher<T>::Dispatch),
94:                                reinterpret_cast<FunctorDelegate::Destructor>(&FunctorDestroyer<T>::Delete));
95:   }
96: 
97:   /**
98:    * @brief Non-virtual destructor; not intended as a base class.
99:    * @SINCE_1_0.0
100:    */
101:   ~FunctorDelegate();
102: 
103:   /**
104:    * @brief Function to call the function or member function dispatcher.
105:    * @SINCE_1_0.0
106:    */
107:   void Execute();
108: 
109: private:
110:   /**
111:    * @brief Used to call the correct function.
112:    * @SINCE_1_0.0
113:    */
114:   using Dispatcher = void (*)(void*);
115: 
116:   /**
117:    * @brief Used to destroy mObjectPointer.
118:    * @SINCE_1_0.0
119:    */
120:   using Destructor = void (*)(void*);
121: 
122:   /**
123:    * @brief Not defined.
124:    * @SINCE_1_0.0
125:    */
126:   FunctorDelegate(const FunctorDelegate& rhs);
127: 
128:   /**
129:    * @brief Not defined.
130:    * @SINCE_1_0.0
131:    */
132:   const FunctorDelegate& operator=(const FunctorDelegate& rhs);
133: 
134:   /**
135:    * @brief Private constructor.
136:    *
137:    * @SINCE_1_0.0
138:    * @param[in] functorPtr A newly allocated functor object (takes ownership)
139:    * @param dispatcher Used to call the actual function
140:    * @param destructor Used to delete the owned functor object
141:    */
142:   FunctorDelegate(void* functorPtr, Dispatcher dispatcher, Destructor destructor);
143: 
144: public:
145:   // Data for deriving classes & Dispatchers
146: 
147:   void*      mFunctorPointer;           ///< Functor that will be called
148:   Dispatcher mMemberFunctionDispatcher; ///< Dispatcher for member functions
149:   Destructor mDestructorDispatcher;     ///< Destructor for owned objects
150: };
151: 
152: /**
153:  * @}
154:  */
