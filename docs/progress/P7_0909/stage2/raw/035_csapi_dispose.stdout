539:         /// <summary>
540:         /// Search through this view's hierarchy for a view as Animatable with the given name.
541:         /// The view itself is also considered in the search.
542:         /// </summary>
543:         /// <pre>The view has been initialized.</pre>
544:         /// <param name="childName">The name of the Animatable to find.</param>
545:         /// <returns>A handle to the view as Animatable if found, or an empty handle if not.</returns>
546:         /// This will not be public opened.
547:         [EditorBrowsable(EditorBrowsableState.Never)]
548:         public Animatable FindChildAnimatableByName(string childName)
549:         {
550:             //to fix memory leak issue, match the handle count with native side.
551:             IntPtr cPtr = Interop.Actor.FindChildByName(SwigCPtr, childName);
552:             Animatable ret = Registry.GetManagedBaseHandleFromNativePtr(cPtr) as Animatable;
553:             if(ret == null)
554:             {
555:                 // Register new camera into Registry.
556:                 ret = new Animatable(cPtr, true);
557:                 return ret;
558:             }
559:             else
560:             {
561:                 // We found matched NUI camera. Reduce cPtr reference count.
562:                 HandleRef handle = new HandleRef(this, cPtr);
563:                 Interop.Actor.DeleteActor(handle);
564:                 handle = new HandleRef(null, IntPtr.Zero);
565:                 if (NDalicPINVOKE.SWIGPendingException.Pending) throw NDalicPINVOKE.SWIGPendingException.Retrieve();
566:                 return ret;
567:             }
568:         }
