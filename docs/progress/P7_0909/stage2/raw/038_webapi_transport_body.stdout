1306: NativeManager.prototype.call = function(cmd, args, callback) {
1307:     args = args || {};
1308: 
1309:     var replyId = this.nextReplyId;
1310:     args[this.CALLBACK_ID_KEY] = replyId;
1311:     this.callbacks_[replyId] = callback;
1312: 
1313:     return this.callSync(cmd, args);
1314: };
1315: 
1316: NativeManager.prototype.callSync = function(cmd, args) {
1317:     var request = JSON_.stringify({
1318:         cmd: cmd,
1319:         args: args || {}
1320:     });
1321: 
1322:     var response = this.extension.internal.sendSyncMessage(request);
1323:     if (response === undefined) {
1324:         /* C++ extension didn't set sync response using Instance::SendSyncReply */
1325:         throw new WebAPIException(WebAPIException.ABORT_ERR, 'Internal error');
1326:     }
1327:     return JSON_.parse(response);
1328: };
1329: 
1330: NativeManager.prototype.callSyncWithBinaryAnswer = function (cmd, args) {
1331:     var request = JSON_.stringify({
1332:         __binaryAnswer: true,
1333:         cmd: cmd,
1334:         args: args || {}
1335:     });
1336: 
1337:     var response = this.extension.internal.sendSyncMessageWithBinaryReply(request);
1338:     if (response === undefined) {
1339:         /* C++ extension didn't set sync binary response using Instance::SendSyncBinaryReply */
1340:         throw new WebAPIException(WebAPIException.ABORT_ERR, 'Internal error');
1341:     }
1342:     return response;
1343: };
1344: 
1345: NativeManager.prototype.callSyncBinaryWithJSONAnswer = function(uint8array_data) {
1346:     // method id should be coded as first byte, refer to:
1347:     // extension.cc - ParsedInstance:: HandleBinaryMessage
1348: 
1349:     var response = this.extension.internal.sendSyncMessage(uint8array_data);
1350:     if (response === undefined) {
1351:         /* C++ extension didn't set sync response using Instance::SendSyncReply */
1352:         throw new WebAPIException(WebAPIException.ABORT_ERR, 'Internal error');
1353:     }
1354:     return JSON_.parse(response);
1355: };
1356: 
1357: NativeManager.prototype.sendRuntimeMessage = function(msg, body) {
1358:     return this.extension.sendRuntimeMessage(msg, body || '');
1359: };
