6: #ifndef XWALK_EXTENSIONS_PUBLIC_XW_EXTENSION_SYNCMESSAGE_H_
7: #define XWALK_EXTENSIONS_PUBLIC_XW_EXTENSION_SYNCMESSAGE_H_
8: 
9: // NOTE: This file and interfaces marked as internal are not considered stable
10: // and can be modified in incompatible ways between Crosswalk versions.
11: 
12: #ifndef XWALK_EXTENSIONS_PUBLIC_XW_EXTENSION_H_
13: #error "You should include XW_Extension.h before this file"
14: #endif
15: 
16: #ifdef __cplusplus
17: extern "C" {
18: #endif
19: 
20: //
21: // XW_INTERNAL_SYNC_MESSAGING_INTERFACE: allow JavaScript code to send a
22: // synchronous message to extension code and block until response is
23: // available. The response is made available by calling the SetSyncReply
24: // function, that can be done from outside the context of the SyncMessage
25: // handler.
26: //
27: 
28: #define XW_INTERNAL_SYNC_MESSAGING_INTERFACE_1 "XW_InternalSyncMessagingInterface_1"
29: #define XW_INTERNAL_SYNC_MESSAGING_INTERFACE XW_INTERNAL_SYNC_MESSAGING_INTERFACE_1
30: 
31: typedef void (*XW_HandleSyncMessageCallback)(XW_Instance instance, const char* message);
32: 
33: struct XW_Internal_SyncMessagingInterface_1 {
34:   void (*Register)(XW_Extension extension, XW_HandleSyncMessageCallback handle_sync_message);
35:   void (*SetSyncReply)(XW_Instance instance, const char* reply);
36:   void (*SetSyncBinaryReply)(XW_Instance instance, const std::vector<uint8_t>& reply);
37: };
38: 
39: typedef struct XW_Internal_SyncMessagingInterface_1 XW_Internal_SyncMessagingInterface;
40: 
41: #ifdef __cplusplus
42: }  // extern "C"
43: #endif
44: 
45: #endif  // XWALK_EXTENSIONS_PUBLIC_XW_EXTENSION_SYNCMESSAGE_H_
