255: #include <cxxabi.h>
256: 
257: #include <dali/dali.h>
258: #include <dali/integration-api/debug.h>
259: 
260: // Function to append SWIG_CSharpException message file/line/function.
261: extern void SWIG_ExceptionMessageWithFileAndLine(const int& code, const char* what, const char* filename, const int& linenumber, const char* funcname);
262: 
263: #define SWIG_EXCEPTION_WITH_FILE_AND_LINE(code, what) \
264:   SWIG_ExceptionMessageWithFileAndLine((code), (what), __FILE__, __LINE__, __FUNCTION__)
265: 
266: // Define Catch exception
267: #define CALL_CATCH_EXCEPTION(ret)                                                      \
268:   catch(std::out_of_range & e)                                                         \
269:   {                                                                                    \
270:     SWIG_EXCEPTION_WITH_FILE_AND_LINE(SWIG_IndexError, const_cast<char*>(e.what()));   \
271:     return ret;                                                                        \
272:   }                                                                                    \
273:   catch(std::exception & e)                                                            \
274:   {                                                                                    \
275:     SWIG_EXCEPTION_WITH_FILE_AND_LINE(SWIG_RuntimeError, const_cast<char*>(e.what())); \
276:     return ret;                                                                        \
277:   }                                                                                    \
278:   catch(Dali::DaliException e)                                                         \
279:   {                                                                                    \
280:     SWIG_EXCEPTION_WITH_FILE_AND_LINE(SWIG_DaliError, e.condition);                    \
281:     return ret;                                                                        \
282:   }                                                                                    \
283:   catch(abi::__forced_unwind&)                                                         \
284:   {                                                                                    \
285:     DALI_LOG_ERROR("abi::__forced_unwind occured\n");                                  \
286:     return ret;                                                                        \
287:   }                                                                                    \
288:   catch(...)                                                                           \
289:   {                                                                                    \
290:     SWIG_EXCEPTION_WITH_FILE_AND_LINE(SWIG_UnknownError, "unknown error");             \
291:     return ret;                                                                        \
292:   }
293: 
294: // Define Catch exception with inputed file and line infomations
295: #define CALL_CATCH_EXCEPTION_WITH_CUSTOM_FILE_AND_LINE(ret, filename, linenumber, funcname)                                     \
296:   catch(std::out_of_range & e)                                                                                                  \
297:   {                                                                                                                             \
298:     SWIG_ExceptionMessageWithFileAndLine(SWIG_IndexError, const_cast<char*>(e.what()), (filename), (linenumber), (funcname));   \
299:     return ret;                                                                                                                 \
300:   }                                                                                                                             \
301:   catch(std::exception & e)                                                                                                     \
302:   {                                                                                                                             \
303:     SWIG_ExceptionMessageWithFileAndLine(SWIG_RuntimeError, const_cast<char*>(e.what()), (filename), (linenumber), (funcname)); \
304:     return ret;                                                                                                                 \
305:   }                                                                                                                             \
306:   catch(Dali::DaliException e)                                                                                                  \
307:   {                                                                                                                             \
308:     SWIG_ExceptionMessageWithFileAndLine(SWIG_DaliError, e.condition, (filename), (linenumber), (funcname));                    \
309:     return ret;                                                                                                                 \
310:   }                                                                                                                             \
311:   catch(abi::__forced_unwind&)                                                                                                  \
312:   {                                                                                                                             \
313:     DALI_LOG_ERROR("abi::__forced_unwind occured\n");                                                                           \
314:     return ret;                                                                                                                 \
315:   }                                                                                                                             \
316:   catch(...)                                                                                                                    \
317:   {                                                                                                                             \
318:     SWIG_ExceptionMessageWithFileAndLine(SWIG_UnknownError, "unknown error", (filename), (linenumber), (funcname));             \
319:     return ret;                                                                                                                 \
320:   }
321: 
322: // Define Catch exception if we need extra job before return
323: #define CALL_CATCH_EXCEPTION_WITH_FUNCTION(ret, func, ...)                             \
324:   catch(std::out_of_range & e)                                                         \
325:   {                                                                                    \
326:     SWIG_EXCEPTION_WITH_FILE_AND_LINE(SWIG_IndexError, const_cast<char*>(e.what()));   \
327:     (*(func))(__VA_ARGS__);                                                            \
328:     return ret;                                                                        \
329:   }                                                                                    \
330:   catch(std::exception & e)                                                            \
331:   {                                                                                    \
332:     SWIG_EXCEPTION_WITH_FILE_AND_LINE(SWIG_RuntimeError, const_cast<char*>(e.what())); \
333:     (*(func))(__VA_ARGS__);                                                            \
334:     return ret;                                                                        \
335:   }                                                                                    \
336:   catch(Dali::DaliException e)                                                         \
337:   {                                                                                    \
338:     SWIG_EXCEPTION_WITH_FILE_AND_LINE(SWIG_DaliError, e.condition);                    \
339:     (*(func))(__VA_ARGS__);                                                            \
340:     return ret;                                                                        \
341:   }                                                                                    \
342:   catch(abi::__forced_unwind&)                                                         \
343:   {                                                                                    \
344:     DALI_LOG_ERROR("abi::__forced_unwind occured\n");                                  \
345:     (*(func))(__VA_ARGS__);                                                            \
346:     return ret;                                                                        \
347:   }                                                                                    \
348:   catch(...)                                                                           \
349:   {                                                                                    \
350:     SWIG_EXCEPTION_WITH_FILE_AND_LINE(SWIG_UnknownError, "unknown error");             \
351:     (*(func))(__VA_ARGS__);                                                            \
352:     return ret;                                                                        \
353:   }
354: 
355: #define GUARD_ON_NULL_RET(arg_name)                                                                            \
