150:       UP,                ///< Move keyboard focus towards the up direction @SINCE_1_0.0
151:       DOWN,              ///< Move keyboard focus towards the down direction @SINCE_1_0.0
152:       PAGE_UP,           ///< Move keyboard focus towards the previous page direction @SINCE_1_2.14
153:       PAGE_DOWN,         ///< Move keyboard focus towards the next page direction @SINCE_1_2.14
154:       FORWARD,           ///< Move keyboard focus towards the forward direction @SINCE_2_1.10
155:       BACKWARD,          ///< Move keyboard focus towards the backward direction @SINCE_2_1.10
156:       CLOCKWISE,         ///< Move keyboard focus towards the clockwise direction @SINCE_2_1.14
