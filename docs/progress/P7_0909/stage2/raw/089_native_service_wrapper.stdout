17: #ifndef TIZEN_APPFW_SERVICE_APP_HPP_
18: #define TIZEN_APPFW_SERVICE_APP_HPP_
19: 
20: #include <service_app.h>
21: 
22: #include <app_control.hpp>
23: #include <app_common.hpp>
24: 
25: namespace tizen_appfw {
26: 
27: class ServiceAppBase : public app_common::AppBase<
28:     decltype(service_app_add_event_handler)*,
29:     decltype(service_app_remove_event_handler)*> {
30:  public:
31:   using Remover = decltype(service_app_remove_event_handler)*;
32: 
33:   ServiceAppBase()
34:       : AppBase(service_app_add_event_handler,
35:                 service_app_remove_event_handler) {}
36: 
37:   // LCOV_EXCL_START
38:   virtual bool OnCreate() { return true; }
39:   virtual void OnTerminate() {}
40:   virtual void OnAppControl(const ReceivedAppControl& ctrl) {}
41:   // LCOV_EXCL_STOP
42: 
43:   int Run(int argc, char** argv) {
44:     service_app_lifecycle_callback_s callback = {
45:       .create = [](void* user_data) -> bool {
46:         ServiceAppBase* b = static_cast<ServiceAppBase*>(user_data);
47:         return b->OnCreate();
48:       },
49:       .terminate = [](void* user_data) {
50:         ServiceAppBase* b = static_cast<ServiceAppBase*>(user_data);
51:         b->OnTerminate();
52:       },
53:       .app_control = [](app_control_h app_control, void* user_data) {
54:         // LCOV_EXCL_START
55:         ServiceAppBase* b = static_cast<ServiceAppBase*>(user_data);
56:         b->OnAppControl(ReceivedAppControl(app_control));
57:         // LCOV_EXCL_STOP
58:       }
59:     };
60: 
61:     return service_app_main(argc, argv, &callback, this);
62:   }
63: 
64:   void Exit() noexcept {
65:     service_app_exit();
66:   }
67: };
68: 
69: }  // namespace tizen_appfw
70: 
71: #endif  // TIZEN_APPFW_SERVICE_APP_HPP_
