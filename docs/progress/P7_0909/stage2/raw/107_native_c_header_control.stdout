42: /**
43:  * @brief Enumeration for input method function error.
44:  *
45:  * @since_tizen 2.4
46:  */
47: typedef enum {
48: 	IME_ERROR_NONE = TIZEN_ERROR_NONE, /**< Successful */
49: 	IME_ERROR_INVALID_PARAMETER = TIZEN_ERROR_INVALID_PARAMETER, /**< Invalid parameter */
50: 	IME_ERROR_PERMISSION_DENIED = TIZEN_ERROR_PERMISSION_DENIED, /**< Permission denied */
51: 	IME_ERROR_NO_CALLBACK_FUNCTION = TIZEN_ERROR_IME | 0x0001, /**< Necessary callback function is not set */
52: 	IME_ERROR_NOT_RUNNING = TIZEN_ERROR_IME | 0x0002, /**< IME main loop is not started yet */
53: 	IME_ERROR_OPERATION_FAILED = TIZEN_ERROR_IME | 0x0003, /**< Operation failed */
54: 	IME_ERROR_OUT_OF_MEMORY = TIZEN_ERROR_OUT_OF_MEMORY, /**< Out of memory */
55: } ime_error_e;
56: 
57: /**
58:  * @brief Enumeration of the option window type.
59:  *
60:  * @since_tizen 2.4
61:  *
62:  * @see ime_option_window_created_cb()
63:  */
64: typedef enum {
65: 	IME_OPTION_WINDOW_TYPE_KEYBOARD,  /**< Open from Keyboard */
66: 	IME_OPTION_WINDOW_TYPE_SETTING_APPLICATION, /**< Open from Setting application */
67: } ime_option_window_type_e;
