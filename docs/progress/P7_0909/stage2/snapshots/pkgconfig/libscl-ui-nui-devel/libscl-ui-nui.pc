# Package Information for pkg-config

prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib64
includedir=${prefix}/include

Name: libscl-ui-nui
Description: SCL UI NUI - A library for developing XML-based software keyboards
Version: 1.0
Requires: libscl-common
Libs: -L${libdir} -lscl-ui-nui
Cflags: -I${includedir}/libscl-ui-nui

