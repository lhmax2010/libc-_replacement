prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib64

Name: efreet-mime
Description: Deprecated, please just use efreet
Version: 1.25.1
Requires: eina, eo, efl
Requires.private: eet, emile, ecore, ecore-con, ecore-file, ecore-ipc, ttrace
Libs: -L${libdir} -lefreet
Libs.private: -lm -lpthread -ldl
Cflags: -I${includedir}/efreet-1
