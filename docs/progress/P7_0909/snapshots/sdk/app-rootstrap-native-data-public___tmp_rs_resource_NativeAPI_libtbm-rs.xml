<?xml version='1.0' encoding='utf-8'?>
<rootstrap name="libtbm">
    <email>lsj119@samsung.com</email>
    <email>sc1.lim@samsung.com</email>
    <emulator>
        <rpm accept="libtbm" arch="i686" />
        <rpm accept="libtbm-devel" arch="i686" />
    </emulator>
    <target>
        <rpm accept="libtbm" arch="armv7l" />
        <rpm accept="libtbm-devel" arch="armv7l" />
    </target>
    <pkgconfig>
        <file>libtbm.pc</file>
    </pkgconfig>
    <riscv>
        <rpm accept="libtbm" arch="riscv32" />
        <rpm accept="libtbm-devel" arch="riscv32" />
    </riscv>
    <necessary>
        <file>/usr/include/tbm_backend.h</file>
        <file>/usr/include/tbm_bo.h</file>
        <file>/usr/include/tbm_bufmgr.h</file>
        <file>/usr/include/tbm_bufmgr_internal.h</file>
        <file>/usr/include/tbm_debug.h</file>
        <file>/usr/include/tbm_drm_helper.h</file>
        <file>/usr/include/tbm_dummy_display.h</file>
        <file>/usr/include/tbm_error.h</file>
        <file>/usr/include/tbm_log.h</file>
        <file>/usr/include/tbm_surface.h</file>
        <file>/usr/include/tbm_surface_internal.h</file>
        <file>/usr/include/tbm_surface_queue.h</file>
        <file>/usr/include/tbm_surface_queue_internal.h</file>
        <file>/usr/include/tbm_sync.h</file>
        <file>/usr/include/tbm_type.h</file>
        <file>/usr/include/tbm_type_common.h</file>
            <file>/usr/lib/libtbm.so*</file>
        <file>/usr/lib64/libtbm.so*</file>
    </necessary>
    <include_path>/usr/include</include_path>
    <library_path>/usr/lib</library_path>
    <library>libtbm.so</library>
</rootstrap>
