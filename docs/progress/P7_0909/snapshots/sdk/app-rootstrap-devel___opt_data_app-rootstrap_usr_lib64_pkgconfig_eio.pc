prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib64

module_arch=v-1.25

Name: eio
Description: efl: eio
Version: 1.25.1
Requires: eina, eet
Requires.private: ecore, eo, efl, ecore-file, emile, efreet-mime, ttrace
Libs: -L${libdir} -leio
Libs.private: -lm -lpthread -ldl
Cflags: -I${includedir}/eio-1
