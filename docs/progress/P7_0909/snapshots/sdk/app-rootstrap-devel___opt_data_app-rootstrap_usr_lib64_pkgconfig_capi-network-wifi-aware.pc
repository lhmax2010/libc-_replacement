# Package Information for pkg-config

prefix=
exec_prefix=/usr
libdir=/usr/lib64
includedir=/usr/include/network

Name: capi-network-wifi-aware
Description: Library and header files for Wi-Fi Aware Native API
Version: 0.2.0
Requires: capi-base-common
Libs: -L${libdir} -lcapi-network-wifi-aware
Cflags: -I${includedir}
