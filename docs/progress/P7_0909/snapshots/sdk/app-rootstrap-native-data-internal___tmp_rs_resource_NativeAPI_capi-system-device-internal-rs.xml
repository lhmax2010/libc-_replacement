<?xml version="1.0"?>
<rootstrap name="capi-system-device">
  <email>cw00.choi@samsung.com</email>
  <email>y0.cho@samsung.com</email>
  <email>yuni.seo@samsung.com</email>
  <emulator>
    <rpm accept="capi-system-device" arch="i686"/>
    <rpm accept="capi-system-device-devel" arch="i686"/>
  </emulator>
  <target>
    <rpm accept="capi-system-device" arch="armv7l"/>
    <rpm accept="capi-system-device-devel" arch="armv7l"/>
  </target>
  <pkgconfig>
    <file>capi-system-device.pc</file>
  </pkgconfig>
  <necessary>
    <file>/usr/include/device/battery-internal.h</file>
    <file>/usr/include/device/power-internal.h</file>
    <file>/usr/include/device/board-internal.h</file>
    <file>/usr/include/device/led-internal.h</file>
    <file>/usr/include/device/pmqos-internal.h</file>
    <file>/usr/include/device/touchscreen-internal.h</file>
    <file>/usr/lib/libcapi-system-device.so*</file>
  </necessary>
  <include_path>/usr/include/device</include_path>
  <library_path>/usr/lib</library_path>
  <library>libcapi-system-device.so</library>
</rootstrap>