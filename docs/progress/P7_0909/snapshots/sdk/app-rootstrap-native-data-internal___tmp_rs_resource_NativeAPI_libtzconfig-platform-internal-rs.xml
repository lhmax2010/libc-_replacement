<?xml version="1.0"?>
<rootstrap name="libtzplatform-config">
  <emulator>
    <rpm accept="libtzplatform-config" arch="i686"/>
    <rpm accept="libtzplatform-config-devel" arch="i686"/>
  </emulator>
  <target>
    <rpm accept="libtzplatform-config" arch="armv7l"/>
    <rpm accept="libtzplatform-config-devel" arch="armv7l"/>
  </target>
  <necessary>
    <file>/etc/rpm/macros.tizen-platform</file>
    <file>/etc/tizen-platform.conf</file>
  </necessary>
</rootstrap>
