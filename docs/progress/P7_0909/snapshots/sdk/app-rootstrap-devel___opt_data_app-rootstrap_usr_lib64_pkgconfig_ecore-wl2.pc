prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib64

module_arch=v-1.25

Name: ecore-wl2
Description: efl: ecore_wl2
Version: 1.25.1
Requires: eina, ecore, ecore-file
Requires.private: eo, efl, ecore-input, eio, eet, emile, ttrace, wayland-client, wayland-server, xkbcommon, wayland-cursor, tizen-extension-client, tizen-launch-client, wayland-tbm-client, wayland-egl, wayland-egl-tizen, tizen-policy-ext-client, wtz-foreign-client, wtz-screen-client, wtz-shell-client, wtz-video-shell-client, relative-pointer-unstable-v1-client, pointer-constraints-unstable-v1-client, wtz-blur-client, pointer-warp-v1-client, cursor-shape-v1-client
Libs: -L${libdir} -lecore_wl2
Libs.private: -lpthread -lm -ldl
Cflags: -I${includedir}/ecore-wl2-1
