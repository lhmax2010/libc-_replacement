prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib64

module_arch=v-1.25

Name: evas
Description: efl: evas
Version: 1.25.1
Requires: eina, ecore, ector, emile, efl, eo
Requires.private: eet, ecore-input, ttrace, lua < 5.3.0, lua >= 5.1.0, freetype2, fontconfig, fribidi, harfbuzz, wayland-client, thorvg, libjpeg, libpng, rlottie
Libs: -L${libdir} -levas
Libs.private: -lm -lpthread -ldl -lhyphen
Cflags: -I${includedir}/evas-1 -I${includedir}/evas-1/canvas -I${includedir}/evas-1/gesture
