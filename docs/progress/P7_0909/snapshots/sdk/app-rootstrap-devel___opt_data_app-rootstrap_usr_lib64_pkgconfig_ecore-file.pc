prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib64

module_arch=v-1.25

Name: ecore-file
Description: efl: ecore_file
Version: 1.25.1
Requires: eina
Requires.private: ecore-con, eo, efl, ecore, ttrace
Libs: -L${libdir} -lecore_file
Libs.private: -lpthread -lm -ldl
Cflags: -I${includedir}/ecore-file-1
