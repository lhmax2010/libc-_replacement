prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib64

module_arch=v-1.25

Name: edje
Description: efl: edje
Version: 1.25.1
Requires: evas, eo, efl, lua < 5.3.0, lua >= 5.1.0
Requires.private: eina, ecore, ector, emile, eet, ecore-evas, ecore-file, ecore-input, ecore-imf, ecore-imf-evas, embryo, efreet-mime, eio, ttrace, ecore-audio
Libs: -L${libdir} -ledje
Libs.private: -lm -lpthread -ldl
Cflags: -I${includedir}/edje-1
