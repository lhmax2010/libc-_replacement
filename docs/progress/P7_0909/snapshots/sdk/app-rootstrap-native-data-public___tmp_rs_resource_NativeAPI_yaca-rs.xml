    <email>ds73.lee@samsung.com</email>
    <emulator>
        <rpm accept="yaca-devel" arch="i686" />
        <rpm accept="yaca" arch="i686" />
    </emulator>
    <target>
        <rpm accept="yaca-devel" arch="armv7l" />
