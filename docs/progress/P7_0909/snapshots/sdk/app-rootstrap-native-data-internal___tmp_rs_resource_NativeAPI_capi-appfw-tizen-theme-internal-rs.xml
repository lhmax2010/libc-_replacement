<?xml version="1.0"?>
<rootstrap name="capi-appfw-tizen-theme">
  <email>jeremy.jang@samsung.com</email>
  <emulator>
    <rpm accept="capi-appfw-tizen-theme" arch="i686" />
    <rpm accept="capi-appfw-tizen-theme-devel" arch="i686" />
  </emulator>
  <target>
    <rpm accept="capi-appfw-tizen-theme" arch="armv7l" />
    <rpm accept="capi-appfw-tizen-theme-devel" arch="armv7l" />
  </target>
  <pkgconfig>
    <file>capi-appfw-tizen-theme.pc</file>
  </pkgconfig>
  <necessary>
    <file>/usr/include/tizen-theme/theme.h</file>
    <file>/usr/include/tizen-theme/theme_error.h</file>
    <file>/usr/include/tizen-theme/theme_loader.h</file>
    <file>/usr/lib/libcapi-appfw-tizen-theme.so*</file>
  </necessary>
  <include_path>/usr/include/tizen-theme</include_path>
  <library_path>/usr/lib</library_path>
  <library>libcapi-appfw-tizen-theme.so</library>
</rootstrap>