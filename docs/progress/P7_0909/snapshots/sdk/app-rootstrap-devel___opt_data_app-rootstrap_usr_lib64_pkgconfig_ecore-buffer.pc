prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib64

module_arch=v-1.25

Name: ecore-buffer
Description: efl: ecore_buffer
Version: 1.25.1
Requires: eina
Requires.private: ecore, eo, efl, ttrace, wayland-client, wayland-server
Libs: -L${libdir} -lecore_buffer
Libs.private: -lpthread -lm -ldl
Cflags: -I${includedir}/ecore-buffer-1
