prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib64
includedir=/usr/include

Name: libswscale
Description: FFmpeg image rescaling library
Version: 9.1.100
Requires: 
Requires.private: libavutil >= 60.8.100
Conflicts:
Libs: -L${libdir}  -lswscale 
Libs.private: -lm -latomic
Cflags: -I${includedir} -DTIZEN_FEATURE_LIBAV
