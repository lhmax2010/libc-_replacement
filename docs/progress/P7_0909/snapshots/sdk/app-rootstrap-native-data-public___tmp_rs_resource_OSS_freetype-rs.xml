        <rpm accept="libfreetype" arch="i686" />
        <rpm accept="freetype2-devel" arch="i686" />
    </emulator>
    <target>
        <rpm accept="libfreetype" arch="armv7l" />
        <rpm accept="freetype2-devel" arch="armv7l" />
    </target>
