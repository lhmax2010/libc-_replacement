<?xml version='1.0' encoding='utf-8'?>
<rootstrap name="eo">
    <emulator>
        <rpm accept="eo" arch="i686" />
        <rpm accept="eo-devel" arch="i686" />
    </emulator>
    <target>
        <rpm accept="eo" arch="armv7l" />
        <rpm accept="eo-devel" arch="armv7l" />
    </target>
    <pkgconfig>
        <file>eo.pc</file>
        <file>eolian.pc</file>
    </pkgconfig>
    <riscv>
        <rpm accept="eo" arch="riscv32" />
        <rpm accept="eo-devel" arch="riscv32" />
    </riscv>
    <necessary>
        <file>/usr/include/eo-1/Eo.h</file>
        <file>/usr/include/eo-1/efl_class.eo.h</file>
        <file>/usr/include/eo-1/efl_object.eo.h</file>
        <file>/usr/include/eo-1/efl_object_override.eo.h</file>
        <file>/usr/include/eo-1/eina_types.eot.h</file>
        <file>/usr/include/eolian-1/Eolian.h</file>
        <file>/usr/include/eolian-1/Eolian_Aux.h</file>
        <file>/usr/lib/libeolian.so*</file>
        <file>/usr/lib/libeo.so*</file>
        <file>/usr/lib64/libeo.so*</file>
        <file>/usr/lib64/libeolian.so*</file>
        <file>/usr/share/gdb/auto-load/usr/lib/libeo.so.1.25.1-gdb.py</file>
    </necessary>
    <include_path>/usr/include/eo-1</include_path>
    <library_path>/usr/lib</library_path>
    <library>libeo.so</library>
    <library>libeolian.so</library>
</rootstrap>
