prefix=/usr
exec_prefix=/usr
libdir=/usr/lib64
includedir=/usr/include
sysconfdir=/etc
localstatedir=/var
PACKAGE=fontconfig
confdir=/etc/fonts
cachedir=/opt/var/cache/fontconfig

Name: Fontconfig
Description: Font configuration and customization library
Version: 2.14.2
Requires:  freetype2 >= 21.0.15
Requires.private:  uuid
Libs: -L${libdir} -lfontconfig
Libs.private:  -L/usr/lib64 -lexpat
Cflags: -I${includedir}  -I/usr/include
