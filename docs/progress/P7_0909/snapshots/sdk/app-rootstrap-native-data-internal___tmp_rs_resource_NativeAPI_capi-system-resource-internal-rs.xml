<?xml version="1.0"?>
<rootstrap name="capi-system-resource">
  <email>cw00.choi@samsung.com</email>
  <email>unsung.lee@samsung.com</email>
  <emulator>
    <rpm accept="capi-system-resource" arch="i686"/>
    <rpm accept="capi-system-resource-devel" arch="i686"/>
  </emulator>
  <target>
    <rpm accept="capi-system-resource" arch="armv7l"/>
    <rpm accept="capi-system-resource-devel" arch="armv7l"/>
  </target>
  <pkgconfig>
    <file>capi-system-resource.pc</file>
  </pkgconfig>
  <necessary>
    <file>/usr/include/system/cpu-boosting.h</file>
    <file>/usr/include/system/cpu-boosting-type.h</file>
    <file>/usr/lib/libcapi-system-resource.so*</file>
  </necessary>
  <include_path>/usr/include/system</include_path>
  <library_path>/usr/lib</library_path>
  <library>libcapi-system-resource.so</library>
</rootstrap>