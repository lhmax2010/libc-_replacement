prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib64

module_arch=v-1.25

Name: ecore-evas
Description: efl: ecore_evas
Version: 1.25.1
Requires: evas, ecore, ector
Requires.private: eina, ecore-input-evas, eo, efl, emile, ecore-input, eet, ttrace
Libs: -L${libdir} -lecore_evas
Libs.private: -lm -lpthread -ldl
Cflags: -I${includedir}/ecore-evas-1
