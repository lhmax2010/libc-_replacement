# Package Information for pkg-config

prefix=/usr
exec_prefix=/usr
libdir=/usr/lib64
includedir=/usr/include/

Name: diagnostics
Description: Tizen Diagnostics API
Version: 1.2.0
Requires: glib-2.0 gio-unix-2.0 dlog dumpsys dumpsys-system capi-system-info bundle aul
Libs: -L${libdir} -ldiagnostics
Cflags: -I${includedir}
