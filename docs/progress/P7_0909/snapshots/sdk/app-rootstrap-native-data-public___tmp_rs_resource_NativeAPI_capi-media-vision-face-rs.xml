    <pkgconfig>
        <file>capi-media-vision-common.pc</file>
        <file>capi-media-vision-face.pc</file>
        <file>capi-media-vision-face-recognition.pc</file>
    </pkgconfig>
    <riscv>
        <rpm accept="capi-media-vision-face" arch="riscv32" />
