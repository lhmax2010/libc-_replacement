        <rpm accept="capi-media-vision-common-devel" arch="i686" />
    </emulator>
    <target>
        <rpm accept="capi-media-vision-face" arch="armv7l" />
        <rpm accept="capi-media-vision-face-devel" arch="armv7l" />
