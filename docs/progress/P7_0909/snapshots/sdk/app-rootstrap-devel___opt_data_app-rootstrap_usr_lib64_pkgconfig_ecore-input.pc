prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib64

module_arch=v-1.25

Name: ecore-input
Description: efl: ecore_input
Version: 1.25.1
Requires: eina, eo
Requires.private: ecore, efl, eeze, ecore-file, ttrace
Libs: -L${libdir} -lecore_input
Libs.private: -lpthread -lm -ldl
Cflags: -I${includedir}/ecore-input-1
