<?xml version="1.0"?>
<rootstrap name="capi-appfw-tizen-action">
  <email>h.jhun@samsung.com</email>
  <email>changyu.choi@samsung.com</email>
  <email>jeremy.jang@samsung.com</email>
  <email>ilho159.kim@samsung.com</email>
  <emulator>
    <rpm accept="capi-appfw-tizen-action" arch="i686"/>
    <rpm accept="capi-appfw-tizen-action-devel" arch="i686"/>
  </emulator>
  <target>
    <rpm accept="capi-appfw-tizen-action" arch="armv7l"/>
    <rpm accept="capi-appfw-tizen-action-devel" arch="armv7l"/>
  </target>
  <riscv>
