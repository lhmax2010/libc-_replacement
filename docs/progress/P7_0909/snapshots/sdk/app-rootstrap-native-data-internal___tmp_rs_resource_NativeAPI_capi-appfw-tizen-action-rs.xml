  <necessary>
    <file>/usr/include/tizen-action/action.h</file>
    <file>/usr/include/tizen-action/action_error.h</file>
    <file>/usr/lib/libcapi-appfw-tizen-action.so*</file>
  </necessary>
  <include_path>/usr/include/tizen-action</include_path>
  <library_path>/usr/lib</library_path>
