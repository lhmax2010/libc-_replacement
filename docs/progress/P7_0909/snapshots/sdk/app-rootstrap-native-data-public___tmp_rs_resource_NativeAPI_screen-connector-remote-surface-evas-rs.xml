<?xml version="1.0"?>
<rootstrap name="screen-connector-remote-surface-evas">
  <email>yjoo93.park@samsung.com</email>
  <email>kyuho.jo@samsung.com</email>
  <emulator>
    <rpm accept="libscreen_connector_remote_surface_evas" arch="i686"/>
    <rpm accept="libscreen_connector_remote_surface_evas-devel" arch="i686"/>
  </emulator>
  <target>
    <rpm accept="libscreen_connector_remote_surface_evas" arch="armv7l"/>
    <rpm accept="libscreen_connector_remote_surface_evas-devel" arch="armv7l"/>
  </target>
  <riscv>
    <rpm accept="libscreen_connector_remote_surface_evas" arch="riscv32"/>
    <rpm accept="libscreen_connector_remote_surface_evas-devel" arch="riscv32"/>
  </riscv>
  <pkgconfig>
    <file>screen_connector_remote_surface_evas.pc</file>
  </pkgconfig>
  <necessary>
