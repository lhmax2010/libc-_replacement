    <file>/usr/include/screen_connector_remote_surface_evas/evas_object.h</file>
    <file>/usr/include/screen_connector_remote_surface_evas/image.h</file>
    <file>/usr/include/screen_connector_remote_surface_evas/image_event_listener.h</file>
    <file>/usr/include/screen_connector_remote_surface_evas/remote_surface_evas.h</file>
    <file>/usr/include/screen_connector_remote_surface_evas/remote_surface_watcher.h</file>
    <file>/usr/include/screen_connector_remote_surface_evas/util.h</file>
    <file>/usr/include/screen_connector_remote_surface_evas/watcher_event_interface.h</file>
    <file>/usr/lib/libscreen_connector_remote_surface_evas.so*</file>
  </necessary>
  <include_path>/usr/include/screen_connector_remote_surface_evas</include_path>
  <library_path>/usr/lib</library_path>
  <library>libscreen_connector_remote_surface_evas.so</library>
