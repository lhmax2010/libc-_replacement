<?xml version="1.0"?>
<rootstrap name="libmm-common">
  <email>heechul.jeon@samsung.com</email>
  <email>ht1211.kim@samsung.com</email>
  <email>jm80.yang@samsung.com</email>
  <emulator>
    <rpm accept="libmm-common" arch="i686"/>
    <rpm accept="libmm-common-devel" arch="i686"/>
  </emulator>
  <target>
    <rpm accept="libmm-common" arch="armv7l"/>
    <rpm accept="libmm-common-devel" arch="armv7l"/>
  </target>
  <pkgconfig>
    <file>mm-common.pc</file>
  </pkgconfig>
  <necessary>
    <file>/usr/include/mmf/mm_types.h</file>
    <file>/usr/include/mmf/mm_error.h</file>
    <file>/usr/include/mmf/mm_message.h</file>
    <file>/usr/lib/libmmfcommon.so*</file>
  </necessary>
  <include_path>/usr/include/mmf</include_path>
  <library_path>/usr/lib</library_path>
  <library>libmmfcommon.so</library>
</rootstrap>