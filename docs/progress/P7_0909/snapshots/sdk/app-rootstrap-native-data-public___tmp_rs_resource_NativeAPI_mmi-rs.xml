        <rpm accept="mmi-cli" arch="riscv32" />
        <rpm accept="mmi-devel" arch="riscv32" />
    </riscv>
    <necessary>
        <file>/usr/include/mmi-common.h</file>
        <file>/usr/include/mmi-manager-dbg.h</file>
        <file>/usr/include/mmi-manager.h</file>
