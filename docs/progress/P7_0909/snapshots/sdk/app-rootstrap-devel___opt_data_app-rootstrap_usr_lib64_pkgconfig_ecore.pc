prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib64

module_arch=v-1.25

Name: ecore
Description: efl: ecore
Version: 1.25.1
Requires: eina, eo, efl
Requires.private: ttrace, glib-2.0, gthread-2.0
Libs: -L${libdir} -lecore
Libs.private: -lm -lpthread -ldl
Cflags: -I${includedir}/ecore-1
