<?xml version="1.0"?>
<rootstrap name="libmm-sound">
  <email>heechul.jeon@samsung.com</email>
  <email>ht1211.kim@samsung.com</email>
  <email>jm80.yang@samsung.com</email>
  <emulator>
    <rpm accept="libmm-sound" arch="i686"/>
    <rpm accept="libmm-sound-devel" arch="i686"/>
  </emulator>
  <target>
    <rpm accept="libmm-sound" arch="armv7l"/>
    <rpm accept="libmm-sound-devel" arch="armv7l"/>
  </target>
  <pkgconfig>
    <file>mm-sound.pc</file>
    <file>mm-keysound.pc</file>
  </pkgconfig>
  <necessary>
    <file>/usr/include/mmf/mm_sound_private.h</file>
    <file>/usr/include/mmf/mm_sound.h</file>
    <file>/usr/lib/libmm-sound.so*</file>
    <file>/usr/lib/libmmfkeysound.so*</file>
    <file>/usr/lib/libmmfsound.so*</file>
  </necessary>
  <include_path>/usr/include/mmf</include_path>
  <library_path>/usr/lib</library_path>
  <library>libmm-sound.so</library>
  <library>libmmfkeysound.so</library>
</rootstrap>