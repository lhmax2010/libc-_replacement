<?xml version='1.0' encoding='utf-8'?>
<rootstrap name="emile">
    <emulator>
        <rpm accept="emile" arch="i686" />
        <rpm accept="emile-devel" arch="i686" />
    </emulator>
    <target>
        <rpm accept="emile" arch="armv7l" />
        <rpm accept="emile-devel" arch="armv7l" />
    </target>
    <pkgconfig>
        <file>emile.pc</file>
    </pkgconfig>
    <riscv>
        <rpm accept="emile" arch="riscv32" />
        <rpm accept="emile-devel" arch="riscv32" />
    </riscv>
    <necessary>
        <file>/usr/include/emile-1/Emile.h</file>
        <file>/usr/include/emile-1/emile_base64.h</file>
        <file>/usr/include/emile-1/emile_cipher.h</file>
        <file>/usr/include/emile-1/emile_compress.h</file>
        <file>/usr/include/emile-1/emile_image.h</file>
        <file>/usr/lib/libemile.so*</file>
    </necessary>
    <unnecessary>
  </unnecessary>
    <include_path>/usr/include/emile-1</include_path>
    <library_path>/usr/lib</library_path>
</rootstrap>
