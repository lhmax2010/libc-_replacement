<?xml version="1.0"?>
<rootstrap name="libswscale">
  <email>heechul.jeon@samsung.com</email>
  <email>ht1211.kim@samsung.com</email>
  <email>jm80.yang@samsung.com</email>
  <emulator>
    <rpm accept="libswscale" arch="i686"/>
    <rpm accept="libswscale-devel" arch="i686"/>
  </emulator>
  <target>
    <rpm accept="libswscale" arch="armv7l"/>
    <rpm accept="libswscale-devel" arch="armv7l"/>
  </target>
  <pkgconfig>
    <file>libswscale.pc</file>
  </pkgconfig>
  <necessary>
    <file>/usr/include/libswscale/swscale.h</file>
    <file>/usr/include/libswscale/version_major.h</file>
    <file>/usr/include/libswscale/version.h</file>
    <file>/usr/lib/libswscale.so*</file>
  </necessary>
  <include_path>/usr/include/libswscale</include_path>
  <library_path>/usr/lib</library_path>
  <library>libswscale.so</library>
</rootstrap>