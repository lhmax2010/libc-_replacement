<?xml version="1.0"?>
<rootstrap name="screen-connector-remote-surface">
  <email>yjoo93.park@samsung.com</email>
  <email>kyuho.jo@samsung.com</email>
  <emulator>
    <rpm accept="libscreen_connector_remote_surface" arch="i686"/>
    <rpm accept="libscreen_connector_remote_surface-devel" arch="i686"/>
  </emulator>
  <target>
    <rpm accept="libscreen_connector_remote_surface" arch="armv7l"/>
    <rpm accept="libscreen_connector_remote_surface-devel" arch="armv7l"/>
  </target>
  <riscv>
    <rpm accept="libscreen_connector_remote_surface" arch="riscv32"/>
    <rpm accept="libscreen_connector_remote_surface-devel" arch="riscv32"/>
  </riscv>
  <pkgconfig>
    <file>screen_connector_remote_surface.pc</file>
  </pkgconfig>
  <necessary>
    <file>/usr/include/screen_connector_remote_surface/aul_handle_internal.h</file>
    <file>/usr/include/screen_connector_remote_surface/aul_handle_mock_internal.h</file>
    <file>/usr/include/screen_connector_remote_surface/buffer_event_interface.h</file>
    <file>/usr/include/screen_connector_remote_surface/common.h</file>
    <file>/usr/include/screen_connector_remote_surface/ecore_event_handler_internal.h</file>
    <file>/usr/include/screen_connector_remote_surface/handle.h</file>
    <file>/usr/include/screen_connector_remote_surface/remote_surface.h</file>
    <file>/usr/include/screen_connector_remote_surface/remote_surface_manager_internal.h</file>
    <file>/usr/include/screen_connector_remote_surface/trs_interface.h</file>
    <file>/usr/include/screen_connector_remote_surface/trs_internal.h</file>
    <file>/usr/include/screen_connector_remote_surface/trs_mock_internal.h</file>
    <file>/usr/include/screen_connector_remote_surface/window_context.h</file>
    <file>/usr/lib/libscreen_connector_remote_surface.so*</file>
  </necessary>
  <include_path>/usr/include/screen_connector_remote_surface</include_path>
  <library_path>/usr/lib</library_path>
  <library>libscreen_connector_remote_surface.so</library>
</rootstrap>