prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib64

themes=/usr/share/elementary/themes

Name: elementary
Description: efl: elementary
Version: 1.25.1
Requires: eina, eet, evas, ecore, ecore-evas, ecore-file, ecore-input, ecore-imf, ecore-con, edje, eldbus, efreet-mime, ethumb-client, efl, eo, emotion, efreet, efreet-trash, eio
Requires.private: emile, ector, ethumb, ttrace, ecore-wl2, wayland-client, wayland-server, xkbcommon, tizen-policy-ext-client
Libs: -L${libdir} -lelementary
Libs.private: -lm -lpthread -ldl
Cflags: -I${includedir}/elementary-1
