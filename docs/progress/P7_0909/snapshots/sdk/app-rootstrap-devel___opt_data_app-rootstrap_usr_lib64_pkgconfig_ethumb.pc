prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib64

module_arch=v-1.25

Name: ethumb
Description: efl: ethumb
Version: 1.25.1
Requires: eina, eo, efl
Requires.private: eet, emile, evas, ecore, ector, ecore-evas, ecore-file, ecore-imf, ecore-input, edje, ttrace
Libs: -L${libdir} -lethumb
Libs.private: -lm -lpthread -ldl
Cflags: -I${includedir}/ethumb-1
