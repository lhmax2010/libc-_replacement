prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib64

module_arch=v-1.25

Name: ecore-imf
Description: efl: ecore_imf
Version: 1.25.1
Requires: eina, ecore-input
Requires.private: ecore, eo, efl, ttrace
Libs: -L${libdir} -lecore_imf
