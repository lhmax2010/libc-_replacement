<?xml version='1.0' encoding='utf-8'?>
<rootstrap name="eio">
    <emulator>
        <rpm accept="eio" arch="i686" />
        <rpm accept="eio-devel" arch="i686" />
    </emulator>
    <target>
        <rpm accept="eio" arch="armv7l" />
        <rpm accept="eio-devel" arch="armv7l" />
    </target>
    <pkgconfig>
        <file>eio.pc</file>
    </pkgconfig>
    <riscv>
        <rpm accept="eio" arch="riscv32" />
        <rpm accept="eio-devel" arch="riscv32" />
    </riscv>
    <necessary>
        <file>/usr/include/eio-1/Eio.h</file>
        <file>/usr/include/eio-1/Eio_Eo.h</file>
        <file>/usr/include/eio-1/Eio_Legacy.h</file>
        <file>/usr/include/eio-1/efl_io_manager.eo.h</file>
        <file>/usr/include/eio-1/efl_io_model.eo.h</file>
        <file>/usr/include/eio-1/eio_inline_helper.x</file>
        <file>/usr/include/eio-1/eio_sentry.eo.h</file>
            <file>/usr/lib/libeio.so*</file>
        <file>/usr/lib64/libeio.so*</file>
    </necessary>
    <include_path>/usr/include/eio-1</include_path>
    <library_path>/usr/lib</library_path>
    <library>libeio.so</library>
</rootstrap>
