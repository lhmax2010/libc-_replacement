<?xml version="1.0"?>
<rootstrap name="libavcodec">
  <email>heechul.jeon@samsung.com</email>
  <email>ht1211.kim@samsung.com</email>
  <email>jm80.yang@samsung.com</email>
  <emulator>
    <rpm accept="libavcodec" arch="i686"/>
    <rpm accept="libavcodec-devel" arch="i686"/>
  </emulator>
  <target>
    <rpm accept="libavcodec" arch="armv7l"/>
    <rpm accept="libavcodec-devel" arch="armv7l"/>
  </target>
  <pkgconfig>
    <file>libavcodec.pc</file>
  </pkgconfig>
  <necessary>
    <file>/usr/include/libavcodec/avcodec.h</file>
    <file>/usr/include/libavcodec/defs.h</file>
    <file>/usr/include/libavcodec/codec.h</file>
    <file>/usr/include/libavcodec/codec_par.h</file>
    <file>/usr/include/libavcodec/codec_desc.h</file>
    <file>/usr/include/libavcodec/codec_id.h</file>
    <file>/usr/include/libavcodec/version_major.h</file>
    <file>/usr/include/libavcodec/version.h</file>
    <file>/usr/include/libavcodec/packet.h</file>
    <file>/usr/lib/libavcodec.so*</file>
  </necessary>
  <include_path>/usr/include/libavcodec</include_path>
  <library_path>/usr/lib</library_path>
  <library>libavcodec.so</library>
</rootstrap>