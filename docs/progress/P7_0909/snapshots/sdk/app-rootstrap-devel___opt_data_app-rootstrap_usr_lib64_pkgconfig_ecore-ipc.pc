prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib64

module_arch=v-1.25

Name: ecore-ipc
Description: efl: ecore_ipc
Version: 1.25.1
Requires: eina
Requires.private: ecore, eo, efl, ecore-con, ttrace
Libs: -L${libdir} -lecore_ipc
Libs.private: -lpthread -lm -ldl
Cflags: -I${includedir}/ecore-ipc-1
