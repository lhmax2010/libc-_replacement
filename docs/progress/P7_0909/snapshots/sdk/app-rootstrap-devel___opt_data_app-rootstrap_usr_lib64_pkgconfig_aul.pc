# Package Information for pkg-config

prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib64
includedir=/usr/include

Name: libaul
Description: new application utility library
Version: 
Requires: bundle glib-2.0 xdgmime vconf dlog
Libs: -L${libdir} -laul
Cflags: -I${includedir} -I${includedir}/aul -I${includedir}/aul/api
