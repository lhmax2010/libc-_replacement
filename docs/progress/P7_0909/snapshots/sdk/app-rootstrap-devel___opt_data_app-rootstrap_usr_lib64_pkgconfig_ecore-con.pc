prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib64

module_arch=v-1.25

Name: ecore-con
Description: efl: ecore_con
Version: 1.25.1
Requires: eina, eo, efl, ecore
Requires.private: ttrace, eldbus, eet, emile
Libs: -L${libdir} -lecore_con
Libs.private: -lm -lpthread -ldl
Cflags: -I${includedir}/ecore-con-1
