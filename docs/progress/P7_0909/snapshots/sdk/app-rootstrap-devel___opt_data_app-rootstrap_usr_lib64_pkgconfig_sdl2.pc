# sdl pkg-config source file

prefix=/usr
exec_prefix=/usr
libdir=/usr/lib64
includedir=/usr/include

Name: sdl2
Description: Simple DirectMedia Layer is a cross-platform multimedia library designed to provide low level access to audio, keyboard, mouse, joystick, 3D hardware via OpenGL, and 2D video framebuffer.
Version: 2.0.14
Requires:
Conflicts:
Libs: -L${libdir} -Wl,-rpath,${libdir} -Wl,--enable-new-dtags -lSDL2main -lSDL2 
Libs.private:  -Wl,--no-undefined -lm -lwayland-egl -lwayland-egl-tizen -lecore_wl2 -lecore -lefl -lecore_file -lxdg-shell-client -ltext-client -ltizen-extension-client -lwayland-client -lm -lcapi-system-system-settings -lecore_imf -lecore_input -leo -ldrm -laul -lbundle -lglib-2.0 -lxdgmime -lvconf -ldlog -lecore_ipc -leina -lpthread -lm -lrt -ldl -lappcore-ui -lappcore-common -lcapi-appfw-app-control -lcapi-appfw-app-control-uri -lcapi-appfw-app-common -lcapi-base-common -lapp-core-cpp -pie -Wl,-z,relro,--as-needed,-z,now -lpthread -lrt
Cflags: -I${includedir}/SDL2  -Dmain=SDL_main -D_REENTRANT
