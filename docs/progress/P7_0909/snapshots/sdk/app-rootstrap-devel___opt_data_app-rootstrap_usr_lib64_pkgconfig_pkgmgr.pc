prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib64
includedir=${prefix}/include

Name: package manager
Description: SLP Package Manager Package
Version: 0.23.1
Requires: pkgmgr-types pkgmgr-common
Libs: -L${libdir} -L${libdir}/pkgmgr -lpkgmgr-client
Cflags: -I${includedir}
