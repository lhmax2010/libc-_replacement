<?xml version="1.0"?>
<rootstrap name="eolian">
  <email>tmp@samsung.com</email>
  <emulator>
    <rpm accept="eolian" arch="i686"/>
    <rpm accept="eolian-devel" arch="i686"/>
  </emulator>
  <target>
    <rpm accept="eolian" arch="armv7l"/>
    <rpm accept="eolian-devel" arch="armv7l"/>
  </target>
  <riscv>
    <rpm accept="eolian" arch="riscv32"/>
    <rpm accept="eolian-devel" arch="riscv32"/>
  </riscv>
  <necessary>
    <file>/usr/include/eolian-1/Eolian.h</file>
    <file>/usr/include/eolian-1/Eolian_Aux.h</file>
    <file>/usr/lib/libeolian.so*</file>
  </necessary>
  <include_path>/usr/include/eolian-1</include_path>
  <library_path>/usr/lib</library_path>
  <library>libeolian.so</library>
</rootstrap>