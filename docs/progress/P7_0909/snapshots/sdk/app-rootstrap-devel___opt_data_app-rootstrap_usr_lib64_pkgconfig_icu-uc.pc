# CFLAGS contains only anything end users should set
CFLAGS =  -std=c11
# CXXFLAGS contains only anything end users should set
CXXFLAGS =  -std=c++17
# DEFS only contains those UCONFIG_CPPFLAGS which are not auto-set by platform.h
DEFS =  -DU_DISABLE_RENAMING=1 -DUCONFIG_ENABLE_PLUGINS=1
prefix = /usr
exec_prefix = /usr
#bindir = /usr/bin
libdir = /usr/lib64
includedir = /usr/include
baselibs = -lpthread -lm 
#datarootdir = ${prefix}/share
#datadir = /usr/share
#sbindir = /usr/sbin
#mandir = /usr/share/man
#sysconfdir = /etc
UNICODE_VERSION=17.0
ICUPREFIX=icu
ICULIBSUFFIX=
LIBICU=lib${ICUPREFIX}
#SHAREDLIBCFLAGS=-fPIC
pkglibdir=${libdir}/icu${ICULIBSUFFIX}/78.1
#pkgdatadir=${datadir}/icu${ICULIBSUFFIX}/78.1
ICUDATA_NAME = icudt78l
#ICUPKGDATA_DIR=/usr/lib64
#ICUDATA_DIR=${pkgdatadir}
ICUDESC=International Components for Unicode

Version: 78.1
Cflags: -I${includedir}
# end of icu.pc.in
Description: International Components for Unicode: Common and Data libraries
Name: icu-uc
Libs: -L${libdir} -licuuc
Libs.private: -licudata ${baselibs}
