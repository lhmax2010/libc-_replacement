<?xml version="1.0"?>
<rootstrap name="minicontrol">
  <email>yjoo93.park@samsung.com</email>
  <email>kyuho.jo@samsung.com</email>
  <emulator>
    <rpm accept="minicontrol-devel" arch="i686"/>
  </emulator>
  <target>
    <rpm accept="minicontrol-devel" arch="armv7l"/>
  </target>
  <pkgconfig>
    <file>minicotnrol-monitor.pc</file>
    <file>minicotnrol-provider.pc</file>
    <file>minicotnrol-viewer.pc</file>
  </pkgconfig>
  <necessary>
    <file>/usr/include/minicontrol/minicontrol-internal.h</file>
    <file>/usr/include/minicontrol/minicontrol-provider-internal.h</file>
    <file>/usr/include/minicontrol/minicontrol-viewer-internal.h</file>
    <file>/usr/lib/libminicontrol-monitor.so*</file>
    <file>/usr/lib/libminicontrol-provider.so*</file>
    <file>/usr/lib/libminicontrol-viewer.so*</file>
  </necessary>
  <include_path>/usr/include/minicontrol</include_path>
  <library_path>/usr/lib</library_path>
  <library>libminicotnrol-monitor.so</library>
  <library>libminicotnrol-provider.so</library>
  <library>libminicotnrol-viewer.so</library>
</rootstrap>