# Package Information for pkg-config

prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib64
includedir=${prefix}/include

Name: bundle
Description: Simple string key/val dictionary library
Version: 0.18.15
Requires: capi-base-common
Libs: -L${libdir} -lbundle
Cflags: -I${includedir}
cppflags: -I${includedir}
