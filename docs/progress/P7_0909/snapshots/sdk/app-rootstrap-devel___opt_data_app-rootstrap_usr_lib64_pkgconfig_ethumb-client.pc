prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib64

module_arch=v-1.25

Name: ethumb-client
Description: efl: ethumb_client
Version: 1.25.1
Requires: eina, eo, efl, ethumb
Requires.private: eldbus, ecore, ttrace
Libs: -L${libdir} -lethumb_client
Libs.private: -lm -lpthread -ldl
Cflags: -I${includedir}/ethumb-client-1
