prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib64

module_arch=v-1.25

Name: ecore-audio
Description: efl: ecore_audio
Version: 1.25.1
Requires: eina, eo
Requires.private: ecore, efl, ttrace, sndfile
Libs: -L${libdir} -lecore_audio
Libs.private: -lpthread -lm -ldl
Cflags: -I${includedir}/ecore-audio-1
