   683	        if ((actions & _UA_HANDLER_FRAME) && (actions & _UA_FORCE_UNWIND))
   684	        {
   685	            // _UA_HANDLER_FRAME should only be set if phase 1 found a handler.
   686	            // If _UA_FORCE_UNWIND is set, phase 1 shouldn't have happened.
   687	            //    Client error
   688	            results.reason = _URC_FATAL_PHASE2_ERROR;
   689	            return;
