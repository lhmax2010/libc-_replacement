   603	void
   604	set_registers(_Unwind_Exception* unwind_exception, _Unwind_Context* context,
   605	              const scan_results& results)
   606	{
   607	#if defined(__USING_SJLJ_EXCEPTIONS__) || defined(__WASM_EXCEPTIONS__)
   608	#define __builtin_eh_return_data_regno(regno) regno
   609	#elif defined(__ibmxl__)
   610	// IBM xlclang++ compiler does not support __builtin_eh_return_data_regno.
   611	#define __builtin_eh_return_data_regno(regno) regno + 3
   612	#endif
   613	  _Unwind_SetGR(context, __builtin_eh_return_data_regno(0),
   614	                reinterpret_cast<uintptr_t>(unwind_exception));
   615	  _Unwind_SetGR(context, __builtin_eh_return_data_regno(1),
   616	                static_cast<uintptr_t>(results.ttypeIndex));
   617	#if __has_feature(ptrauth_calls)
   618	  auto stackPointer = _Unwind_GetGR(context, UNW_REG_SP);
   619	  // We manually re-sign the IP as the __ptrauth qualifiers cannot
   620	  // express the required relationship with the destination address
   621	  const auto existingDiscriminator =
   622	      ptrauth_blend_discriminator(&results.landingPad,
   623	                                  __ptrauth_scan_results_landingpad_disc);
