   636	/*
   637	    There are 3 types of scans needed:
   638	
   639	    1.  Scan for handler with native or foreign exception.  If handler found,
   640	        save state and return _URC_HANDLER_FOUND, else return _URC_CONTINUE_UNWIND.
   641	        May also report an error on invalid input.
   642	        May terminate for invalid exception table.
   643	        _UA_SEARCH_PHASE
   644	
   645	    2.  Scan for handler with foreign exception.  Must return _URC_HANDLER_FOUND,
   646	        or call terminate.
   647	        _UA_CLEANUP_PHASE && _UA_HANDLER_FRAME && !native_exception
   648	
   649	    3.  Scan for cleanups.  If a handler is found and this isn't forced unwind,
   650	        then terminate, otherwise ignore the handler and keep looking for cleanup.
   651	        If a cleanup is found, return _URC_HANDLER_FOUND, else return _URC_CONTINUE_UNWIND.
   652	        May also report an error on invalid input.
   653	        May terminate for invalid exception table.
   654	        _UA_CLEANUP_PHASE && !_UA_HANDLER_FRAME
   655	*/
   656	
   657	static void scan_eh_tab(scan_results &results, _Unwind_Action actions,
   658	                        bool native_exception,
   659	                        _Unwind_Exception *unwind_exception,
   660	                        _Unwind_Context *context) {
   661	    // Initialize results to found nothing but an error
   662	    results.ttypeIndex = 0;
   663	    results.actionRecord = 0;
   664	    results.languageSpecificData = 0;
   665	    results.landingPad = 0;
   666	    results.adjustedPtr = 0;
   667	    results.isForcedUnwindHandler = false;
   668	    results.reason = _URC_FATAL_PHASE1_ERROR;
   669	    // Check for consistent actions
   670	    if (actions & _UA_SEARCH_PHASE)
   671	    {
   672	        // Do Phase 1
   673	        if (actions & (_UA_CLEANUP_PHASE | _UA_HANDLER_FRAME | _UA_FORCE_UNWIND))
   674	        {
   675	            // None of these flags should be set during Phase 1
   676	            //   Client error
   677	            results.reason = _URC_FATAL_PHASE1_ERROR;
   678	            return;
   679	        }
