   625	      (unw_word_t)ptrauth_auth_and_resign(*(void* const*)&results.landingPad,
   626	                                          __ptrauth_scan_results_landingpad_key,
   627	                                          existingDiscriminator,
   628	                                          ptrauth_key_return_address,
   629	                                          stackPointer);
   630	  _Unwind_SetIP(context, newIP);
   631	#else
   632	  _Unwind_SetIP(context, results.landingPad);
   633	#endif
