  1232	extern "C" _LIBCXXABI_FUNC_VIS _Unwind_Reason_Code
  1233	__gxx_personality_v0(_Unwind_State state,
  1234	                     _Unwind_Exception* unwind_exception,
  1235	                     _Unwind_Context* context)
  1236	{
