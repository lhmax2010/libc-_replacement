  1249	    // _Unwind_GetLanguageSpecificData() and _Unwind_GetRegionStart() can
  1250	    // return correct address.
  1251	    _Unwind_SetGR(context, REG_UCB, reinterpret_cast<uint32_t>(unwind_exception));
