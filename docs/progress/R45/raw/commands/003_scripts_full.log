     1	#!/usr/bin/env bash
     2	set -u
     3	set -o pipefail
     4	
     5	sample_log=${1:?sample log required}
     6	shift
     7	
     8	nice -n 15 ionice -c 3 "$@" &
     9	watched_pid=$!
    10	printf 'watched_pid=%s\n' "$watched_pid" >"$sample_log"
    11	
    12	while kill -0 "$watched_pid" 2>/dev/null; do
    13	  {
    14	    date --iso-8601=seconds
    15	    printf '%s\n' '$ free -h'
    16	    free -h
    17	    printf '[exit_code=%s]\n' "$?"
    18	    printf '%s\n' '$ uptime'
    19	    uptime
    20	    printf '[exit_code=%s]\n' "$?"
    21	  } >>"$sample_log" 2>&1
    22	  mem_available_kib=$(awk '/^MemAvailable:/ {print $2; exit}' /proc/meminfo)
    23	  if (( mem_available_kib < 1048576 )); then
    24	    printf 'RED_STOP_RESOURCE\tmem_available_kib=%s\n' "$mem_available_kib" >>"$sample_log"
    25	    kill -TERM "$watched_pid" 2>/dev/null || true
    26	    wait "$watched_pid" 2>/dev/null || true
    27	    exit 30
    28	  fi
    29	  elapsed=0
    30	  while (( elapsed < 300 )) && kill -0 "$watched_pid" 2>/dev/null; do
    31	    sleep 1
    32	    elapsed=$((elapsed + 1))
    33	  done
    34	done
    35	
    36	wait "$watched_pid"
    37	exit $?
EXIT_CODE=0
