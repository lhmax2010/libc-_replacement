===== progress/R42/tools/run_x86_matrix.sh =====
     1	#!/bin/bash
     2	set -u
     3	workspace=/home/toolchain/development/libc++_replacement
     4	sysroot="$workspace/tmp/GBS-ROOT/R32-candidates-libcxx-x86_64-20260813-02/local/BUILD-ROOTS/scratch.x86_64.0"
     5	loader="$sysroot/lib64/ld-linux-x86-64.so.2"
     6	patched="$workspace/tmp/R42/runtime/patched/x86_64"
     7	probes="$workspace/tmp/R42/probes/x86_64"
     8	
     9	run_cell() {
    10	  suite=$1
    11	  binary=$2
    12	  mode=$3
    13	  library_path=$4
    14	  printf '\nCELL_BEGIN suite=%s mode=%s\n' "$suite" "$mode"
    15	  if [ "$mode" = NO_ARGUMENT ]; then
    16	    cmd=(/usr/bin/timeout --preserve-status 15s "$loader" --library-path "$library_path" "$binary")
    17	  else
    18	    cmd=(/usr/bin/timeout --preserve-status 15s "$loader" --library-path "$library_path" "$binary" "$mode")
    19	  fi
    20	  printf 'EXECUTION_MODE=HOST_NATIVE_X86_64_TARGET_USERSPACE_NO_QEMU\n'
    21	  printf 'RUN_COMMAND='; printf '%q ' "${cmd[@]}"; printf '\n'
    22	  "${cmd[@]}"
    23	  rc=$?
    24	  printf 'CELL_EXIT_CODE=%d\n' "$rc"
    25	  if [ "$rc" -gt 128 ]; then printf 'CELL_SIGNAL=%d\n' "$((rc-128))"; else printf 'CELL_SIGNAL=0\n'; fi
    26	  printf 'CELL_END suite=%s mode=%s\n' "$suite" "$mode"
    27	}
    28	
    29	printf 'RUNTIME_IDENTITY_PATCHED_BEGIN\n'
    30	env LD_LIBRARY_PATH="$patched:$sysroot/usr/lib64:$sysroot/lib64" ldd "$probes/s1_libcxx"
    31	sha256sum "$patched/libc++abi.so.1.0" "$probes/s1_libcxx"
    32	printf 'RUNTIME_IDENTITY_PATCHED_END\n'
    33	
    34	modes=(cancel exit real foreign cancel-no-catch exit-no-catch cancel-nested)
    35	for mode in "${modes[@]}"; do
    36	  run_cell libcxx_patched "$probes/s1_libcxx" "$mode" "$patched:$sysroot/usr/lib64:$sysroot/lib64"
    37	done
    38	for mode in "${modes[@]}"; do
    39	  run_cell libstdcxx_control "$probes/s1_libstdcxx" "$mode" "$sysroot/usr/lib64:$sysroot/lib64"
    40	done
    41	run_cell libcxx_unpatched "$probes/unpatched_libcxx" NO_ARGUMENT "$sysroot/usr/lib64:$sysroot/lib64"
    42	exit 0

===== progress/R42/tools/run_board_matrix.sh =====
     1	#!/bin/bash
     2	set -u
     3	sdb=/home/toolchain/.local/bin/sdb
     4	serial=192.168.108.26:26101
     5	remote=/var/tmp/r42_s1_20260815
     6	
     7	run_cell() {
     8	  suite=$1
     9	  library_dir=$2
    10	  binary=$3
    11	  mode=$4
    12	  printf '\nCELL_BEGIN suite=%s mode=%s\n' "$suite" "$mode"
    13	  if [ "$mode" = NO_ARGUMENT ]; then
    14	    remote_cmd="set +e; LD_LIBRARY_PATH='$library_dir' '$binary'; rc=\$?; printf 'REMOTE_CELL_EXIT_CODE=%d\\n' \"\$rc\"; if test \"\$rc\" -gt 128; then printf 'REMOTE_CELL_SIGNAL=%d\\n' \"\$((rc-128))\"; else printf 'REMOTE_CELL_SIGNAL=0\\n'; fi; exit 0"
    15	  else
    16	    remote_cmd="set +e; LD_LIBRARY_PATH='$library_dir' '$binary' '$mode'; rc=\$?; printf 'REMOTE_CELL_EXIT_CODE=%d\\n' \"\$rc\"; if test \"\$rc\" -gt 128; then printf 'REMOTE_CELL_SIGNAL=%d\\n' \"\$((rc-128))\"; else printf 'REMOTE_CELL_SIGNAL=0\\n'; fi; exit 0"
    17	  fi
    18	  printf 'EXECUTION_MODE=BOARD_NATIVE_ARMV7L_NO_QEMU\n'
    19	  printf 'SDB_COMMAND='; printf '%q ' "$sdb" -s "$serial" shell "$remote_cmd"; printf '\n'
    20	  /usr/bin/timeout --preserve-status 20s "$sdb" -s "$serial" shell "$remote_cmd"
    21	  carrier_rc=$?
    22	  printf 'SDB_CARRIER_EXIT_CODE=%d\nCELL_END suite=%s mode=%s\n' "$carrier_rc" "$suite" "$mode"
    23	}
    24	
    25	printf 'RUNTIME_IDENTITY_PATCHED_BEGIN\n'
    26	identity="set +e; LD_LIBRARY_PATH='$remote/patched' ldd '$remote/s1_libcxx'; ldd_rc=\$?; sha256sum '$remote/s1_libcxx' '$remote/patched/libc++abi.so.1'; printf 'LDD_EXIT_CODE=%d\\n' \"\$ldd_rc\"; exit 0"
    27	printf 'SDB_COMMAND='; printf '%q ' "$sdb" -s "$serial" shell "$identity"; printf '\n'
    28	"$sdb" -s "$serial" shell "$identity"
    29	printf 'RUNTIME_IDENTITY_PATCHED_END\n'
    30	
    31	modes=(cancel exit real foreign cancel-no-catch exit-no-catch cancel-nested)
    32	for mode in "${modes[@]}"; do
    33	  run_cell libcxx_patched "$remote/patched" "$remote/s1_libcxx" "$mode"
    34	done
    35	for mode in "${modes[@]}"; do
    36	  run_cell libstdcxx_control /lib "$remote/s1_libstdcxx" "$mode"
    37	done
    38	run_cell libcxx_unpatched "$remote/unpatched" "$remote/unpatched_libcxx" NO_ARGUMENT
    39	exit 0

