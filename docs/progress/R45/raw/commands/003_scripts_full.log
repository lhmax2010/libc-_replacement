    37	    -Wl,-z,now -lc++abi -lpthread -ldl -lm -latomic -lc -lgcc_s -lgcc -o "$out/s1_libcxx"
    38	  run "$cxx" "${common[@]}" -Dprivate_1=unwinder_cache.reserved1 \
    39	    -c "$src" -o "$out/s1_libstdcxx.o"
    40	  run "$cxx" "$out/s1_libstdcxx.o" -pthread -Wl,-z,now -o "$out/s1_libstdcxx"
    41	  run "$cxx" "${common[@]}" -stdlib=libc++ -nostdinc++ -I"$build/include/c++/v1" \
    42	    -c "$control_src" -o "$out/unpatched_libcxx.o"
    43	  run "$cxx" "$out/unpatched_libcxx.o" -nostdlib++ "$static_libcxx" \
    44	    -L"$workspace/tmp/R38/build-unpatched-armv7l/lib" -Wl,-z,now \
    45	    -lc++abi -lpthread -ldl -lm -latomic -lc -lgcc_s -lgcc -o "$out/unpatched_libcxx"
    46	else
