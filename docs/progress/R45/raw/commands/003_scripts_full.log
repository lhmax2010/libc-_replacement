===== progress/R42/tools/build_with_monitor.sh =====
     1	#!/bin/bash
     2	set -u
     3	
     4	label=$1
     5	shift
     6	sample_log=/home/toolchain/development/libc++_replacement/progress/R42/resources/${label}_samples.log
     7	printf 'BUILD_COMMAND='
     8	printf '%q ' "$@"
     9	printf '\n'
    10	env CMAKE_BUILD_PARALLEL_LEVEL=2 LLVM_PARALLEL_LINK_JOBS=1 \
    11	  nice -n 15 ionice -c 3 "$@" -j2 &
    12	build_pid=$!
    13	printf 'BUILD_PID=%d\n' "$build_pid"
    14	while kill -0 "$build_pid" 2>/dev/null; do
    15	  {
    16	    date --iso-8601=seconds
    17	    free -h
    18	    uptime
    19	  } >>"$sample_log"
    20	  available_kib=$(awk '/MemAvailable:/ {print $2}' /proc/meminfo)
    21	  if [ "$available_kib" -lt $((2 * 1024 * 1024)) ]; then
    22	    printf 'RED_STOP_RESOURCE MEM_AVAILABLE_KIB=%s\n' "$available_kib" | tee -a "$sample_log"
    23	    kill -TERM "$build_pid"
    24	    wait "$build_pid"
    25	    printf 'BUILD_EXIT_CODE=%d\n' "$?"
    26	    exit 22
    27	  fi
    28	  for _ in $(seq 1 300); do
    29	    kill -0 "$build_pid" 2>/dev/null || break
    30	    sleep 1
    31	  done
    32	done
    33	wait "$build_pid"
    34	rc=$?
    35	printf 'BUILD_EXIT_CODE=%d\n' "$rc"
    36	exit "$rc"

