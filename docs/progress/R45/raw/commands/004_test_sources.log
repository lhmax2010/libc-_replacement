    94	    return 22;
    95	  std::fprintf(stderr, "%s:join=%s\n", label,
    96	               result == PTHREAD_CANCELED ? "PTHREAD_CANCELED" : "OTHER");
    97	  return result == PTHREAD_CANCELED ? 0 : 23;
    98	}
