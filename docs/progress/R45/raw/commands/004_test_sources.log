   135	void foreign_cleanup(_Unwind_Reason_Code reason, _Unwind_Exception* exception) {
   136	  ++foreign_cleanup_count;
   137	  std::fprintf(stderr, "foreign:cleanup:reason=%d:count=%d\n",
   138	               static_cast<int>(reason), foreign_cleanup_count);
   139	  std::free(reinterpret_cast<ForeignException*>(exception));
   140	  active_foreign = nullptr;
