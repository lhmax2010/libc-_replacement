   143	int run_foreign() {
   144	  active_foreign = static_cast<ForeignException*>(
   145	      std::calloc(1, sizeof(ForeignException)));
   146	  if (active_foreign == nullptr)
   147	    return 50;
   148	  active_foreign->unwind.exception_class =
   149	      static_cast<_Unwind_Exception_Class>(0x52333442464f5245ULL); // R34BFORE
   150	  active_foreign->unwind.exception_cleanup = foreign_cleanup;
   151	
   152	  try {
   153	    try {
   154	      Cleanup cleanup{"foreign-inner"};
   155	      std::fprintf(stderr, "foreign:raise\n");
   156	      const _Unwind_Reason_Code reason =
   157	          _Unwind_RaiseException(&active_foreign->unwind);
   158	      std::fprintf(stderr, "foreign:raise-returned:%d\n",
   159	                   static_cast<int>(reason));
   160	      _Unwind_DeleteException(&active_foreign->unwind);
   161	      return 51;
   162	    } catch (...) {
   163	      std::fprintf(stderr, "foreign:inner-catch:private_1=%llu:rethrow\n",
   164	                   static_cast<unsigned long long>(
