COMMAND=bash -lc $'\nset -u\nfail=0\nfor mode in default libcxx; do\n  d="tmp/R29/consumer-elf-$mode"\n  mkdir -p "$d"\n  rpmf=$(find "artifacts/R29/consumer/$mode/x86_64/RPMS" -maxdepth 1 -type f -name "r29-consumer-1-1.x86_64.rpm" -print -quit)\n  (cd "$d" && rpm2cpio "$OLDPWD/$rpmf" | cpio -idm --quiet)\n  if [ "$mode" = default ]; then root="$PWD/tmp/GBS-ROOT/R29-consumer-default-x86_64-20260812-06/local/BUILD-ROOTS/scratch.x86_64.0"; else root="$PWD/tmp/GBS-ROOT/R29-consumer-libcxx-x86_64-20260812-03/local/BUILD-ROOTS/scratch.x86_64.0"; fi\n  echo MODE=$mode RPM=$rpmf BUILDROOT=$root\n  for elf in "$d"/usr/bin/r29-*; do\n    echo ELF=$elf\n    readelf -d "$elf" | grep -E "SONAME|NEEDED" || true\n    echo LDD_R_BEGIN\n    LD_LIBRARY_PATH="$root/usr/lib64:$root/lib64:$root/usr/lib" ldd -r "$elf"\n    rc=$?\n    echo LDD_R_EXIT_CODE=$rc\n    [ $rc -eq 0 ] || fail=1\n    echo LDD_R_END\n  done\ndone\nexit $fail\n' 
