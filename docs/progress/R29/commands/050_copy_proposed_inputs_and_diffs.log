 %files
 %defattr(-,root,root,-)
 %{_libdir}/librlottie.so.*
 %{_libdir}/librlottie-image-loader.so*
 %manifest packaging/rlottie.manifest
 %license COPYING licenses/COPYING*
 
 %files devel
 %defattr(-,root,root,-)
 %{_includedir}/*.h
 %{_libdir}/librlottie.so
 %{_libdir}/librlottie-image-loader.so
 
 %{_libdir}/pkgconfig/rlottie.pc
