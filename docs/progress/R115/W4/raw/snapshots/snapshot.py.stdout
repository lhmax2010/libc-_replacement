--- /dev/null	2026-09-07 09:29:10.192384252 +0800
+++ /home/toolchain/development/libcxx_runtime_validation/tmp/R115-W4/snapshot.py	2026-09-07 21:42:47.629746364 +0800
@@ -0,0 +1,20 @@
+#!/usr/bin/env python3
+"""只生成审阅用 diff 与摘要；不把实验源码/二进制加入 git。"""
+import pathlib, subprocess, sys, shutil
+root=pathlib.Path.cwd(); task=root/'tmp/R115-W4'; dest=root/'docs/progress/R115/W4/diffs'
+dest.mkdir(exist_ok=True)
+pairs=[('rollback_library',task/'control/shared_mutex.cpp',task/'rollback/shared_mutex.cpp'),
+       ('rollback_header',task/'control/include/shared_mutex',task/'rollback/include/shared_mutex'),
+       ('removed_library',root/'codes/llvm/libcxx/src/condition_variable.cpp',task/'condition_variable_removed.cpp'),
+       ('removed_header',root/'codes/llvm/libcxx/include/__condition_variable/condition_variable.h',task/'control/include/__condition_variable/condition_variable.h')]
+for name in ['probe.cpp','trace.h','build.py','run.py','snapshot.py','verify.py']:
+ pairs.append((name,pathlib.Path('/dev/null'),task/name))
+pairs.append(('record.py',pathlib.Path('/dev/null'),root/'docs/progress/R114/code/record.py'))
+for name,before,after in pairs:
+ stem=root/f'docs/progress/R115/W4/raw/snapshots/{name}'
+ rc=subprocess.run([sys.executable,'docs/progress/R114/code/record.py',str(stem),'diff','-u',str(before),str(after)]).returncode
+ if rc not in (0,1):raise SystemExit(rc)
+ shutil.copyfile(str(stem)+'.stdout',dest/(name+'.diff'))
+subprocess.run([sys.executable,'docs/progress/R114/code/record.py','docs/progress/R115/W4/raw/030_script_and_diff_sha',
+               'sha256sum',*map(str,sorted(task.glob('*.py'))),str(task/'probe.cpp'),str(task/'trace.h'),
+               'docs/progress/R114/code/record.py',*map(str,sorted(dest.glob('*.diff')))],check=True)
