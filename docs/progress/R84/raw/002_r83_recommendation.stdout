28433fe5f44b5c966596ef0fbf7d8bbd012a4d8dddaf92e666f4e94b6aafadec  docs/progress/R83/artifacts/PROJECT_CONFIG_CHANGES.diff
--- Base.project_config.orig
+++ Base.project_config
@@ -288,6 +288,7 @@
 Support: which  elfutils
 Support: update-alternatives
 Support: libstdc++-devel
+Support: libc++-devel libc++abi-devel
 Support: cpp
 Support: libatomic
 Support: libgomp
@@ -298,3 +299,5 @@
 Keep: libstdc++-devel
+Keep: libc++-devel libc++abi-devel
 Keep: cpp gcc libstdc++
+Keep: libc++ libc++abi
 Keep: pam
--- Unified.project_config.orig
+++ Unified.project_config
@@ -153,6 +153,8 @@
 export AR=%{__ar} RANLIB=%{__ranlib};\
 export CC=%{__cc} CXX=%{__cxx};\
 export MAKEFLAGS+=" -k";\
+export CXXFLAGS="${CXXFLAGS} -stdlib=libc++";\
+export LDFLAGS="${LDFLAGS} -stdlib=libc++ -Wl,--no-as-needed -lc++abi -Wl,--as-needed";\
 %{nil}
 :Macros
