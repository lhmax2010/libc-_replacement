60bcc705f5fede943b9eea3f9c823cb3c1bcc9c54292ac6ecf2fb2b2044153cf  docs/progress/R84/base_project_config.patch
22ed0a3f6b75bff9b9bd3924e81c8eecc0434c4ff2e3495c3e632484de374547  docs/progress/R84/unified_project_config.patch
--- codes/qb/TIZEN/Tizen/Tizen-Base-Toolchain/project_config
+++ codes/qb/TIZEN/Tizen/Tizen-Base-Toolchain/project_config
@@ -288,6 +288,7 @@
 Support: which  elfutils
 Support: update-alternatives
 Support: libstdc++-devel
+Support: libc++-devel libc++abi-devel
 Support: cpp
 Support: libatomic
 Support: libgomp
@@ -298,6 +299,8 @@
 Keep: libstdc++-devel
+Keep: libc++-devel libc++abi-devel
 Keep: cpp gcc libstdc++
+Keep: libc++ libc++abi
 Keep: pam
 Keep: binutils cpp  libmagic-data file findutils gawk gcc  gcc-c++
 Keep: gdbm gzip libada libunwind  glibc-devel libpcre xz-lzma-compat
--- codes/qb/TIZEN/Tizen/Tizen-Unified-Toolchain/project_config
+++ codes/qb/TIZEN/Tizen/Tizen-Unified-Toolchain/project_config
@@ -153,6 +153,8 @@
 export AR=%{__ar} RANLIB=%{__ranlib};\
 export CC=%{__cc} CXX=%{__cxx};\
 export MAKEFLAGS+=" -k";\
+export CXXFLAGS="${CXXFLAGS} -stdlib=libc++";\
+export LDFLAGS="${LDFLAGS} -stdlib=libc++ -Wl,--no-as-needed -lc++abi -Wl,--as-needed";\
 %{nil}
 :Macros
 
