docs/progress/R83/raw/035_strict_config_diff_validation.command.txt:1:bash -lc $'\nset -u\ncheckdir=tmp/R83/config-patch-check-v3\nif test -e "$checkdir"; then echo "REFUSE_EXISTING=$checkdir" >&2; exit 90; fi\nmkdir -p "$checkdir"\ncp codes/qb/TIZEN/Tizen/Tizen-Base-Toolchain/project_config "$checkdir/Base.project_config.orig"\ncp codes/qb/TIZEN/Tizen/Tizen-Unified-Toolchain/project_config "$checkdir/Unified.project_config.orig"\ncp "$checkdir/Base.project_config.orig" "$checkdir/Base.project_config"\ncp "$checkdir/Unified.project_config.orig" "$checkdir/Unified.project_config"\npatch --fuzz=0 --dry-run -d "$checkdir" -p0 < progress/R83/artifacts/PROJECT_CONFIG_CHANGES.diff\npatch --fuzz=0 -d "$checkdir" -p0 < progress/R83/artifacts/PROJECT_CONFIG_CHANGES.diff\nrg -n -F -e "Support: libc++-devel libc++abi-devel" -e "Keep: libc++-devel libc++abi-devel" -e "Keep: libc++ libc++abi" -e "-stdlib=libc++" "$checkdir/Base.project_config" "$checkdir/Unified.project_config"\n' 
docs/progress/R83/raw/027_llvm_spec_and_packaging_commit.command.txt:1:bash -lc $'\nset -u\nrepo=tmp/R83/sandbox\nprintf "%s\\n" "== packaging commit exact change =="\ngit -C "$repo" show --format=fuller --stat --summary 5ed6c772\ngit -C "$repo" diff-tree --no-commit-id --name-status -r 5ed6c772\nprintf "%s\\n" "== all packaging files at sandbox HEAD =="\nfind "$repo/packaging" -maxdepth 1 -type f -printf "%f\\t%s\\n" | LC_ALL=C sort\nprintf "%s\\n" "== llvm.spec identity and runtime relevance =="\nrg -n "^(Name|Version|Release|ExclusiveArch|BuildRequires|%package|%files)|LLVM_ENABLE_RUNTIMES|libc\\\\+\\\\+|libcxx" "$repo/packaging/llvm.spec" | head -400\nprintf "%s\\n" "== patch directives in checked-in specs =="\nfor s in "$repo"/packaging/*.spec; do echo "### $(basename "$s")"; rg -n "^Patch[0-9]+:|^%patch[0-9]+ " "$s" || true; done\n' 
