COMMAND_BEGIN
set -u; for item in base_binary:tmp/corpus/repodata/base-standard.primary.xml.gz unified_binary:tmp/corpus/repodata/unified-standard.primary.xml.gz base_source:tmp/corpus/repodata/base-standard.source.primary.xml.gz unified_source:tmp/corpus/repodata/unified-standard.source.primary.xml.gz; do label=${item%%:*}; file=${item#*:}; printf "DATASET=%s\nPATH=%s\n" "$label" "$file"; gzip -dc "$file" | rg -i -n "<name>(libc\\+\\+abi|libc\\+\\+|libcxxabi|libcxx|llvm-libc\\+\\+)[^<]*</name>|<rpm:entry name=\\\"(libc\\+\\+abi|libc\\+\\+|libcxxabi|libcxx|llvm-libc\\+\\+)"; search_exit=${PIPESTATUS[1]}; printf "EXACT_NAME_OR_PROVIDE_SEARCH_EXIT=%s\n" "$search_exit"; if test "$search_exit" -eq 1; then printf "NOT_FOUND\n"; elif test "$search_exit" -ne 0; then exit "$search_exit"; fi; done
COMMAND_END
OUTPUT_BEGIN
DATASET=base_binary
PATH=tmp/corpus/repodata/base-standard.primary.xml.gz
EXACT_NAME_OR_PROVIDE_SEARCH_EXIT=1
NOT_FOUND
DATASET=unified_binary
PATH=tmp/corpus/repodata/unified-standard.primary.xml.gz
EXACT_NAME_OR_PROVIDE_SEARCH_EXIT=1
NOT_FOUND
DATASET=base_source
PATH=tmp/corpus/repodata/base-standard.source.primary.xml.gz
EXACT_NAME_OR_PROVIDE_SEARCH_EXIT=1
NOT_FOUND
DATASET=unified_source
PATH=tmp/corpus/repodata/unified-standard.source.primary.xml.gz
EXACT_NAME_OR_PROVIDE_SEARCH_EXIT=1
NOT_FOUND
OUTPUT_END
EXIT_CODE=0
