    "//net/dns:dns_client",
    "//net/dns:host_resolver",
    "//net/dns:host_resolver_manager",
    "//net/dns:mdns_client",
    "//net/dns/public",
    "//net/third_party/quiche",
  ]

  allow_circular_includes_from = [
    "//net/dns",
    "//net/dns:dns_client",
    "//net/dns:host_resolver",
    "//net/dns:host_resolver_manager",
    "//net/dns:mdns_client",
    "//net/dns/public",
    "//net/http:transport_security_state_generated_files",
  ]

