   594	        # When clang is used, some target may use clang module. This dependency
   595	        # is required for things to work, regardless of whether the libc++
   596	        # module is used in this target or not.
   597	        public_deps += [
   598	          "//buildtools/third_party/libc++:custom_headers",
   599	          "//buildtools/third_party/libc++:libcxx_headers",
   600	        ]
   601	      }
   602	
   603	      if (!defined(use_libcxx_modules)) {
   604	        use_libcxx_modules = is_clang
   605	      }
   606	
   607	      if (filter_include(
   608	              configs,
   609	              [
   610	                # TODO(https://github.com/llvm/llvm-project/pull/145654):
   611	                # Remove mac_no_default_new_delete_symbols after clang roll.
   612	                ":mac_no_default_new_delete_symbols",
   613	                "//build/config/compiler:exceptions",
   614	                "//build/config/compiler:rtti",
   615	              ]) != [] ||
   616	          filter_include(configs,
   617	                         [ "//build/config/compiler:no_exceptions" ]) == []) {
   618	        # Exceptions (i.e. if the 'no_exceptions' config is not used) and RTTI
   619	        # flags are incompatible with libc++ modules build. So disable modules
   620	        # build for such targets.
   621	        use_libcxx_modules = false
   622	      }
   623	
   624	      if (use_libcxx_modules) {
   625	        # Add a dependency needed for Clang modules builds.
   626	        deps += [ "//buildtools/third_party/libc++:all_modules" ]
   627	      }
   628	
   629	      # Consumed by the unsafe-buffers plugin during compile.
   630	      #
   631	      # TODO(crbug.com/326584510): Reclient doesn't respect this variable, see
   632	      # rbe_bug_326584510_missing_inputs in //build/config/clang/clang.gni
   633	      _uses_cflags = false
   634	      if (defined(sources)) {
   635	        foreach(f, sources) {
   636	          if (string_replace(f + ".END", ".cc.END", "") != f + ".END" ||
   637	              string_replace(f + ".END", ".c.END", "") != f + ".END" ||
   638	              string_replace(f + ".END", ".mm.END", "") != f + ".END" ||
   720	          "//buildtools/third_party/libc++:libcxx_headers",
   721	        ]
   722	      }
   723	
   724	      if (!defined(use_libcxx_modules)) {
   725	        use_libcxx_modules = is_clang
   726	      }
   727	
   728	      if (filter_include(
   729	              configs,
   730	              [
   731	                # TODO(https://github.com/llvm/llvm-project/pull/145654):
   732	                # Remove mac_no_default_new_delete_symbols after clang roll.
   733	                ":mac_no_default_new_delete_symbols",
   734	                "//build/config/compiler:exceptions",
   735	                "//build/config/compiler:rtti",
   736	              ]) != [] ||
   737	          filter_include(configs,
   738	                         [ "//build/config/compiler:no_exceptions" ]) == []) {
   739	        # Exceptions (i.e. if the 'no_exceptions' config is not used) and RTTI
   740	        # flags are incompatible with libc++ modules build. So disable modules
   741	        # build for such targets.
   742	        use_libcxx_modules = false
   743	      }
   744	
   745	      if (use_libcxx_modules) {
   746	        # Add a dependency needed for Clang modules builds.
   747	        deps += [ "//buildtools/third_party/libc++:all_modules" ]
   748	      }
   749	
   750	      # On Android, write shared library output file to metadata. We will use
   751	      # this information to, for instance, collect all shared libraries that
   752	      # should be packaged into an APK.
   753	      if (!defined(invoker.metadata) && (is_android || is_robolectric) &&
   754	          (_target_type == "shared_library" ||
   755	           _target_type == "loadable_module")) {
   756	        _output_name = _target_name
   757	        if (defined(invoker.output_name)) {
   758	          _output_name = invoker.output_name
   759	        }
