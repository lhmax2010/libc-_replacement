diff --git home/toolchain/development/libcxx_runtime_validation/tmp/P14/baseline/net/BUILD.gn home/toolchain/development/libcxx_runtime_validation/tmp/P14/chromium-efl/net/BUILD.gn
index 969ed46e..bea26ba8 100644
--- home/toolchain/development/libcxx_runtime_validation/tmp/P14/baseline/net/BUILD.gn
+++ home/toolchain/development/libcxx_runtime_validation/tmp/P14/chromium-efl/net/BUILD.gn
@@ -1865,6 +1865,24 @@ component("net") {
       "//sql",
     ]
   }
+  if (is_tizen) {
+    sources -= [ "cookies/parsed_cookie.cc" ]
+    deps += [ ":cookie_parser_exception_cleanup" ]
+    allow_circular_includes_from += [ ":cookie_parser_exception_cleanup" ]
+  }
+}
+
+# Candidate: keep exception cleanup local to the cookie parser TU on Tizen.
+# ParsedCookie already owns pairs_ with RAII; a throwing GNU allocator must
+# not bypass member and local string cleanup during construction.
+if (is_tizen) {
+  source_set("cookie_parser_exception_cleanup") {
+    visibility = [ ":net" ]
+    sources = [ "cookies/parsed_cookie.cc" ]
+    deps = [ ":net_deps" ]
+    configs -= [ "//build/config/compiler:no_exceptions" ]
+    configs += [ "//build/config/compiler:exceptions" ]
+  }
 }
 
 # net_export.h has its own build target so that code (eg
@@ -1879,6 +1897,7 @@ source_set("net_export_header") {
 source_set("net_deps") {
   visibility = [
     ":net",
+    ":cookie_parser_exception_cleanup",
     "//crypto",
     "//net/dns",
     "//net/dns:dns_client",
