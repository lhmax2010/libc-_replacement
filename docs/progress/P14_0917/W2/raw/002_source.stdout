    77	
    78	// Returns true if |c| occurs in |chars|
    79	// TODO(erikwright): maybe make this take an iterator, could check for end also?
    80	inline bool CharIsA(const char c, std::string_view chars) {
    81	  return chars.find(c) != std::string_view::npos;
    82	}
    83	
    84	// Seek the iterator to the first occurrence of |character|.
    85	// Returns true if it hits the end, false otherwise.
    86	inline bool SeekToCharacter(std::string_view::iterator* it,
    87	                            const std::string_view::iterator& end,
    88	                            const char character) {
    89	  for (; *it != end && **it != character; ++(*it)) {
    90	  }
    91	  return *it == end;
    92	}
    93	
    94	// Seek the iterator to the first occurrence of a character in |chars|.
    95	// Returns true if it hit the end, false otherwise.
    96	inline bool SeekTo(std::string_view::iterator* it,
    97	                   const std::string_view::iterator& end,
    98	                   std::string_view chars) {
    99	  for (; *it != end && !CharIsA(**it, chars); ++(*it)) {
   100	  }
   101	  return *it == end;
   102	}
   103	// Seek the iterator to the first occurrence of a character not in |chars|.
   104	// Returns true if it hit the end, false otherwise.
   105	inline bool SeekPast(std::string_view::iterator* it,
   106	                     const std::string_view::iterator& end,
   107	                     std::string_view chars) {
   108	  for (; *it != end && CharIsA(**it, chars); ++(*it)) {
   109	  }
   110	  return *it == end;
   111	}
   112	inline bool SeekBackPast(std::string_view::iterator* it,
   113	                         const std::string_view::iterator& end,
   114	                         std::string_view chars) {
   115	  for (; *it != end && CharIsA(**it, chars); --(*it)) {
   116	  }
   117	  return *it == end;
   118	}
   119	
   120	// Returns the string piece within `value` that is a valid cookie value.
   121	std::string_view ValidStringPieceForValue(std::string_view value) {
   122	  std::string_view::iterator it = value.begin();
   123	  std::string_view::iterator end =
   124	      net::ParsedCookie::FindFirstTerminator(value);
   125	  std::string_view::iterator value_start;
   126	  std::string_view::iterator value_end;
   127	
   128	  net::ParsedCookie::ParseValue(&it, end, &value_start, &value_end);
   129	
   130	  return std::string_view(value_start, value_end);
   131	}
