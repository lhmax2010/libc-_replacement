   185	  // Sets a key/value pair for a cookie. |index| has to point to one of the
   186	  // |*_index_| fields in ParsedCookie and is updated to the position where
   187	  // the key/value pair is set in |pairs_|. Accordingly, |key| has to correspond
   188	  // to the token matching |index|. If |value| contains invalid characters, the
   189	  // cookie parameter is not changed and the function returns false.
   190	  // If |value| is empty/false the key/value pair is removed.
   191	  bool SetString(size_t* index, std::string_view key, std::string_view value);
   192	  bool SetBool(size_t* index, std::string_view key, bool value);
   193	
   194	  // Helper function for SetString and SetBool handling the case that the
   195	  // key/value pair shall not be removed.
   196	  bool SetAttributePair(size_t* index,
   197	                        std::string_view key,
   198	                        std::string_view value);
   199	
   200	  // Removes the key/value pair from a cookie that is identified by |index|.
   201	  // |index| refers to a position in |pairs_|.
   202	  void ClearAttributePair(size_t index);
   203	
   204	  std::vector<std::pair<std::string, std::string>> pairs_;
   205	  // These will default to 0, but that should never be valid since the
   206	  // 0th index is the user supplied cookie name/value, not an attribute.
   207	  size_t path_index_ = 0;
   208	  size_t domain_index_ = 0;
   209	  size_t expires_index_ = 0;
   210	  size_t maxage_index_ = 0;
   211	  size_t secure_index_ = 0;
   212	  size_t httponly_index_ = 0;
   213	  size_t same_site_index_ = 0;
   214	  size_t priority_index_ = 0;
   215	  size_t partitioned_index_ = 0;
   216	  // For metrics on cookie name/value internal HTABS
   217	  bool internal_htab_ = false;
   218	};
