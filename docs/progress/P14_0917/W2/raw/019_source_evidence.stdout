  2566	# exceptions -------------------------------------------------------------------
  2567	#
  2568	# Allows turning Exceptions on or off.
  2569	# Note: exceptions are disallowed in Google code.
  2570	
  2571	config("exceptions") {
  2572	  if (is_win) {
  2573	    # Enables exceptions in the STL.
  2574	    if (!use_custom_libcxx) {
  2575	      defines = [ "_HAS_EXCEPTIONS=1" ]
  2576	    }
  2577	    cflags_cc = [ "/EHsc" ]
  2578	  } else {
  2579	    cflags_cc = [ "-fexceptions" ]
  2580	    cflags_objcc = cflags_cc
  2581	  }
  2582	}
  2583	
  2584	config("no_exceptions") {
  2585	  if (is_win) {
  2586	    # Disables exceptions in the STL.
  2587	    # libc++ uses the __has_feature macro to control whether to use exceptions,
  2588	    # so defining this macro is unnecessary. Defining _HAS_EXCEPTIONS to 0 also
  2589	    # breaks libc++ because it depends on MSVC headers that only provide certain
  2590	    # declarations if _HAS_EXCEPTIONS is 1. Those MSVC headers do not use
  2591	    # exceptions, despite being conditional on _HAS_EXCEPTIONS.
  2592	    if (!use_custom_libcxx) {
  2593	      defines = [ "_HAS_EXCEPTIONS=0" ]
  2594	    }
  2595	  } else {
  2596	    cflags_cc = [ "-fno-exceptions" ]
  2597	    cflags_objcc = cflags_cc
  2598	  }
  2599	}
