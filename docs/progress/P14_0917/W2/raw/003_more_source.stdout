   470	      status_out->AddExclusionReason(
   471	          CookieInclusionStatus::ExclusionReason::EXCLUDE_NO_COOKIE_CONTENT);
   472	    }
   473	    // TODO(crbug.com/40189703) Note - if the exclusion reasons change to no
   474	    // longer be the same, we'll need to not return right away and evaluate all
   475	    // of the checks.
   476	    return false;
   477	  }
   478	
   479	  // Enforce a length limit for name + value per RFC6265bis.
   480	  base::CheckedNumeric<size_t> name_value_pair_size = name.size();
   481	  name_value_pair_size += value.size();
   482	  if (!name_value_pair_size.IsValid() ||
   483	      (name_value_pair_size.ValueOrDie() > kMaxCookieNamePlusValueSize)) {
   484	    if (status_out != nullptr) {
   485	      status_out->AddExclusionReason(
   486	          CookieInclusionStatus::ExclusionReason::
   487	              EXCLUDE_NAME_VALUE_PAIR_EXCEEDS_MAX_SIZE);
   488	    }
   489	    return false;
   490	  }
   491	
   492	  // Ignore Set-Cookie directives containing control characters. See
   493	  // http://crbug.com/238041.
   494	  if (!IsValidCookieName(name) || !IsValidCookieValue(value)) {
   495	    if (status_out != nullptr) {
   496	      status_out->AddExclusionReason(
   497	          CookieInclusionStatus::ExclusionReason::EXCLUDE_DISALLOWED_CHARACTER);
   498	    }
   499	    return false;
   500	  }
   501	  return true;
   502	}
   503	
   504	bool ParsedCookie::ForEachAttribute(
   505	    base::FunctionRef<bool(std::string_view, std::string_view)> functor) const {
   506	  // The first element in `pairs_` is the name and value, so skip that one.
   507	  for (const auto& [attribute, value] : base::span(pairs_).subspan(1u)) {
   508	    if (!functor(attribute, value)) {
   509	      return false;
   510	    }
   511	  }
   512	
   513	  return true;
   514	}
   515	
   516	// Parse all token/value pairs and populate pairs_.
   517	void ParsedCookie::ParseTokenValuePairs(std::string_view cookie_line,
   518	                                        CookieInclusionStatus& status_out) {
   519	  pairs_.clear();
   520	
   521	  // Ok, here we go.  We should be expecting to be starting somewhere
   522	  // before the cookie line, not including any header name...
   523	  std::string_view::iterator start = cookie_line.begin();
   524	  std::string_view::iterator it = start;
   525	
   526	  // TODO(erikwright): Make sure we're stripping \r\n in the network code.
   527	  // Then we can log any unexpected terminators.
   528	  std::string_view::iterator end = FindFirstTerminator(cookie_line);
   529	
   530	  // Block cookies that were truncated by control characters.
   531	  if (end < cookie_line.end()) {
   532	    status_out.AddExclusionReason(
   533	        CookieInclusionStatus::ExclusionReason::EXCLUDE_DISALLOWED_CHARACTER);
   534	    return;
   535	  }
   536	
   537	  // Exit early for an empty cookie string.
   538	  if (it == end) {
   539	    status_out.AddExclusionReason(
   540	        CookieInclusionStatus::ExclusionReason::EXCLUDE_NO_COOKIE_CONTENT);
   541	    return;
   542	  }
   543	
   544	  for (int pair_num = 0; it != end; ++pair_num) {
   545	    std::pair<std::string, std::string> pair;
   546	
   547	    std::string_view::iterator token_start, token_end;
   548	    if (!ParseToken(&it, end, &token_start, &token_end)) {
   549	      // Allow first token to be treated as empty-key if unparsable
   550	      if (pair_num != 0)
   551	        break;
   552	
   553	      // If parsing failed, start the value parsing at the very beginning.
   554	      token_start = start;
   555	    }
   556	
   557	    if (it == end || *it != '=') {
   558	      // We have a token-value, we didn't have any token name.
   559	      if (pair_num == 0) {
   560	        // For the first time around, we want to treat single values
   561	        // as a value with an empty name. (Mozilla bug 169091).
   562	        // IE seems to also have this behavior, ex "AAA", and "AAA=10" will
   563	        // set 2 different cookies, and setting "BBB" will then replace "AAA".
   564	        pair.first = "";
   565	        // Rewind to the beginning of what we thought was the token name,
   566	        // and let it get parsed as a value.
   567	        it = token_start;
   568	      } else {
   569	        // Any not-first attribute we want to treat a value as a
   570	        // name with an empty value...  This is so something like
   571	        // "secure;" will get parsed as a Token name, and not a value.
   572	        pair.first = std::string(token_start, token_end);
   573	      }
   574	    } else {
   575	      // We have a TOKEN=VALUE.
   576	      pair.first = std::string(token_start, token_end);
   577	      ++it;  // Skip past the '='.
   578	    }
   579	
   580	    // OK, now try to parse a value.
   581	    std::string_view::iterator value_start, value_end;
   582	    ParseValue(&it, end, &value_start, &value_end);
   583	
   584	    // OK, we're finished with a Token/Value.
   585	    pair.second = std::string(value_start, value_end);
   586	
   587	    // For metrics, check if either the name or value contain an internal HTAB
   588	    // (0x9). That is, not leading or trailing.
   589	    if (pair_num == 0 &&
   590	        (pair.first.find_first_of("\t") != std::string::npos ||
   591	         pair.second.find_first_of("\t") != std::string::npos)) {
   592	      internal_htab_ = true;
   593	    }
   594	
   595	    bool ignore_pair = false;
   596	    if (pair_num == 0) {
   597	      if (!IsValidCookieNameValuePair(pair.first, pair.second, &status_out)) {
   598	        pairs_.clear();
   599	        break;
   600	      }
   601	    } else {
   602	      // From RFC2109: "Attributes (names) (attr) are case-insensitive."
   603	      pair.first = base::ToLowerASCII(pair.first);
   604	
   605	      // Attribute names have the same character set limitations as cookie
   606	      // names, but only a handful of values are allowed. We don't check that
   607	      // this attribute name is one of the allowed ones here, so just re-use
   608	      // the cookie name check.
   609	      if (!IsValidCookieName(pair.first)) {
   610	        status_out.AddExclusionReason(CookieInclusionStatus::ExclusionReason::
   611	                                          EXCLUDE_DISALLOWED_CHARACTER);
   612	        pairs_.clear();
   613	        break;
   614	      }
   615	
   616	      if (!CookieAttributeValueHasValidCharSet(pair.second)) {
   617	        // If the attribute value contains invalid characters, the whole
   618	        // cookie should be ignored.
   619	        status_out.AddExclusionReason(CookieInclusionStatus::ExclusionReason::
   620	                                          EXCLUDE_DISALLOWED_CHARACTER);
   621	        pairs_.clear();
   622	        break;
   623	      }
   624	
   625	      if (!CookieAttributeValueHasValidSize(pair.second)) {
   626	        // If the attribute value is too large, it should be ignored.
   627	        ignore_pair = true;
   628	        status_out.AddWarningReason(CookieInclusionStatus::WarningReason::
   629	                                        WARN_ATTRIBUTE_VALUE_EXCEEDS_MAX_SIZE);
   630	      }
   631	    }
   632	
   633	    if (!ignore_pair) {
   634	      pairs_.emplace_back(std::move(pair));
   635	    }
   636	
   637	    // We've processed a token/value pair, we're either at the end of
   638	    // the string or a ValueSeparator like ';', which we want to skip.
   639	    if (it != end)
   640	      ++it;
   641	  }
   642	}
   643	
   644	void ParsedCookie::SetupAttributes() {
   645	  // We skip over the first token/value, the user supplied one.
   646	  for (size_t i = 1; i < pairs_.size(); ++i) {
   647	    if (pairs_[i].first == kPathTokenName) {
   648	      path_index_ = i;
   649	    } else if (pairs_[i].first == kDomainTokenName) {
   650	      domain_index_ = i;
   651	    } else if (pairs_[i].first == kExpiresTokenName) {
   652	      expires_index_ = i;
   653	    } else if (pairs_[i].first == kMaxAgeTokenName) {
   654	      maxage_index_ = i;
   655	    } else if (pairs_[i].first == kSecureTokenName) {
   656	      secure_index_ = i;
   657	    } else if (pairs_[i].first == kHttpOnlyTokenName) {
   658	      httponly_index_ = i;
   659	    } else if (pairs_[i].first == kSameSiteTokenName) {
   660	      same_site_index_ = i;
   661	    } else if (pairs_[i].first == kPriorityTokenName) {
   662	      priority_index_ = i;
   663	    } else if (pairs_[i].first == kPartitionedTokenName) {
   664	      partitioned_index_ = i;
   665	    } else {
   666	      /* some attribute we don't know or don't care about. */
   667	    }
   668	  }
   669	}
   670	
   671	bool ParsedCookie::SetString(size_t* index,
   672	                             std::string_view key,
   673	                             std::string_view untrusted_value) {
   674	  // This function should do equivalent input validation to the
   675	  // constructor. Otherwise, the Set* functions can put this ParsedCookie in a
   676	  // state where parsing the output of ToCookieLine() produces a different
   677	  // ParsedCookie.
   678	  //
   679	  // Without input validation, invoking pc.SetPath(" baz ") would result in
   680	  // pc.ToCookieLine() == "path= baz ". Parsing the "path= baz " string would
   681	  // produce a cookie with "path" attribute equal to "baz" (no spaces). We
   682	  // should not produce cookie lines that parse to different key/value pairs!
   683	
   684	  // Inputs containing invalid characters or attribute value strings that are
   685	  // too large should be ignored. Note that we check the attribute value size
   686	  // after removing leading and trailing whitespace.
   687	  if (!CookieAttributeValueHasValidCharSet(untrusted_value))
   688	    return false;
   689	
   690	  // Use the same whitespace trimming code as the constructor.
   691	  std::string_view parsed_value = ParseValueString(untrusted_value);
   692	
   693	  if (!CookieAttributeValueHasValidSize(parsed_value))
   694	    return false;
   695	
   696	  if (parsed_value.empty()) {
   697	    ClearAttributePair(*index);
   698	    return true;
   699	  } else {
   700	    return SetAttributePair(index, key, parsed_value);
   701	  }
   702	}
   703	
   704	bool ParsedCookie::SetBool(size_t* index, std::string_view key, bool value) {
   705	  if (!value) {
   706	    ClearAttributePair(*index);
   707	    return true;
   708	  } else {
   709	    return SetAttributePair(index, key, std::string());
   710	  }
   711	}
   712	
   713	bool ParsedCookie::SetAttributePair(size_t* index,
   714	                                    std::string_view key,
   715	                                    std::string_view value) {
   716	  if (!HttpUtil::IsToken(key))
   717	    return false;
   718	  if (!IsValid())
   719	    return false;
   720	  if (*index) {
   721	    pairs_[*index].second = value;
   722	  } else {
   723	    pairs_.emplace_back(key, value);
   724	    *index = pairs_.size() - 1;
   725	  }
   726	  return true;
   727	}
   728	
   729	void ParsedCookie::ClearAttributePair(size_t index) {
   730	  // The first pair (name/value of cookie at pairs_[0]) cannot be cleared.
    40	                        CookieInclusionStatus* status_out = nullptr);
    41	
    42	  ParsedCookie(const ParsedCookie&) = delete;
