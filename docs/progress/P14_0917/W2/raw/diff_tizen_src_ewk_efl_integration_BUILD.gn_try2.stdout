diff --git home/toolchain/development/libcxx_runtime_validation/tmp/P14/baseline/tizen_src/ewk/efl_integration/BUILD.gn home/toolchain/development/libcxx_runtime_validation/tmp/P14/chromium-efl/tizen_src/ewk/efl_integration/BUILD.gn
index d1fdd1e6..44f32d64 100644
--- home/toolchain/development/libcxx_runtime_validation/tmp/P14/baseline/tizen_src/ewk/efl_integration/BUILD.gn
+++ home/toolchain/development/libcxx_runtime_validation/tmp/P14/chromium-efl/tizen_src/ewk/efl_integration/BUILD.gn
@@ -854,6 +854,31 @@ shared_library("chromium-ewk") {
     # Reduce linker memory consumption, so it will fit in 32bit address space.
     ldflags += [ "-Wl,--no-keep-memory" ]
   }
+  if (is_tizen) {
+    sources -= [ "public/ewk_cookie_parser.cc" ]
+    deps += [ ":cookie_parser_exception_cleanup" ]
+  }
+}
+
+# Candidate: preserve cleanup of the completed ParsedCookie when copying its
+# values to EWKCookieContents throws. No public signature or parse rule changes.
+if (is_tizen) {
+  source_set("cookie_parser_exception_cleanup") {
+    visibility = [ ":chromium-ewk" ]
+    sources = [
+      "private/ewk_private.h",
+      "public/ewk_cookie_parser.cc",
+      "public/ewk_cookie_parser.h",
+    ]
+    include_dirs = [ ".", "public" ]
+    deps = [ "//base", "//net" ]
+    configs -= [ "//build/config/compiler:no_exceptions" ]
+    configs += [
+      "//build/config/compiler:exceptions",
+      "//tizen_src/build/config:ecore",
+      "//tizen_src/build/config:evas",
+    ]
+  }
 }
 
 executable("efl_webprocess") {
