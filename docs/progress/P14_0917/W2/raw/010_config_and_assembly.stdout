shared_library("chromium-ewk") {
  if (enable_ewk_interface) {
    output_name = "chromium-impl"
  }
  include_dirs = [
    ".",
    "//tizen_src/ewk/efl_integration/public",
    "//third_party/skia/include/core",
    "//v8/include",
    "$root_gen_dir/blink",
  ]
  configs += [ "//tizen_src/build/config:ecore" ]
  configs += [ "//tizen_src/build/config:evas" ]
  configs += [ "//tizen_src/build/config:ecore-evas" ]
  configs += [ "//tizen_src/build/config:elementary" ]
  configs += [ "//tizen_src/build/config:elementary_config" ]
  configs += [ "//tizen_src/build/config:vconf" ]
  configs += [ "//tizen_src/build/config:capi-system-info" ]
  configs += [ "//tizen_src/build/config:capi-media-camera" ]
  configs += [ "//tizen_src/build/config:efl-extension" ]
  configs += [ "//tizen_src/build/config:ttrace" ]
  configs += [ "//build/config/compiler:no_exit_time_destructors" ]

  # Tizen system replacements for third_party libraries
  if (is_tizen) {
    configs += [ "//tizen_src/build/config:brotli" ]
    configs += [ "//tizen_src/build/config:freetype2" ]
    configs += [ "//tizen_src/build/config:vpx" ]
    configs += [ "//tizen_src/build/config:webp" ]
    configs += [ "//tizen_src/build/config:opus" ]
    configs += [ "//tizen_src/build/config:jsoncpp" ]
    configs += [ "//tizen_src/build/config:libpng" ]
  }
  if (tizen_product_tv) {
    configs += [ "//tizen_src/build/config:drmdecrypt" ]

    # For accessing LIB_UPGRADE_ROOT_DIR
    configs += [ "//tizen_src/chromium_impl/base:external_base_efl_config" ]
  }
