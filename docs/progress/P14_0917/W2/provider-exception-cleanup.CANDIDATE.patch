+
+# Candidate: keep exception cleanup local to the cookie parser TU on Tizen.
+# ParsedCookie already owns pairs_ with RAII; a throwing GNU allocator must
+# not bypass member and local string cleanup during construction.
+if (is_tizen) {
+  source_set("cookie_parser_exception_cleanup") {
+    visibility = [ ":net" ]
+    sources = [ "cookies/parsed_cookie.cc" ]
+    deps = [ ":net_deps" ]
+    configs -= [ "//build/config/compiler:no_exceptions" ]
+    configs += [ "//build/config/compiler:exceptions" ]
+  }
 }
 
