     ]
   }
+  if (is_tizen) {
+    sources -= [ "cookies/parsed_cookie.cc" ]
+    deps += [ ":cookie_parser_exception_cleanup" ]
+    allow_circular_includes_from += [ ":cookie_parser_exception_cleanup" ]
+  }
