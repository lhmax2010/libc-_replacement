from pathlib import Path
from collections import Counter
lines=Path('progress/R79/tables/rg_all_token_hits.txt').read_text(errors='replace').splitlines()
packages=set(Path('progress/R79/tables/package_denominator.txt').read_text().splitlines())
records=[]; outside=[]
for line in lines:
 p,ln,text=line.split(':',2)
 rel=p.removeprefix('tmp/corpus/extracted/')
 pkg,sub=rel.split('/',1)
 row=(pkg,sub,int(ln),text)
 (records if pkg in packages else outside).append(row)
print('RAW_LINES',len(lines)); print('IN_DENOMINATOR_LINES',len(records)); print('OUTSIDE_LINES',len(outside))
print('HIT_PACKAGES',len({r[0] for r in records})); print('HIT_FILES',len({(r[0],r[1]) for r in records}))
for token in ('pthread_setcanceltype','PTHREAD_CANCEL_ASYNCHRONOUS','PTHREAD_CANCEL_DEFERRED','pthread_setcancelstate','pthread_cancel'):
 print('TOKEN',token,sum(token in r[3] for r in records),len({r[0] for r in records if token in r[3]}))
print('PACKAGE_COUNTS')
for p,n in Counter(r[0] for r in records).most_common(): print(p,n)
print('OUTSIDE_PACKAGES',sorted({r[0] for r in outside}))
print('FIRST_80')
for r in records[:80]: print('\t'.join(map(str,r)))
