From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: He Fangyu <fangyu.he@samsung.com>
Date: Tue, 25 Aug 2026 20:52:54 +0800
Subject: [PATCH 4/4] libcxx: preserve forced unwind in library-delivered
 handlers
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Catch-all handlers in explicitly instantiated iostream paths consume foreign
forced unwind and can turn pthread cancellation into process termination.
Add typed handlers at the thirty sites whose implementation is delivered by
the shared libc++ library, preserving stream state before rethrowing.

For the badbit and failbit aggregation helpers, classify and rethrow while
the nested handler remains active; a later bare rethrow has no active
exception for foreign exception paths.  Streambuf extraction commits its
state with the non-throwing setter before rethrowing so an exception mask
cannot replace the forced unwind.

This library batch is separate from consumer-instantiated header sites and
depends on the libc++abi forced-unwind marker and unwind fixes.

中文说明：
为由 libc++ 动态库交付的三十处 iostream 站点补齐强制展开防护。
badbit/failbit 汇聚函数在活动 handler 内完成条件重抛，streambuf
提取路径以不抛异常的接口先提交状态位，再继续传播取消展开。

Validation covers x86_64 and armv7l cancellation paths, library-only
replacement, stream exception masks, state-bit assertions, and normal I/O
failure behavior.  Other architectures, unaudited LTO modes, mixed runtimes,
and dynamic loading boundaries are not covered.
---
 libcxx/include/istream | 63 ++++++++++++++++++++++++++++++++++++++++++
 libcxx/src/ios.cpp     | 17 ++++++++++--
 2 files changed, 78 insertions(+), 2 deletions(-)

diff --git a/libcxx/include/istream b/libcxx/include/istream
index fcf0452db691..c39dce589fa0 100644
--- a/libcxx/include/istream
+++ b/libcxx/include/istream
@@ -658,6 +658,12 @@ basic_istream<_CharT, _Traits>::operator>>(basic_streambuf<char_type, traits_typ
         if (__gc_ == 0)
           __state |= ios_base::failbit;
 #    if _LIBCPP_HAS_EXCEPTIONS
+      } catch (const __cxxabiv1::__forced_unwind&) {
+        __state |= ios_base::badbit;
+        if (__gc_ == 0)
+          __state |= ios_base::failbit;
+        this->__setstate_nothrow(__state);
+        throw;
       } catch (...) {
         __state |= ios_base::badbit;
         if (__gc_ == 0)
@@ -693,6 +699,9 @@ typename basic_istream<_CharT, _Traits>::int_type basic_istream<_CharT, _Traits>
       else
         __gc_ = 1;
 #    if _LIBCPP_HAS_EXCEPTIONS
+    } catch (const __cxxabiv1::__forced_unwind&) {
+      this->__setstate_nothrow(this->rdstate() | ios_base::badbit);
+      throw;
     } catch (...) {
       this->__setstate_nothrow(this->rdstate() | ios_base::badbit);
       if (this->exceptions() & ios_base::badbit) {
@@ -731,6 +740,12 @@ basic_istream<_CharT, _Traits>& basic_istream<_CharT, _Traits>::get(char_type* _
         if (__gc_ == 0)
           __state |= ios_base::failbit;
 #    if _LIBCPP_HAS_EXCEPTIONS
+      } catch (const __cxxabiv1::__forced_unwind&) {
+        __state |= ios_base::badbit;
+        this->__setstate_nothrow(__state);
+        if (__n > 0)
+          *__s = char_type();
+        throw;
       } catch (...) {
         __state |= ios_base::badbit;
         this->__setstate_nothrow(__state);
@@ -779,6 +794,10 @@ basic_istream<_CharT, _Traits>::get(basic_streambuf<char_type, traits_type>& __s
         this->rdbuf()->sbumpc();
       }
 #    if _LIBCPP_HAS_EXCEPTIONS
+    } catch (const __cxxabiv1::__forced_unwind&) {
+      __state |= ios_base::badbit;
+      this->__setstate_nothrow(__state);
+      throw;
     } catch (...) {
       __state |= ios_base::badbit;
       // according to the spec, exceptions here are caught but not rethrown
@@ -822,6 +841,14 @@ basic_istream<_CharT, _Traits>::getline(char_type* __s, streamsize __n, char_typ
         __inc_gcount();
       }
 #    if _LIBCPP_HAS_EXCEPTIONS
+    } catch (const __cxxabiv1::__forced_unwind&) {
+      __state |= ios_base::badbit;
+      this->__setstate_nothrow(__state);
+      if (__n > 0)
+        *__s = char_type();
+      if (__gc_ == 0)
+        __state |= ios_base::failbit;
+      throw;
     } catch (...) {
       __state |= ios_base::badbit;
       this->__setstate_nothrow(__state);
@@ -876,6 +903,10 @@ basic_istream<_CharT, _Traits>& basic_istream<_CharT, _Traits>::ignore(streamsiz
         }
       }
 #    if _LIBCPP_HAS_EXCEPTIONS
+    } catch (const __cxxabiv1::__forced_unwind&) {
+      __state |= ios_base::badbit;
+      this->__setstate_nothrow(__state);
+      throw;
     } catch (...) {
       __state |= ios_base::badbit;
       this->__setstate_nothrow(__state);
@@ -903,6 +934,10 @@ typename basic_istream<_CharT, _Traits>::int_type basic_istream<_CharT, _Traits>
       if (traits_type::eq_int_type(__r, traits_type::eof()))
         __state |= ios_base::eofbit;
 #    if _LIBCPP_HAS_EXCEPTIONS
+    } catch (const __cxxabiv1::__forced_unwind&) {
+      __state |= ios_base::badbit;
+      this->__setstate_nothrow(__state);
+      throw;
     } catch (...) {
       __state |= ios_base::badbit;
       this->__setstate_nothrow(__state);
@@ -972,6 +1007,10 @@ streamsize basic_istream<_CharT, _Traits>::readsome(char_type* __s, streamsize _
         break;
       }
 #    if _LIBCPP_HAS_EXCEPTIONS
+    } catch (const __cxxabiv1::__forced_unwind&) {
+      __state |= ios_base::badbit;
+      this->__setstate_nothrow(__state);
+      throw;
     } catch (...) {
       __state |= ios_base::badbit;
       this->__setstate_nothrow(__state);
@@ -1000,6 +1039,10 @@ basic_istream<_CharT, _Traits>& basic_istream<_CharT, _Traits>::putback(char_typ
       if (this->rdbuf() == nullptr || this->rdbuf()->sputbackc(__c) == traits_type::eof())
         __state |= ios_base::badbit;
 #    if _LIBCPP_HAS_EXCEPTIONS
+    } catch (const __cxxabiv1::__forced_unwind&) {
+      __state |= ios_base::badbit;
+      this->__setstate_nothrow(__state);
+      throw;
     } catch (...) {
       __state |= ios_base::badbit;
       this->__setstate_nothrow(__state);
@@ -1028,6 +1071,10 @@ basic_istream<_CharT, _Traits>& basic_istream<_CharT, _Traits>::unget() {
       if (this->rdbuf() == nullptr || this->rdbuf()->sungetc() == traits_type::eof())
         __state |= ios_base::badbit;
 #    if _LIBCPP_HAS_EXCEPTIONS
+    } catch (const __cxxabiv1::__forced_unwind&) {
+      __state |= ios_base::badbit;
+      this->__setstate_nothrow(__state);
+      throw;
     } catch (...) {
       __state |= ios_base::badbit;
       this->__setstate_nothrow(__state);
@@ -1060,6 +1107,10 @@ int basic_istream<_CharT, _Traits>::sync() {
         __r = -1;
       }
 #    if _LIBCPP_HAS_EXCEPTIONS
+    } catch (const __cxxabiv1::__forced_unwind&) {
+      __state |= ios_base::badbit;
+      this->__setstate_nothrow(__state);
+      throw;
     } catch (...) {
       __state |= ios_base::badbit;
       this->__setstate_nothrow(__state);
@@ -1084,6 +1135,10 @@ typename basic_istream<_CharT, _Traits>::pos_type basic_istream<_CharT, _Traits>
 #    endif // _LIBCPP_HAS_EXCEPTIONS
       __r = this->rdbuf()->pubseekoff(0, ios_base::cur, ios_base::in);
 #    if _LIBCPP_HAS_EXCEPTIONS
+    } catch (const __cxxabiv1::__forced_unwind&) {
+      __state |= ios_base::badbit;
+      this->__setstate_nothrow(__state);
+      throw;
     } catch (...) {
       __state |= ios_base::badbit;
       this->__setstate_nothrow(__state);
@@ -1109,6 +1164,10 @@ basic_istream<_CharT, _Traits>& basic_istream<_CharT, _Traits>::seekg(pos_type _
       if (this->rdbuf()->pubseekpos(__pos, ios_base::in) == pos_type(-1))
         __state |= ios_base::failbit;
 #    if _LIBCPP_HAS_EXCEPTIONS
+    } catch (const __cxxabiv1::__forced_unwind&) {
+      __state |= ios_base::badbit;
+      this->__setstate_nothrow(__state);
+      throw;
     } catch (...) {
       __state |= ios_base::badbit;
       this->__setstate_nothrow(__state);
@@ -1134,6 +1193,10 @@ basic_istream<_CharT, _Traits>& basic_istream<_CharT, _Traits>::seekg(off_type _
       if (this->rdbuf()->pubseekoff(__off, __dir, ios_base::in) == pos_type(-1))
         __state |= ios_base::failbit;
 #    if _LIBCPP_HAS_EXCEPTIONS
+    } catch (const __cxxabiv1::__forced_unwind&) {
+      __state |= ios_base::badbit;
+      this->__setstate_nothrow(__state);
+      throw;
     } catch (...) {
       __state |= ios_base::badbit;
       this->__setstate_nothrow(__state);
diff --git a/libcxx/src/ios.cpp b/libcxx/src/ios.cpp
index 02ce4841187f..3aab86189bbc 100644
--- a/libcxx/src/ios.cpp
+++ b/libcxx/src/ios.cpp
@@ -9,6 +9,7 @@
 #include <__config>
 #include <__locale>
 #include <algorithm>
+#include <cxxabi.h>
 #include <ios>
 #include <limits>
 #include <memory>
@@ -362,16 +363,28 @@ void ios_base::swap(ios_base& rhs) noexcept {
 void ios_base::__set_badbit_and_consider_rethrow() {
   __rdstate_ |= badbit;
 #if _LIBCPP_HAS_EXCEPTIONS
-  if (__exceptions_ & badbit)
+  try {
     throw;
+  } catch (const __cxxabiv1::__forced_unwind&) {
+    throw;
+  } catch (...) {
+    if (__exceptions_ & badbit)
+      throw;
+  }
 #endif // _LIBCPP_HAS_EXCEPTIONS
 }
 
 void ios_base::__set_failbit_and_consider_rethrow() {
   __rdstate_ |= failbit;
 #if _LIBCPP_HAS_EXCEPTIONS
-  if (__exceptions_ & failbit)
+  try {
     throw;
+  } catch (const __cxxabiv1::__forced_unwind&) {
+    throw;
+  } catch (...) {
+    if (__exceptions_ & failbit)
+      throw;
+  }
 #endif // _LIBCPP_HAS_EXCEPTIONS
 }
 
