    54	Prefer: mono-data
    55	Prefer: mono-mvc
    56	Prefer: mono-winforms
    57	Prefer: mono-data-sqlite
    58	
    59	# Set a preference for ambiguous libs to use *-64bit libs
    60	#     *-64bit libs on 32bit build environment are required for .Net build (e.g., coreclr, corefx)
    61	#     But when building 64bit target, they could make 'have choice' error with original libs in 64bit repository.
    62	#     e.g., libstdc++ and libstdc++-64bit provides same libs. It's ambiguous to choose appropriate one.
    63	#     Owner : Jiyoung Yun (jy910.yun@samsung.com)
    64	#     libopenssl* : Dongsun Lee (ds73.lee@samsung.com), Dariusz Michaluk (d.michaluk@samsung.com)
    65	Prefer: libgcc libstdc++ libunwind libuuid zlib libopenssl libopenssl11 libopenssl3
    66	Prefer: lldb
    67	
    68	############################# base definition ###############################
    69	
    70	# %release_name and %tizen_full_version are used in platform/upstream/tizen-release
    71	
    72	Macros:
    73	%release_name Tizen11.0/Unified
    74	
    75	%tizen_version_major 11
    76	%tizen_version_minor 0
    77	%tizen_version_patch 0
    78	
    79	%tizen_version %{tizen_version_major}.%{tizen_version_minor}
    80	%tizen_full_version %{tizen_version}.%{tizen_version_patch}
    81	%tizen %tizen_version
    82	%vendor tizen
    83	%_vendor tizen
    84	%_with_tizen 1
    85	
    86	#### %__spec_check_pre exit 0
    87	#### %run_check_section 0
    88	
    89	%opensuse_bs 1
    90	%_default_patch_fuzz   2
    91	
    92	%_binary_payload w5T.xzdio
    93	:Macros
    94	
    95	#### %%__spec_check_pre exit 0
    96	#### %%run_check_section 0
    97	
    98	# skip %%check section
    99	Macros:
   100	# skip package list
   101	%_skip_check_packages autogen bison boost expat findutils flex fribidi glibc \\\
   102	gmp gn golang grep libgc libgcrypt libogg libsigc++ libvorbis libxml2 libzio \\\
   103	m4 nspr openssl openssl1.1 perl-Devel-Symdump perl-gettext perl-Pod-Coverage \\\
   104	perl-Test-Pod perl-Test-Pod-Coverage perl-TimeDate procps-ng python3-mako \\\
   105	python3-mock python3-ply python-funcsigs python-mako python-mock python-ply \\\
   106	setup zlib openssl3 autoconf libxcrypt
   107	
   108	%__spec_check_pre \
   109	for name in %_skip_check_packages \
   110	do \
   111	    if [ "$name" = "%{name}" ]; then \
   112	        exit 0 \
   113	    fi \
   114	done \
   115	%{___build_pre} \
   116	%{nil}
   117	
