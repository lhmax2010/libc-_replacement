   439	
   440	############################# misc config flags ################################
   441	########## USAGE ##########
   442	#
   443	# IMPORTANT: please follow the following rules when playing with flags
   444	# ********************************************************************
   445	#
   446	# In spec file, call %bcond_with macro at the beginning and test with %with:
   447	# -------------------------
   448	# | %bcond_with myfeature
   449	# | [...]
   450	# | %if %{with myfeature}
   451	# | [...]
   452	# | %endif
   453	# | [...]
   454	# -------------------------
   455	#
   456	# To activate an option, use:
   457	# -------------------------
   458	# | %define _with_myfeature 1
   459	# | Macros:
   460	# | %_with_myfeature 1
   461	# | :Macros
   462	# -------------------------
   463	#
   464	# To disable an option, DON'T set the values to 0, as the option would still be defined
   465	# but simply comment the lines: this will undefine the option.
   466	# -------------------------
   467	# | #%define _with_myfeature 1
   468	# | #Macros:
   469	# | #%_with_myfeature 1
   470	# | #:Macros
   471	# -------------------------
   472	#
   473	# More information here:
   474	# https://en.opensuse.org/openSUSE:Build_Service_prjconf#.25bcond
   475	#
   476	
   477	########## flags ##########
   478	
   479	# Activate introspection
   480	# This is needed on GuPNP to build Rygel correctly in IVI
   481	# Impacts potentially packages that use gobject-introspection
   482	# Owner: Mikko <mikko.ylinen@intel.com>
   483	
   484	Macros:
   485	%_with_introspection 1
   486	:Macros
