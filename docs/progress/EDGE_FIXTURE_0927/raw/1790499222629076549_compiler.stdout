#!/usr/bin/env bash
set -euo pipefail
workspace=/home/toolchain/development/libc++_replacement
sysroot=$workspace/tmp/GBS-ROOT/R32-candidates-libcxx-x86_64-20260813-02/local/BUILD-ROOTS/scratch.x86_64.0
export LD_LIBRARY_PATH="$sysroot/usr/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$sysroot/usr/bin/clang++" \
  --sysroot="$sysroot" \
  -resource-dir "$sysroot/usr/lib64/clang/22" \
  "$@"
