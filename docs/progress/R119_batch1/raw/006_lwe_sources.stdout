619: WebContainer* WebContainer::CreateGLWithPlatformImage(
620:     const WebContainerArguments& args, const RendererGLConfiguration& config,
621:     const OnPrepareImage& prepareImageCb, const OnFlush& flushCb)
622: {
623:     WebContainer* newWebContainer = nullptr;
624:     ThreadedCallHelper::Instance()->PostTaskToLWEMainThreadSync([&]() -> void {
625:         Starfish::WebView* webView = createStarfishWebViewInstance(
626:             args.width, args.height, args.devicePixelRatio,
627:             args.defaultFontName, args.locale, args.timezoneID);
628: 
629:         newWebContainer = new (NoGC) WebContainerImpl(webView);
630: 
631:         webView->renderer()->registerOnMakeCurrent(
632:             [config, newWebContainer](Starfish::Renderer* renderer) {
633:                 config.onMakeCurrent(newWebContainer);
634:             });
635: 
636:         webView->renderer()->registerOnSwapBuffers(
637:             [config, newWebContainer](Starfish::Renderer* renderer,
638:                                       bool mayNeedsSync) {
639:                 config.onSwapBuffers(newWebContainer, mayNeedsSync);
640:             });
641: 
642:         if (config.onCreateSharedContext) {
643:             webView->renderer()->registerOnCreateSharedContext(
644:                 [config,
645:                  newWebContainer](Starfish::Renderer* renderer) -> uintptr_t {
646:                     return config.onCreateSharedContext(newWebContainer);
647:                 });
648:         }
649:         if (config.onDestroyContext) {
650:             webView->renderer()->registerOnDestroyContext(
651:                 [config, newWebContainer](Starfish::Renderer* renderer,
652:                                           uintptr_t context) -> bool {
653:                     return config.onDestroyContext(newWebContainer, context);
654:                 });
655:         }
656:         if (config.onClearCurrentContext) {
657:             webView->renderer()->registerOnClearCurrentContext(
658:                 [config,
659:                  newWebContainer](Starfish::Renderer* renderer) -> bool {
660:                     return config.onClearCurrentContext(newWebContainer);
661:                 });
662:         }
663:         if (config.onMakeCurrentWithContext) {
664:             webView->renderer()->registerOnMakeCurrentWithContext(
665:                 [config, newWebContainer](Starfish::Renderer* renderer,
666:                                           uintptr_t context) -> bool {
667:                     return config.onMakeCurrentWithContext(newWebContainer,
668:                                                            context);
669:                 });
670:         }
671:         if (config.onGetProcAddress) {
672:             webView->renderer()->registerOnGetProcAddress(
673:                 [config, newWebContainer](Starfish::Renderer* renderer,
674:                                           const char* name) -> void* {
675:                     return config.onGetProcAddress(newWebContainer, name);
676:                 });
677:         }
678:         if (config.onIsSupportedExtension) {
679:             webView->renderer()->registerOnIsSupportedExtension(
680:                 [config, newWebContainer](Starfish::Renderer* renderer,
681:                                           const char* extension) -> bool {
682:                     return config.onIsSupportedExtension(newWebContainer,
683:                                                          extension);
684:                 });
685:         }
686:         webView->renderer()->registerRenderingPrepareCallback(
687:             [prepareImageCb](void) -> Starfish::RenderInfo {
688:                 WebContainer::ExternalImageInfo tmp = prepareImageCb();
689:                 Starfish::RenderInfo result;
690:                 result.updatedBufferAddress = tmp.imageAddress;
691:                 result.bufferStride = 0;
692:                 return result;
693:             });
694: 
695:         webView->renderer()->registerSurfaceFlushedCallback(
696:             [newWebContainer, flushCb](bool needsFlush) {
697:                 flushCb(newWebContainer, needsFlush);
698:             });
699:     });
700:     return newWebContainer;
701: }
