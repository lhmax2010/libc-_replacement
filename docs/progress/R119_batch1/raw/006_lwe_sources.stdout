728: void WebContainerImpl::AddIdleCallback(void (*callback)(void*), void* data)
729: {
730:     ThreadedCallHelper::Instance()->PostTaskToLWEMainThreadSync([&]() -> void {
731:         struct Data : public gc {
732:             void (*callback)(void*);
733:             void* data;
734:         };
735: 
736:         Data* d = new Data();
737:         d->callback = callback;
738:         d->data = data;
739:         m_webView->messageLoop()->addIdler(
740:             nullptr,
741:             [](size_t, void* data) {
742:                 Data* d = (Data*)data;
743:                 d->callback(d->data);
744:             },
745:             d);
746:     });
747: }
