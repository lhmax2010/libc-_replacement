974: std::string WebContainerImpl::EvaluateJavaScript(const std::string& script)
975: {
976:     std::string ret;
977:     ThreadedCallHelper::Instance()->PostTaskToLWEMainThreadSync([&]() -> void {
978:         ret = m_webView
979:                   ->evaluateJavaScript(
980:                       Starfish::String::fromUTF8(script.data(), script.size()))
981:                   ->toUTF8NonGCString();
982:     });
983:     return ret;
984: }
985: 
986: void WebContainerImpl::EvaluateJavaScript(
987:     const std::string& script, std::function<void(const std::string&)> cb)
988: {
989:     struct Params {
990:         Starfish::WebView* webview;
991:         std::string script;
992:         std::function<void(const std::string&)> cb;
993:     };
994:     Params* p = new Params;
995:     p->webview = m_webView;
996:     p->script = script;
997:     p->cb = cb;
998: 
999:     if (Starfish::isMainThread()) {
1000:         p->webview->messageLoop()->addIdler(
1001:             m_webView->mainBrowsingContext()
1002:                 ? p->webview->mainBrowsingContext()->window()
1003:                 : nullptr,
1004:             [](size_t handle, void* data) {
1005:                 STARFISH_ASSERT(data != nullptr);
1006:                 Params* p = (Params*)data;
1007:                 p->webview->evaluateJavaScript(
1008:                     Starfish::String::fromUTF8(p->script.data(),
1009:                                                p->script.size()),
1010:                     p->cb);
1011:                 delete p;
1012:             },
1013:             p);
1014:     } else {
1015:         p->webview->messageLoop()->addIdlerWithNoGCRootingInOtherThread(
1016:             m_webView->mainBrowsingContext()
1017:                 ? p->webview->mainBrowsingContext()->window()
1018:                 : nullptr,
1019:             [](size_t handle, void* data) {
1020:                 STARFISH_ASSERT(data != nullptr);
1021:                 Params* p = (Params*)data;
1022: 
1023:                 p->webview->evaluateJavaScript(
1024:                     Starfish::String::fromUTF8(p->script.data(),
1025:                                                p->script.size()),
1026:                     p->cb);
1027:                 delete p;
1028:             },
1029:             p);
1030:     }
1031: }
