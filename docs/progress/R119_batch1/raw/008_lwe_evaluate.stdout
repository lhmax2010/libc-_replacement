1021: BlobURLStore WebView::addMediaSourceInBlobURLStore(MediaSource* ptr)
1022: {
1023:     STARFISH_ASSERT(ptr != nullptr);
1024: 
1025: #ifndef NDEBUG
1026:     {
1027:         BlobURLStore s;
1028:         s.m_blob = ptr;
1029:         STARFISH_ASSERT(m_urlMediaSourceBlobStore.find(s) ==
1030:                         m_urlMediaSourceBlobStore.end());
1031:     }
1032: #endif
1033:     BlobURLStore a;
1034:     a.m_blob = ptr;
1035: 
1036:     std::uniform_int_distribution<uint32_t> distribution;
1037: 
1038: #ifdef STARFISH_32
1039:     a.m_a = distribution(randomEngine());
1040:     a.m_b = distribution(randomEngine());
1041:     a.m_c = distribution(randomEngine());
1042: #else
1043:     a.m_a = distribution(randomEngine());
1044:     a.m_b = distribution(randomEngine());
1045: #endif
1046: 
1047:     m_urlMediaSourceBlobStore.insert(a);
1048: 
1049:     return a;
1050: }
