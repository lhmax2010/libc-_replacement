365:     Starfish::WebView* m_webView = nullptr;
366: 
367:     // Mouse-move coalescing. A burst of native motion events (e.g. dragging the
368:     // seek bar) would otherwise post one async task each, and every task forces
369:     // a hit-test + layoutIfNeeded on the LWE thread. We instead keep only the
370:     // newest position and post a single task while one is still pending, so a
371:     // fast drag collapses to one dispatch per drained queue. UA coalescing of
372:     // mousemove is permitted by the spec.
373:     std::mutex m_mouseMoveLock;
374:     bool m_mouseMovePending = false;
375:     ::LWE::MouseButtonValue m_mouseMoveButton = ::LWE::MouseButtonValue();
376:     ::LWE::MouseButtonsValue m_mouseMoveButtons = ::LWE::MouseButtonsValue();
377:     double m_mouseMoveX = 0;
378:     double m_mouseMoveY = 0;
379: 
380:     // Touch-move coalescing, mirroring the mouse-move coalescing above. Touch
381:     // panels report motion at 90-120Hz and every dispatched task runs a full
382:     // hit-test (plus touchmove and pointermove dispatch) on the LWE thread, so
383:     // without coalescing a drag during video playback builds a task backlog
384:     // and the page sees touch positions seconds behind the finger. Only
385:     // touchmove is coalesced; start/end/cancel stay one task each, and the
386:     // message loop's FIFO order guarantees a pending move still runs before a
387:     // subsequently posted end. UA coalescing of touchmove is permitted by the
388:     // spec.
389:     std::mutex m_touchMoveLock;
390:     bool m_touchMovePending = false;
391:     std::vector<::Starfish::TouchData> m_touchMoveData;
392: };
