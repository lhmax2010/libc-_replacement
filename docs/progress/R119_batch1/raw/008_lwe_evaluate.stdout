394: WebContainer* WebContainer::CreateWithBuffer(void* buffer, unsigned width,
395:                                              unsigned height, unsigned stride,
396:                                              float scaleFactor,
397:                                              const char* defaultFontName,
398:                                              const char* locale,
399:                                              const char* timezoneID)
400: {
401:     STARFISH_RELEASE_ASSERT(defaultFontName != nullptr);
402:     STARFISH_RELEASE_ASSERT(locale != nullptr);
403:     STARFISH_RELEASE_ASSERT(timezoneID != nullptr);
404: 
405:     WebContainer* newWebContainer = nullptr;
406:     ThreadedCallHelper::Instance()->PostTaskToLWEMainThreadSync([&]() -> void {
407:         Starfish::WebView* webView = createStarfishWebViewInstance(
408:             width, height, scaleFactor, defaultFontName, locale, timezoneID);
409: 
410:         newWebContainer = new (NoGC) WebContainerImpl(webView);
411:         newWebContainer->UpdateBuffer(buffer, width, height, stride);
412:     });
413:     return newWebContainer;
414: }
