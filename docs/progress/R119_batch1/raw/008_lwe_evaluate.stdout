435: void WebContainerImpl::UpdateBuffer(void* buffer, unsigned width,
436:                                     unsigned height, unsigned stride)
437: {
438:     ThreadedCallHelper::Instance()->PostTaskToLWEMainThreadSync([&]() -> void {
439:         ResizeTo(width, height);
440:         m_webView->renderer()->updateDrawingBufferAddress(buffer, stride);
441:     });
442: }
443: 
444: void WebContainerImpl::RegisterPreRenderingHandler(
445:     const std::function<WebContainer::RenderInfo(void)>& cb)
446: {
447:     ThreadedCallHelper::Instance()->PostTaskToLWEMainThreadSync([&]() -> void {
448:         m_webView->renderer()->registerRenderingPrepareCallback(
449:             [cb](void) -> Starfish::RenderInfo {
450:                 WebContainer::RenderInfo tmp = cb();
451:                 Starfish::RenderInfo result;
452:                 result.updatedBufferAddress = tmp.updatedBufferAddress;
453:                 result.bufferStride = tmp.bufferStride;
454: 
455:                 return result;
456:             });
457:     });
458: }
459: 
460: void WebContainerImpl::RegisterOnRenderedHandler(
461:     const std::function<void(WebContainer*, const WebContainer::RenderResult&)>&
462:         cb)
463: {
464:     ThreadedCallHelper::Instance()->PostTaskToLWEMainThreadSync([&]() -> void {
465:         m_webView->renderer()->registerRenderingFinishedCallback(
466:             [this, cb](const Starfish::RenderResult& renderResult) {
467:                 WebContainer::RenderResult result;
468:                 result.updatedX = (int)renderResult.updateRect.x();
469:                 result.updatedY = (int)renderResult.updateRect.y();
470:                 result.updatedWidth = (int)renderResult.updateRect.width();
471:                 result.updatedHeight = (int)renderResult.updateRect.height();
472:                 result.updatedBufferAddress =
473:                     m_webView->renderer()->drawingBufferAddress();
474:                 result.bufferImageWidth = m_webView->renderer()->width();
475:                 result.bufferImageHeight = m_webView->renderer()->height();
476:                 cb(this, result);
477:             });
478:     });
479: }
