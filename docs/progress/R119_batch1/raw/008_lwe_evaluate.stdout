988: String* WebView::evaluateJavaScript(String* s)
989: {
990:     STARFISH_ASSERT(s != nullptr);
991: 
992:     if (mainBrowsingContext()) {
993:         ANNOTATE_SETUP;
994:         ANNOTATE_CHANNEL_COLOR(3003, ANNOTATE_BLUE,
995:                                "WebView::evaluateJavaScript");
996:         String* result = toBrowserString(
997:             mainBrowsingContext()->scriptBindingInstance(),
998:             evaluateString(mainBrowsingContext()->scriptBindingInstance(), s));
999:         ANNOTATE_CHANNEL_END(3003);
1000:         return result;
1001: 
1002:     } else {
1003:         return String::emptyString;
1004:     }
1005: }
1006: 
1007: void WebView::evaluateJavaScript(String* s, std::function<void(std::string)> cb)
1008: {
1009:     STARFISH_ASSERT(s != nullptr);
1010: 
1011:     String* ret = String::emptyString;
1012: 
1013:     if (mainBrowsingContext()) {
1014:         ret = toBrowserString(
1015:             mainBrowsingContext()->scriptBindingInstance(),
1016:             evaluateString(mainBrowsingContext()->scriptBindingInstance(), s));
1017:     }
1018:     cb(ret->toUTF8NonGCString());
1019: }
