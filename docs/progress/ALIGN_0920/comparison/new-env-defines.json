{
  "env": {
    "PATH": "/bin:/usr/bin:/sbin:/usr/sbin",
    "QEMU_RESERVED_VA": "0x100000000",
    "CMAKE_BUILD_PARALLEL_LEVEL": "1",
    "RPM_BUILD_NCPUS": "1",
    "MAKEFLAGS": "-j1",
    "LC_ALL": "C"
  },
  "defines": [
    "_binary_payload w5T1.xzdio",
    "_topdir /home/abuild/rpmbuild",
    "_rpmdir /tmp/diag/rpm-arm-llvm/RPMS",
    "_srcrpmdir /tmp/diag/rpm-arm-llvm/SRPMS",
    "_buildrootdir /tmp/diag/rpm-arm-llvm/BUILDROOT",
    "_tmppath /tmp/diag/rpm-arm-llvm/TMP",
    "_smp_mflags -j1",
    "_smp_build_ncpus 1",
    "jobs 1",
    "mlgo_build_jobs 1",
    "_srcdefattr (-,root,root)",
    "_build_create_debug 1"
  ]
}
