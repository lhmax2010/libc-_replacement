#!/usr/bin/env python3
"""顺序编译/执行，原始命令归档；物理板失败立即停止，不自动重试。"""
import argparse, hashlib, json, os, pathlib, re, shutil, subprocess, sys, time
ROOT=pathlib.Path(__file__).resolve().parents[4]
OUT=ROOT/'docs/progress/R118'; TMP=ROOT/'tmp/R118'; CODE=OUT/'code'
OLD=pathlib.Path('/home/toolchain/development/libc++_replacement')
CC=OLD/'progress/R33/tools/tizen-clang++'
REC=ROOT/'docs/progress/API_0911/record.py'
SDK=ROOT/'tmp/API_0911/W1_CONT'
ARMROOT=OLD/'tmp/GBS-ROOT/R30-semantic-libcxx-armv7l-20260812-01/local/BUILD-ROOTS/scratch.armv7l.0'
SDB=['sdb','-s','192.168.108.26:26101']
REMOTE='/opt/usr/home/owner/share/tmp/r118'

def digest(p): return hashlib.sha256(pathlib.Path(p).read_bytes()).hexdigest()
def save(p,obj):
 p.parent.mkdir(parents=True,exist_ok=True);p.write_text(json.dumps(obj,ensure_ascii=False,indent=2)+'\n')
def record(tag,args):
 stem=OUT/'raw'/tag; n=1
 while pathlib.Path(str(stem)+'.command.txt').exists():
  n+=1;stem=OUT/'raw'/(tag+f'_attempt{n}')
 subprocess.run([sys.executable,str(REC),str(stem),*map(str,args)],cwd=ROOT,check=False)
 rc=int(pathlib.Path(str(stem)+'.exitcode').read_text())
 return rc,pathlib.Path(str(stem)+'.stdout').read_text(errors='replace'),str(stem.relative_to(ROOT))
def checked(tag,args):
 rc,out,raw=record(tag,args)
 if rc:raise RuntimeError(f'{tag}: exit={rc}, {raw}')
 return out,raw
def remote(tag,cmd):
 rc,out,raw=record(tag,['timeout','45',*SDB,'shell',f'{{ {cmd}; }}; r118_rc=$?; printf "\\nR118_TARGET_EXIT=%s\\n" "$r118_rc"'])
 m=re.findall(r'R118_TARGET_EXIT=(\d+)',out)
 if rc or not m:raise RuntimeError(f'BOARD_CONNECTION_INTERRUPTED: {raw}; 不重试、不清理，停报')
 return int(m[-1]),out,raw
def remote_checked(tag,cmd):
 rc,out,raw=remote(tag,cmd)
 if rc:raise RuntimeError(f'BOARD_COMMAND_FAILED: exit={rc}, {raw}')
 return out,raw
def configuration(arch,lib):
 target='native' if arch=='x86_64' else 'armv7l'
 build=ROOT/f'tmp/IMPL_0908/build-{target}'
 gnu_lib=SDK/('closure_ewk/libstdc++.so.6' if arch=='x86_64' else 'arm/sdk/libstdc++/usr/lib/libstdc++.so.6')
 if arch=='x86_64':
  inc=SDK/'gnu14_sdk/usr/lib64/gcc/x86_64-tizen-linux-gnu/14.2.0/include/c++';triplet='x86_64-tizen-linux-gnu'
  extra=['-fuse-ld=/usr/bin/ld.gold']
 else:
  inc=SDK/'arm/sdk/libstdc++-devel/usr/lib/gcc/armv7l-tizen-linux-gnueabi/14.2.0/include/c++';triplet='armv7l-tizen-linux-gnueabi'
  extra=['--target=armv7l-tizen-linux-gnueabi',f'--sysroot={ARMROOT}',f'--ld-path={OLD}/progress/R36/tools/armv7l-ld','-march=armv7-a','-mfpu=neon','-mfloat-abi=softfp','-mthumb']
 flags=['-std=c++17','-O0','-g','-fexceptions','-nostdinc++','-nostdlib++','-I'+str(CODE),*extra]
 if lib=='gnu':flags+=['-I'+str(inc),'-I'+str(inc/triplet)];links=[str(gnu_lib)]
 else:flags+=['-I'+str(build/'include/c++/v1')];links=['-L'+str(build/'lib'),'-lc++','-lc++abi']
 return flags,links,build,gnu_lib
def native_run(tag,exe,lib):
 _,_,build,gnu_lib=configuration('x86_64',lib)
 return record(tag,['nice','-n','19','ionice','-c','3',SDK/'closure_ewk/ld-linux-x86-64.so.2','--library-path',str(build/'lib')+':'+str(SDK/'closure_ewk'),exe])
def clean_output(s):return '\n'.join(x for x in s.replace('\r','').splitlines() if not x.startswith('MAP ') and not x.startswith('R118_TARGET_EXIT='))

def main():
 p=argparse.ArgumentParser();p.add_argument('type',choices=['string','vector','function']);p.add_argument('--arch',choices=['x86_64','armv7l'],required=True);p.add_argument('--only');a=p.parse_args()
 start=time.time();dest=TMP/a.type/a.arch;dest.mkdir(parents=True,exist_ok=True);rows=[];built=[]
 for source in sorted((CODE/a.type).glob('*.cpp')):
  if a.only and source.stem!=a.only:continue
  for lib in ['gnu','cxx']:
   flags,links,build,gnu_lib=configuration(a.arch,lib);exe=dest/(source.stem+'_'+lib)
   if source.stem.startswith('cxx23_'):flags=['-std=c++23' if x=='-std=c++17' else x for x in flags]
   tag=f'{a.type}_{a.arch}_{source.stem}_{lib}'
   rc,out,raw=record(tag+'_build',['nice','-n','19','ionice','-c','3',CC,*flags,source,*links,'-ldl','-pthread','-o',exe])
   row=dict(test=source.stem,arch=a.arch,library=lib,source=str(source.relative_to(ROOT)),source_sha256=digest(source),build_exit=rc,build_raw=raw,runs=[])
   rows.append(row)
   if rc==0:row['executable_sha256']=digest(exe);built.append((row,exe,tag))
   elif 'extension' not in source.stem:save(OUT/a.type/(a.arch+'_matrix.json'),rows);raise RuntimeError('非预期编译失败：'+tag)
   if source.stem=='layout' and rc==0:
    checked(tag+'_record_layout',['nice','-n','19','ionice','-c','3',CC,*flags,'-Xclang','-fdump-record-layouts','-c',source,'-o',dest/('layout_'+lib+'.o')])
 if a.arch=='armv7l':
  remote_checked(a.type+'_pre_upload',f'test ! -e {REMOTE} && uname -m && mkdir {REMOTE}')
  _,_,build,gnu_lib=configuration(a.arch,'cxx')
  upload=[(build/'lib/libc++.so.1.0','libc++.so.1'),(build/'lib/libc++abi.so.1.0','libc++abi.so.1'),(gnu_lib,'libstdc++.so.6')]+[(exe,exe.name) for _,exe,_ in built]
  save(OUT/a.type/'board_uploads.json',[dict(local=str(src),remote=REMOTE+'/'+name,sha256=digest(src)) for src,name in upload])
  for src,name in upload:checked(a.type+'_upload_'+name,['timeout','45',*SDB,'push',src,REMOTE+'/'+name])
  out,_=remote_checked(a.type+'_board_hashes','sha256sum '+' '.join(REMOTE+'/'+name for _,name in upload))
  for src,name in upload:assert digest(src)+'  '+REMOTE+'/'+name in out
  remote_checked(a.type+'_board_chmod','chmod 755 '+' '.join(REMOTE+'/'+exe.name for _,exe,_ in built))
 for row,exe,tag in built:
  for repeat in range(1,6):
   if a.arch=='x86_64':rc,out,raw=native_run(tag+f'_run{repeat}',exe,row['library'])
   else:rc,out,raw=remote(tag+f'_run{repeat}',f'cd {REMOTE} && LD_LIBRARY_PATH={REMOTE} nice -n 19 ionice -c 3 ./{exe.name}')
   row['runs'].append(dict(repeat=repeat,exit=rc,raw=raw,result=clean_output(out)))
   save(OUT/a.type/(a.arch+('_'+a.only if a.only else '')+'_matrix.json'),rows)
   if rc:raise RuntimeError(f'运行失败（不是成功的差异结果）：{tag} exit={rc}')
  row['repeat_results_identical']=len({x['result'] for x in row['runs']})==1
 if a.arch=='armv7l':
  remote_checked(a.type+'_cleanup','rm -- '+' '.join(REMOTE+'/'+name for _,name in upload)+f' && rmdir {REMOTE} && test ! -e {REMOTE}')
  save(OUT/a.type/'board_cleanup.json',dict(directory=REMOTE,removed=[name for _,name in upload],absent=True,board_released=True))
 save(OUT/a.type/(a.arch+('_'+a.only if a.only else '')+'_matrix.json'),rows)
 save(OUT/a.type/(a.arch+'_timing.json'),dict(start_epoch=start,end_epoch=time.time(),elapsed_seconds=time.time()-start))

if __name__=='__main__':main()
