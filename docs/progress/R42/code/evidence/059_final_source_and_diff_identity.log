   331	#if defined(_LIBCXXABI_ARM_EHABI)
   332	/*
   333	The routine to be called before the cleanup.  This will save __cxa_exception in
   334	__cxa_eh_globals, so that __cxa_end_cleanup() can recover later.
   335	*/
   336	bool __cxa_begin_cleanup(void *unwind_arg) throw() {
   337	    _Unwind_Exception* unwind_exception = static_cast<_Unwind_Exception*>(unwind_arg);
   338	    __cxa_eh_globals* globals = __cxa_get_globals();
   339	    __cxa_exception* exception_header =
   340	        cxa_exception_from_exception_unwind_exception(unwind_exception);
   341	
   342	    R42_TRACE(
   343	            "R41_BEGIN_CLEANUP_ENTRY native=%d propagating=%p unwind=%p exception_header=%p\n",
   344	            static_cast<int>(__isOurExceptionClass(unwind_exception)),
   345	            static_cast<void*>(globals->propagatingExceptions),
   346	            static_cast<void*>(unwind_exception),
   347	            static_cast<void*>(exception_header));
   348	
   349	    if (__isOurExceptionClass(unwind_exception))
   350	    {
   351	        if (0 == exception_header->propagationCount)
   352	        {
   353	            exception_header->nextPropagatingException = globals->propagatingExceptions;
   354	            globals->propagatingExceptions = exception_header;
   355	        }
   356	        ++exception_header->propagationCount;
   357	    }
   358	    else
   359	    {
   360	        // If the propagatingExceptions stack is not empty, since we can't
   361	        // chain the foreign exception, terminate it.
   362	        if (NULL != globals->propagatingExceptions) {
   363	            R42_TRACE(
   364	                    "R41_BEGIN_CLEANUP_TERMINATE reason=foreign-stack-nonempty propagating=%p unwind=%p\n",
   365	                    static_cast<void*>(globals->propagatingExceptions),
   366	                    static_cast<void*>(unwind_exception));
   367	            std::terminate();
   368	        }
   369	        globals->propagatingExceptions = exception_header;
   370	    }
   371	    R42_TRACE(
   372	            "R41_BEGIN_CLEANUP_RETURN propagating=%p unwind=%p result=1\n",
   373	            static_cast<void*>(globals->propagatingExceptions),
   374	            static_cast<void*>(unwind_exception));
   375	    return true;
   376	}
   377	
   378	/*
   379	The routine to be called after the cleanup has been performed.  It will get the
   380	propagating __cxa_exception from __cxa_eh_globals, and continue the stack
   381	unwinding with _Unwind_Resume.
   382	
   383	According to ARM EHABI 8.4.1, __cxa_end_cleanup() should not clobber any
   384	register, thus we have to write this function in assembly so that we can save
   385	{r1, r2, r3}.  We don't have to save r0 because it is the return value and the
   386	first argument to _Unwind_Resume().  The function also saves/restores r4 to
   387	keep the stack aligned and to provide a temp register.  _Unwind_Resume never
   388	returns and we need to keep the original lr so just branch to it.  When
   389	targeting bare metal, the function also clobbers ip/r12 to hold the address of
   390	_Unwind_Resume, which may be too far away for an ordinary branch.
   391	*/
   392	__attribute__((used)) static _Unwind_Exception *
   393	__cxa_end_cleanup_impl()
   394	{
   395	    __cxa_eh_globals* globals = __cxa_get_globals();
   396	    __cxa_exception* exception_header = globals->propagatingExceptions;
   397	    R42_TRACE(
   398	        "R42_END_CLEANUP_ENTRY propagating=%p exception_header=%p\n",
   399	        static_cast<void*>(globals->propagatingExceptions),
   400	        static_cast<void*>(exception_header));
   401	    if (NULL == exception_header)
   402	    {
   403	        // It seems that __cxa_begin_cleanup() is not called properly.
   404	        // We have no choice but terminate the program now.
   405	        std::terminate();
   406	    }
   407	
   408	    if (__isOurExceptionClass(&exception_header->unwindHeader))
   409	    {
   410	        --exception_header->propagationCount;
   411	        if (0 == exception_header->propagationCount)
   412	        {
   413	            globals->propagatingExceptions = exception_header->nextPropagatingException;
   414	            exception_header->nextPropagatingException = NULL;
   415	        }
   416	    }
   417	    else
   418	    {
   419	        globals->propagatingExceptions = NULL;
   420	    }
   421	    R42_TRACE(
   422	        "R42_END_CLEANUP_RETURN propagating=%p unwind=%p\n",
   423	        static_cast<void*>(globals->propagatingExceptions),
   424	        static_cast<void*>(&exception_header->unwindHeader));
   425	    return &exception_header->unwindHeader;
   426	}
   427	
   428	asm("	.pushsection	.text.__cxa_end_cleanup,\"ax\",%progbits\n"
   429	    "	.globl	__cxa_end_cleanup\n"
   430	    "	.type	__cxa_end_cleanup,%function\n"
   475	  __cxa_exception block in front of the foreign exception.  It would be better
   476	  if the __cxa_eh_globals structure had a stack of _Unwind_Exception, but it
   477	  doesn't.  It has a stack of __cxa_exception (which has a next* in it).
   478	* Do not decrement the uncaught_exception count because we didn't increment it
   479	  in __cxa_throw (or one of our rethrow functions).
   480	* If we haven't terminated, assume the exception object is just past the
   481	  _Unwind_Exception and return a pointer to that.
   482	*/
   483	void*
   484	__cxa_begin_catch(void* unwind_arg) throw()
   485	{
   486	    _Unwind_Exception* unwind_exception = static_cast<_Unwind_Exception*>(unwind_arg);
   487	    bool native_exception = __isOurExceptionClass(unwind_exception);
   488	    __cxa_eh_globals* globals = __cxa_get_globals();
   489	    R42_TRACE(
   490	        "R42_BEGIN_CATCH_ENTRY native=%d caught=%p propagating=%p unwind=%p\n",
   491	        static_cast<int>(native_exception),
   492	        static_cast<void*>(globals->caughtExceptions),
   493	        static_cast<void*>(globals->propagatingExceptions), unwind_arg);
   494	    // exception_header is a hackish offset from a foreign exception, but it
   495	    //   works as long as we're careful not to try to access any __cxa_exception
   496	    //   parts.
   497	    __cxa_exception* exception_header =
   498	            cxa_exception_from_exception_unwind_exception
   499	            (
   500	                static_cast<_Unwind_Exception*>(unwind_exception)
   501	            );
   502	
   503	#if defined(__MVS__)
   504	    // Remove the exception object from the linked list of exceptions that the z/OS unwinder
   505	    // maintains before adding it to the libc++abi list of caught exceptions.
   506	    // The libc++abi will manage the lifetime of the exception from this point forward.
   507	    _UnwindZOS_PopException();
   508	#endif
   509	
   510	    if (native_exception)
   511	    {
   512	        // Increment the handler count, removing the flag about being rethrown
   513	        exception_header->handlerCount = exception_header->handlerCount < 0 ?
   514	            -exception_header->handlerCount + 1 : exception_header->handlerCount + 1;
   515	        //  place the exception on the top of the stack if it's not already
   516	        //    there by a previous rethrow
   517	        if (exception_header != globals->caughtExceptions)
   518	        {
   519	            exception_header->nextException = globals->caughtExceptions;
   520	            globals->caughtExceptions = exception_header;
   521	        }
   522	        globals->uncaughtExceptions -= 1;   // Not atomically, since globals are thread-local
   523	#if defined(_LIBCXXABI_ARM_EHABI)
   524	        return reinterpret_cast<void*>(exception_header->unwindHeader.barrier_cache.bitpattern[0]);
   525	#else
   526	        return exception_header->adjustedPtr;
   527	#endif
   528	    }
   529	    // Else this is a foreign exception
   530	    // If the caughtExceptions stack is not empty, terminate
   531	    if (globals->caughtExceptions != 0)
   532	        std::terminate();
   533	    // Push the foreign exception on to the stack
   534	    globals->caughtExceptions = exception_header;
   535	    R42_TRACE(
   536	        "R42_BEGIN_CATCH_FOREIGN_RETURN caught=%p propagating=%p unwind=%p\n",
   537	        static_cast<void*>(globals->caughtExceptions),
   538	        static_cast<void*>(globals->propagatingExceptions), unwind_arg);
   539	    return unwind_exception + 1;
   540	}
