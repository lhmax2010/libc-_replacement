   636	/*
   637	    There are 3 types of scans needed:
   638	
   639	    1.  Scan for handler with native or foreign exception.  If handler found,
   640	        save state and return _URC_HANDLER_FOUND, else return _URC_CONTINUE_UNWIND.
   641	        May also report an error on invalid input.
   642	        May terminate for invalid exception table.
   643	        _UA_SEARCH_PHASE
   644	
   645	    2.  Scan for handler with foreign exception.  Must return _URC_HANDLER_FOUND,
   646	        or call terminate.
   647	        _UA_CLEANUP_PHASE && _UA_HANDLER_FRAME && !native_exception
   648	
   649	    3.  Scan for cleanups.  If a handler is found and this isn't forced unwind,
   650	        then terminate, otherwise ignore the handler and keep looking for cleanup.
   651	        If a cleanup is found, return _URC_HANDLER_FOUND, else return _URC_CONTINUE_UNWIND.
   652	        May also report an error on invalid input.
   653	        May terminate for invalid exception table.
   654	        _UA_CLEANUP_PHASE && !_UA_HANDLER_FRAME
   655	*/
   656	
   657	static void scan_eh_tab(scan_results &results, _Unwind_Action actions,
   658	                        bool native_exception,
   659	                        _Unwind_Exception *unwind_exception,
   660	                        _Unwind_Context *context) {
   661	    // Initialize results to found nothing but an error
   662	    results.ttypeIndex = 0;
   663	    results.actionRecord = 0;
   664	    results.languageSpecificData = 0;
   665	    results.landingPad = 0;
   666	    results.adjustedPtr = 0;
   667	    results.isForcedUnwindHandler = false;
   668	    results.reason = _URC_FATAL_PHASE1_ERROR;
   669	    // Check for consistent actions
   670	    if (actions & _UA_SEARCH_PHASE)
   671	    {
   672	        // Do Phase 1
   673	        if (actions & (_UA_CLEANUP_PHASE | _UA_HANDLER_FRAME | _UA_FORCE_UNWIND))
   674	        {
   675	            // None of these flags should be set during Phase 1
   676	            //   Client error
   677	            results.reason = _URC_FATAL_PHASE1_ERROR;
   678	            return;
   679	        }
   680	    }
   681	    else if (actions & _UA_CLEANUP_PHASE)
   682	    {
   683	        if ((actions & _UA_HANDLER_FRAME) && (actions & _UA_FORCE_UNWIND))
   684	        {
   685	            // _UA_HANDLER_FRAME should only be set if phase 1 found a handler.
   686	            // If _UA_FORCE_UNWIND is set, phase 1 shouldn't have happened.
   687	            //    Client error
   688	            results.reason = _URC_FATAL_PHASE2_ERROR;
   689	            return;
   690	        }
   691	    }
   692	    else // Neither _UA_SEARCH_PHASE nor _UA_CLEANUP_PHASE is set
   693	    {
   694	        // One of these should be set.
   695	        //   Client error
   696	        results.reason = _URC_FATAL_PHASE1_ERROR;
   697	        return;
   698	    }
   699	    // Start scan by getting exception table address.
   700	    const uint8_t *lsda = (const uint8_t *)_Unwind_GetLanguageSpecificData(context);
   701	    if (lsda == 0)
   702	    {
   703	        // There is no exception table
   704	        results.reason = _URC_CONTINUE_UNWIND;
   705	        return;
   706	    }
   707	    results.languageSpecificData = lsda;
   708	#if defined(_AIX)
   709	    uintptr_t base = _Unwind_GetDataRelBase(context);
   710	#else
   711	    uintptr_t base = 0;
   712	#endif
   713	    // Get the current instruction pointer and offset it before next
   714	    // instruction in the current frame which threw the exception.
   715	    uintptr_t ip = _Unwind_GetIP(context) - 1;
   716	    // Get beginning current frame's code (as defined by the
   717	    // emitted dwarf code)
   718	    uintptr_t funcStart = _Unwind_GetRegionStart(context);
   719	#if defined(__USING_SJLJ_EXCEPTIONS__) || defined(__WASM_EXCEPTIONS__)
   720	    if (ip == uintptr_t(-1))
   721	    {
   722	        // no action
   723	        results.reason = _URC_CONTINUE_UNWIND;
   724	        return;
   725	    }
   726	    else if (ip == 0)
   727	        call_terminate(native_exception, unwind_exception);
   728	    // ip is 1-based index into call site table
   729	#else  // !__USING_SJLJ_EXCEPTIONS__ && !__WASM_EXCEPTIONS__
   730	    uintptr_t ipOffset = ip - funcStart;
   731	#endif // !__USING_SJLJ_EXCEPTIONS__ && !__WASM_EXCEPTIONS__
   732	    const uint8_t* classInfo = NULL;
   733	    // Note: See JITDwarfEmitter::EmitExceptionTable(...) for corresponding
   734	    //       dwarf emission
   735	    // Parse LSDA header.
   736	    uint8_t lpStartEncoding = *lsda++;
   737	    const uint8_t* lpStart = lpStartEncoding == DW_EH_PE_omit
   738	                                 ? (const uint8_t*)funcStart
   739	                                 : (const uint8_t*)readEncodedPointer(&lsda, lpStartEncoding, base);
   740	    uint8_t ttypeEncoding = *lsda++;
   741	    if (ttypeEncoding != DW_EH_PE_omit)
   742	    {
   743	        // Calculate type info locations in emitted dwarf code which
   744	        // were flagged by type info arguments to llvm.eh.selector
   745	        // intrinsic
   746	        uintptr_t classInfoOffset = readULEB128(&lsda);
   747	        classInfo = lsda + classInfoOffset;
   748	    }
   749	    // Walk call-site table looking for range that
   750	    // includes current PC.
   751	    uint8_t callSiteEncoding = *lsda++;
   752	#if defined(__USING_SJLJ_EXCEPTIONS__) || defined(__WASM_EXCEPTIONS__)
   753	    (void)callSiteEncoding;  // When using SjLj/Wasm exceptions, callSiteEncoding is never used
   754	#endif
   755	    uint32_t callSiteTableLength = static_cast<uint32_t>(readULEB128(&lsda));
   756	    const uint8_t* callSiteTableStart = lsda;
   757	    const uint8_t* callSiteTableEnd = callSiteTableStart + callSiteTableLength;
   758	    const uint8_t* actionTableStart = callSiteTableEnd;
   759	    const uint8_t* callSitePtr = callSiteTableStart;
   760	    while (callSitePtr < callSiteTableEnd)
   761	    {
   762	        // There is one entry per call site.
   763	#if !defined(__USING_SJLJ_EXCEPTIONS__) && !defined(__WASM_EXCEPTIONS__)
   764	        // The call sites are non-overlapping in [start, start+length)
   765	        // The call sites are ordered in increasing value of start
   766	        uintptr_t start = readEncodedPointer(&callSitePtr, callSiteEncoding);
   767	        uintptr_t length = readEncodedPointer(&callSitePtr, callSiteEncoding);
   768	        landing_pad_t landingPad = readEncodedPointer(&callSitePtr, callSiteEncoding);
   769	        uintptr_t actionEntry = readULEB128(&callSitePtr);
   770	        if ((start <= ipOffset) && (ipOffset < (start + length)))
   771	#else  // __USING_SJLJ_EXCEPTIONS__ || __WASM_EXCEPTIONS__
   772	        // ip is 1-based index into this table
   773	        landing_pad_t landingPad = readULEB128(&callSitePtr);
   774	        uintptr_t actionEntry = readULEB128(&callSitePtr);
   775	        if (--ip == 0)
   776	#endif // __USING_SJLJ_EXCEPTIONS__ || __WASM_EXCEPTIONS__
   777	        {
   778	            // Found the call site containing ip.
   779	#if !defined(__USING_SJLJ_EXCEPTIONS__) && !defined(__WASM_EXCEPTIONS__)
   780	            if (landingPad == 0)
   781	            {
   782	                // No handler here
   783	                results.reason = _URC_CONTINUE_UNWIND;
   784	                return;
   785	            }
   786	            landingPad = (uintptr_t)lpStart + landingPad;
   787	#else  // __USING_SJLJ_EXCEPTIONS__ || __WASM_EXCEPTIONS__
   788	            ++landingPad;
   789	#endif // __USING_SJLJ_EXCEPTIONS__ || __WASM_EXCEPTIONS__
   790	            results.landingPad = landingPad;
   791	            if (actionEntry == 0)
   792	            {
   793	                // Found a cleanup
   794	                results.reason = (actions & _UA_SEARCH_PHASE) ? _URC_CONTINUE_UNWIND : _URC_HANDLER_FOUND;
   795	                return;
   796	            }
   797	            // Convert 1-based byte offset into
   798	            const uint8_t* action = actionTableStart + (actionEntry - 1);
   799	            bool hasCleanup = false;
   800	            // Scan action entries until you find a matching handler, cleanup, or the end of action list
   801	            while (true)
   802	            {
   803	                const uint8_t* actionRecord = action;
   804	                int64_t ttypeIndex = readSLEB128(&action);
   805	                if (ttypeIndex > 0)
   806	                {
   807	                    // Found a catch, does it actually catch?
   808	                    // First check for catch (...)
   809	                    const __shim_type_info* catchType =
   810	                        get_shim_type_info(static_cast<uint64_t>(ttypeIndex),
   811	                                           classInfo, ttypeEncoding,
   812	                                           native_exception, unwind_exception,
   813	                                           base);
   814	                    if (catchType == 0)
   815	                    {
   816	                        // Found catch (...) catches everything, including
   817	                        // foreign exceptions. This is search phase, cleanup
   818	                        // phase with foreign exception, or forced unwinding.
   819	                        assert(actions & (_UA_SEARCH_PHASE | _UA_HANDLER_FRAME |
   820	                                          _UA_FORCE_UNWIND));
   821	                        results.ttypeIndex = ttypeIndex;
   822	                        results.actionRecord = actionRecord;
   823	                        results.adjustedPtr =
   824	                            get_thrown_object_ptr(unwind_exception);
   825	                        results.reason = _URC_HANDLER_FOUND;
   826	                        R42_TRACE(
   827	                                "R41_SCAN_MATCH kind=catch-all actions=0x%x native=%d ip=0x%lx landing=0x%lx ttype=%lld reason=%d unwind=%p\n",
   828	                                static_cast<unsigned>(actions),
   829	                                static_cast<int>(native_exception),
   830	                                static_cast<unsigned long>(ip),
   831	                                static_cast<unsigned long>(results.landingPad),
   832	                                static_cast<long long>(ttypeIndex),
   833	                                static_cast<int>(results.reason),
   834	                                static_cast<void*>(unwind_exception));
   835	                        return;
   836	                    }
   837	                    // Else this is a catch (T) clause and will never
   838	                    //    catch a foreign exception
   839	                    else if (!native_exception &&
   840	                             (actions & _UA_FORCE_UNWIND))
   841	                    {
   842	                        void* adjustedPtr =
   843	                            get_thrown_object_ptr(unwind_exception);
   844	                        const __shim_type_info* forcedType =
   845	                            static_cast<const __shim_type_info*>(
   846	                                &typeid(__cxxabiv1::__forced_unwind));
   847	                        if (catchType->can_catch(forcedType, adjustedPtr))
   848	                        {
   849	                            results.ttypeIndex = ttypeIndex;
   850	                            results.actionRecord = actionRecord;
   851	                            results.adjustedPtr = adjustedPtr;
   852	                            results.isForcedUnwindHandler = true;
   853	                            results.reason = _URC_HANDLER_FOUND;
   854	                            R42_TRACE(
   855	                                    "R41_SCAN_MATCH kind=forced-type actions=0x%x native=%d ip=0x%lx catch_type=%p forced_type=%p landing=0x%lx ttype=%lld reason=%d unwind=%p\n",
   856	                                    static_cast<unsigned>(actions),
   857	                                    static_cast<int>(native_exception),
   858	                                    static_cast<unsigned long>(ip),
   859	                                    static_cast<const void*>(catchType),
   860	                                    static_cast<const void*>(forcedType),
   861	                                    static_cast<unsigned long>(results.landingPad),
   862	                                    static_cast<long long>(ttypeIndex),
   863	                                    static_cast<int>(results.reason),
   864	                                    static_cast<void*>(unwind_exception));
   865	                            return;
   866	                        }
   867	                    }
   868	                    else if (native_exception)
   869	                    {
   870	                        __cxa_exception* exception_header = (__cxa_exception*)(unwind_exception+1) - 1;
  1215	    unwind_exception->barrier_cache.bitpattern[1] = (uint32_t)results.actionRecord;
  1216	    unwind_exception->barrier_cache.bitpattern[2] = (uint32_t)results.languageSpecificData;
  1217	    unwind_exception->barrier_cache.bitpattern[3] = (uint32_t)results.landingPad;
  1218	    unwind_exception->barrier_cache.bitpattern[4] = (uint32_t)results.ttypeIndex;
  1219	}
  1220	
  1221	static void load_results_from_barrier_cache(scan_results& results,
  1222	                                            const _Unwind_Exception* unwind_exception)
  1223	{
  1224	    results.adjustedPtr = (void*)unwind_exception->barrier_cache.bitpattern[0];
  1225	    results.actionRecord = (const uint8_t*)unwind_exception->barrier_cache.bitpattern[1];
  1226	    results.languageSpecificData = (const uint8_t*)unwind_exception->barrier_cache.bitpattern[2];
  1227	    results.landingPad = (uintptr_t)unwind_exception->barrier_cache.bitpattern[3];
  1228	    results.ttypeIndex = (int64_t)(int32_t)unwind_exception->barrier_cache.bitpattern[4];
  1229	    results.isForcedUnwindHandler = false;
  1230	}
  1231	
  1232	extern "C" _LIBCXXABI_FUNC_VIS _Unwind_Reason_Code
  1233	__gxx_personality_v0(_Unwind_State state,
  1234	                     _Unwind_Exception* unwind_exception,
  1235	                     _Unwind_Context* context)
  1236	{
  1237	    R42_TRACE(
  1238	            "R41_EHABI_ENTRY raw_state=0x%x unwind=%p context=%p\n",
  1239	            static_cast<unsigned>(state), static_cast<void*>(unwind_exception),
  1240	            static_cast<void*>(context));
  1241	    if (unwind_exception == 0 || context == 0)
  1242	        return _URC_FATAL_PHASE1_ERROR;
  1243	
  1244	    bool native_exception = __isOurExceptionClass(unwind_exception);
  1245	    _Unwind_State r40_raw_state = state;
  1246	
  1247	#if !defined(_LIBUNWIND_VERSION)
  1248	    // Copy the address of _Unwind_Control_Block to r12 so that
  1249	    // _Unwind_GetLanguageSpecificData() and _Unwind_GetRegionStart() can
  1250	    // return correct address.
  1251	    _Unwind_SetGR(context, REG_UCB, reinterpret_cast<uint32_t>(unwind_exception));
  1252	#endif
  1253	
  1254	    // Check the undocumented force unwinding behavior
  1255	    bool is_force_unwinding = state & _US_FORCE_UNWIND;
  1256	    state &= ~_US_FORCE_UNWIND;
  1257	
  1258	    scan_results results;
  1259	    switch (state) {
  1260	    case _US_VIRTUAL_UNWIND_FRAME:
  1261	        if (is_force_unwinding) {
  1262	            R42_TRACE(
  1263	                    "R41_EHABI_RETURN branch=virtual-force result=%d unwind=%p\n",
  1264	                    static_cast<int>(_URC_CONTINUE_UNWIND),
  1265	                    static_cast<void*>(unwind_exception));
  1266	            return continue_unwind(unwind_exception, context);
  1267	        }
  1268	
  1269	        // Phase 1 search:  All we're looking for in phase 1 is a handler that halts unwinding
  1270	        scan_eh_tab(results, _UA_SEARCH_PHASE, native_exception, unwind_exception, context);
  1271	        if (results.reason == _URC_HANDLER_FOUND)
  1272	        {
  1273	            unwind_exception->barrier_cache.sp = _Unwind_GetGR(context, REG_SP);
  1274	            if (native_exception)
  1275	                save_results_to_barrier_cache(unwind_exception, results);
  1276	            R42_TRACE(
  1277	                    "R41_EHABI_RETURN branch=virtual-handler result=%d unwind=%p\n",
  1278	                    static_cast<int>(_URC_HANDLER_FOUND),
  1279	                    static_cast<void*>(unwind_exception));
  1280	            return _URC_HANDLER_FOUND;
  1281	        }
  1282	        // Did not find the catch handler
  1283	        if (results.reason == _URC_CONTINUE_UNWIND) {
  1284	            R42_TRACE(
  1285	                    "R41_EHABI_RETURN branch=virtual-continue scan_reason=%d result=%d unwind=%p\n",
  1286	                    static_cast<int>(results.reason),
  1287	                    static_cast<int>(_URC_CONTINUE_UNWIND),
  1288	                    static_cast<void*>(unwind_exception));
  1289	            return continue_unwind(unwind_exception, context);
  1290	        }
  1291	        R42_TRACE(
  1292	                "R41_EHABI_RETURN branch=virtual-error result=%d unwind=%p\n",
  1293	                static_cast<int>(results.reason),
  1294	                static_cast<void*>(unwind_exception));
  1295	        return results.reason;
  1296	
  1297	    case _US_UNWIND_FRAME_STARTING:
  1298	        // TODO: Support force unwinding in the phase 2 search.
  1299	        // NOTE: In order to call the cleanup functions, _Unwind_ForcedUnwind()
  1300	        // will call this personality function with (_US_FORCE_UNWIND |
  1301	        // _US_UNWIND_FRAME_STARTING).
  1302	
  1303	        // R40 observation only: report the EHABI barrier decision inputs.
  1304	        R42_TRACE(
  1305	                "R40_EHABI_START raw_state=0x%x masked_state=0x%x force=%d native=%d barrier_sp=0x%lx current_sp=0x%lx unwind=%p\n",
  1306	                static_cast<unsigned>(r40_raw_state),
  1307	                static_cast<unsigned>(state),
  1308	                static_cast<int>(is_force_unwinding),
  1309	                static_cast<int>(native_exception),
  1310	                static_cast<unsigned long>(unwind_exception->barrier_cache.sp),
  1311	                static_cast<unsigned long>(_Unwind_GetGR(context, REG_SP)),
  1312	                static_cast<void*>(unwind_exception));
  1313	
  1314	        // Phase 2 search
  1315	        if (unwind_exception->barrier_cache.sp == _Unwind_GetGR(context, REG_SP))
  1316	        {
  1317	            // Found a catching handler in phase 1
  1318	            if (native_exception)
  1319	            {
  1320	                // Load the result from the native exception barrier cache.
