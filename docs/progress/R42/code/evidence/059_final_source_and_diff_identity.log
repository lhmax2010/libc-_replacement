   542	
   543	/*
   544	Upon exit for any reason, a handler must call:
   545	    void __cxa_end_catch ();
   546	
   547	This routine can be called for either a native or foreign exception.
   548	For a native exception:
   549	* Locates the most recently caught exception and decrements its handler count.
   550	* Removes the exception from the caught exception stack, if the handler count goes to zero.
   670	    __cxa_exception* exception_header = globals->caughtExceptions;
   671	    if (NULL == exception_header)
   672	        std::terminate();      // throw; called outside of a exception handler
   673	    bool native_exception = __isOurExceptionClass(&exception_header->unwindHeader);
   674	    if (native_exception)
   675	    {
   676	        //  Mark the exception as being rethrown (reverse the effects of __cxa_begin_catch)
   677	        exception_header->handlerCount = -exception_header->handlerCount;
   678	        globals->uncaughtExceptions += 1;
   679	        //  __cxa_end_catch will remove this exception from the caughtExceptions stack if necessary
   680	    }
   681	    else  // this is a foreign exception
   682	    {
   683	        // R40 observation only: report the unwinder's forced-unwind state at
   684	        // the exact point where a foreign exception is rethrown.  This does
   685	        // not mutate the exception object or select a different control path.
   686	#if defined(_LIBCXXABI_ARM_EHABI)
   687	        R42_TRACE(
   688	                "R40_RETHROW_STATE arch=armv7l reserved1=0x%lx reserved4=0x%lx unwind=%p\n",
   689	                static_cast<unsigned long>(exception_header->unwindHeader.unwinder_cache.reserved1),
   690	                static_cast<unsigned long>(exception_header->unwindHeader.unwinder_cache.reserved4),
   691	                static_cast<void*>(&exception_header->unwindHeader));
   692	#else
   693	        R42_TRACE(
   694	                "R40_RETHROW_STATE arch=x86_64 private_1=0x%lx private_2=0x%lx unwind=%p\n",
   695	                static_cast<unsigned long>(exception_header->unwindHeader.private_1),
   696	                static_cast<unsigned long>(exception_header->unwindHeader.private_2),
   697	                static_cast<void*>(&exception_header->unwindHeader));
   698	#endif
   699	        // The only way to communicate to __cxa_end_catch that we've rethrown
   700	        //   a foreign exception, so don't delete us, is to pop the stack here
   701	        //   which must be empty afterwards.  Then __cxa_end_catch will do
   702	        //   nothing
   703	        globals->caughtExceptions = 0;
   704	    }
   705	#ifdef __USING_SJLJ_EXCEPTIONS__
   706	    _Unwind_SjLj_RaiseException(&exception_header->unwindHeader);
   707	#else
   708	    if (native_exception)
   709	        _Unwind_RaiseException(&exception_header->unwindHeader);
   710	    else
   711	    {
   712	        _Unwind_Reason_Code r40_rethrow_result =
   713	            _Unwind_Resume_or_Rethrow(&exception_header->unwindHeader);
   714	        R42_TRACE(
   715	                "R40_RESUME_OR_RETHROW_RETURN reason=%d unwind=%p\n",
   716	                static_cast<int>(r40_rethrow_result),
   717	                static_cast<void*>(&exception_header->unwindHeader));
   718	        (void)r40_rethrow_result;
   719	    }
   720	#endif
