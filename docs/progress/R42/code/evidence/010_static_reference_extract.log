   701	    case _URC_CONTINUE_UNWIND:
   702	      /* Continue unwinding the next frame.  */
   703	      unwind_phase2 (ucbp, entry_vrs);
   704	
   705	    default:
   706	      abort ();
   707	    }
   708	}
