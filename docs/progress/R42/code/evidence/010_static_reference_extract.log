   667	  VRS_PC (entry_vrs) = UCB_SAVED_CALLSITE_ADDR (ucbp);
   668	
   669	  if (UCB_FORCED_STOP_FN (ucbp))
   670	    {
   671	      unwind_phase2_forced (ucbp, entry_vrs, 1);
