   325	#if defined(_LIBCXXABI_ARM_EHABI)
   326	/*
   327	The routine to be called before the cleanup.  This will save __cxa_exception in
   328	__cxa_eh_globals, so that __cxa_end_cleanup() can recover later.
   329	*/
   330	bool __cxa_begin_cleanup(void *unwind_arg) throw() {
   331	    _Unwind_Exception* unwind_exception = static_cast<_Unwind_Exception*>(unwind_arg);
   332	    __cxa_eh_globals* globals = __cxa_get_globals();
   333	    __cxa_exception* exception_header =
   334	        cxa_exception_from_exception_unwind_exception(unwind_exception);
   335	
   336	    if (__isOurExceptionClass(unwind_exception))
   337	    {
   338	        if (0 == exception_header->propagationCount)
   339	        {
   340	            exception_header->nextPropagatingException = globals->propagatingExceptions;
   341	            globals->propagatingExceptions = exception_header;
   342	        }
   343	        ++exception_header->propagationCount;
   344	    }
   345	    else
   346	    {
   347	        // If the propagatingExceptions stack is not empty, since we can't
   348	        // chain the foreign exception, terminate it.
   349	        if (NULL != globals->propagatingExceptions)
   350	            std::terminate();
   351	        globals->propagatingExceptions = exception_header;
   352	    }
   353	    return true;
   354	}
   355	
   356	/*
   357	The routine to be called after the cleanup has been performed.  It will get the
   358	propagating __cxa_exception from __cxa_eh_globals, and continue the stack
   359	unwinding with _Unwind_Resume.
   360	
   361	According to ARM EHABI 8.4.1, __cxa_end_cleanup() should not clobber any
   362	register, thus we have to write this function in assembly so that we can save
   363	{r1, r2, r3}.  We don't have to save r0 because it is the return value and the
   364	first argument to _Unwind_Resume().  The function also saves/restores r4 to
   365	keep the stack aligned and to provide a temp register.  _Unwind_Resume never
   366	returns and we need to keep the original lr so just branch to it.  When
   367	targeting bare metal, the function also clobbers ip/r12 to hold the address of
   368	_Unwind_Resume, which may be too far away for an ordinary branch.
   369	*/
   370	__attribute__((used)) static _Unwind_Exception *
   371	__cxa_end_cleanup_impl()
   372	{
   373	    __cxa_eh_globals* globals = __cxa_get_globals();
   374	    __cxa_exception* exception_header = globals->propagatingExceptions;
   375	    if (NULL == exception_header)
   376	    {
   377	        // It seems that __cxa_begin_cleanup() is not called properly.
   378	        // We have no choice but terminate the program now.
   379	        std::terminate();
   380	    }
   381	
   382	    if (__isOurExceptionClass(&exception_header->unwindHeader))
   383	    {
   384	        --exception_header->propagationCount;
   385	        if (0 == exception_header->propagationCount)
   386	        {
   387	            globals->propagatingExceptions = exception_header->nextPropagatingException;
   388	            exception_header->nextPropagatingException = NULL;
   389	        }
   390	    }
   391	    else
   392	    {
   393	        globals->propagatingExceptions = NULL;
   394	    }
   395	    return &exception_header->unwindHeader;
   396	}
   397	
   398	asm("	.pushsection	.text.__cxa_end_cleanup,\"ax\",%progbits\n"
   399	    "	.globl	__cxa_end_cleanup\n"
   400	    "	.type	__cxa_end_cleanup,%function\n"
   401	    "__cxa_end_cleanup:\n"
   402	#if defined(__ARM_FEATURE_BTI_DEFAULT)
   403	    "	bti\n"
   404	#endif
   405	    "	push	{r1, r2, r3, r4}\n"
   406	    "	mov	r4, lr\n"
   407	    "	bl	__cxa_end_cleanup_impl\n"
   408	    "	mov	lr, r4\n"
   409	#if defined(LIBCXXABI_BAREMETAL)
   410	    "	ldr	r4,	=_Unwind_Resume\n"
   411	    "	mov	ip,	r4\n"
   412	#endif
   413	    "	pop	{r1, r2, r3, r4}\n"
   414	#if defined(LIBCXXABI_BAREMETAL)
   415	    "	bx	ip\n"
   416	#else
   417	    "	b	_Unwind_Resume\n"
   418	#endif
   419	    "	.popsection");
   420	#endif // defined(_LIBCXXABI_ARM_EHABI)
