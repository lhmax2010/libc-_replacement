commit e79f1c3dde12c356142b77231e304c0da67adaf1
Author:     lhmax2025 <hao.lin@samsung.com>
AuthorDate: Tue Sep 1 16:15:34 2026 +0900
Commit:     Dongkyun Son <dongkyun.s@samsung.com>
CommitDate: Tue Sep 1 16:34:57 2026 +0900

    libcxx: backport EH ABI forced-unwind handling
    
    Squash the changes from sandbox/lhmax2025/libcxx-ehabi-backport:
    
    - packaging: add libc++ runtimes spec
    - libc++abi: preserve foreign forced-unwind state
    - libc++abi: expose GNU forced-unwind marker type
    - libcxx: preserve forced unwind in consumer-instantiated handlers
    - libcxx: preserve forced unwind in library-delivered handlers
    
    Change-Id: I0dfaf3ae6c88db033f1aff9167d64ffa211cdf2e
    Signed-off-by: Dongkyun Son <dongkyun.s@samsung.com>

diff --git a/libcxx/include/__ostream/basic_ostream.h b/libcxx/include/__ostream/basic_ostream.h
index 62770be72f98..67b9586cbc7c 100644
--- a/libcxx/include/__ostream/basic_ostream.h
+++ b/libcxx/include/__ostream/basic_ostream.h
@@ -13,6 +13,7 @@
 
 #if _LIBCPP_HAS_LOCALIZATION
 
+#  include <cxxabi.h>
 #  include <__exception/operations.h>
 #  include <__fwd/memory.h>
 #  include <__iterator/ostreambuf_iterator.h>
@@ -214,6 +215,8 @@ basic_ostream<_CharT, _Traits>::sentry::~sentry() {
       if (__os_.rdbuf()->pubsync() == -1)
         __os_.setstate(ios_base::badbit);
 #  if _LIBCPP_HAS_EXCEPTIONS
+    } catch (const __cxxabiv1::__forced_unwind&) {
+      throw;
     } catch (...) {
     }
 #  endif // _LIBCPP_HAS_EXCEPTIONS
