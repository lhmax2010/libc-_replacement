     2	import argparse
     3	import hashlib
     4	from pathlib import Path
     5	
     6	
     7	def digest(path: Path) -> str:
     8	    return hashlib.sha256(path.read_bytes()).hexdigest()
     9	
    10	
    11	def main() -> int:
    12	    parser = argparse.ArgumentParser()
    13	    parser.add_argument("--header", required=True, type=Path)
    14	    parser.add_argument("--source", required=True, type=Path)
    15	    parser.add_argument("--output", required=True, type=Path)
    16	    args = parser.parse_args()
    17	    target_header = args.output / "include/__condition_variable/condition_variable.h"
    18	    target_source = args.output / "condition_variable_removed.cpp"
    19	    target_header.parent.mkdir(parents=True, exist_ok=True)
    20	    header = args.header.read_text()
    21	    source = args.source.read_text()
    22	    header_replacements = 0
    23	    source_replacements = 0
    24	    for old, new in (
    25	        ("void wait(unique_lock<mutex>& __lk) _NOEXCEPT;", "void wait(unique_lock<mutex>& __lk);"),
    26	        (
    27	            "__do_timed_wait(unique_lock<mutex>& __lk, chrono::time_point<chrono::system_clock, chrono::nanoseconds>) _NOEXCEPT;",
    28	            "__do_timed_wait(unique_lock<mutex>& __lk, chrono::time_point<chrono::system_clock, chrono::nanoseconds>);",
    29	        ),
    30	        (
    31	            "__do_timed_wait(unique_lock<mutex>& __lk, chrono::time_point<chrono::steady_clock, chrono::nanoseconds>) _NOEXCEPT;",
    32	            "__do_timed_wait(unique_lock<mutex>& __lk, chrono::time_point<chrono::steady_clock, chrono::nanoseconds>);",
    33	        ),
    34	        (
    35	            "__do_timed_wait(unique_lock<mutex>& __lk, chrono::time_point<_Clock, chrono::nanoseconds>) _NOEXCEPT;",
    36	            "__do_timed_wait(unique_lock<mutex>& __lk, chrono::time_point<_Clock, chrono::nanoseconds>);",
    37	        ),
    38	        (
    39	            "chrono::time_point<chrono::steady_clock, chrono::nanoseconds> __tp) _NOEXCEPT {",
    40	            "chrono::time_point<chrono::steady_clock, chrono::nanoseconds> __tp) {",
    41	        ),
    42	        (
    43	            "chrono::time_point<_Clock, chrono::nanoseconds> __tp) _NOEXCEPT {",
    44	            "chrono::time_point<_Clock, chrono::nanoseconds> __tp) {",
    45	        ),
    46	    ):
    47	        count = header.count(old)
    48	        header_replacements += count
    49	        header = header.replace(old, new)
    50	    for old, new in (
    51	        (
    52	            "void condition_variable::wait(unique_lock<mutex>& lk) noexcept {",
    53	            "void condition_variable::wait(unique_lock<mutex>& lk) {",
    54	        ),
    55	        (
    56	            "chrono::time_point<chrono::system_clock, chrono::nanoseconds> tp) noexcept {",
    57	            "chrono::time_point<chrono::system_clock, chrono::nanoseconds> tp) {",
    58	        ),
    59	    ):
    60	        count = source.count(old)
    61	        source_replacements += count
    62	        source = source.replace(old, new)
    63	    if header_replacements != 6 or source_replacements != 2:
    64	        raise SystemExit(f"unexpected replacement counts: header={header_replacements} source={source_replacements}")
    65	    target_header.write_text(header)
    66	    target_source.write_text(source)
    67	    print(f"header_replacements={header_replacements}")
    68	    print(f"source_replacements={source_replacements}")
    69	    print(f"input_header_sha256={digest(args.header)}")
    70	    print(f"output_header_sha256={digest(target_header)}")
    71	    print(f"input_source_sha256={digest(args.source)}")
    72	    print(f"output_source_sha256={digest(target_source)}")
    73	    return 0
