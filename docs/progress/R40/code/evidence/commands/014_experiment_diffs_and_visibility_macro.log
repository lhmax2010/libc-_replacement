== visibility diff ==
--- baseline/libcxxabi/include/cxxabi.h
+++ visibility/libcxxabi/include/cxxabi.h
@@ -37,8 +37,9 @@
 // runtime routines use C calling conventions, but are in __cxxabiv1 namespace
 namespace __cxxabiv1 {
 
-// R33 experiment only: a type token used to match forced unwinding.
-class _LIBCXXABI_TYPE_VIS __forced_unwind {};
+// R40 visibility-only experiment: spell out default visibility without
+// introducing a key function or changing the class layout.
+class __attribute__((visibility("default"))) __forced_unwind {};
 
 struct __cxa_exception;
 
