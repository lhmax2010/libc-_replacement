PWD=/home/toolchain/development/libc++_replacement
COMMAND= bash -lc $'\nset -euo pipefail\nmkdir -p progress/R40/patches\nfor variant in diagnostic strong visibility; do\n  : > "progress/R40/patches/${variant}.diff"\n  for rel in libcxxabi/include/cxxabi.h libcxxabi/src/cxa_exception.cpp libcxxabi/src/cxa_personality.cpp; do\n    diff -u --label "baseline/$rel" --label "$variant/$rel" "tmp/R34B/llvm-exp/$rel" "tmp/R40/source-$variant/$rel" >> "progress/R40/patches/${variant}.diff" || rc=$?\n    if [ "${rc:-0}" -gt 1 ]; then exit "$rc"; fi\n    rc=0\n  done\n  printf "== %s diff ==\\n" "$variant"\n  sed -n "1,260p" "progress/R40/patches/${variant}.diff"\n  sha256sum "progress/R40/patches/${variant}.diff"\ndone\nprintf "== _LIBCXXABI_TYPE_VIS definitions ==\\n"\nrg -n "define _LIBCXXABI_TYPE_VIS|_LIBCXXABI_TYPE_VIS" tmp/R34B/llvm-exp/libcxxabi/include tmp/R34B/llvm-exp/libcxx/include/__configuration/abi.h | head -120\n'
== diagnostic diff ==
--- baseline/libcxxabi/src/cxa_exception.cpp
+++ diagnostic/libcxxabi/src/cxa_exception.cpp
@@ -13,6 +13,7 @@
 #include "cxxabi.h"
 
 #include <exception>        // for std::terminate
+#include <stdio.h>          // R40 observation-only state logging
 #include <string.h>         // for memset
 #include "cxa_exception.h"
 #include "cxa_handlers.h"
@@ -639,6 +640,22 @@
     }
     else  // this is a foreign exception
     {
+        // R40 observation only: report the unwinder's forced-unwind state at
+        // the exact point where a foreign exception is rethrown.  This does
+        // not mutate the exception object or select a different control path.
+#if defined(_LIBCXXABI_ARM_EHABI)
+        fprintf(stderr,
+                "R40_RETHROW_STATE arch=armv7l reserved1=0x%lx reserved4=0x%lx unwind=%p\n",
+                static_cast<unsigned long>(exception_header->unwindHeader.unwinder_cache.reserved1),
+                static_cast<unsigned long>(exception_header->unwindHeader.unwinder_cache.reserved4),
+                static_cast<void*>(&exception_header->unwindHeader));
+#else
+        fprintf(stderr,
+                "R40_RETHROW_STATE arch=x86_64 private_1=0x%lx private_2=0x%lx unwind=%p\n",
+                static_cast<unsigned long>(exception_header->unwindHeader.private_1),
+                static_cast<unsigned long>(exception_header->unwindHeader.private_2),
+                static_cast<void*>(&exception_header->unwindHeader));
+#endif
         // The only way to communicate to __cxa_end_catch that we've rethrown
         //   a foreign exception, so don't delete us, is to pop the stack here
         //   which must be empty afterwards.  Then __cxa_end_catch will do
