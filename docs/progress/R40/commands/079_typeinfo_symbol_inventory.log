PWD=/home/toolchain/development/libc++_replacement
COMMAND= bash -lc $'\nset -u\nw=/home/toolchain/development/libc++_replacement\nfor variant in strong visibility; do\n  for arch in x86_64 armv7l; do\n    if [ "$arch" = x86_64 ]; then abi="$w/tmp/R40/runtime/$variant/x86_64/libc++abi.so.1.0"; else abi="$w/tmp/R40/build-$variant-armv7l/lib/libc++abi.so.1.0"; fi\n    probe="$w/tmp/R40/probes/$variant/$arch/s1_libcxx"\n    printf "OBJECT variant=%s arch=%s kind=libcxxabi path=%s\\n" "$variant" "$arch" "$abi"\n    file "$abi"\n    printf "DYNSYM\\n"; readelf --dyn-syms -W "$abi" | grep -E "_ZTI.*__forced_unwind|_ZTS.*__forced_unwind|Num:" || true\n    printf "SYMTAB\\n"; readelf --syms -W "$abi" | grep -E "_ZTI.*__forced_unwind|_ZTS.*__forced_unwind|Num:" || true\n    printf "OBJECT variant=%s arch=%s kind=probe path=%s\\n" "$variant" "$arch" "$probe"\n    file "$probe"\n    printf "DYNSYM\\n"; readelf --dyn-syms -W "$probe" | grep -E "_ZTI.*__forced_unwind|_ZTS.*__forced_unwind|Num:" || true\n    printf "SYMTAB\\n"; readelf --syms -W "$probe" | grep -E "_ZTI.*__forced_unwind|_ZTS.*__forced_unwind|Num:" || true\n    sha256sum "$abi" "$probe"\n  done\ndone\n'
