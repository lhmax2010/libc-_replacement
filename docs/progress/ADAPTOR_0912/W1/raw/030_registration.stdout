    25	
    26	// this variable is valid only during Extension::XW_Initialize() call
    27	// do not use !!!
    28	// it's here, so we don't have to modify the interface of CreateExtension(), Extension(), etc.
    29	XW_Extension g_xw_extension_ = 0;
    30	
    31	const XW_CoreInterface* g_core = NULL;
    32	const XW_MessagingInterface* g_messaging = NULL;
    33	const XW_Internal_SyncMessagingInterface* g_sync_messaging = NULL;
    34	const XW_Internal_EntryPointsInterface* g_entry_points = NULL;
    35	const XW_Internal_RuntimeInterface* g_runtime = NULL;
    36	const XW_Internal_PermissionsInterface* g_permission = NULL;
    37	
    38	bool InitializeInterfaces(XW_GetInterface get_interface) {
    39	  ScopeLogger();
    40	  static bool initialized = false;
    41	
    42	  if (!initialized) {
    43	    g_core = reinterpret_cast<const XW_CoreInterface*>(get_interface(XW_CORE_INTERFACE));
    44	    if (!g_core) {
    45	      LoggerE("Can't initialize extension: error getting Core interface.");
    46	      return false;
    47	    }
    48	
    49	    g_messaging =
    50	        reinterpret_cast<const XW_MessagingInterface*>(get_interface(XW_MESSAGING_INTERFACE));
    51	    if (!g_messaging) {
    52	      LoggerE("Can't initialize extension: error getting Messaging interface.");
    53	      return false;
    54	    }
    55	
    56	    g_sync_messaging = reinterpret_cast<const XW_Internal_SyncMessagingInterface*>(
    57	        get_interface(XW_INTERNAL_SYNC_MESSAGING_INTERFACE));
    58	    if (!g_sync_messaging) {
    59	      LoggerE("Can't initialize extension: error getting SyncMessaging interface.");
    60	      return false;
    61	    }
    62	
    63	    g_entry_points = reinterpret_cast<const XW_Internal_EntryPointsInterface*>(
    64	        get_interface(XW_INTERNAL_ENTRY_POINTS_INTERFACE));
    65	    if (!g_entry_points) {
    66	      LoggerE(
    67	          "NOTE: Entry points interface not available in this version "
    68	          "of runtime, ignoring entry point data for extensions.");
    69	    }
    70	
    71	    g_runtime = reinterpret_cast<const XW_Internal_RuntimeInterface*>(
    72	        get_interface(XW_INTERNAL_RUNTIME_INTERFACE));
    73	    if (!g_runtime) {
    74	      LoggerE(
    75	          "NOTE: runtime interface not available in this version "
    76	          "of runtime, ignoring runtime variables for extensions.");
    77	    }
    78	
    79	    g_permission = reinterpret_cast<const XW_Internal_PermissionsInterface*>(
    80	        get_interface(XW_INTERNAL_PERMISSIONS_INTERFACE));
    81	    if (!g_permission) {
    82	      LoggerE(
    83	          "NOTE: permission interface not available in this version "
    84	          "of runtime, ignoring permission for extensions.");
    85	    }
    86	
    87	    initialized = true;
    88	  }
    89	
    90	  return true;
    91	}
    92	
    93	}  // namespace
    94	
    95	namespace common {
    96	
    97	Extension::Extension() : xw_extension_(g_xw_extension_) {
    98	  ScopeLogger();
    99	}
   100	
   101	Extension::~Extension() {
   102	  ScopeLogger();
   103	}
   104	
   105	void Extension::SetExtensionName(const char* name) {
   210	  Instance* instance = reinterpret_cast<Instance*>(g_core->GetInstanceData(xw_instance));
   211	  if (!instance) return;
   212	  instance->HandleSyncMessage(msg);
   213	}
   214	
   215	// static
   216	int32_t Extension::XW_Initialize(XW_Extension extension, XW_GetInterface get_interface,
   217	                                 XW_Initialize_Func initialize,
   218	                                 XW_CreatedInstanceCallback created_instance,
   219	                                 XW_ShutdownCallback shutdown) {
   220	  ScopeLogger();
   221	  Assert(extension);
   222	
   223	  if (!InitializeInterfaces(get_interface)) {
   224	    return XW_ERROR;
   225	  }
   226	
   227	  g_xw_extension_ = extension;
   228	
   229	  if (XW_ERROR == initialize(extension, get_interface)) {
   230	    return XW_ERROR;
   231	  }
   232	
   233	  g_xw_extension_ = 0;
   234	
   235	  using common::Extension;
   236	  g_core->RegisterShutdownCallback(extension, shutdown);
   237	  g_core->RegisterInstanceCallbacks(extension, created_instance, Extension::OnInstanceDestroyed);
   238	  g_messaging->Register(extension, Extension::HandleMessage);
   239	  g_sync_messaging->Register(extension, Extension::HandleSyncMessage);
   240	
   241	  g_messaging->RegisterBinaryMesssageCallback(extension, Extension::HandleBinaryMessage);
   242	  return XW_OK;
   243	}
   244	
   245	std::mutex Instance::instances_mutex_;
   246	std::unordered_set<Instance*> Instance::all_instances_;
   247	
   248	Instance::Instance() : xw_instance_(0) {
   249	  ScopeLogger();
   250	  {
   251	    std::lock_guard<std::mutex> lock{instances_mutex_};
   252	    all_instances_.insert(this);
   253	  }
   254	}
   255	
   256	Instance::~Instance() {
   257	  ScopeLogger();
   258	  {
   259	    std::lock_guard<std::mutex> lock{instances_mutex_};
   260	    all_instances_.erase(this);
   305	}
   306	
   307	void Instance::PostMessage(const char* msg) {
   308	  ScopeLogger();
   309	  if (!xw_instance_) {
   310	    LoggerE(
   311	        "Ignoring PostMessage() in the constructor or after the "
   312	        "instance was destroyed.");
   313	    return;
   314	  }
   315	  g_messaging->PostMessage(xw_instance_, msg);
   316	}
   317	
   318	void Instance::PostMessage(const char* msg, size_t size) {
   319	  ScopeLogger();
   320	  if (!xw_instance_) {
   321	    LoggerE(
   322	        "Ignoring PostMessage() in the constructor or after the "
   323	        "instance was destroyed.");
   324	    return;
   325	  }
   326	  g_messaging->PostBinaryMessage(xw_instance_, msg, size);
   327	}
   328	
   329	void Instance::SendSyncReply(const char* reply) {
   330	  ScopeLogger();
   331	  if (!xw_instance_) {
   332	    LoggerE(
   333	        "Ignoring SendSyncReply() in the constructor or after the "
   334	        "instance was destroyed.");
   335	    return;
   336	  }
   337	  g_sync_messaging->SetSyncReply(xw_instance_, reply);
   338	}
   339	
   340	void Instance::SendSyncBinaryReply(const std::vector<uint8_t>& reply) {
   341	  ScopeLogger();
   342	  if (!xw_instance_) {
   343	    LoggerE(
   344	        "Ignoring SendSyncBinaryReply() in the constructor or after the "
   345	        "instance was destroyed.");
   346	    return;
   347	  }
   348	  g_sync_messaging->SetSyncBinaryReply(xw_instance_, reply);
   349	}
