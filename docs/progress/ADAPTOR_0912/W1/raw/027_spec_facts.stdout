import("//mojo/public/tools/bindings/mojom.gni")

declare_args() {
  xwalk_extension_path = ""
  xwalk_extension_service_path = ""
}

config("xwalk_extension_config") {
  defines = [
    "XWALK_EXTENSION_PATH=\"$xwalk_extension_path\"",
    "XWALK_EXTENSION_SERVICE_PATH=\"$xwalk_extension_service_path\"",
  ]
}

config("xwalk_extension_service_config") {
  ldflags = [
    "-Wl,-rpath=$xwalk_extension_path",
  ]
}

mojom("mojo_bindings") {
  cpp_only = true
  sources = [
    "common/xwalk_extension.mojom",
  ]
  public_deps = [
    "//mojo/public/mojom/base",
  ]
}

template("xwalk_extension_library") {
  assert(defined(invoker.native_files), "Need native_files arguments")
  assert(defined(invoker.js_file), "Need js_file argumets")
  assert(defined(invoker.json_file), "Need json_file argumets")

  target_copy = target_name + "_copy"
  target_gen = target_name + "_gen"
  target_dir = "$target_gen_dir/$target_name/"

  copy(target_copy) {
    sources = [ invoker.json_file ]
    outputs = [
      "$target_dir/{{source_file_part}}",
    ]
  }

  action(target_gen) {
    inputs = [ invoker.js_file ]

    name_part = get_path_info(invoker.js_file, "name")
    outputs = [ "$target_dir/$name_part.h" ]

    script = "tools/generate_api.py"
    args = [
      rebase_path(invoker.js_file),
      "kSource_$name_part",
      rebase_path(outputs[0]),
    ]
  }

  shared_library(target_name) {
    sources = invoker.native_files + get_target_outputs(":$target_gen")
    configs += [
      "//tizen_src/build/config:dlog",
    ]
    configs += invoker.additional_config
    deps = [
      ":$target_copy",
      ":$target_gen",
    ]
    include_dirs = [
      "$target_dir",
      "public",
    ]
  }
}

xwalk_extension_library("splash_screen_plugin") {
  native_files = [ "internal/splash_screen/splash_screen_extension.cc" ]
  js_file = "internal/splash_screen/splash_screen_api.js"
  json_file = "internal/splash_screen/splash_screen.json"
  additional_config = []
}

xwalk_extension_library("widget_plugin") {
  native_files = [ "internal/widget/widget_extension.cc" ]
  js_file = "internal/widget/widget_api.js"
  json_file = "internal/widget/widget.json"
  additional_config = []
}

if (enable_wrt_js) {
  xwalk_extension_library("wrtservice_plugin") {
    native_files = [ "internal/wrtservice/wrtservice_extension.cc" ]
    js_file = "internal/wrtservice/wrtservice_api.js"
    json_file = "internal/wrtservice/wrtservice.json"
    additional_config = [
      "//tizen_src/build/config:aul",
      "//tizen_src/build/config:capi-media-camera",
      "//tizen_src/build/config:capi-system-info",
      "//tizen_src/build/config:jsoncpp",
      "//tizen_src/build/config:notification",
      "//tizen_src/build/config:pkgmgr-info",
      "//tizen_src/build/config:vconf",
    ]
  }
}

source_set("xwalk_extension") {
  configs += [
    "//tizen_src/chromium_impl/components/xwalk_extensions:xwalk_extension_config",
    "//tizen_src/build/config:jsoncpp",
  ]
  defines = [ "INSIDE_BLINK" ]
  deps = [
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
  ]
}
