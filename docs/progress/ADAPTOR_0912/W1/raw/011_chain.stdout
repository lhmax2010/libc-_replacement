   225	void XWalkExtension::Instance::Destroy() {
   226	  base::AutoLock lock(instance_lock);
   227	  auto callback = extension_->destroyed_instance_callback_;
   228	  if (callback)
   229	    callback(xw_instance_);
   230	
   231	  auto* extension_manager = XWalkExtensionManager::GetInstance();
   232	  extension_manager->UnregisterInstance(this);
   233	}
   234	
   235	// postMessage(message: string): void
   236	void XWalkExtension::Instance::PostMessage(const std::string& message) {
   237	  XW_HandleMessageCallback callback = extension_->handle_msg_callback_;
   238	  if (callback)
   239	    callback(xw_instance_, message.c_str());
   240	}
   241	
   242	// sendSyncMessage(message: string): string
   243	std::string XWalkExtension::Instance::SendSyncMessageWithStringReply(
   244	    const std::string& message) {
   245	#if BUILDFLAG(IS_TIZEN_TV)
   246	  LOG(INFO) << "[WebAPI] message:" << message;
   247	#endif
   248	  XW_HandleSyncMessageCallback callback =
   249	      extension_->handle_sync_msg_callback_;
   250	  if (!callback)
   251	    return std::string();
   252	
   253	  callback(xw_instance_, message.c_str());
   254	  return std::move(sync_reply_);
   255	}
   256	
   257	// sendSyncMessage(message: string): Uint8Array
   258	std::vector<uint8_t> XWalkExtension::Instance::SendSyncMessageWithBinaryReply(
   259	    const std::string& message) {
   260	#if BUILDFLAG(IS_TIZEN_TV)
   261	  LOG(INFO) << "[WebAPI] message:" << message;
   262	#endif
   263	  XW_HandleSyncMessageCallback callback =
   264	      extension_->handle_sync_msg_callback_;
   265	  if (!callback)
   266	    return std::vector<uint8_t>{};
   267	
   268	  callback(xw_instance_, message.c_str());
   269	  return std::move(sync_binary_reply_);
   270	}
   271	
