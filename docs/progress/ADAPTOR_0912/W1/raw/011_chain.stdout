    33	 public:
    34	  static XWalkExtension* GetExtension(XW_Extension xw_extension) {
    35	    const auto& map = XWalkExtensionManager::GetInstance()->GetExtensions();
    36	    for (const auto& iter : map) {
    37	      if (iter.second->xw_extension_ == xw_extension)
    38	        return iter.second.get();
    39	    }
    40	    LOG(WARNING) << "Ignoring call. Invalid extension = " << xw_extension;
    41	    return nullptr;
    42	  }
    43	
    44	  static Instance* GetExtensionInstance(XW_Instance xw_instance) {
    45	    auto* extension_manager = XWalkExtensionManager::GetInstance();
    46	    auto* instance = extension_manager->GetExtensionInstance(xw_instance);
    47	    if (!instance)
    48	      LOG(WARNING) << "Ignoring call. Invalid instance = " << xw_instance;
    49	    return instance;
    50	  }
    51	
    52	  static void CoreSetExtensionName(
    53	      XW_Extension xw_extension, const char* name) {
    54	    XWalkExtension* extension = GetExtension(xw_extension);
    55	    if (extension)
    56	      extension->name_ = name;
    57	  }
    58	
    59	  static void CoreSetJavaScriptAPI(
    60	      XW_Extension xw_extension, const char* javascript_api) {
    61	    XWalkExtension* extension = GetExtension(xw_extension);
    62	    if (extension)
    63	      extension->javascript_api_ = javascript_api;
    64	  }
    65	
    66	  static void CoreRegisterInstanceCallbacks(
    67	      XW_Extension xw_extension, XW_CreatedInstanceCallback created,
    68	      XW_DestroyedInstanceCallback destroyed) {
    69	    XWalkExtension* extension = GetExtension(xw_extension);
    70	    if (!extension)
    71	      return;
    72	    extension->created_instance_callback_ = created;
    73	    extension->destroyed_instance_callback_ = destroyed;
    74	  }
    75	
    76	  static void CoreRegisterShutdownCallback(
    77	      XW_Extension xw_extension, XW_ShutdownCallback shutdown) {
    78	    XWalkExtension* extension = GetExtension(xw_extension);
    79	    if (extension)
    80	      extension->shutdown_callback_ = shutdown;
    81	  }
    82	
    83	  static void CoreSetInstanceData(XW_Instance xw_instance, void* data) {
    84	    auto* instance = GetExtensionInstance(xw_instance);
    85	    if (instance)
    86	      instance->SetInstanceData(data);
    87	  }
    88	
    89	  static void* CoreGetInstanceData(XW_Instance xw_instance) {
    90	    auto* instance = GetExtensionInstance(xw_instance);
    91	    return instance ? instance->GetInstanceData() : nullptr;
    92	  }
    93	
    94	  static void MessagingRegister(
    95	      XW_Extension xw_extension, XW_HandleMessageCallback handle_message) {
    96	    XWalkExtension* extension = GetExtension(xw_extension);
    97	    if (extension)
    98	      extension->handle_msg_callback_ = handle_message;
    99	  }
   100	
