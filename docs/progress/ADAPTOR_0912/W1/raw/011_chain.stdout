   365	// static
   366	const void* XWalkExtension::GetInterface(const char* name) {
   367	  std::string interface_name(name);
   368	  if (interface_name == XW_CORE_INTERFACE_1) {
   369	    static const XW_CoreInterface_1 coreInterface1 = {
   370	      Interface::CoreSetExtensionName,
   371	      Interface::CoreSetJavaScriptAPI,
   372	      Interface::CoreRegisterInstanceCallbacks,
   373	      Interface::CoreRegisterShutdownCallback,
   374	      Interface::CoreSetInstanceData,
   375	      Interface::CoreGetInstanceData
   376	    };
   377	    return &coreInterface1;
   378	  }
   379	
   380	  if (interface_name == XW_MESSAGING_INTERFACE_1) {
   381	    static const XW_MessagingInterface_1 messagingInterface1 = {
   382	      Interface::MessagingRegister,
   383	      Interface::MessagingPostMessage
   384	    };
   385	    return &messagingInterface1;
   386	  }
   387	
   388	  if (interface_name == XW_MESSAGING_INTERFACE_2) {
   389	    static const XW_MessagingInterface_2 messagingInterface2 = {
   390	      Interface::MessagingRegister,
   391	      Interface::MessagingPostMessage,
   392	      Interface::MessagingRegisterBinaryMessageCallback,
   393	      Interface::MessagingPostBinaryMessage
   394	    };
   395	    return &messagingInterface2;
   396	  }
   397	
   398	  if (interface_name == XW_INTERNAL_SYNC_MESSAGING_INTERFACE_1) {
   399	    static const XW_Internal_SyncMessagingInterface_1
   400	        syncMessagingInterface1 = {
   401	      Interface::SyncMessagingRegister,
   402	      Interface::SyncMessagingSetSyncReply,
   403	      Interface::SyncMessagingSetSyncBinaryReply
   404	    };
   405	    return &syncMessagingInterface1;
   406	  }
   407	
   408	  if (interface_name == XW_INTERNAL_ENTRY_POINTS_INTERFACE_1) {
   409	    static const XW_Internal_EntryPointsInterface_1 entryPointsInterface1 = {
   410	      Interface::EntryPointsSetExtraJSEntryPoints
   411	    };
   412	    return &entryPointsInterface1;
   413	  }
   414	
   415	  if (interface_name == XW_INTERNAL_RUNTIME_INTERFACE_1) {
   416	    static const XW_Internal_RuntimeInterface_1 runtimeInterface1 = {
   417	      Interface::RuntimeGetStringVariable
   418	    };
   419	    return &runtimeInterface1;
   420	  }
