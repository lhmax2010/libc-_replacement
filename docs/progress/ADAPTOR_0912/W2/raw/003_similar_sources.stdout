   308	
   309	void XWalkExtension::Instance::SetPostMessageCallback(
   310	    MessageCallback callback) {
   311	  base::AutoLock lock(callback_lock);
   312	  post_message_callback_ = callback;
   313	}
   314	
   315	void XWalkExtension::Instance::SetPostBinaryMessageCallback(
   316	    BinaryMessageCallback callback) {
   317	  base::AutoLock lock(callback_lock);
   318	  post_binary_message_callback_ = callback;
   319	}
   320	
   321	void XWalkExtension::Instance::PostMessageToJS(const std::string& message) {
   322	  base::AutoLock lock(callback_lock);
   323	  if (post_message_callback_)
   324	    post_message_callback_(message);
   325	}
   326	
   327	void XWalkExtension::Instance::PostBinaryMessageToJS(
   328	    const char* message, int size) {
   329	  base::AutoLock lock(callback_lock);
   330	  if (post_binary_message_callback_)
   331	    post_binary_message_callback_(message, size);
   332	}
   333	
   334	void XWalkExtension::Instance::SyncReplyToJS(const std::string& reply) {
   335	  sync_reply_ = reply;
   336	}
   337	
   338	void XWalkExtension::Instance::SyncBinaryReplyToJS(
   339	    const std::vector<uint8_t>& reply) {
   340	  sync_binary_reply_ = reply;
   341	}
   342	
   343	XWalkExtension::XWalkExtension(const std::string& path)
   344	    : lazy_loading_(false), library_path_(path) {}
   345	
   346	XWalkExtension::XWalkExtension(const std::string& path,
   347	                               const std::string& name,
   348	                               const std::vector<std::string>& entry_points)
   349	    : lazy_loading_(true),
   350	      library_path_(path),
   351	      name_(name),
   352	      entry_points_(entry_points) {}
   353	
   354	XWalkExtension::~XWalkExtension() {
   355	  if (!initialized_)
   356	    return;
   357	  if (shutdown_callback_)
   358	    shutdown_callback_(xw_extension_);
   359	#if !BUILDFLAG(IS_TIZEN_TV)
   360	  dlclose(handle_);
