     1	#include "bridge.h"
     2	#include <ewk_cookie_parser.h>
     3	#include <stdexcept>
     4	static int emit(void*p,unsigned i,const char*s,size_t n){
     5	 auto*f=static_cast<std::string*>(p);
     6	 if(i>=4)return 0;try{f[i].assign(s,n);return 1;}catch(...){return 0;}
     7	}
     8	extern "C" __attribute__((visibility("default"))) int api_probe_configure_real_provider(const char*p){return bridge_configure(p);}
     9	extern "C" __attribute__((visibility("default"))) Eina_Bool ewk_parse_cookie(const std::string&in,EWKCookieContents&out){
    10	 CookieState initial{{{out.domain.data(),out.domain.size()},{out.name.data(),out.name.size()},
    11	                       {out.path.data(),out.path.size()},{out.value.data(),out.value.size()}},out.expiry_date_utc};
    12	 // Do not instantiate the shared-name EWK wrapper in both translation units:
    13	 // its weak destructor has the same mangled name despite different field layouts.
    14	 std::string next[4];int64_t expiry=0;
    15	 int rc=bridge_parse({in.data(),in.size()},&initial,next,emit,&expiry);
    16	 // Experimental policy: fail visibly; do not silently turn transport/allocation failure into success.
    17	 // This is NOT a claim of exception-contract equivalence with the original function.
    18	 if(rc<0)throw std::runtime_error("experimental adaptor transport/allocation error");
    19	 if(rc==0)return EINA_FALSE;
    20	 out.domain.swap(next[0]);out.name.swap(next[1]);out.path.swap(next[2]);out.value.swap(next[3]);
    21	 out.expiry_date_utc=static_cast<time_t>(expiry);return EINA_TRUE;
    22	}
