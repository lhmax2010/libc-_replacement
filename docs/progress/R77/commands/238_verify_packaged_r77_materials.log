from pathlib import Path
import hashlib
src=Path('progress/R77'); dst=Path('docs/progress/R77')
def hashes(root, skip_index=False):
 out={}
 for p in root.rglob('*'):
  if p.is_file():
   rel=p.relative_to(root).as_posix()
   if skip_index and rel=='INDEX.tsv': continue
   out[rel]=hashlib.sha256(p.read_bytes()).hexdigest()
 return out
s=hashes(src); d=hashes(dst,True)
print('SOURCE_FILES',len(s)); print('DOC_FILES_EXCLUDING_INDEX',len(d))
print('MISSING_IN_DOC',sorted(set(s)-set(d)))
print('EXTRA_IN_DOC',sorted(set(d)-set(s)))
print('HASH_MISMATCHES',sorted(k for k in set(s)&set(d) if s[k]!=d[k]))
idx=dst/'INDEX.tsv'; lines=idx.read_text().splitlines()
print('INDEX_DATA_ROWS',len(lines)-1)
print('REPORT_EXISTS',(dst/'REPORT.md').is_file())
