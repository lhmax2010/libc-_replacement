from pathlib import Path
import json, re
root=Path('progress/R77/raw/results/baseline_armv7l/libcxx')
complete=sorted(root.glob('batch_*/result.json'))
running=[]
for p in sorted(root.glob('batch_*/lit.stdout')):
    txt=p.read_text(errors='replace')
    m=list(re.finditer(r'\[([0-9]+)/([0-9]+)\]',txt))
    if m:
        running.append((p.parent.name,m[-1].group(1),m[-1].group(2)))
print('COMPLETE_BATCHES',len(complete))
print('LATEST_PROGRESS',running[-1] if running else 'NONE')
for p in complete[-3:]:
    d=json.loads(p.read_text())
    print(p.parent.name,d.get('exit_code'),d.get('elapsed_seconds'))
runner=Path('progress/R77/raw/results/baseline_armv7l/libcxx/runner.stdout')
if runner.exists():
    print('RUNNER_TAIL')
    print('\n'.join(runner.read_text(errors='replace').splitlines()[-8:]))
