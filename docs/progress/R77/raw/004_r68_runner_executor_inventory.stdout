#!/usr/bin/env python3
"""Run one libc++ lit test directory on the registered armv7l SDB target."""

import argparse
import hashlib
import os
import re
import shlex
import subprocess
import sys
import tarfile
import tempfile


SDB = "/home/toolchain/.local/bin/sdb"
SERIAL = "192.168.108.26:26101"
REMOTE_ROOT = "/opt/usr/home/owner/share/tmp/r68_lit_20260827"
SHARED_ROOT = "/opt/usr/home/owner/share/tmp"
EXIT_MARKER = "__R68_SDB_EXIT__="


def run_host(command, *, check=True, **kwargs):
    if os.environ.get("R68_SDB_EXECUTOR_VERBOSE") == "1":
        print(f"HOST_COMMAND={shlex.join(command)}", file=sys.stderr)
    return subprocess.run(command, check=check, **kwargs)


def sdb_command(*arguments):
    return [SDB, "-s", SERIAL, *arguments]


def build_environment(env_args, prepend_args):
    components = []
    for assignment in env_args:
        key, value = assignment.split("=", 1)
        components.append(f"export {key}={shlex.quote(value)}; ")
    for assignment in prepend_args:
        key, value = assignment.split("=", 1)
        components.append(
            f"export {key}={shlex.quote(value)}${{{key}:+:${key}}}; "
        )
    components.append(
        f"export LD_LIBRARY_PATH={shlex.quote(REMOTE_ROOT + '/runtime')}"
        "${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}; "
    )
    return "".join(components)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--execdir", required=True)
    parser.add_argument("--env", nargs="*", default=[])
    parser.add_argument("--prepend_env", nargs="*", default=[])
    parser.add_argument("command", nargs=argparse.ONE_OR_MORE)
    args = parser.parse_args()

    local_dir = os.path.abspath(args.execdir)
    if not os.path.isdir(local_dir):
        print(f"ERROR: execdir is not a directory: {local_dir}", file=sys.stderr)
        return 10

    digest = hashlib.sha256(local_dir.encode()).hexdigest()[:16]
    invocation = f"run-{digest}-{os.getpid()}"
    remote_dir = f"{REMOTE_ROOT}/runs/{invocation}"
    shared_tar = f"{SHARED_ROOT}/{invocation}.tar"
    remote_tar = f"{REMOTE_ROOT}/{invocation}.tar"
    local_tar = None
    local_tar_bytes = 0

    def map_argument(argument):
        prefix = local_dir + os.sep
        if argument.startswith(prefix):
            return remote_dir + "/" + argument[len(prefix) :]
        return argument

    try:
        with tempfile.NamedTemporaryFile(suffix=".tar", delete=False) as temporary:
            local_tar = temporary.name
        with tarfile.open(local_tar, "w") as archive:
            archive.add(local_dir, arcname=os.path.basename(local_dir))
        local_tar_bytes = os.path.getsize(local_tar)

        run_host(
            sdb_command("push", local_tar, shared_tar),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
        )

        setup = (
            "set -e; "
            f"mkdir -p {shlex.quote(REMOTE_ROOT + '/runs')}; "
            f"cp {shlex.quote(shared_tar)} {shlex.quote(remote_tar)}; "
            f"rm -f {shlex.quote(shared_tar)}; "
            f"mkdir {shlex.quote(remote_dir)}; "
            f"tar -xf {shlex.quote(remote_tar)} -C {shlex.quote(remote_dir)} "
            "--strip-components 1; "
            f"rm -f {shlex.quote(remote_tar)}; "
            f"chmod -R u+rwX {shlex.quote(remote_dir)}"
        )
        run_host(
            sdb_command("shell", setup),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
        )

        remote_command = [map_argument(argument) for argument in args.command]
        shell_command = (
            "set +e; "
            + build_environment(args.env, args.prepend_env)
            + f"cd {shlex.quote(remote_dir)}; "
            + shlex.join(remote_command)
            + "; rc=$?; "
            + f"printf '\n{EXIT_MARKER}%d\n' \"$rc\"; exit 0"
        )
        completed = run_host(
            sdb_command("shell", shell_command),
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            errors="replace",
        )
        telemetry_path = os.environ.get("R68_SDB_TELEMETRY")
        if telemetry_path:
            usage = run_host(
                sdb_command("shell", f"du -sk {shlex.quote(remote_dir)}"),
                check=False,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
            )
            with open(telemetry_path, "a", encoding="utf-8") as telemetry:
                telemetry.write(
                    f"{local_dir}\t{local_tar_bytes}\t"
                    f"{usage.returncode}\t{usage.stdout.strip()}\n"
                )
        if completed.stderr:
            sys.stderr.write(completed.stderr)
        if completed.returncode != 0:
            sys.stderr.write(
                f"ERROR: SDB carrier exited with {completed.returncode}\n"
            )
            sys.stderr.write(completed.stdout)
            return 90

        output = completed.stdout.replace("\r\n", "\n")
        match = re.search(rf"\n{re.escape(EXIT_MARKER)}([0-9]+)\n?$", output)
        if match is None:
            sys.stderr.write("ERROR: remote exit marker was not observed\n")
            sys.stderr.write(output)
            return 91
        sys.stdout.write(output[: match.start()])
        return int(match.group(1))
    finally:
        if local_tar is not None:
            try:
                os.remove(local_tar)
            except FileNotFoundError:
                pass
        cleanup = (
            f"rm -rf {shlex.quote(remote_dir)}; "
            f"rm -f {shlex.quote(remote_tar)} {shlex.quote(shared_tar)}"
        )
        run_host(
            sdb_command("shell", cleanup),
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
        )


if __name__ == "__main__":
    sys.exit(main())
RUNNER
#!/usr/bin/env bash
set -euo pipefail

workspace=/home/toolchain/development/libc++_replacement
label=${1:?combination label required}
output_root="$workspace/progress/R68/raw/full_run/results/$label"
status_root="$workspace/progress/R68/raw/full_run/status"
mkdir -p "$output_root" "$status_root"

case "$label" in
  patched_x86_64)
    source_dir="$workspace/tmp/R69/replay"
    build_dir="$workspace/tmp/R68/build-patched-x86_64"
    capability_root="$workspace/progress/R68/raw/capability/patched/x86_64"
    arch=x86_64
    extra_lit=()
    ;;
  baseline_x86_64)
    source_dir="$workspace/tmp/R68/source-baseline"
    build_dir="$workspace/tmp/R68/build-baseline-x86_64"
    capability_root="$workspace/progress/R68/raw/capability/baseline/x86_64"
    arch=x86_64
    extra_lit=()
    ;;
  patched_armv7l)
    source_dir="$workspace/tmp/R69/replay"
    build_dir="$workspace/tmp/R68/build-patched-armv7l"
    capability_root="$workspace/progress/R68/raw/capability/patched/armv7l"
    arch=armv7l
    extra_lit=(-D std=c++26
      -D compiler="$workspace/progress/R68/tools/armv7l_lit_host_clangxx.sh"
      -D executor="$workspace/progress/R68/tools/sdb_executor.py")
    ;;
  baseline_armv7l)
    source_dir="$workspace/tmp/R68/source-baseline"
    build_dir="$workspace/tmp/R68/build-baseline-armv7l"
    capability_root="$workspace/progress/R68/raw/capability/baseline/armv7l"
    arch=armv7l
    extra_lit=(-D std=c++26
      -D compiler="$workspace/progress/R68/tools/armv7l_lit_host_clangxx.sh"
      -D executor="$workspace/progress/R68/tools/sdb_executor.py")
    ;;
  *)
    printf 'ERROR: unsupported combination: %s\n' "$label" >&2
    exit 10
    ;;
esac

lit="$source_dir/llvm/utils/lit/lit.py"
summary_tool="$workspace/progress/R68/tools/summarize_full_suite.py"
combination_status="$status_root/$label.tsv"
combination_complete="$output_root/COMBINATION_COMPLETE"

if [[ -e "$combination_complete" ]]; then
  printf 'COMBINATION_ALREADY_COMPLETE\t%s\n' "$label"
  exit 0
fi

source_head=$(git -C "$source_dir" rev-parse HEAD)
source_status=$(git -C "$source_dir" status --porcelain)
if [[ -n "$source_status" ]]; then
  printf 'ERROR: source tree is dirty: %s\n' "$source_dir" >&2
  exit 11
fi

install_root="$build_dir/libcxx/test-suite-install"
libcxx="$install_root/lib/libc++.so.1.0"
libcxxabi="$install_root/lib/libc++abi.so.1.0"
for required in "$lit" "$summary_tool" "$libcxx" "$libcxxabi"; do
  if [[ ! -f "$required" ]]; then
    printf 'ERROR: required file is absent: %s\n' "$required" >&2
    exit 11
  fi
done

{
  printf 'label\t%s\n' "$label"
  printf 'arch\t%s\n' "$arch"
  printf 'source_dir\t%s\n' "$source_dir"
  printf 'source_head\t%s\n' "$source_head"
  printf 'build_dir\t%s\n' "$build_dir"
  printf 'libcxx_sha256\t%s\n' "$(sha256sum "$libcxx" | awk '{print $1}')"
  printf 'libcxxabi_sha256\t%s\n' "$(sha256sum "$libcxxabi" | awk '{print $1}')"
  printf 'started_at\t%s\n' "$(date --iso-8601=seconds)"
} > "$output_root/combination_metadata.tsv"

sample_resources() {
  local destination=$1
  local available
  available=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)
  {
    printf 'timestamp=%s\n' "$(date --iso-8601=seconds)"
    free -h
    uptime
    printf 'mem_available_kib=%s\n' "$available"
  } >> "$destination"
  if (( available < 1048576 )); then
    return 20
  fi
}

run_suite() {
  local suite=$1
  local suite_dir="$output_root/$suite"
  local complete="$suite_dir/COMPLETE"
  local started="$suite_dir/STARTED"
  local capability
  if [[ "$arch" == armv7l ]]; then
    capability="$capability_root/$suite.sdb.no-execute.json"
  else
    capability="$capability_root/$suite.no-execute.json"
  fi

  if [[ -e "$complete" ]]; then
    printf 'SUITE_ALREADY_COMPLETE\t%s\t%s\n' "$label" "$suite"
    return 0
  fi
  if [[ -e "$started" ]]; then
    printf 'ERROR: interrupted suite state exists; refusing automatic rerun: %s/%s\n' \
      "$label" "$suite" >&2
    return 12
  fi
  if [[ ! -f "$capability" ]]; then
    printf 'ERROR: capability JSON is absent: %s\n' "$capability" >&2
    return 11
  fi

  mkdir -p "$suite_dir/failures"
  local result_json="$suite_dir/result.json"
  local stdout="$suite_dir/lit.stdout"
  local stderr="$suite_dir/lit.stderr"
  local resources="$suite_dir/resources.log"
  local telemetry="$suite_dir/executor_telemetry.tsv"
  local command_record="$suite_dir/command.txt"
  local test_dir="$build_dir/$suite/test"
  local -a command=(timeout --signal=TERM --kill-after=30s 18000s
    nice -n 15 ionice -c 3 python3 "$lit" -j 2
    "${extra_lit[@]}" --order=lexical --show-unsupported --show-skipped
    --time-tests -v -o "$result_json" "$test_dir")

  {
    printf 'COMMAND='
    printf '%q ' env "R68_SDB_TELEMETRY=$telemetry" "${command[@]}"
    printf '\n'
  } > "$command_record"
  printf 'started_at=%s\n' "$(date --iso-8601=seconds)" > "$started"
  sample_resources "$resources"
  local start_seconds
  start_seconds=$(date +%s)

  set +e
  setsid env "R68_SDB_TELEMETRY=$telemetry" "${command[@]}" \
    > "$stdout" 2> "$stderr" &
  local command_pid=$!
  set -e

  (
    while kill -0 "$command_pid" 2>/dev/null; do
      sleep 300
      if kill -0 "$command_pid" 2>/dev/null; then
        if ! sample_resources "$resources"; then
          printf 'RED_STOP_RESOURCE\t%s\n' "$(date --iso-8601=seconds)" \
            >> "$resources"
          kill -TERM -- "-$command_pid" 2>/dev/null || true
          sleep 10
          kill -KILL -- "-$command_pid" 2>/dev/null || true
          exit 20
        fi
      fi
    done
  ) &
  local monitor_pid=$!

  set +e
  wait "$command_pid"
  local lit_rc=$?
  kill "$monitor_pid" 2>/dev/null
  wait "$monitor_pid" 2>/dev/null
  local monitor_rc=$?
  set -e

  local elapsed=$(( $(date +%s) - start_seconds ))
  {
    printf 'LIT_EXIT_CODE=%d\n' "$lit_rc"
    printf 'MONITOR_EXIT_CODE=%d\n' "$monitor_rc"
    printf 'ELAPSED_SECONDS=%d\n' "$elapsed"
    printf 'finished_at=%s\n' "$(date --iso-8601=seconds)"
  } >> "$command_record"

  if [[ "$monitor_rc" -eq 20 ]]; then
    printf 'ERROR: memory red stop during %s/%s\n' "$label" "$suite" >&2
    return 20
  fi
  if [[ "$lit_rc" -ne 0 && "$lit_rc" -ne 1 ]]; then
    printf 'ERROR: lit technical/interruption exit %d for %s/%s\n' \
      "$lit_rc" "$label" "$suite" >&2
    return "$lit_rc"
  fi
  if [[ ! -s "$result_json" ]]; then
    printf 'ERROR: result JSON is absent or empty: %s\n' "$result_json" >&2
    return 13
  fi

  python3 "$summary_tool" --result "$result_json" --capability "$capability" \
    --failure-dir "$suite_dir/failures" > "$suite_dir/summary.tsv" \
    2> "$suite_dir/summary.stderr"
  local summary_rc=$?
  if [[ "$summary_rc" -ne 0 ]]; then
    printf 'ERROR: result validation failed for %s/%s\n' "$label" "$suite" >&2
    return "$summary_rc"
  fi

  {
    printf 'label\tsuite\tlit_exit_code\telapsed_seconds\tresult_sha256\n'
    printf '%s\t%s\t%d\t%d\t%s\n' "$label" "$suite" "$lit_rc" "$elapsed" \
      "$(sha256sum "$result_json" | awk '{print $1}')"
  } > "$complete"
  printf '%s\t%s\tCOMPLETE\t%d\t%d\n' "$label" "$suite" "$lit_rc" "$elapsed" \
    >> "$combination_status"
  printf 'SUITE_COMPLETE\t%s\t%s\tlit_rc=%d\telapsed=%d\n' \
    "$label" "$suite" "$lit_rc" "$elapsed"
}

for suite in libcxxabi libcxx; do
  run_suite "$suite"
done

{
  printf 'label\t%s\n' "$label"
  printf 'completed_at\t%s\n' "$(date --iso-8601=seconds)"
  printf 'result\tCOMPLETE\n'
} > "$combination_complete"
printf 'COMBINATION_COMPLETE\t%s\n' "$label"
