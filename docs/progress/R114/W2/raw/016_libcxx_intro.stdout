      "contents_url": "https://api.github.com/repos/llvm/llvm-project/contents/libcxx%2Ftest%2Fthread%2Fthread.mutex%2Fthread.lock%2Fthread.lock.shared%2Fthread.lock.shared.obs%2Fowns_lock.pass.cpp?ref=ead6f1699dcda74528393b328250cbcb47fb1211",
      "patch": "@@ -0,0 +1,36 @@\n+//===----------------------------------------------------------------------===//\n+//\n+//                     The LLVM Compiler Infrastructure\n+//\n+// This file is dual licensed under the MIT and the University of Illinois Open\n+// Source Licenses. See LICENSE.TXT for details.\n+//\n+//===----------------------------------------------------------------------===//\n+\n+// <shared_mutex>\n+\n+// template <class Mutex> class shared_lock;\n+\n+// bool owns_lock() const noexcept;\n+\n+#include <shared_mutex>\n+#include <cassert>\n+\n+#if _LIBCPP_STD_VER > 11\n+\n+std::shared_mutex m;\n+\n+#endif  // _LIBCPP_STD_VER > 11\n+\n+int main()\n+{\n+#if _LIBCPP_STD_VER > 11\n+    std::shared_lock<std::shared_mutex> lk0;\n+    assert(lk0.owns_lock() == false);\n+    std::shared_lock<std::shared_mutex> lk1(m);\n+    assert(lk1.owns_lock() == true);\n+    lk1.unlock();\n+    assert(lk1.owns_lock() == false);\n+    static_assert(noexcept(lk0.owns_lock()), \"owns_lock must be noexcept\");\n+#endif  // _LIBCPP_STD_VER > 11\n+}"
