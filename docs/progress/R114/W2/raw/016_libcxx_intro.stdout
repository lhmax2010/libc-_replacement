    {
      "sha": "2fd78008151e9d91851b2c46813e65cb46054f78",
      "filename": "libcxx/test/thread/thread.mutex/thread.mutex.requirements/thread.sharedmutex.requirements/thread.sharedmutex.class/lock.pass.cpp",
      "status": "added",
      "additions": 52,
      "deletions": 0,
      "changes": 52,
      "blob_url": "https://github.com/llvm/llvm-project/blob/ead6f1699dcda74528393b328250cbcb47fb1211/libcxx%2Ftest%2Fthread%2Fthread.mutex%2Fthread.mutex.requirements%2Fthread.sharedmutex.requirements%2Fthread.sharedmutex.class%2Flock.pass.cpp",
      "raw_url": "https://github.com/llvm/llvm-project/raw/ead6f1699dcda74528393b328250cbcb47fb1211/libcxx%2Ftest%2Fthread%2Fthread.mutex%2Fthread.mutex.requirements%2Fthread.sharedmutex.requirements%2Fthread.sharedmutex.class%2Flock.pass.cpp",
      "contents_url": "https://api.github.com/repos/llvm/llvm-project/contents/libcxx%2Ftest%2Fthread%2Fthread.mutex%2Fthread.mutex.requirements%2Fthread.sharedmutex.requirements%2Fthread.sharedmutex.class%2Flock.pass.cpp?ref=ead6f1699dcda74528393b328250cbcb47fb1211",
      "patch": "@@ -0,0 +1,52 @@\n+//===----------------------------------------------------------------------===//\n+//\n+//                     The LLVM Compiler Infrastructure\n+//\n+// This file is dual licensed under the MIT and the University of Illinois Open\n+// Source Licenses. See LICENSE.TXT for details.\n+//\n+//===----------------------------------------------------------------------===//\n+\n+// <shared_mutex>\n+\n+// class shared_mutex;\n+\n+// void lock();\n+\n+#include <shared_mutex>\n+#include <thread>\n+#include <cstdlib>\n+#include <cassert>\n+\n+#if _LIBCPP_STD_VER > 11\n+\n+std::shared_mutex m;\n+\n+typedef std::chrono::system_clock Clock;\n+typedef Clock::time_point time_point;\n+typedef Clock::duration duration;\n+typedef std::chrono::milliseconds ms;\n+typedef std::chrono::nanoseconds ns;\n+\n+void f()\n+{\n+    time_point t0 = Clock::now();\n+    m.lock();\n+    time_point t1 = Clock::now();\n+    m.unlock();\n+    ns d = t1 - t0 - ms(250);\n+    assert(d < ms(50));  // within 50ms\n+}\n+\n+#endif  // _LIBCPP_STD_VER > 11\n+\n+int main()\n+{\n+#if _LIBCPP_STD_VER > 11\n+    m.lock();\n+    std::thread t(f);\n+    std::this_thread::sleep_for(ms(250));\n+    m.unlock();\n+    t.join();\n+#endif  // _LIBCPP_STD_VER > 11\n+}"
    },
    {
      "sha": "6fe1b446950353836a0afd1b2d5074b4aad49c86",
