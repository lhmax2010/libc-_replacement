      "raw_url": "https://github.com/llvm/llvm-project/raw/ead6f1699dcda74528393b328250cbcb47fb1211/libcxx%2Ftest%2Fthread%2Fthread.mutex%2Fthread.lock%2Fthread.lock.shared%2Fthread.lock.shared.obs%2Fmutex.pass.cpp",
