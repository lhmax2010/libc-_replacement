      "contents_url": "https://api.github.com/repos/llvm/llvm-project/contents/libcxx%2Ftest%2Fthread%2Fthread.mutex%2Fthread.lock%2Fthread.lock.shared%2Fthread.lock.shared.cons%2Fdefault.pass.cpp?ref=ead6f1699dcda74528393b328250cbcb47fb1211",
      "patch": "@@ -0,0 +1,26 @@\n+//===----------------------------------------------------------------------===//\n+//\n+//                     The LLVM Compiler Infrastructure\n+//\n+// This file is dual licensed under the MIT and the University of Illinois Open\n+// Source Licenses. See LICENSE.TXT for details.\n+//\n+//===----------------------------------------------------------------------===//\n+\n+// <shared_mutex>\n+\n+// template <class Mutex> class shared_lock;\n+\n+// shared_lock();\n+\n+#include <shared_mutex>\n+#include <cassert>\n+\n+int main()\n+{\n+#if _LIBCPP_STD_VER > 11\n+    std::shared_lock<std::shared_mutex> ul;\n+    assert(!ul.owns_lock());\n+    assert(ul.mutex() == nullptr);\n+#endif  // _LIBCPP_STD_VER > 11\n+}"
    },
    {
      "sha": "1fcc98fce96f2fef5d32bff3a3e7fe96e7181197",
      "filename": "libcxx/test/thread/thread.mutex/thread.lock/thread.lock.shared/thread.lock.shared.cons/move_assign.pass.cpp",
      "status": "added",
      "additions": 37,
      "deletions": 0,
      "changes": 37,
      "blob_url": "https://github.com/llvm/llvm-project/blob/ead6f1699dcda74528393b328250cbcb47fb1211/libcxx%2Ftest%2Fthread%2Fthread.mutex%2Fthread.lock%2Fthread.lock.shared%2Fthread.lock.shared.cons%2Fmove_assign.pass.cpp",
      "raw_url": "https://github.com/llvm/llvm-project/raw/ead6f1699dcda74528393b328250cbcb47fb1211/libcxx%2Ftest%2Fthread%2Fthread.mutex%2Fthread.lock%2Fthread.lock.shared%2Fthread.lock.shared.cons%2Fmove_assign.pass.cpp",
      "contents_url": "https://api.github.com/repos/llvm/llvm-project/contents/libcxx%2Ftest%2Fthread%2Fthread.mutex%2Fthread.lock%2Fthread.lock.shared%2Fthread.lock.shared.cons%2Fmove_assign.pass.cpp?ref=ead6f1699dcda74528393b328250cbcb47fb1211",
      "patch": "@@ -0,0 +1,37 @@\n+//===----------------------------------------------------------------------===//\n+//\n+//                     The LLVM Compiler Infrastructure\n+//\n+// This file is dual licensed under the MIT and the University of Illinois Open\n+// Source Licenses. See LICENSE.TXT for details.\n+//\n+//===----------------------------------------------------------------------===//\n+\n+// <shared_mutex>\n+\n+// template <class Mutex> class shared_lock;\n+\n+// shared_lock& operator=(shared_lock&& u);\n+\n+#include <shared_mutex>\n+#include <cassert>\n+\n+#if _LIBCPP_STD_VER > 11\n+\n+std::shared_mutex m0;\n+std::shared_mutex m1;\n+\n+#endif  // _LIBCPP_STD_VER > 11\n+\n+int main()\n+{\n+#if _LIBCPP_STD_VER > 11\n+    std::shared_lock<std::shared_mutex> lk0(m0);\n+    std::shared_lock<std::shared_mutex> lk1(m1);\n+    lk1 = std::move(lk0);\n+    assert(lk1.mutex() == &m0);\n+    assert(lk1.owns_lock() == true);\n+    assert(lk0.mutex() == nullptr);\n+    assert(lk0.owns_lock() == false);\n+#endif  // _LIBCPP_STD_VER > 11\n+}"
    },
    {
      "sha": "7e801da20f29ccc225dd64152ad977bdd8451fac",
      "filename": "libcxx/test/thread/thread.mutex/thread.lock/thread.lock.shared/thread.lock.shared.cons/move_ctor.pass.cpp",
      "status": "added",
