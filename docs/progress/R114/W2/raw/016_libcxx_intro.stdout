      "blob_url": "https://github.com/llvm/llvm-project/blob/ead6f1699dcda74528393b328250cbcb47fb1211/libcxx%2Ftest%2Fthread%2Fthread.mutex%2Fthread.mutex.requirements%2Fthread.sharedmutex.requirements%2Fthread.sharedmutex.class%2Ftry_lock_for.pass.cpp",
      "raw_url": "https://github.com/llvm/llvm-project/raw/ead6f1699dcda74528393b328250cbcb47fb1211/libcxx%2Ftest%2Fthread%2Fthread.mutex%2Fthread.mutex.requirements%2Fthread.sharedmutex.requirements%2Fthread.sharedmutex.class%2Ftry_lock_for.pass.cpp",
      "contents_url": "https://api.github.com/repos/llvm/llvm-project/contents/libcxx%2Ftest%2Fthread%2Fthread.mutex%2Fthread.mutex.requirements%2Fthread.sharedmutex.requirements%2Fthread.sharedmutex.class%2Ftry_lock_for.pass.cpp?ref=ead6f1699dcda74528393b328250cbcb47fb1211",
      "patch": "@@ -0,0 +1,71 @@\n+//===----------------------------------------------------------------------===//\n+//\n+//                     The LLVM Compiler Infrastructure\n+//\n+// This file is dual licensed under the MIT and the University of Illinois Open\n+// Source Licenses. See LICENSE.TXT for details.\n+//\n+//===----------------------------------------------------------------------===//\n+\n+// <shared_mutex>\n+\n+// class shared_mutex;\n+\n+// template <class Rep, class Period>\n+//     bool try_lock_for(const chrono::duration<Rep, Period>& rel_time);\n+\n+#include <shared_mutex>\n+#include <thread>\n+#include <cstdlib>\n+#include <cassert>\n+\n+#if _LIBCPP_STD_VER > 11\n+\n+std::shared_mutex m;\n+\n+typedef std::chrono::steady_clock Clock;\n+typedef Clock::time_point time_point;\n+typedef Clock::duration duration;\n+typedef std::chrono::milliseconds ms;\n+typedef std::chrono::nanoseconds ns;\n+\n+void f1()\n+{\n+    time_point t0 = Clock::now();\n+    assert(m.try_lock_for(ms(300)) == true);\n+    time_point t1 = Clock::now();\n+    m.unlock();\n+    ns d = t1 - t0 - ms(250);\n+    assert(d < ms(50));  // within 50ms\n+}\n+\n+void f2()\n+{\n+    time_point t0 = Clock::now();\n+    assert(m.try_lock_for(ms(250)) == false);\n+    time_point t1 = Clock::now();\n+    ns d = t1 - t0 - ms(250);\n+    assert(d < ms(50));  // within 50ms\n+}\n+\n+#endif  // _LIBCPP_STD_VER > 11\n+\n+int main()\n+{\n+#if _LIBCPP_STD_VER > 11\n+    {\n+        m.lock();\n+        std::thread t(f1);\n+        std::this_thread::sleep_for(ms(250));\n+        m.unlock();\n+        t.join();\n+    }\n+    {\n+        m.lock();\n+        std::thread t(f2);\n+        std::this_thread::sleep_for(ms(300));\n+        m.unlock();\n+        t.join();\n+    }\n+#endif  // _LIBCPP_STD_VER > 11\n+}"
    },
