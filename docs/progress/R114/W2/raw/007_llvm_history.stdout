  {
    "sha": "b3fcc67f8f13cd95d36ed29d0ae1308decb9e099",
    "node_id": "MDY6Q29tbWl0NzU4MjE0MzI6YjNmY2M2N2Y4ZjEzY2Q5NWQzNmVkMjlkMGFlMTMwOGRlY2I5ZTA5OQ==",
    "commit": {
      "author": {
        "name": "Jonathan Roelofs",
        "email": "jonathan@codesourcery.com",
        "date": "2014-09-05T19:45:05Z"
      },
      "committer": {
        "name": "Jonathan Roelofs",
        "email": "jonathan@codesourcery.com",
        "date": "2014-09-05T19:45:05Z"
      },
      "message": "Allow libc++ to be built on systems without POSIX threads\n\nIf you're crazy enough to want this sort of thing, then add\n-D_LIBCPP_HAS_NO_THREADS to your CXXFLAGS and\n--param=additiona_features=libcpp-has-no-threads to your lit commnad line.\n\nhttp://reviews.llvm.org/D3969\n\nllvm-svn: 217271",
      "tree": {
        "sha": "0c01716be284ed8200fde073b145887bea7b4508",
