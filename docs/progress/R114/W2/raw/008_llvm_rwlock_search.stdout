      "id": 4450367362,
      "node_id": "PR_kwDOBITxeM7bvLh5",
      "number": 197851,
      "title": "[lldb] Use os_unfair_lock for the string pool on Darwin",
      "user": {
        "login": "JDevlieghere",
        "id": 712896,
        "node_id": "MDQ6VXNlcjcxMjg5Ng==",
        "avatar_url": "https://avatars.githubusercontent.com/u/712896?v=4",
        "gravatar_id": "",
        "url": "https://api.github.com/users/JDevlieghere",
        "html_url": "https://github.com/JDevlieghere",
        "followers_url": "https://api.github.com/users/JDevlieghere/followers",
        "following_url": "https://api.github.com/users/JDevlieghere/following{/other_user}",
        "gists_url": "https://api.github.com/users/JDevlieghere/gists{/gist_id}",
        "starred_url": "https://api.github.com/users/JDevlieghere/starred{/owner}{/repo}",
        "subscriptions_url": "https://api.github.com/users/JDevlieghere/subscriptions",
        "organizations_url": "https://api.github.com/users/JDevlieghere/orgs",
        "repos_url": "https://api.github.com/users/JDevlieghere/repos",
        "events_url": "https://api.github.com/users/JDevlieghere/events{/privacy}",
        "received_events_url": "https://api.github.com/users/JDevlieghere/received_events",
        "type": "User",
        "user_view_type": "public",
        "site_admin": false
      },
      "labels": [
        {
          "id": 1958966960,
          "node_id": "MDU6TGFiZWwxOTU4OTY2OTYw",
          "url": "https://api.github.com/repos/llvm/llvm-project/labels/lldb",
          "name": "lldb",
          "color": "c400b3",
          "default": false,
          "description": ""
        }
      ],
      "state": "closed",
      "locked": false,
      "assignees": [

      ],
      "milestone": null,
      "comments": 4,
      "created_at": "2026-05-15T00:50:17Z",
      "updated_at": "2026-05-15T17:15:43Z",
      "closed_at": "2026-05-15T17:15:40Z",
      "assignee": null,
      "author_association": "MEMBER",
      "issue_field_values": [

      ],
      "type": null,
      "active_lock_reason": null,
      "draft": false,
      "pull_request": {
        "url": "https://api.github.com/repos/llvm/llvm-project/pulls/197851",
        "html_url": "https://github.com/llvm/llvm-project/pull/197851",
        "diff_url": "https://github.com/llvm/llvm-project/pull/197851.diff",
        "patch_url": "https://github.com/llvm/llvm-project/pull/197851.patch",
        "merged_at": "2026-05-15T17:15:40Z"
      },
      "body": "The  ConstString pool guards each shard with a SmartRWMutex<false>, which on Darwin maps to pthread_rwlock and incurs heavy syscall overhead under contention. os_unfair_lock is a userspace fast path that's significantly faster for the write path and roughly on par for reads, but it's exclusive-only and not available off Apple platforms.\r\n\r\nOn a 32-thread machine, hyperfine reports the benchmark unit test binary running 4.07x faster (365.6 ms +/- 3.9 ms -> 89.8 ms +/- 5.1 ms), with system time dropping from 4.35 s to 0.39 s as the kernel pthread_rwlock path is replaced by the userspace fast path.",
      "reactions": {
        "url": "https://api.github.com/repos/llvm/llvm-project/issues/197851/reactions",
        "total_count": 0,
        "+1": 0,
        "-1": 0,
        "laugh": 0,
        "hooray": 0,
        "confused": 0,
        "heart": 0,
        "rocket": 0,
        "eyes": 0
      },
      "timeline_url": "https://api.github.com/repos/llvm/llvm-project/issues/197851/timeline",
      "performed_via_github_app": null,
      "state_reason": null,
      "score": 1.0
    },
