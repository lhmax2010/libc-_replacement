    {
      "url": "https://api.github.com/repos/llvm/llvm-project/issues/197851",
      "repository_url": "https://api.github.com/repos/llvm/llvm-project",
      "labels_url": "https://api.github.com/repos/llvm/llvm-project/issues/197851/labels{/name}",
