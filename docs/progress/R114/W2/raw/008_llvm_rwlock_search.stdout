      "node_id": "PR_kwDOBITxeM5ne0b0",
      "number": 82466,
      "title": "[libc++] add shared_recursive_mutex api",
      "user": {
        "login": "Jolyon0202",
        "id": 51943930,
        "node_id": "MDQ6VXNlcjUxOTQzOTMw",
        "avatar_url": "https://avatars.githubusercontent.com/u/51943930?v=4",
        "gravatar_id": "",
        "url": "https://api.github.com/users/Jolyon0202",
        "html_url": "https://github.com/Jolyon0202",
        "followers_url": "https://api.github.com/users/Jolyon0202/followers",
        "following_url": "https://api.github.com/users/Jolyon0202/following{/other_user}",
        "gists_url": "https://api.github.com/users/Jolyon0202/gists{/gist_id}",
        "starred_url": "https://api.github.com/users/Jolyon0202/starred{/owner}{/repo}",
        "subscriptions_url": "https://api.github.com/users/Jolyon0202/subscriptions",
        "organizations_url": "https://api.github.com/users/Jolyon0202/orgs",
        "repos_url": "https://api.github.com/users/Jolyon0202/repos",
        "events_url": "https://api.github.com/users/Jolyon0202/events{/privacy}",
        "received_events_url": "https://api.github.com/users/Jolyon0202/received_events",
        "type": "User",
        "user_view_type": "public",
        "site_admin": false
      },
      "labels": [
        {
          "id": 1958966208,
          "node_id": "MDU6TGFiZWwxOTU4OTY2MjA4",
          "url": "https://api.github.com/repos/llvm/llvm-project/labels/libc++",
          "name": "libc++",
          "color": "bc3c5c",
          "default": false,
          "description": "libc++ C++ Standard Library. Not GNU libstdc++. Not libc++abi."
        }
      ],
      "state": "closed",
      "locked": false,
      "assignees": [

      ],
      "milestone": null,
      "comments": 5,
      "created_at": "2024-02-21T07:06:28Z",
      "updated_at": "2024-09-04T12:09:27Z",
      "closed_at": "2024-09-04T12:09:26Z",
      "assignee": null,
      "author_association": "CONTRIBUTOR",
      "issue_field_values": [

      ],
      "type": null,
      "active_lock_reason": null,
      "draft": false,
      "pull_request": {
        "url": "https://api.github.com/repos/llvm/llvm-project/pulls/82466",
        "html_url": "https://github.com/llvm/llvm-project/pull/82466",
        "diff_url": "https://github.com/llvm/llvm-project/pull/82466.diff",
        "patch_url": "https://github.com/llvm/llvm-project/pull/82466.patch",
        "merged_at": null
      },
      "body": "libc++'s shared_mutex favor writers over readers, but libstdc++'s shared_mutex favor readers over writers defaultly.\r\n\r\nlibstdc++¡®s shared_mutex use ptread_rwlock_t(PTHREAD_RWLOCK_PREFER_READER_NP defaultly), and it also support to favor writers over readers.\r\n\r\nOfficial C++ Standard doesn't specify the std::shared_mutex policy. Explanation could be found in original N2406 proposal (http://www.open-std.org/jtc1/sc22/wg21/docs/papers/2007/n2406.html#shared_mutex_imp) in shared_mutex.\r\n\r\nAnd we add shared_recursive_mutex api that favor readers over writers, and support Write-read nesting and write nesting.",
      "reactions": {
        "url": "https://api.github.com/repos/llvm/llvm-project/issues/82466/reactions",
        "total_count": 0,
        "+1": 0,
        "-1": 0,
        "laugh": 0,
        "hooray": 0,
        "confused": 0,
        "heart": 0,
        "rocket": 0,
        "eyes": 0
      },
      "timeline_url": "https://api.github.com/repos/llvm/llvm-project/issues/82466/timeline",
      "performed_via_github_app": null,
      "state_reason": null,
      "score": 1.0
    },
