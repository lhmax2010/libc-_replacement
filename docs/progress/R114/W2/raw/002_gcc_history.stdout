  {
    "sha": "c3d71b62c66f81b95213b88897cdd75f840e2fae",
    "node_id": "MDY6Q29tbWl0MjI3MTE1MDM6YzNkNzFiNjJjNjZmODFiOTUyMTNiODg4OTdjZGQ3NWY4NDBlMmZhZQ==",
    "commit": {
      "author": {
        "name": "Jonathan Wakely",
        "email": "jwakely@redhat.com",
        "date": "2015-04-10T09:00:00Z"
      },
      "committer": {
        "name": "Jonathan Wakely",
        "email": "redi@gcc.gnu.org",
        "date": "2015-04-10T09:00:00Z"
      },
      "message": "shared_mutex (shared_timed_mutex): Only use pthread_rwlock_t when the POSIX Timeouts option is supported.\n\n\t* include/std/shared_mutex (shared_timed_mutex): Only use\n\tpthread_rwlock_t when the POSIX Timeouts option is supported.\n\t* testsuite/30_threads/shared_lock/cons/5.cc: Remove\n\tdg-require-gthreads-timed.\n\t* testsuite/30_threads/shared_lock/cons/6.cc: Likewise.\n\t* testsuite/30_threads/shared_lock/locking/3.cc: Likewise.\n\t* testsuite/30_threads/shared_lock/locking/4.cc: Likewise.\n\nFrom-SVN: r221971",
      "tree": {
