   196	  template <class _Lock, class _Clock, class _Duration, class _Predicate>
   197	  bool _LIBCPP_HIDE_FROM_ABI
   198	  wait_until(_Lock& __lock, const chrono::time_point<_Clock, _Duration>& __t, _Predicate __pred);
