   200	  template <class _Lock, class _Rep, class _Period>
   201	  cv_status _LIBCPP_HIDE_FROM_ABI wait_for(_Lock& __lock, const chrono::duration<_Rep, _Period>& __d);
   202	
   203	  template <class _Lock, class _Rep, class _Period, class _Predicate>
   204	  bool _LIBCPP_HIDE_FROM_ABI wait_for(_Lock& __lock, const chrono::duration<_Rep, _Period>& __d, _Predicate __pred);
