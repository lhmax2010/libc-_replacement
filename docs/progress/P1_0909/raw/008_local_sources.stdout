    28	
    29	// ~condition_variable is defined elsewhere.
    30	
    31	void condition_variable::notify_one() noexcept { __libcpp_condvar_signal(&__cv_); }
    32	
    33	void condition_variable::notify_all() noexcept { __libcpp_condvar_broadcast(&__cv_); }
    34	
    35	static void __condvar_wait_body(condition_variable::native_handle_type cv, unique_lock<mutex>& lk) {
    36	  if (!lk.owns_lock())
    37	    std::__throw_system_error(EPERM, "condition_variable::wait: mutex not locked");
    38	  int ec = __libcpp_condvar_wait(cv, lk.mutex()->native_handle());
    39	  if (ec)
    40	    std::__throw_system_error(ec, "condition_variable wait failed");
    41	}
    42	
    43	static void __condvar_timed_wait_body(condition_variable::native_handle_type cv, unique_lock<mutex>& lk,
    44	                                     chrono::time_point<chrono::system_clock, chrono::nanoseconds> tp) {
    45	  using namespace chrono;
    46	  if (!lk.owns_lock())
    47	    std::__throw_system_error(EPERM, "condition_variable::timed wait: mutex not locked");
    48	  nanoseconds d = tp.time_since_epoch();
    49	  if (d > nanoseconds(0x59682F000000E941))
    50	    d = nanoseconds(0x59682F000000E941);
    51	  __libcpp_timespec_t ts;
    52	  seconds s = duration_cast<seconds>(d);
    53	  typedef decltype(ts.tv_sec) ts_sec;
    54	  constexpr ts_sec ts_sec_max = numeric_limits<ts_sec>::max();
    55	  if (s.count() < ts_sec_max) {
    56	    ts.tv_sec  = static_cast<ts_sec>(s.count());
    57	    ts.tv_nsec = static_cast<decltype(ts.tv_nsec)>((d - s).count());
    58	  } else {
    59	    ts.tv_sec  = ts_sec_max;
    60	    ts.tv_nsec = giga::num - 1;
    61	  }
    62	  int ec = __libcpp_condvar_timedwait(cv, lk.mutex()->native_handle(), &ts);
    63	  if (ec != 0 && ec != ETIMEDOUT)
    64	    std::__throw_system_error(ec, "condition_variable timed_wait failed");
    65	}
    66	
    67	#if defined(_LIBCPP_TIZEN_CONDVAR_VERSIONS)
    68	
    69	// ratio's non-type parameters are intmax_t: long on LP64, but long long
    70	// on the supported 32-bit Linux ABI. Validate the type behind the spelling
    71	// rather than assuming the x86_64 mangled name also applies to ARM.
    72	#  if __SIZEOF_LONG__ == 8
    73	static_assert(is_same<intmax_t, long>::value, "unexpected intmax_t ABI");
    74	#    define _LIBCPP_TIZEN_INTMAX_ABI "l"
    75	#  else
    76	static_assert(is_same<intmax_t, long long>::value, "unexpected intmax_t ABI");
    77	#    define _LIBCPP_TIZEN_INTMAX_ABI "x"
    78	#  endif
    79	
    80	// Native handles are public: no private-member access or object-layout cast is
    81	// needed. The explicit first argument is the member function's Itanium ABI this.
    82	extern "C" {
    83	_LIBCPP_EXPORTED_FROM_ABI void
    84	__libcpp_tizen_cv_wait_old(condition_variable*, unique_lock<mutex>&) noexcept;
    85	_LIBCPP_EXPORTED_FROM_ABI void
    86	__libcpp_tizen_cv_wait_new(condition_variable*, unique_lock<mutex>&);
    87	_LIBCPP_EXPORTED_FROM_ABI void __libcpp_tizen_cv_timed_old(
    88	    condition_variable*, unique_lock<mutex>&, chrono::time_point<chrono::system_clock, chrono::nanoseconds>) noexcept;
    89	_LIBCPP_EXPORTED_FROM_ABI void __libcpp_tizen_cv_timed_new(
    90	    condition_variable*, unique_lock<mutex>&, chrono::time_point<chrono::system_clock, chrono::nanoseconds>);
    91	
    92	void __libcpp_tizen_cv_wait_old(condition_variable* self, unique_lock<mutex>& lk) noexcept {
    93	  __condvar_wait_body(self->native_handle(), lk);
    94	}
    95	void __libcpp_tizen_cv_wait_new(condition_variable* self, unique_lock<mutex>& lk) {
    96	  __condvar_wait_body(self->native_handle(), lk);
    97	}
    98	void __libcpp_tizen_cv_timed_old(condition_variable* self, unique_lock<mutex>& lk,
    99	                                chrono::time_point<chrono::system_clock, chrono::nanoseconds> tp) noexcept {
   100	  __condvar_timed_wait_body(self->native_handle(), lk, tp);
   101	}
   102	void __libcpp_tizen_cv_timed_new(condition_variable* self, unique_lock<mutex>& lk,
   103	                                chrono::time_point<chrono::system_clock, chrono::nanoseconds> tp) {
   104	  __condvar_timed_wait_body(self->native_handle(), lk, tp);
   105	}
   106	}
   107	
   108	// Remove implementation names from the object symbol table as well as marking
   109	// their namespace local in the version script. Only the ABI aliases are public.
   110	asm(".symver __libcpp_tizen_cv_wait_old,"
   111	    "_ZNSt3__118condition_variable4waitERNS_11unique_lockINS_5mutexEEE@LLVM_22, remove");
   112	asm(".symver __libcpp_tizen_cv_wait_new,"
   113	    "_ZNSt3__118condition_variable4waitERNS_11unique_lockINS_5mutexEEE@@LLVM_22_TIZEN_1, remove");
   114	asm(".symver __libcpp_tizen_cv_timed_old,"
   115	    "_ZNSt3__118condition_variable15__do_timed_waitERNS_11unique_lockINS_5mutexEEE"
   116	    "NS_6chrono10time_pointINS5_12system_clockENS5_8durationIxNS_5ratioIL" _LIBCPP_TIZEN_INTMAX_ABI
   117	    "1EL" _LIBCPP_TIZEN_INTMAX_ABI "1000000000EEEEEEE@LLVM_22, remove");
   118	asm(".symver __libcpp_tizen_cv_timed_new,"
   119	    "_ZNSt3__118condition_variable15__do_timed_waitERNS_11unique_lockINS_5mutexEEE"
   120	    "NS_6chrono10time_pointINS5_12system_clockENS5_8durationIxNS_5ratioIL" _LIBCPP_TIZEN_INTMAX_ABI
   121	    "1EL" _LIBCPP_TIZEN_INTMAX_ABI "1000000000EEEEEEE@@LLVM_22_TIZEN_1, remove");
   122	
   123	#  undef _LIBCPP_TIZEN_INTMAX_ABI
   124	
   125	#else
   126	
   127	void condition_variable::wait(unique_lock<mutex>& lk) { __condvar_wait_body(native_handle(), lk); }
   128	
   129	void condition_variable::__do_timed_wait(unique_lock<mutex>& lk,
   130	                                         chrono::time_point<chrono::system_clock, chrono::nanoseconds> tp) {
   131	  __condvar_timed_wait_body(native_handle(), lk, tp);
   132	}
   133	
   134	#endif
   135	
   136	void notify_all_at_thread_exit(condition_variable& cond, unique_lock<mutex> lk) {
   137	  auto& tl_ptr = __thread_local_data();
   138	  // If this thread was not created using std::thread then it will not have
   139	  // previously allocated.
   140	  if (tl_ptr.get() == nullptr) {
   141	    tl_ptr.set_pointer(new __thread_struct);
   142	  }
   143	  __thread_local_data()->notify_all_at_thread_exit(&cond, lk.release());
   144	}
