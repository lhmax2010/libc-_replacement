diff --git a/libcxx/CMakeLists.txt b/libcxx/CMakeLists.txt
index 00ea2deef196..d867acf97eff 100644
--- a/libcxx/CMakeLists.txt
+++ b/libcxx/CMakeLists.txt
@@ -318,6 +318,13 @@ endif()
 # about #include_next which is used everywhere.
 option(LIBCXX_ENABLE_PEDANTIC "Compile with pedantic enabled." OFF)
 option(LIBCXX_ENABLE_WERROR "Fail and stop if a warning is triggered." OFF)
+option(LIBCXX_ENABLE_TIZEN_CONDVAR_VERSIONS
+  "Provide legacy and unwind-capable Tizen condition-variable symbol versions." OFF)
+if (LIBCXX_ENABLE_TIZEN_CONDVAR_VERSIONS)
+  if (NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR NOT LIBCXX_ABI_NAMESPACE STREQUAL "__1")
+    message(FATAL_ERROR "Tizen condition-variable versions require Linux ELF and ABI namespace __1")
+  endif()
+endif()
 
 set(LIBCXX_HERMETIC_STATIC_LIBRARY_DEFAULT OFF)
 if (WIN32)
diff --git a/libcxx/include/shared_mutex b/libcxx/include/shared_mutex
index 028bbf565025..176f8dedd229 100644
--- a/libcxx/include/shared_mutex
+++ b/libcxx/include/shared_mutex
@@ -244,6 +244,17 @@ public:
       }
     }
     __base_.__state_ |= __base_.__write_entered_;
+    // Restore the writer reservation while __lk still owns the internal mutex.
+    struct __rollback_guard {
+      __shared_mutex_base& __base;
+      bool __completed = false;
+      ~__rollback_guard() {
+        if (!__completed) {
+          __base.__state_ &= ~__base.__write_entered_;
+          __base.__gate1_.notify_all();
+        }
+      }
+    } __rollback{__base_};
     if (__base_.__state_ & __base_.__n_readers_) {
       while (true) {
         cv_status __status = __base_.__gate2_.wait_until(__lk, __abs_time);
@@ -252,10 +263,12 @@ public:
         if (__status == cv_status::timeout) {
           __base_.__state_ &= ~__base_.__write_entered_;
           __base_.__gate1_.notify_all();
+          __rollback.__completed = true;
           return false;
         }
       }
     }
+    __rollback.__completed = true;
     return true;
   }
 
