    32	BuildRequires:  ninja
    33	BuildRequires:  python3
    34	BuildRequires:  glibc-devel
    35	BuildRequires:  libgcc
    36	
    37	%description
    38	Source package for the LLVM libc++ standard library and libc++abi runtime.
    39	The libraries use libgcc_s as the unwinder and export only default-version
    40	LLVM_22 symbols.
    41	
    42	%package -n libc++
    43	Summary:        LLVM C++ standard library runtime
    44	Requires:       libc++abi = %{version}-%{release}
    45	
    46	%description -n libc++
    47	Shared LLVM libc++ runtime, built against libc++abi and libgcc_s.
    48	
    49	%package -n libc++-devel
    50	Summary:        LLVM C++ standard library headers and development files
    51	Requires:       libc++ = %{version}-%{release}
    52	Requires:       libc++abi-devel = %{version}-%{release}
    53	
    54	%description -n libc++-devel
    55	Headers, ABI linker script, module metadata, and development files for LLVM
    56	libc++.
    57	
    58	%package -n libc++abi
    59	Summary:        LLVM C++ ABI runtime
    60	
    61	%description -n libc++abi
    62	Shared LLVM libc++abi runtime using libgcc_s rather than LLVM libunwind.
    63	
    64	%package -n libc++abi-devel
    65	Summary:        LLVM C++ ABI development files
    66	Requires:       libc++abi = %{version}-%{release}
    67	
    68	%description -n libc++abi-devel
    69	Linker name for LLVM libc++abi.  Its public headers are installed in the
    70	common c++/v1 tree shipped by libc++-devel.
    71	
    72	%prep
    73	%setup -q -n llvm-%{version}
