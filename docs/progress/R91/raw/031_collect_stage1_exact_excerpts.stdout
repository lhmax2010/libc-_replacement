BASE_MACROS
   115	:Macros
   116	%endif
   117	
   118	Macros:
   119	# clang utils
   120	%__ar_clang llvm-ar
   121	%__ranlib_clang llvm-ranlib
   122	%__cc_clang %{_host}-clang
   123	%__cxx_clang %{_host}-clang++
   124	%__optflags_toolchain_clang -Os -fstack-protector -Wno-unused-command-line-argument -Wno-error=unused-but-set-variable -Wno-error=unused-command-line-argument %{?___optflags_toolchain_clang:%{___optflags_toolchain_clang}}
   125	
   126	# gcc utils
   127	%__ar_gcc gcc-ar
   128	%__ranlib_gcc gcc-ranlib
   129	%__cc_gcc %{_host}-gcc
   130	%__cxx_gcc %{_host}-g++
   131	%__optflags_toolchain_gcc -O2 -fno-inline-functions -fstack-protector-strong %{?___optflags_toolchain_gcc:%{___optflags_toolchain_gcc}}
   132	
   133	%_toolchain %{?_toolchain_override}%{!?_toolchain_override:clang}
   134	%toolchain_is() %((echo "%_toolchain" | %{__grep} -qE "%{1}") && echo 1 || echo 0)
   135	
   136	%__ar %{expand:%%{__ar_%{_toolchain}}}
   137	%__ranlib %{expand:%%{__ranlib_%{_toolchain}}}
   138	%__cc %{expand:%%{__cc_%{_toolchain}}}
   139	%__cxx %{expand:%%{__cxx_%{_toolchain}}}
   140	%__optflags_toolchain %{expand:%%{__optflags_toolchain_%{_toolchain}}}
   141	
   142	%prep %%prep\
   143	export AR=%{__ar} RANLIB=%{__ranlib};\
   144	%{nil}
   145	
   146	%build %%build\
   147	export AR=%{__ar} RANLIB=%{__ranlib};\
   148	export CC=%{__cc} CXX=%{__cxx};\
   149	%{nil}
   150	
   151	%install %{?_enable_debug_packages:%{?buildsubdir:%{debug_package}}}\
   152	%%install\
   153	export AR=%{__ar} RANLIB=%{__ranlib};\
   154	export CC=%{__cc} CXX=%{__cxx};\
   155	%{nil}
   156	:Macros
BASE_ARCH_CROSS
   157	
   158	########## targets ##########
   159	
   160	%ifarch i586
   161	Target: i686-tizen-linux
   162	%endif
   163	
   164	%ifarch armv7hl
   165	Target: armv7hl-tizen-linux
   166	%endif
   167	
   168	%ifarch armv7l
   169	Target: armv7l-tizen-linux
   170	%endif
   171	
   172	%ifarch aarch64
   173	Target: aarch64-tizen-linux
   174	%endif
   175	
   176	%ifarch riscv64
   177	Target: riscv64-tizen-linux
   178	%endif
   179	
   180	########## cross build ##########
   181	
   182	%define build_hostarch x86_64
   183	Macros:
   184	%build_hostarch x86_64
   185	:Macros
   186	
   187	%ifarch riscv64 %arm armv7l armv7hl aarch64
   188	Hostarch: x86_64
   189	# cross build support for the build hosts
   190	Preinstall: qemu-linux-user-%{build_hostarch}-cross
   191	Runscripts: qemu-linux-user-%{build_hostarch}-cross
   192	Keep: qemu-linux-user-%{build_hostarch}-cross
   193	Macros:
   194	%qemu_user_space_build 1
   195	:Macros
   196	%endif
   197	
   198	%ifarch armv7l
   199	Preinstall: qemu-accel-%{build_hostarch}-armv7l
   200	Runscripts: qemu-accel-%{build_hostarch}-armv7l
   201	Preinstall: clang-accel-%{build_hostarch}-armv7l
   202	Runscripts: clang-accel-%{build_hostarch}-armv7l
   203	Preinstall: libmount libblkid libuuid
   204	%endif
   205	
   206	%ifarch armv7hl
   207	Preinstall: qemu-accel-%{build_hostarch}-armv7hl
   208	Runscripts: qemu-accel-%{build_hostarch}-armv7hl
   209	Preinstall: clang-accel-%{build_hostarch}-armv7hl
   210	Runscripts: clang-accel-%{build_hostarch}-armv7hl
   211	Preinstall: libmount libblkid libuuid
   212	%endif
   213	
   214	%ifarch aarch64
   215	Preinstall: qemu-accel-%{build_hostarch}-aarch64
   216	Runscripts: qemu-accel-%{build_hostarch}-aarch64
   217	Preinstall: clang-accel-%{build_hostarch}-aarch64
   218	Runscripts: clang-accel-%{build_hostarch}-aarch64
   219	Preinstall: libmount libblkid libuuid
   220	%endif # aarch64
   221	
   222	%ifarch riscv64
   223	Preinstall: qemu-accel-%{build_hostarch}-riscv64
   224	Runscripts: qemu-accel-%{build_hostarch}-riscv64
   225	Preinstall: clang-accel-%{build_hostarch}-riscv64
   226	Runscripts: clang-accel-%{build_hostarch}-riscv64
   227	Preinstall: libmount libblkid libuuid
   228	%endif # riscv64
   229	
   230	Substitute: python-accel-armv7l-cross-arm python-accel-%{build_hostarch}-armv7l
UNIFIED_BUILD_AND_BASE
   147	Macros:
   148	%_with_introspection 1
   149	:Macros
   150	
   151	Macros:
   152	%build %%build\
   153	export AR=%{__ar} RANLIB=%{__ranlib};\
   154	export CC=%{__cc} CXX=%{__cxx};\
   155	export MAKEFLAGS+=" -k";\
   156	%{nil}
   157	:Macros
