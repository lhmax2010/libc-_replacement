   206	CC=clang CXX=clang++ \
   207	cmake \
   208	  -DCMAKE_C_COMPILER=clang \
   209	  -DCMAKE_CXX_COMPILER=clang++ \
   210	  -DCMAKE_VERBOSE_MAKEFILE=ON \
   211	  -GNinja \
   212	  -DTFLITE_BUILD_SHARED_LIB="%{SHARED_LIB}" \
   213	  -DTFLITE_ENABLE_XNNPACK="%{USE_XNNPACK}" \
   214	  -DTFLITE_ENABLE_GPU="%{USE_OPENCL}" \
   215	  ../tensorflow/lite
   230	cmake --build . %{?_smp_mflags}
