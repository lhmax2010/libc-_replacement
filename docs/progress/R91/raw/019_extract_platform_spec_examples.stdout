   190	# VD/TV: Disable a link-time optimization (requested on 2020-06-09)
   191	%if "%{?profile}" == "tv"
   192	  EXTRA_CFLAGS="${EXTRA_CFLAGS} -fno-lto"
   193	  EXTRA_CXXFLAGS="${EXTRA_CXXFLAGS} -fno-lto"
   194	  %ifarch armv7l
   195	    EXTRA_CFLAGS="${EXTRA_CFLAGS} -march=armv7-a -mtune=cortex-a8"
   196	    EXTRA_CXXFLAGS="${EXTRA_CXXFLAGS} -march=armv7-a -mtune=cortex-a8"
   197	    EXTRA_CFLAGS=${EXTRA_CFLAGS/-mcpu=cortex-a53/}
   198	    EXTRA_CXXFLAGS=${EXTRA_CXXFLAGS/-mcpu=cortex-a53/}
   199	  %endif
   200	%endif
   201	%endif # USE_CLANG
