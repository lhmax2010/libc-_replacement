   215	# TF2Lite users do: #include <tensorflow/FILENAME.h>
   230	install -m 0655 ./build/tools/benchmark/benchmark_model %{buildroot}%{_bindir}/tflite_benchmark_model
   231	
   232	## install headers
   233	pushd tensorflow/lite
   234	find . -name "*.h" -type f -exec cp --parents {} %{buildroot}%{_includedir}/tensorflow2/lite \;
   235	popd
   236	
   237	pushd tensorflow/compiler/mlir
   238	find . -name "*.h" -type f -exec cp --parents {} %{buildroot}%{_includedir}/tensorflow2/compiler/mlir \;
   239	popd
   240	
   241	### rename tensorflow -> tensorflow2
   242	pushd %{buildroot}%{_includedir}/tensorflow2/
   243	for HEADER in `find -name '*.h'`; do
   244	  sed -i 's|#\W*include\W*<tensorflow/|#include <tensorflow2/|' ${HEADER}
   245	  sed -i 's|#\W*include\W*"tensorflow/|#include "tensorflow2/|' ${HEADER}
   246	done
   247	popd
   248	
   249	## install flatbuffers header for tensorflow lite
   250	mkdir -p %{buildroot}%{_includedir}/tensorflow2/flatbuffers
