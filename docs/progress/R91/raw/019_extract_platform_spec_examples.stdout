   211	RELCFLAGS=$(echo $CFLAGS | sed -e 's*\(^\|[[:space:]]\)-g\([[:digit:]]\+\|gdb\|dwarf-[[:digit:]]\)\?* *g')
   212	export CFLAGS=${RELCFLAGS}
   213	RELCXXFLAGS=$(echo $CXXFLAGS | sed -e 's*\(^\|[[:space:]]\)-g\([[:digit:]]\+\|gdb\|dwarf-[[:digit:]]\)\?* *g')
   214	export CXXFLAGS=${RELCXXFLAGS}
   215	RELFFLAGS=$(echo $FFLAGS | sed -e 's*\(^\|[[:space:]]\)-g\([[:digit:]]\+\|gdb\)|dwarf-[[:digit:]]\\?* *g')
   230	MLGO_BUILD_DIR="$PWD/build"
   231	MLGO_RUNTIME_OBJECTS="${MLGO_AOT_DIR}/xla_runtime_objects/xla_compiled_cpu_function.cc.o;${MLGO_AOT_DIR}/xla_runtime_objects/cpu_function_runtime.cc.o;${MLGO_AOT_DIR}/xla_runtime_objects/custom_call_status.cc.o;${MLGO_AOT_DIR}/xla_runtime_objects/executable_run_options.cc.o;${MLGO_AOT_DIR}/xla_runtime_objects/runtime_single_threaded_matmul_f32.cc.o"
   232	MLGO_REQUIRED_RUNTIME_OBJECTS="xla_compiled_cpu_function.cc.o cpu_function_runtime.cc.o custom_call_status.cc.o executable_run_options.cc.o runtime_single_threaded_matmul_f32.cc.o"
   233	%endif
   234	
   235	mkdir -p build
   236	cd build
   237	cmake \
   238	    -G Ninja \
   239	    -DTIZEN=1 \
   240	    -DCMAKE_C_COMPILER=%__cc \
   241	    -DCMAKE_CXX_COMPILER=%__cxx \
   242	    -DLLVM_HOST_TRIPLE=%{_host} \
   243	    -DLLVM_DEFAULT_TARGET_TRIPLE=%{_host} \
   244	    -DLLVM_TARGET_TRIPLE_ENV=%{_host} \
   245	    -DCMAKE_ASM_FLAGS="$CFLAGS" \
   246	    -DCMAKE_C_FLAGS="$CFLAGS" \
   247	    -DCMAKE_CXX_FLAGS="$CXXFLAGS" \
   248	%if %{defined _toolchain}
   249	    -DCMAKE_SHARED_LINKER_FLAGS="-fuse-ld=lld -ffunction-sections -fdata-sections -Wl,--gc-sections" \
   250	    -DCMAKE_EXE_LINKER_FLAGS="-fuse-ld=lld -ffunction-sections -fdata-sections -Wl,--gc-sections" \
