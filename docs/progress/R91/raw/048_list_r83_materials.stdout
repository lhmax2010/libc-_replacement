docs/progress/R83/raw/009_gbs_and_prior_material_context.command.txt:1:bash -lc $'\nprintf "GBS_VERSION\\n"; gbs --version 2>&1 || true\nprintf "GBS_BUILD_HELP_RELEVANT\\n"; gbs build --help 2>&1 | rg -n "conf|repository|repo|arch|clean|include-all|exclude|output|root|build" | head -n 240 || true\nprintf "PRIOR_REPORT_REFERENCES\\n"; rg -n --glob "REPORT.md" --glob "*.sh" --glob "*.conf" "project_config|include-all|gbs build|build-conf|libcxx-runtimes|Unified-Toolchain|Base-Toolchain" docs progress codes 2>/dev/null | head -n 300\nprintf "ROOT_GBS_CONFIG_STATE\\n"; if test -f gbs_llvm.conf; then nl -ba gbs_llvm.conf; else echo NOT_AVAILABLE; fi\nprintf "QB_TOP\\n"; git -C codes/qb status --porcelain=v1; git -C codes/qb rev-parse HEAD; find codes/qb -maxdepth 3 -type f -printf "%p\\n" | sort | head -n 240\n' 
--
docs/progress/R83/raw/021_local_build_feasibility.command.txt:1:bash -lc $'\nset -u\nprintf "%s\\n" "== current resources =="\ncat /proc/loadavg\nfree -h\ndf -h .\nprintf "%s\\n" "== R9C relevant command files =="\nfind progress/R9C docs/progress/R9C -type f 2>/dev/null | sort | rg -i "build|gbs|config" | head -200\nprintf "%s\\n" "== exact gbs build invocations in R9B/R9C =="\nrg -n "gbs .*build|CMD=\\(gbs|gbs -c" progress/R9B progress/R9C docs/progress/R9C 2>/dev/null --glob "*.sh" --glob "*.command.txt" --glob "*.log" | head -300\nprintf "%s\\n" "== available prior config/buildconf =="\nfor f in progress/T3R/config/gbs_llvm.conf artifacts/rebuild_2218_c2/x86_64/tizen_unified_standard.conf gbs_llvm.conf; do test -f "$f" && { echo "### $f"; sha256sum "$f"; sed -n "1,120p" "$f"; }; done\n' 
--
