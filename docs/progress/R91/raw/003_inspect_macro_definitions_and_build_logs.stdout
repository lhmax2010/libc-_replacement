===== Base compiler macro block =====
    88	
    89	############################# build config #####################################
    90	
    91	########## compilers and utils ##########
    92	
    93	%ifarch armv7l aarch64
    94	Macros:
    95	%_with_mlgo 1
    96	%mlgo_build_jobs 6
    97	%mlgo_verify_configure_only 0
    98	:Macros
    99	%endif
   100	
   101	%ifarch armv7l armv7hl
   102	Macros:
   103	%___optflags_toolchain_gcc --param=ssp-buffer-size=4
   104	:Macros
   105	%endif
   106	%ifarch aarch64 riscv64
   107	Macros:
   108	%___optflags_toolchain_gcc -feliminate-unused-debug-types
   109	:Macros
   110	%endif
   111	%ifarch i686 x86_64
   112	Macros:
   113	%___optflags_toolchain_gcc --param=ssp-buffer-size=4 -feliminate-unused-debug-types
   114	%___optflags_toolchain_clang -momit-leaf-frame-pointer %{?_with_mlgo:-mllvm=-regalloc-enable-advisor=release -mllvm=-enable-ml-inliner=release}
   115	:Macros
   116	%endif
   117	
   118	Macros:
   119	# clang utils
   120	%__ar_clang llvm-ar
   121	%__ranlib_clang llvm-ranlib
   122	%__cc_clang %{_host}-clang
   123	%__cxx_clang %{_host}-clang++
   124	%__optflags_toolchain_clang -Os -fstack-protector -Wno-unused-command-line-argument -Wno-error=unused-but-set-variable -Wno-error=unused-command-line-argument %{?___optflags_toolchain_clang:%{___optflags_toolchain_clang}}
   125	
   126	# gcc utils
   127	%__ar_gcc gcc-ar
   128	%__ranlib_gcc gcc-ranlib
   129	%__cc_gcc %{_host}-gcc
   130	%__cxx_gcc %{_host}-g++
   131	%__optflags_toolchain_gcc -O2 -fno-inline-functions -fstack-protector-strong %{?___optflags_toolchain_gcc:%{___optflags_toolchain_gcc}}
   132	
   133	%_toolchain %{?_toolchain_override}%{!?_toolchain_override:clang}
   134	%toolchain_is() %((echo "%_toolchain" | %{__grep} -qE "%{1}") && echo 1 || echo 0)
   135	
   136	%__ar %{expand:%%{__ar_%{_toolchain}}}
   137	%__ranlib %{expand:%%{__ranlib_%{_toolchain}}}
   138	%__cc %{expand:%%{__cc_%{_toolchain}}}
   139	%__cxx %{expand:%%{__cxx_%{_toolchain}}}
   140	%__optflags_toolchain %{expand:%%{__optflags_toolchain_%{_toolchain}}}
   141	
   142	%prep %%prep\
   143	export AR=%{__ar} RANLIB=%{__ranlib};\
   144	%{nil}
   145	
   146	%build %%build\
   147	export AR=%{__ar} RANLIB=%{__ranlib};\
   148	export CC=%{__cc} CXX=%{__cxx};\
   149	%{nil}
   150	
   151	%install %{?_enable_debug_packages:%{?buildsubdir:%{debug_package}}}\
   152	%%install\
   153	export AR=%{__ar} RANLIB=%{__ranlib};\
   154	export CC=%{__cc} CXX=%{__cxx};\
   155	%{nil}
   156	:Macros
   157	
