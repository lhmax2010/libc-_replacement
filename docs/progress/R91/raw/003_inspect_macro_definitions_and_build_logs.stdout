   224	Runscripts: qemu-accel-%{build_hostarch}-riscv64
   225	Preinstall: clang-accel-%{build_hostarch}-riscv64
   226	Runscripts: clang-accel-%{build_hostarch}-riscv64
   227	Preinstall: libmount libblkid libuuid
   228	%endif # riscv64
