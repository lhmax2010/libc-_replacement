      "sha256": "2eba76c4110dca0de24d5aef15f029a1d8496fd33e9c81a5f37594b5c3a7dc83",
      "text": "1: #ifndef DALI_CONDITIONAL_WAIT_H\n2: #define DALI_CONDITIONAL_WAIT_H\n3: \n4: /*\n5:  * Copyright (c) 2024 Samsung Electronics Co., Ltd.\n6:  *\n7:  * Licensed under the Apache License, Version 2.0 (the \"License\");\n8:  * you may not use this file except in compliance with the License.\n9:  * You may obtain a copy of the License at\n10:  *\n11:  * http://www.apache.org/licenses/LICENSE-2.0\n12:  *\n13:  * Unless required by applicable law or agreed to in writing, software\n14:  * distributed under the License is distributed on an \"AS IS\" BASIS,\n15:  * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n16:  * See the License for the specific language governing permissions and\n17:  * limitations under the License.\n18:  *\n19:  */\n20: \n21: // EXTERNAL INCLUDES\n22: #include <chrono> ///< for std::chrono::time_point\n23: \n24: // INTERNAL INCLUDES\n25: #include <dali/public-api/common/dali-common.h>\n26: \n27: namespace Dali\n28: {\n29: /**\n30:  * Helper class to allow conditional waiting and notifications between multiple threads.\n31:  */\n32: class DALI_CORE_API ConditionalWait\n33: {\n34: public:\n35:   /**\n36:    * @brief Allows client code to synchronize updates to its own state with the\n37:    * internal state of a ConditionalWait object.\n38:    */\n39:   class DALI_CORE_API ScopedLock\n40:   {\n41:   public:\n42:     /**\n43:      * Constructor\n44:      * @brief Will acquire the internal mutex of the ConditionalWait object passed in.\n45:      * @param[in] wait The ConditionalWait object to lock.\n46:      */\n47:     ScopedLock(ConditionalWait& wait);\n48: \n49:     /**\n50:      * Destructor\n51:      * @brief Will release the internal mutex of the ConditionalWait object passed in.\n52:      */\n53:     ~ScopedLock();\n54: \n55:     /**\n56:      * Getter for the ConditionalWait locked for this instance's lifetime.\n57:      * @return the ConditionalWait object currently locked.\n58:      */\n59:     ConditionalWait& GetLockedWait() const;\n60: \n61:   public: // Data, public to allow nesting class to access\n62:     struct ScopedLockImpl;\n63:     ScopedLockImpl* mImpl;\n64: \n65:   private:\n66:     // Not implemented as ScopedLock cannot be copied:\n67:     ScopedLock(const ScopedLock&);\n68:     const ScopedLock& operator=(const ScopedLock&);\n69:   };\n70: \n71:   using TimePoint = std::chrono::time_point<std::chrono::steady_clock>;\n72: \n73:   /**\n74:    * @brief Constructor, creates the internal synchronization objects\n75:    */\n76:   ConditionalWait();\n77: \n78:   /**\n79:    * @brief Destructor, non-virtual as this is not a base class\n80:    */\n81:   ~ConditionalWait();\n82: \n83:   /**\n84:    * @brief Notifies another thread to continue if it is blocked on a wait.\n85:    *\n86:    * Can be called from any thread.\n87:    * Does not block the current thread but may cause a rescheduling of threads.\n88:    */\n89:   void Notify();\n90: \n91:   /**\n92:    * @brief Notifies another thread to continue if it is blocked on a wait.\n93:    *\n94:    * Assumes that the ScopedLock object passed in has already locked the internal state of\n95:    * this object.\n96:    * Can be called from any thread.\n97:    * Does not block the current thread but may cause a rescheduling of threads.\n98:    *\n99:    * @param[in] scope A pre-existing lock on the internal state of this object.\n100:    */\n101:   void Notify(const ScopedLock& scope);\n102: \n103:   /**\n104:    * @brief Wait for another thread to notify us when the condition is true and we can continue\n105:    *\n106:    * Will always block current thread until Notify is called\n107:    */\n108:   void Wait();\n109: \n110:   /**\n111:    * @brief Wait for another thread to notify us when the condition is true and we can continue\n112:    *\n113:    * Will always block current thread until Notify is called.\n114:    * Assumes that the ScopedLock object passed in has already locked the internal state of\n115:    * this object. Releases the lock while waiting and re-acquires it when returning\n116:    * from the wait.\n117:    * @param[in] scope A pre-existing lock on the internal state of this object.\n118:    * @pre scope must have been passed this ConditionalWait during its construction.\n119:    */\n120:   void Wait(const ScopedLock& scope);\n121: \n122:   /**\n123:    * @brief Wait until specific time point or another thread to notify us when the condition is true and we can continue\n124:    *\n125:    * Will always block current thread until Notify is called.\n126:    * Assumes that the ScopedLock object passed in has already locked the internal state of\n127:    * this object. Releases the lock while waiting and re-acquires it when returning\n128:    * from the wait.\n129:    * @param[in] scope A pre-existing lock on the internal state of this object.\n130:    * @param[in] timePoint Maximum time point to wait.\n131:    * @pre scope must have been passed this ConditionalWait during its construction.\n132:    */\n133:   void WaitUntil(const ScopedLock& scope, TimePoint timePoint);\n134: \n135:   /**\n136:    * @brief Return the count of threads waiting for this conditional\n137:    * @return count of waits\n138:    */\n139:   unsigned int GetWaitCount() const;\n140: \n141: private:\n142:   // Not implemented as ConditionalWait is not copyable\n143:   ConditionalWait(const ConditionalWait&);\n144:   const ConditionalWait& operator=(const ConditionalWait&);\n145: \n146:   struct ConditionalWaitImpl;\n147:   ConditionalWaitImpl* mImpl;\n148: };\n149: \n150: } // namespace Dali\n151: \n152: #endif // DALI_CONDITIONAL_WAIT_H"
    }
  ],
