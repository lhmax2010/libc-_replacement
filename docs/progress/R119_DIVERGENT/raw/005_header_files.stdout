   *  was typedef long.
  */  
#ifdef __INT64_TYPE__
  typedef __INT64_TYPE__          streamoff;
#else
  typedef long long     streamoff;
#endif

  /// Integral type for I/O operation counts and buffer sizes.
  typedef ptrdiff_t	streamsize; // Signed integral type

  /**
