   524	class _LIBCPP_EXPORTED_FROM_ABI __assoc_sub_state : public __shared_count {
   525	protected:
   526	  exception_ptr __exception_;
   527	  mutable mutex __mut_;
   528	  mutable condition_variable __cv_;
   529	  unsigned __state_;
