   531	  void __on_zero_shared() _NOEXCEPT override;
   532	  void __sub_wait(unique_lock<mutex>& __lk);
   533	
   534	public:
   535	  enum { __constructed = 1, __future_attached = 2, ready = 4, deferred = 8 };
   536	
   537	  _LIBCPP_HIDE_FROM_ABI __assoc_sub_state() : __state_(0) {}
   538	
   539	  _LIBCPP_HIDE_FROM_ABI bool __has_value() const { return (__state_ & __constructed) || (__exception_ != nullptr); }
   540	
   541	  _LIBCPP_HIDE_FROM_ABI void __attach_future() {
   542	    lock_guard<mutex> __lk(__mut_);
   543	    bool __has_future_attached = (__state_ & __future_attached) != 0;
   544	    if (__has_future_attached)
   545	      std::__throw_future_error(future_errc::future_already_retrieved);
   546	    this->__add_shared();
   547	    __state_ |= __future_attached;
   548	  }
   549	
   550	  _LIBCPP_HIDE_FROM_ABI void __set_deferred() { __state_ |= deferred; }
   551	
   552	  void __make_ready();
   553	  _LIBCPP_HIDE_FROM_ABI bool __is_ready() const { return (__state_ & ready) != 0; }
   554	
   555	  void set_value();
   556	  void set_value_at_thread_exit();
   557	
   558	  void set_exception(exception_ptr __p);
   559	  void set_exception_at_thread_exit(exception_ptr __p);
   560	
   561	  void copy();
   562	
   563	  void wait();
   564	  template <class _Rep, class _Period>
   565	  future_status _LIBCPP_HIDE_FROM_ABI wait_for(const chrono::duration<_Rep, _Period>& __rel_time) const;
   566	  template <class _Clock, class _Duration>
   567	  _LIBCPP_HIDE_FROM_ABI future_status wait_until(const chrono::time_point<_Clock, _Duration>& __abs_time) const {
   568	    unique_lock<mutex> __lk(__mut_);
   569	    if (__state_ & deferred)
   570	      return future_status::deferred;
   571	    while (!(__state_ & ready) && _Clock::now() < __abs_time)
   572	      __cv_.wait_until(__lk, __abs_time);
   573	    if (__state_ & ready)
