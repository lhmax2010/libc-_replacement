  1043	# C compiler flags.  This is traditionally called CFLAGS in makefiles.
  1044	# Historically also available as %%{optflags}, and %%build sets the
  1045	# environment variable RPM_OPT_FLAGS to this value.
  1046	%build_cflags %{optflags}
  1047	
  1048	# C++ compiler flags.  This is traditionally called CXXFLAGS in makefiles.
  1049	%build_cxxflags %{optflags}
  1050	
  1051	# Link editor flags.  This is usually called LDFLAGS in makefiles.
  1052	#%build_ldflags -Wl,-z,relro
  1053	
  1054	# Expands to shell code to seot the compiler/linker environment
  1055	# variables CFLAGS, CXXFLAGS, LDFLAGS if they have
  1056	# not been set already.
  1057	%set_build_flags \
  1058	  CFLAGS="${CFLAGS:-%{?build_cflags}}" ; export CFLAGS ; \
  1059	  CXXFLAGS="${CXXFLAGS:-%{?build_cxxflags}}" ; export CXXFLAGS ; \
  1060	  LDFLAGS="${LDFLAGS:-%{?build_ldflags}}" ; export LDFLAGS
