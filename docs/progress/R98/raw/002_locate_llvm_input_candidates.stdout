docs/progress/R83/raw/037_delivery_content_validation.command.txt:1:bash -lc $'\nset -u\nprintf "%s\\n" "== bash fence syntax =="\nawk \'/^```bash$/ {inside=1; next} /^```$/ {if (inside) {inside=0; print ""}; next} inside {print}\' progress/R83/GBS_RUNBOOK.md | bash -n\nprintf "%s\\n" "BASH_FENCES=SYNTAX_OK"\nprintf "%s\\n" "== expected files =="\nfind progress/R83 -maxdepth 2 -type f -printf "%P\\t%s\\n" | LC_ALL=C sort\nprintf "%s\\n" "== no unresolved generic placeholders =="\nif rg -n "TODO|TBD|<账号>|<路径>|PLACEHOLDER" progress/R83/REPORT.md progress/R83/*.md progress/R83/artifacts progress/R83/tables; then exit 91; else echo NONE; fi\nprintf "%s\\n" "== evidence reference existence =="\nfor f in progress/R83/PACKAGING_INVENTORY.md progress/R83/PROJECT_CONFIG_ANALYSIS.md progress/R83/GBS_RUNBOOK.md progress/R83/DEPENDENCIES_AND_TRIAGE.md progress/R83/artifacts/PROJECT_CONFIG_CHANGES.diff progress/R83/tables/exported_patch_inventory.tsv progress/R83/tables/packaging_files.tsv progress/R83/tables/layer_c_install_paths.tsv progress/R83/tables/known45_source_rpms.txt progress/R83/tables/hardcoded_lstdcxx_13.tsv progress/R83/tables/self_decisions_and_questions.tsv; do test -s "$f"; done\necho REFERENCES=PASS\nprintf "%s\\n" "== line/count assertions =="\ntest "$(wc -l < progress/R83/tables/known45_source_rpms.txt)" -eq 45\ntest "$(($(wc -l < progress/R83/tables/hardcoded_lstdcxx_13.tsv)-1))" -eq 13\ntest "$(($(wc -l < progress/R83/tables/exported_patch_inventory.tsv)-1))" -eq 10\nrg -q "Patch6" progress/R83/REPORT.md\nrg -q "SOURCE_PROVENANCE" progress/R83/REPORT.md\necho COUNTS=PASS\nprintf "%s\\n" "== originals/worktree unchanged =="\nsha256sum codes/qb/TIZEN/Tizen/Tizen-Base-Toolchain/project_config codes/qb/TIZEN/Tizen/Tizen-Unified-Toolchain/project_config\ngit -C tmp/R83/sandbox status --porcelain=v1\ngit -C tmp/R83/sandbox rev-parse HEAD\ngit diff -- codes/qb/TIZEN/Tizen/Tizen-Base-Toolchain/project_config codes/qb/TIZEN/Tizen/Tizen-Unified-Toolchain/project_config\n' 
docs/progress/R83/raw/023_config_exact_lines_and_runtime_metadata.command.txt:1:bash -lc $'\nset -u\nbase=codes/qb/TIZEN/Tizen/Tizen-Base-Toolchain/project_config\nunified=codes/qb/TIZEN/Tizen/Tizen-Unified-Toolchain/project_config\nprintf "%s\\n" "== Base exact relevant regions =="\nnl -ba "$base" | sed -n "25,48p;120,145p;270,320p"\nprintf "%s\\n" "== Unified exact relevant regions =="\nnl -ba "$unified" | sed -n "1,45p;120,175p"\nprintf "%s\\n" "== branch/repository selectors in configs =="\nrg -n -i "llvm|libc\\\\+\\\\+|libstdc\\\\+\\\\+|git|branch|sandbox|repository|repo" "$base" "$unified" || true\nprintf "%s\\n" "== prior libcxx package metadata =="\nfor p in artifacts/rebuild_2218_c2/x86_64/libc++-22.1.8-1.x86_64.rpm artifacts/rebuild_2218_c2/x86_64/libc++-devel-22.1.8-1.x86_64.rpm artifacts/rebuild_2218_c2/x86_64/libc++abi-22.1.8-1.x86_64.rpm artifacts/rebuild_2218_c2/x86_64/libc++abi-devel-22.1.8-1.x86_64.rpm; do\n  test -f "$p" || continue\n  echo "### $p"\n  rpm -qp --qf "NAME=%{NAME}\\nNEVRA=%{NEVRA}\\nSIZE=%{SIZE}\\n" "$p"\n  echo "PROVIDES"; rpm -qp --provides "$p"\n  echo "REQUIRES"; rpm -qp --requires "$p"\n  echo "CONFLICTS"; rpm -qp --conflicts "$p"\ndone\n' 
