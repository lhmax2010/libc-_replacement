38-Name:           glibc
39-VCS:            platform/upstream/glibc#8f08a7e30396822a8d969d357822a6ffd56b43fb
40-Summary:        Standard Shared Libraries (from the GNU C Library)
--
365-function glibc_configure () {
366-  local aux_options=${@:1}
367-
368-  CFLAGS="$conf_cflags" BUILD_CFLAGS="$conf_cflags" \
369:  CC="%{__cc}" CXX="%{__cxx}" \
370-  ../configure \
371-  --prefix=%{_prefix} \
372-  --libexecdir=%{_libexecdir} --infodir=%{_infodir} \
373-%ifarch riscv64
--
413-
414-#
415-# Build glibc_post_upgrade binary
416-#
417:%{__cc} \
418-    -static %{optflags} -Os \
419-    $RPM_SOURCE_DIR/glibc_post_upgrade.c -o glibc_post_upgrade \
420-    -L. -Bcsu \
421-    '-DREMOVE_TLS_DIRS' '-DREMOVE_PPC_OPTIMIZE_POWER5' \
--
461-%endif
462-CPPFLAGS+=" -DASAN_INIT_FIRST"
463-
464-# build static wrapper, because we don't want asan to intercept allocators
465:%{__cxx} -o gcc-wrapper gcc-wrapper.cc -O3 -funroll-loops -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-exceptions -static
466-
467-rm -rf $ASAN_BUILD
468-mkdir -p $ASAN_BUILD
469-pushd $ASAN_BUILD
470-
471-CPPFLAGS=$CPPFLAGS \
472:	CC=$GLIBC/gcc-wrapper $GLIBC/configure $configure_flags
473-
474-# Quick build - builds only libraries, but does not create symlinks.
475-make -r %{?_smp_mflags} -C $GLIBC objdir=`pwd` subdir_lib
476-# make -r %{?_smp_mflags} -C $GLIBC objdir=`pwd` install_root=$ASAN_INST install-lib
--
494-%endif
495-CPPFLAGS+=" -DASAN_INIT_FIRST"
496-
497-# build static wrapper, because we don't want asan to intercept allocators
498:%{__cxx} -o gcc-wrapper gcc-wrapper.cc -O3 -funroll-loops -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-exceptions -static -DHWASAN_BUILD
499-
500-rm -rf $ASAN_BUILD
