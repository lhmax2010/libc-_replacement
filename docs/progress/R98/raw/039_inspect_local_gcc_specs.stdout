49c5060508ce8a6ed6beca375233688a6bdd9140
FILE=codes/gcc/packaging/gcc.spec
25-# acceleration collect2 cannot use liblto_plugin.so of "stage1".
26-# Also compiler is not required to support bootstrap for cross-compile
27-%{?cross:%undefine bootstrap}
28-
29-# Always build gcc with gcc compiler
30:%define _toolchain_override gcc
31-
32-# Bootstrap build constrains for ASan config
33-%if 0%{?asanbootstrap}
34-  %ifarch %arm aarch64 # or #if 0#{?qemu_user_space_build}
35-    %{error:"'asanbootstrap' supposed to be used with i586/x86_64 arch"}
