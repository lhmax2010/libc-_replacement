   358	TEST_F(CyadCommandlineDispatcherTest, checkReturnErrorNegative) {
   359	    using ::testing::_;
   360	    using ::testing::DoAll;
   361	    using ::testing::HasSubstr;
   362	    using ::testing::Invoke;
   363	    using ::testing::NotNull;
   364	    using ::testing::Return;
   365	    using ::testing::StrEq;
   366	    using ::testing::Unused;
   367	
   368	    Cynara::CommandsDispatcher dispatcher(m_io, m_adminApi, m_errorApi);
   369	
   370	    Cynara::CheckCyadCommand command("", true, { "client", "user", "privilege" });
