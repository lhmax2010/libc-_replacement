    22	/*
    23	 * @file        fstream-helper.h
    24	 * @author      Marek Smolinski (m.smolinski@samsung.com)
    25	 * @version     1.0
    26	 * @brief       This file is the implementation file of fstream-helper
    27	 *
    28	 */
    29	
    30	#pragma once
    31	
    32	namespace DPL {
    33	
    34	/*
    35	 * Bypass lack of public member function to get file
    36	 * descriptor from fstream objects in std
    37	 * This feature is needed for flushing data from kernel space buffer to
    38	 * physical device [fsync(int fd) - syscall] on opened fstream object
    39	*/
    40	
    41	template<typename T>
    42	class FstreamAccessors : T::__filebuf_type {
    43	    typedef FstreamAccessors<T> MyType;
    44	public:
    45	    static int GetFd(T &strm) {
    46	        return static_cast<MyType *>(strm.rdbuf())->_M_file.fd();
    47	    }
    48	};
    49	
    50	} // namespace DPL
