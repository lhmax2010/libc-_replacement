    98	TEST_F(CyadCommandlineDispatcherTest, setBucketPositive) {
    99	    using ::testing::_;
   100	    using ::testing::Return;
   101	    using ::testing::StrEq;
   102	    using ::testing::IsNull;
   103	    using ::testing::NotNull;
   104	    using Cynara::PolicyBucketId;
   105	    using Cynara::PolicyType;
   106	    using Cynara::PolicyResult;
   107	
   108	    addDescriptions({ { 42, "hitchhiker" } });
   109	
   110	    typedef std::string RawPolicyType;
   111	    typedef std::string Metadata;
   112	    typedef std::tuple<PolicyBucketId, PolicyType, RawPolicyType, Metadata> BucketData;
   113	
   114	    typedef std::vector<BucketData> Buckets;
   115	    const Buckets buckets = {
   116	        {"test-bucket-1", CYNARA_ADMIN_ALLOW, "ALLOW", ""},
   117	        {"test-bucket-2", CYNARA_ADMIN_DENY, "DENY", ""},
   118	        {"test-bucket-3", CYNARA_ADMIN_BUCKET, "BUCKET", "other-bucket"},
   119	        {"test-bucket-2", CYNARA_ADMIN_NONE, "NONE", ""},
   120	        {"test-bucket-4", 42, "hitchhiker", "douglas-noel-adams"}
   121	    };
   122	
   123	    Cynara::CommandsDispatcher dispatcher(m_io, m_adminApi, m_errorApi);
   124	
   125	    for (auto &bucket : buckets) {
   126	        auto &bucketId = std::get<0>(bucket);
   127	        auto &policyType = std::get<1>(bucket);
   128	        auto &rawPolicyType = std::get<2>(bucket);
   129	        auto &metadata = std::get<3>(bucket);
   130	
   131	        SCOPED_TRACE(bucketId);
   132	
   133	        Cynara::SetBucketCyadCommand result(bucketId, { rawPolicyType, metadata });
   134	
   135	        if (metadata.empty() == false) {
   136	            EXPECT_CALL(m_adminApi,
   137	                    cynara_admin_set_bucket(_, StrEq(bucketId.c_str()), policyType,
   138	                                            StrEq(metadata.c_str())))
   139	                .WillOnce(Return(CYNARA_API_SUCCESS));
   140	        } else {
   141	            EXPECT_CALL(m_adminApi,
   142	                    cynara_admin_set_bucket(_, StrEq(bucketId.c_str()), policyType, IsNull()))
   143	                .WillOnce(Return(CYNARA_API_SUCCESS));
   144	        }
   145	
   146	        dispatcher.execute(result);
   147	    }
   148	}
