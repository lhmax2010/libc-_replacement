   372	    auto setErrorMessage = [] (Unused, char *buf, std::size_t buflen) {
   373	        strncpy(buf, "Test error message", buflen);
   374	    };
   375	
   376	    EXPECT_CALL(m_adminApi, cynara_admin_check(_, StrEq(""), true, StrEq("client"), StrEq("user"),
   377	                                             StrEq("privilege"), NotNull(), NotNull()))
