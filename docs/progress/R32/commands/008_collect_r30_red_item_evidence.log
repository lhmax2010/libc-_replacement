   381	    EXPECT_CALL(m_errorApi, cynara_strerror(CYNARA_API_UNKNOWN_ERROR, NotNull(), _))
   382	        .WillOnce(DoAll(Invoke(setErrorMessage), Return(CYNARA_API_SUCCESS)));
   383	
   384	    dispatcher.execute(command);
   385	
   386	    ASSERT_THAT(m_io.cerrRaw().str(), HasSubstr("Test error message"));
