   351	          codecvt_base::result __r;
   352	          const char_type* __e = this->gptr();
   353	          char* __extbe;
   354	          do {
   355	            __r = __cv_->out(__st_, __e, this->egptr(), __e, __extbuf_, __extbuf_ + __ebs_, __extbe);
