   319	int wbuffer_convert<_Codecvt, _Elem, _Tr>::sync() {
   320	  _LIBCPP_SUPPRESS_DEPRECATED_POP
   321	  if (__cv_ == 0 || !__bufptr_)
   322	    return 0;
