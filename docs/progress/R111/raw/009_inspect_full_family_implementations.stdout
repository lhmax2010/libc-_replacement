   380	template <class _Codecvt, class _Elem, class _Tr>
   381	bool wbuffer_convert<_Codecvt, _Elem, _Tr>::__read_mode() {
   382	  if (!(__cm_ & ios_base::in)) {
   383	    this->setp(0, 0);
