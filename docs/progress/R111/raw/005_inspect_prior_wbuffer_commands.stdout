===== docs/progress/R86/raw/003_five_site_libcxx_source.command.txt =====
bash -lc $'\nset -e\nfiles=(\n  codes/llvm/libcxx/include/__condition_variable/condition_variable.h\n  codes/llvm/libcxx/src/condition_variable.cpp\n  codes/llvm/libcxx/include/__locale_dir/wbuffer_convert.h\n  codes/llvm/libcxx/include/future\n  codes/llvm/libcxx/src/future.cpp\n  codes/llvm/libcxx/include/__thread/support/pthread.h\n)\nfor f in "${files[@]}"; do\n  echo "===== $f ====="\n  case "$f" in\n    *condition_variable.h) nl -ba "$f" | sed -n "90,240p" ;;\n    *condition_variable.cpp) nl -ba "$f" | sed -n "20,80p" ;;\n    *wbuffer_convert.h) nl -ba "$f" | sed -n "100,145p;380,435p" ;;\n    */future) nl -ba "$f" | sed -n "490,550p;830,930p" ;;\n    *future.cpp) nl -ba "$f" | sed -n "80,145p" ;;\n    *pthread.h) nl -ba "$f" | sed -n "110,135p" ;;\n  esac\ndone\n' 
===== docs/progress/R86/raw/004_wbuffer_and_exception_contracts.command.txt =====
bash -lc $'\nset -e\nfor f in codes/llvm/libcxx/include/__locale_dir/wbuffer_convert.h codes/llvm/libcxx/include/__streambuf/basic_streambuf.h codes/llvm/libcxx/include/__locale_dir/locale_base_api/locale_guard.h; do\n  echo "===== $f ====="\n  case "$f" in\n    *wbuffer_convert.h) nl -ba "$f" | sed -n "35,105p;235,380p" ;;\n    *basic_streambuf.h) rg -n -C3 "pubsync|virtual.*sync|~basic_streambuf" "$f" ;;\n    *) rg -n -C3 "~|noexcept|_NOEXCEPT" "$f" || true ;;\n  esac\ndone\nprintf "===== standard tests for invalid lock =====\\n"\nrg -n -C3 "mutex not locked|owns_lock|system_error|condition_variable::wait" codes/llvm/libcxx/test/std/thread/thread.condition 2>/dev/null | head -240\n' 
===== docs/progress/R86/raw/005_wbuffer_throwing_operations_corrected.command.txt =====
bash -lc $'\nset -e\nfor f in codes/llvm/libcxx/include/streambuf codes/llvm/libcxx/include/__locale_dir/wbuffer_convert.h codes/llvm/libcxx/include/__locale; do\n  echo "===== $f ====="\n  rg -n -C4 "~basic_streambuf|pubsync|virtual int sync|unshift\\(" "$f" || true\ndone\nprintf "===== invalid-lock tests =====\\n"\nrg -n -C3 "owns_lock|system_error|mutex not locked|condition_variable::wait" codes/llvm/libcxx/test/std/thread/thread.condition 2>/dev/null | head -240 || true\n' 
===== docs/progress/R86/raw/023_cxx03_mirror_scope.command.txt =====
bash -lc $'\nset -e\nfor f in codes/llvm/libcxx/include/__cxx03/__condition_variable/condition_variable.h codes/llvm/libcxx/include/__cxx03/__locale_dir/wbuffer_convert.h; do\n  echo "===== $f ====="\n  if test -f "$f"; then rg -n -C2 "void wait\\(|__do_timed_wait|~wbuffer_convert" "$f"; else echo NOT_AVAILABLE; fi\ndone\n' 
===== docs/progress/R86/raw/024_cxx03_wbuffer_and_prior_dynamic_evidence.command.txt =====
bash -lc $'\nset -u\nprintf "%s\\n" "===== C++03 wbuffer_convert locations ====="\nrg -n -C 5 "class wbuffer_convert|~wbuffer_convert|int sync\\\\(" codes/llvm/libcxx/include/__cxx03 codes/llvm/libcxx/include | sed -n "1,260p"\nprintf "%s\\n" "===== R72 verified boundary rows D01-D05 ====="\nrg -n "D0[1-5]|condition_variable|wbuffer_convert" docs/progress/R72/tables docs/progress/R72/REPORT.md docs/progress/R73/REPORT.md | sed -n "1,320p"\nprintf "%s\\n" "===== source repositories status (read-only integrity check) ====="\ngit -C codes/llvm status --short\ngit -C codes/gcc status --short\n' 
