+def stop_remote_test(remote_pid_file):
+    cleanup_process = (
+        f"if test -s {shlex.quote(remote_pid_file)}; then "
+        f"pgid=$(cat {shlex.quote(remote_pid_file)}); "
+        "pkill -TERM -g \"$pgid\" 2>/dev/null || true; "
+        "sleep 2; "
+        "pkill -KILL -g \"$pgid\" 2>/dev/null || true; "
+        "fi"
+    )
+    return run_host(
+        sdb_command("shell", cleanup_process),
+        check=False,
+        stdin=subprocess.DEVNULL,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        text=True,
+        errors="replace",
+    )
+
+
+def write_timeout_stream(stream, destination):
+    if not stream:
+        return
+    if isinstance(stream, bytes):
+        stream = stream.decode("utf-8", errors="replace")
+    destination.write(stream)
+
+
