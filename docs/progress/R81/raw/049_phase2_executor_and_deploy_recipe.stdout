set -euo pipefail

prefix=()
command=()
seen_separator=0
for argument in "$@"; do
  if [[ "$seen_separator" -eq 0 && "$argument" == "--" ]]; then
    seen_separator=1
  elif [[ "$seen_separator" -eq 0 ]]; then
    prefix+=("$argument")
  else
    command+=("$argument")
  fi
done
