            + test_command
        )
        shell_command = (
            "set +e; "
            + build_environment(args.env, args.prepend_env)
            + f"cd {shlex.quote(remote_dir)}; "
            + f"setsid sh -c {shlex.quote(remote_test_script)}"
            + "; rc=$?; "
            + f"printf '\n{EXIT_MARKER}%d\n' \"$rc\"; exit 0"
        )
        try:
            completed = run_host(
                sdb_command("shell", shell_command),
                check=False,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                errors="replace",
                timeout=test_timeout_seconds,
            )
        except subprocess.TimeoutExpired as timeout_error:
            stop_result = stop_remote_test(remote_pid_file)
            write_timeout_stream(timeout_error.stdout, sys.stdout)
            write_timeout_stream(timeout_error.stderr, sys.stderr)
            sys.stderr.write(
                f"ERROR: remote test exceeded {test_timeout_seconds} seconds; "
                "terminated and recorded as failure\n"
            )
            if stop_result.stdout:
                sys.stderr.write(stop_result.stdout)
            return 124
        telemetry_path = os.environ.get("R77_SDB_TELEMETRY")
        if telemetry_path:
            usage = run_host(
                sdb_command("shell", f"du -sk {shlex.quote(remote_dir)}"),
                check=False,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
            )
            with open(telemetry_path, "a", encoding="utf-8") as telemetry:
                telemetry.write(
