37:BuildRequires: cmake
183:%build
191:cmake_flags=" -DENABLE_WAYLAND=ON"
201:cmake_flags+=" -DENABLE_ECORE_WAYLAND2=ON"
212:cmake_flags+=" -DENABLE_LEGACY_BINDER_BUILD=OFF"
214:cmake_flags+=" -DENABLE_LEGACY_BINDER_BUILD=ON"
226:cmake_flags+=" -DCMAKE_BUILD_TYPE=Debug"
230:cmake_flags+=" -DENABLE_RIVE_ANIMATION=ON"
243:cmake_flags+=" -DCMAKE_INSTALL_PREFIX=$PREFIX"
244:cmake_flags+=" -DCMAKE_INSTALL_LIBDIR=%{_libdir}"
245:cmake_flags+=" -DCMAKE_INSTALL_INCLUDEDIR=%{_includedir}"
246:cmake_flags+=" -DENABLE_TIZEN_MAJOR_VERSION=%{tizen_version_major}"
247:cmake_flags+=" -DENABLE_SCENE3D=ON"
248:cmake_flags+=" -DENABLE_PHYSICS_2D=ON"
249:cmake_flags+=" -DENABLE_PHYSICS_3D=ON"
250:cmake_flags+=" -DENABLE_WIDGET_VIEWER_DALI=ON"
251:cmake_flags+=" -DENABLE_TOOLKIT_DEMO=ON"
254:# Set up the build via Cmake
263:cmake -DENABLE_PROFILE=MOBILE $cmake_flags ..
266:make %{?jobs:-j%jobs}
279:cmake -DENABLE_PROFILE=TV $cmake_flags ..
282:make %{?jobs:-j%jobs}
296:cmake -DENABLE_PROFILE=COMMON $cmake_flags ..
299:make %{?jobs:-j%jobs}
315:%make_install
320:make clean # So that we can gather symbol/size information for only one profile if we're building all profiles
328:%make_install
333:make clean # So that we can gather symbol/size information for only one profile if we're building all profiles
341:%make_install
