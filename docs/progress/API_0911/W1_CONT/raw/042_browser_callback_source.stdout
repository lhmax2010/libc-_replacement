#ifndef XWALK_EXTENSIONS_XWALK_EXTENSION_H_
#define XWALK_EXTENSIONS_XWALK_EXTENSION_H_

#include <functional>
#include <string>
#include <vector>

#include "tizen_src/chromium_impl/components/xwalk_extensions/public/XW_Extension.h"
#include "tizen_src/chromium_impl/components/xwalk_extensions/public/XW_Extension_SyncMessage.h"
#include "tizen_src/chromium_impl/components/xwalk_extensions/public/XW_Extension_Message_2.h"

namespace wrt {

class XWalkExtension {
 public:
  class Instance {
   public:
    typedef std::function<void(const std::string&)> MessageCallback;
    typedef std::function<void(const char*, int)> BinaryMessageCallback;

    Instance(XWalkExtension* extension, XW_Instance xw_instance);
    ~Instance();

    XW_Instance GetXWInstance() const { return xw_instance_; }

    void* GetInstanceData() const { return instance_data_;}
    void SetInstanceData(void* data) { instance_data_ = data; }

    void Destroy();

    void PostMessage(const std::string& msg);
    void PostBinaryMessage(const std::vector<uint8_t>& msg);

    std::string SendSyncMessageWithStringReply(const std::string& msg);
    std::string SendSyncBinaryMessageWithStringReply(
        const std::vector<uint8_t>& msg);

    std::vector<uint8_t> SendSyncMessageWithBinaryReply(
        const std::string& msg);
    std::vector<uint8_t> SendSyncBinaryMessageWithBinaryReply(
        const std::vector<uint8_t>& msg);

    void SetPostMessageCallback(MessageCallback callback);
    void SetPostBinaryMessageCallback(BinaryMessageCallback callback);
    void PostMessageToJS(const std::string& message);
    void PostBinaryMessageToJS(const char* message, int size);

    void SyncReplyToJS(const std::string& reply);
    void SyncBinaryReplyToJS(const std::vector<uint8_t>& reply);

   private:
    XWalkExtension* extension_;
    XW_Instance xw_instance_;
    void* instance_data_ = nullptr;
    MessageCallback post_message_callback_ = nullptr;
    BinaryMessageCallback post_binary_message_callback_ = nullptr;

    std::string sync_reply_;
    std::vector<uint8_t> sync_binary_reply_;
  };

  XWalkExtension(const std::string& path);
  XWalkExtension(const std::string& path,
                 const std::string& name,
                 const std::vector<std::string>& entry_points);
  ~XWalkExtension();

  bool Initialize(bool immediate);
  Instance* CreateInstance();

  const std::string& GetName() const { return name_; }
  const std::string& GetLibraryPath() { return library_path_; }
  const std::string& GetJavascriptCode();

  const std::vector<std::string>& GetEntryPoints() const {
    return entry_points_;
  }

 private:
  class Interface;

  static const void* GetInterface(const char* name);

  int CheckAPIAccessControl(const char* api_name);
  int RegisterPermissions(const char* perm_table);

  bool initialized_ = false;
  bool lazy_loading_;
  // in upgradable xwalk extension logic, if extenison is force_update, will
  // update library_path_ by upgradable path.
  std::string library_path_;
  XW_Extension xw_extension_ = 0;

  std::string name_;
  std::string javascript_api_;
  std::vector<std::string> entry_points_;
  void* handle_ = nullptr;

  XW_CreatedInstanceCallback created_instance_callback_ = nullptr;
  XW_DestroyedInstanceCallback destroyed_instance_callback_ = nullptr;
  XW_ShutdownCallback shutdown_callback_ = nullptr;
  XW_HandleMessageCallback handle_msg_callback_ = nullptr;
  XW_HandleSyncMessageCallback handle_sync_msg_callback_ = nullptr;
  XW_HandleBinaryMessageCallback handle_binary_msg_callback_ = nullptr;
};

}  // namespace wrt

#endif  // XWALK_EXTENSIONS_XWALK_EXTENSION_H_
