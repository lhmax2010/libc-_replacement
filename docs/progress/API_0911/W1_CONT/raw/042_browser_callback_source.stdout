#include <dlfcn.h>
#include <string>

#include "base/logging.h"
#include "base/synchronization/lock.h"
#include "tizen_src/chromium_impl/components/xwalk_extensions/browser/xwalk_extension_manager.h"
#include "tizen_src/chromium_impl/components/xwalk_extensions/public/XW_Extension_EntryPoints.h"
#include "tizen_src/chromium_impl/components/xwalk_extensions/public/XW_Extension_Permissions.h"
#include "tizen_src/chromium_impl/components/xwalk_extensions/public/XW_Extension_Runtime.h"

#ifndef XWALK_EXTENSION_PATH
#error XWALK_EXTENSION_PATH is not set.
#endif

namespace wrt {

namespace {

XW_Extension last_xw_extension_id_ = 0;
base::Lock instance_lock;
base::Lock callback_lock;

}  // namespace

class XWalkExtension::Interface {
 public:
  static XWalkExtension* GetExtension(XW_Extension xw_extension) {
    const auto& map = XWalkExtensionManager::GetInstance()->GetExtensions();
    for (const auto& iter : map) {
      if (iter.second->xw_extension_ == xw_extension)
        return iter.second.get();
    }
    LOG(WARNING) << "Ignoring call. Invalid extension = " << xw_extension;
    return nullptr;
  }

  static Instance* GetExtensionInstance(XW_Instance xw_instance) {
    auto* extension_manager = XWalkExtensionManager::GetInstance();
    auto* instance = extension_manager->GetExtensionInstance(xw_instance);
    if (!instance)
      LOG(WARNING) << "Ignoring call. Invalid instance = " << xw_instance;
    return instance;
  }

  static void CoreSetExtensionName(
      XW_Extension xw_extension, const char* name) {
    XWalkExtension* extension = GetExtension(xw_extension);
    if (extension)
      extension->name_ = name;
  }

  static void CoreSetJavaScriptAPI(
      XW_Extension xw_extension, const char* javascript_api) {
    XWalkExtension* extension = GetExtension(xw_extension);
    if (extension)
      extension->javascript_api_ = javascript_api;
  }

  static void CoreRegisterInstanceCallbacks(
      XW_Extension xw_extension, XW_CreatedInstanceCallback created,
      XW_DestroyedInstanceCallback destroyed) {
    XWalkExtension* extension = GetExtension(xw_extension);
    if (!extension)
      return;
    extension->created_instance_callback_ = created;
    extension->destroyed_instance_callback_ = destroyed;
  }

  static void CoreRegisterShutdownCallback(
      XW_Extension xw_extension, XW_ShutdownCallback shutdown) {
    XWalkExtension* extension = GetExtension(xw_extension);
    if (extension)
      extension->shutdown_callback_ = shutdown;
  }

  static void CoreSetInstanceData(XW_Instance xw_instance, void* data) {
    auto* instance = GetExtensionInstance(xw_instance);
    if (instance)
      instance->SetInstanceData(data);
  }

  static void* CoreGetInstanceData(XW_Instance xw_instance) {
    auto* instance = GetExtensionInstance(xw_instance);
    return instance ? instance->GetInstanceData() : nullptr;
  }

  static void MessagingRegister(
      XW_Extension xw_extension, XW_HandleMessageCallback handle_message) {
    XWalkExtension* extension = GetExtension(xw_extension);
    if (extension)
      extension->handle_msg_callback_ = handle_message;
  }

  static void MessagingPostMessage(
      XW_Instance xw_instance, const char* message) {
    auto* instance = GetExtensionInstance(xw_instance);
    if (instance && message)
      instance->PostMessageToJS(message);
  }

  static void SyncMessagingRegister(
      XW_Extension xw_extension,
      XW_HandleSyncMessageCallback handle_sync_message) {
    XWalkExtension* extension = GetExtension(xw_extension);
    if (extension)
      extension->handle_sync_msg_callback_ = handle_sync_message;
  }

  static void SyncMessagingSetSyncReply(
      XW_Instance xw_instance, const char* reply) {
    auto* instance = GetExtensionInstance(xw_instance);
    if (instance)
      instance->SyncReplyToJS(reply);
  }

  static void SyncMessagingSetSyncBinaryReply(
      XW_Instance xw_instance, const std::vector<uint8_t>& reply) {
    auto* instance = GetExtensionInstance(xw_instance);
    if (instance)
      instance->SyncBinaryReplyToJS(reply);
  }

  static void EntryPointsSetExtraJSEntryPoints(
      XW_Extension xw_extension, const char** entry_points) {
    XWalkExtension* extension = GetExtension(xw_extension);
    if (!extension)
      return;
    for (int i = 0; entry_points[i]; ++i)
      extension->entry_points_.push_back(entry_points[i]);
  }

  static void RuntimeGetStringVariable(
      XW_Extension xw_extension, const char* key, char* value,
      unsigned int value_len) {
    auto* extension_manager = XWalkExtensionManager::GetInstance();
    extension_manager->GetRuntimeVariable(key, value, value_len);
  }

  static void* RuntimeGetWindowObject() {
    auto* extension_manager = XWalkExtensionManager::GetInstance();
    return extension_manager->GetWindowObject();
  }

  static void RuntimeAddWindowEventListener(XW_Instance instance,
                                            WindowEvent event) {
    auto* extension_manager = XWalkExtensionManager::GetInstance();
    extension_manager->AddWindowEventListener(instance, event);
  }

  static void RuntimeRemoveWindowEventListener(XW_Instance instance) {
    auto* extension_manager = XWalkExtensionManager::GetInstance();
    extension_manager->RemoveWindowEventListener(instance);
  }

  static void RuntimeSendKeyEvent(const char* event, const char* key_code) {
    auto* extension_manager = XWalkExtensionManager::GetInstance();
    extension_manager->SendKeyEvent(event, key_code);
  }

  static void RuntimeSendMouseEvent(const char* event, int btn, int x, int y) {
    auto* extension_manager = XWalkExtensionManager::GetInstance();
    extension_manager->SendMouseEvent(event, btn, x, y);
  }

  static void RuntimeGetMetadataValue(const char* key,
                                      char* value,
                                      unsigned int len) {
    auto* extension_manager = XWalkExtensionManager::GetInstance();
    auto metadata_value = extension_manager->GetMetadataValue(key);
    if (!metadata_value.empty())
      std::snprintf(value, len, "%s", metadata_value.c_str());
  }

  static int PermissionsCheckAPIAccessControl(
      XW_Extension xw_extension, const char* api_name) {
    XWalkExtension* extension = GetExtension(xw_extension);
    return extension ? extension->CheckAPIAccessControl(api_name) : XW_ERROR;
  }

  static int PermissionsRegisterPermissions(
      XW_Extension xw_extension, const char* perm_table) {
    XWalkExtension* extension = GetExtension(xw_extension);
    return extension ? extension->RegisterPermissions(perm_table) : XW_ERROR;
  }

  static void MessagingRegisterBinaryMessageCallback(
      XW_Extension xw_extension,
      XW_HandleBinaryMessageCallback handle_message) {
    XWalkExtension* extension = GetExtension(xw_extension);
    if (extension)
      extension->handle_binary_msg_callback_ = handle_message;
  }

  static void MessagingPostBinaryMessage(
      XW_Instance xw_instance, const char* message, size_t size) {
    auto* instance = GetExtensionInstance(xw_instance);
    if (!instance)
      return;

    instance->PostBinaryMessageToJS(message, size);
  }
};

XWalkExtension::Instance::Instance(
    XWalkExtension* extension, XW_Instance xw_instance)
  : extension_(extension),
    xw_instance_(xw_instance) {
  auto* extension_manager = XWalkExtensionManager::GetInstance();
  extension_manager->RegisterInstance(this);

  auto callback = extension_->created_instance_callback_;
  if (callback)
    callback(xw_instance_);
}

XWalkExtension::Instance::~Instance() {}

void XWalkExtension::Instance::Destroy() {
  base::AutoLock lock(instance_lock);
  auto callback = extension_->destroyed_instance_callback_;
  if (callback)
    callback(xw_instance_);

  auto* extension_manager = XWalkExtensionManager::GetInstance();
  extension_manager->UnregisterInstance(this);
}

// postMessage(message: string): void
void XWalkExtension::Instance::PostMessage(const std::string& message) {
  XW_HandleMessageCallback callback = extension_->handle_msg_callback_;
  if (callback)
    callback(xw_instance_, message.c_str());
}

// sendSyncMessage(message: string): string
std::string XWalkExtension::Instance::SendSyncMessageWithStringReply(
    const std::string& message) {
#if BUILDFLAG(IS_TIZEN_TV)
  LOG(INFO) << "[WebAPI] message:" << message;
#endif
  XW_HandleSyncMessageCallback callback =
      extension_->handle_sync_msg_callback_;
  if (!callback)
    return std::string();

  callback(xw_instance_, message.c_str());
  return std::move(sync_reply_);
}
  if (!initialized_)
    return;
  if (shutdown_callback_)
    shutdown_callback_(xw_extension_);
#if !BUILDFLAG(IS_TIZEN_TV)
  dlclose(handle_);
  XWalkExtensionManager::GetInstance()->ClearPreloadHandle(library_path_);
#endif
}

// static
const void* XWalkExtension::GetInterface(const char* name) {
  std::string interface_name(name);
  if (interface_name == XW_CORE_INTERFACE_1) {
    static const XW_CoreInterface_1 coreInterface1 = {
      Interface::CoreSetExtensionName,
      Interface::CoreSetJavaScriptAPI,
      Interface::CoreRegisterInstanceCallbacks,
      Interface::CoreRegisterShutdownCallback,
      Interface::CoreSetInstanceData,
      Interface::CoreGetInstanceData
    };
    return &coreInterface1;
  }

  if (interface_name == XW_MESSAGING_INTERFACE_1) {
    static const XW_MessagingInterface_1 messagingInterface1 = {
      Interface::MessagingRegister,
      Interface::MessagingPostMessage
    };
    return &messagingInterface1;
  }

  if (interface_name == XW_MESSAGING_INTERFACE_2) {
    static const XW_MessagingInterface_2 messagingInterface2 = {
      Interface::MessagingRegister,
      Interface::MessagingPostMessage,
      Interface::MessagingRegisterBinaryMessageCallback,
      Interface::MessagingPostBinaryMessage
    };
    return &messagingInterface2;
  }

  if (interface_name == XW_INTERNAL_SYNC_MESSAGING_INTERFACE_1) {
    static const XW_Internal_SyncMessagingInterface_1
        syncMessagingInterface1 = {
      Interface::SyncMessagingRegister,
      Interface::SyncMessagingSetSyncReply,
      Interface::SyncMessagingSetSyncBinaryReply
    };
    return &syncMessagingInterface1;
  }

  if (interface_name == XW_INTERNAL_ENTRY_POINTS_INTERFACE_1) {
    static const XW_Internal_EntryPointsInterface_1 entryPointsInterface1 = {
      Interface::EntryPointsSetExtraJSEntryPoints
    };
    return &entryPointsInterface1;
  }

  if (interface_name == XW_INTERNAL_RUNTIME_INTERFACE_1) {
    static const XW_Internal_RuntimeInterface_1 runtimeInterface1 = {
      Interface::RuntimeGetStringVariable
    };
    return &runtimeInterface1;
  }
