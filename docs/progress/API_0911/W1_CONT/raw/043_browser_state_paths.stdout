namespace {

const char kExtensionPrefix[] = "lib";
const char kExtensionSuffix[] = ".so";
const char kExtensionMetadataSuffix[] = ".json";

const char kUserPluginsDirectory[] = "plugin/";
const char kArchArmv7l[] = "armv7l";
const char kArchI586[] = "i586";
const char kArchDefault[] = "default";
const char kWrtServiceJson[] = "wrtservice.json";

const std::set<std::string> kWorkerSupported = {
    "tizen.ml", "xwalk"
};

base::Lock xmanager_instance_lock;
base::Lock preload_handle_lock;

}  // namespace

// static
XWalkExtensionManager* XWalkExtensionManager::GetInstance() {
  static XWalkExtensionManager self;
  return &self;
}

// static
void XWalkExtensionManager::Bind(
    mojo::PendingReceiver<mojom::XWalkExtensionBrowser> receiver) {
  auto* manager = GetInstance();
  manager->receivers_.Add(manager, std::move(receiver));
}

XWalkExtensionManager::XWalkExtensionManager() {
  auto major_version = TIZEN_VERSION / 10000;
  auto minor_version = (TIZEN_VERSION % 1000) / 100;
  build_tizen_version_ =
      std::to_string(major_version) + "." + std::to_string(minor_version);
}

XWalkExtension::Instance* XWalkExtensionManager::GetExtensionInstance(
    XW_Instance xw_instance) {
  base::AutoLock lock(xmanager_instance_lock);
  auto it = instances_.find(xw_instance);
  return (it != instances_.end()) ? it->second.get() : nullptr;
}

void XWalkExtensionManager::PreloadExtensions() {
  if (delegate_)
    delegate_->PreloadExtensions();
}

void XWalkExtensionManager::ClearPreloadHandle(const std::string& lib_path) {
  base::AutoLock lock(preload_handle_lock);
  preload_handle_.erase(lib_path);
}

void* XWalkExtensionManager::GetPreloadHandle(const std::string& lib_path) {
  base::AutoLock lock(preload_handle_lock);
  if (preload_handle_.find(lib_path) != preload_handle_.end())
    return preload_handle_[lib_path];
  else
    return nullptr;
}

void XWalkExtensionManager::SetPreloadHandle(
    const std::string& lib_path, void* handle) {
  base::AutoLock lock(preload_handle_lock);
  preload_handle_[lib_path] = handle;
}

void XWalkExtensionManager::LoadExtensionsByPath(const std::string& path) {
  if (is_loaded_by_path_)
    return;

  std::ignore = LoadExtensions(path);
  is_loaded_by_path_ = true;
}

void XWalkExtensionManager::LoadUIAppExtensions() {
  if (is_loaded_for_web_app_)
    return;

  std::ignore = LoadExtensions(XWALK_EXTENSION_PATH);
  if (delegate_)
    delegate_->LoadUIAppExtensions();

 is_loaded_for_web_app_ = true;
}

void XWalkExtensionManager::LoadServiceAppExtensions() {
  auto is_ui_service = is_loaded_for_web_app_;
  if (is_ui_service || is_loaded_for_service_app_)
    return;

  auto files = LoadExtensions(XWALK_EXTENSION_SERVICE_PATH);
  for (auto it = files.begin(); it != files.end(); ++it) {
    LOG(INFO) << "*it : " << *it;
    RegisterExtension(new XWalkExtension(*it));
  }

  is_loaded_for_service_app_ = true;
}

std::set<std::string> XWalkExtensionManager::LoadExtensions(
    const std::string& extension_path) {
  LOG(INFO) << "extension_path : " << extension_path;

  // Gets all extension files in the XWALK_EXTENSION_PATH
  std::string ext_pattern(extension_path);
  ext_pattern.append("/");
  ext_pattern.append(kExtensionPrefix);
  ext_pattern.append("*");
  ext_pattern.append(kExtensionSuffix);

  std::set<std::string> files;
  {
    glob_t glob_result;
    glob(ext_pattern.c_str(), GLOB_TILDE, nullptr, &glob_result);
    for (unsigned int i = 0; i < glob_result.gl_pathc; ++i)
      files.insert(glob_result.gl_pathv[i]);
  }

  // Gets all metadata files in the XWALK_EXTENSION_PATH
  // Loads information from the metadata files and remove the loaded file from
  // the set 'files'
  std::string meta_pattern(extension_path);
  meta_pattern.append("/");
  meta_pattern.append("*");
  meta_pattern.append(kExtensionMetadataSuffix);
  {
    glob_t glob_result;
    glob(meta_pattern.c_str(), GLOB_TILDE, nullptr, &glob_result);
    for (unsigned int i = 0; i < glob_result.gl_pathc; ++i)
      ParseMetadata(glob_result.gl_pathv[i], &files, extension_path);
  }
  return files;
}

void XWalkExtensionManager::LoadUserExtensions(const std::string& app_path) {
  if (app_path.empty()) {
    LOG(ERROR) << "Failed to get package root path";
    return;
  }
  std::string app_ext_pattern(app_path);
  app_ext_pattern.append(kUserPluginsDirectory);
