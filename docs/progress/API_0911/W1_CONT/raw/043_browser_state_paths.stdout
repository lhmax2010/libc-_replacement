  if (!callback)
    return std::string();

  callback(xw_instance_, message.c_str());
  return std::move(sync_reply_);
}

// sendSyncMessage(message: string): Uint8Array
std::vector<uint8_t> XWalkExtension::Instance::SendSyncMessageWithBinaryReply(
    const std::string& message) {
#if BUILDFLAG(IS_TIZEN_TV)
  LOG(INFO) << "[WebAPI] message:" << message;
#endif
  XW_HandleSyncMessageCallback callback =
      extension_->handle_sync_msg_callback_;
  if (!callback)
    return std::vector<uint8_t>{};

  callback(xw_instance_, message.c_str());
  return std::move(sync_binary_reply_);
}

// postMessage(message: Uint8Array): void
void XWalkExtension::Instance::PostBinaryMessage(
    const std::vector<uint8_t>& message) {
  XW_HandleBinaryMessageCallback callback =
      extension_->handle_binary_msg_callback_;
  if (callback)
    callback(xw_instance_, reinterpret_cast<const char*>(message.data()),
             message.size());
}

// sendSyncMessage(message: Uint8Array): string
std::string XWalkExtension::Instance::SendSyncBinaryMessageWithStringReply(
    const std::vector<uint8_t>& message) {
  XW_HandleBinaryMessageCallback callback =
      extension_->handle_binary_msg_callback_;
  if (!callback)
    return std::string();

  callback(xw_instance_, reinterpret_cast<const char*>(message.data()),
           message.size());
  return std::move(sync_reply_);
}

// sendSyncMessage(message: Uint8Array): Uint8Array
std::vector<uint8_t>
XWalkExtension::Instance::SendSyncBinaryMessageWithBinaryReply(
    const std::vector<uint8_t>& message) {
  XW_HandleBinaryMessageCallback callback =
      extension_->handle_binary_msg_callback_;
  if (!callback)
    return std::vector<uint8_t>{};

  callback(xw_instance_, reinterpret_cast<const char*>(message.data()),
           message.size());
  return std::move(sync_binary_reply_);
}

void XWalkExtension::Instance::SetPostMessageCallback(
    MessageCallback callback) {
  base::AutoLock lock(callback_lock);
  post_message_callback_ = callback;
}

void XWalkExtension::Instance::SetPostBinaryMessageCallback(
    BinaryMessageCallback callback) {
  base::AutoLock lock(callback_lock);
  post_binary_message_callback_ = callback;
}

void XWalkExtension::Instance::PostMessageToJS(const std::string& message) {
  base::AutoLock lock(callback_lock);
  if (post_message_callback_)
    post_message_callback_(message);
}

void XWalkExtension::Instance::PostBinaryMessageToJS(
    const char* message, int size) {
  base::AutoLock lock(callback_lock);
  if (post_binary_message_callback_)
    post_binary_message_callback_(message, size);
}

void XWalkExtension::Instance::SyncReplyToJS(const std::string& reply) {
  sync_reply_ = reply;
}

void XWalkExtension::Instance::SyncBinaryReplyToJS(
    const std::vector<uint8_t>& reply) {
  sync_binary_reply_ = reply;
}

XWalkExtension::XWalkExtension(const std::string& path)
    : lazy_loading_(false), library_path_(path) {}

XWalkExtension::XWalkExtension(const std::string& path,
                               const std::string& name,
                               const std::vector<std::string>& entry_points)
    : lazy_loading_(true),
      library_path_(path),

  XW_Initialize_Func initialize = reinterpret_cast<XW_Initialize_Func>(
      dlsym(handle_, "XW_Initialize"));
  if (!initialize) {
    LOG(ERROR) << "Error loading extension '" << library_path
               << "' : couldn't get XW_Initialize function.";
    dlclose(handle_);
    return false;
  }

  xw_extension_ = ++last_xw_extension_id_;
  int ret = initialize(xw_extension_, GetInterface);
  if (ret != XW_OK) {
    LOG(ERROR) << "Error loading extension '" << library_path
               << "' : XW_Initialize() returned error value.";
    dlclose(handle_);
    return false;
  }

  initialized_ = true;
  return true;
}

XWalkExtension::Instance* XWalkExtension::CreateInstance() {
  base::AutoLock lock(instance_lock);
  auto id = XWalkExtensionManager::GetInstance()->GetNextInstanceID();
  if (id == 0) {
    LOG(ERROR) << "Exceed xwalk extension limit";
    return nullptr;
  }
  Initialize(true);
  return new Instance(this, id);
}

const std::string& XWalkExtension::GetJavascriptCode() {
  Initialize(true);
  return javascript_api_;
}

int XWalkExtension::CheckAPIAccessControl(const char* /*api_name*/) {
  // Not Supported
  return XW_OK;
}

int XWalkExtension::RegisterPermissions(const char* /*perm_table*/) {
  // Not Supported
  return XW_OK;
}

