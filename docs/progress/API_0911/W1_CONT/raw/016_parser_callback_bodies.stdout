namespace wrt {

namespace {

const char kExtensionPrefix[] = "lib";
const char kExtensionSuffix[] = ".so";
const char kExtensionMetadataSuffix[] = ".json";

XW_Extension last_xw_extension_id = 0;
XW_Instance last_xw_instance_id = 0;

XWalkExtensionNode::Interface* GetExtensionInterface(
    XW_Extension xw_extension_id) {
  const auto& map = XWalkExtensionNode::GetInstance()->GetExtensions();
  for (const auto& iter : map) {
    if (iter.second->GetExtensionId() == xw_extension_id) {
      return iter.second.get();
    }
  }
  LOG(ERROR) << "Ignoring call. Invalid extension = " << xw_extension_id;
  return nullptr;
}

XWalkExtensionNode::Instance* GetExtensionInstance(XW_Instance xw_instance_id) {
  auto* extension_node = XWalkExtensionNode::GetInstance();
  auto* instance = extension_node->GetExtensionInstance(xw_instance_id);
  if (!instance) {
    LOG(ERROR) << "Ignoring call. Invalid instance = " << xw_instance_id;
  }
  return instance;
}

void CoreSetExtensionName(XW_Extension xw_extension_id, const char* name) {
  auto* extension_interface = GetExtensionInterface(xw_extension_id);
  if (extension_interface) {
    extension_interface->SetExtensionName(name);
  }
}

void CoreSetJavaScriptAPI(XW_Extension xw_extension_id, const char* js_api) {
  auto* extension_interface = GetExtensionInterface(xw_extension_id);
  if (extension_interface) {
    extension_interface->SetJavaScriptAPI(js_api);
  }
}

void CoreRegisterInstanceCallbacks(XW_Extension xw_extension_id,
                                   XW_CreatedInstanceCallback created,
                                   XW_DestroyedInstanceCallback destroyed) {
  auto* extension_interface = GetExtensionInterface(xw_extension_id);
  if (extension_interface) {
    extension_interface->RegisterInstanceCallbacks(created, destroyed);
  }
}

void CoreRegisterShutdownCallback(XW_Extension xw_extension_id,
                                  XW_ShutdownCallback shutdown) {
  auto* extension_interface = GetExtensionInterface(xw_extension_id);
  if (extension_interface) {
    extension_interface->RegisterShutdownCallback(shutdown);
  }
}

void CoreSetInstanceData(XW_Instance xw_instance_id, void* data) {
  auto* extension_instance = GetExtensionInstance(xw_instance_id);
  if (extension_instance) {
    extension_instance->SetInstanceData(data);
  }
}

void* CoreGetInstanceData(XW_Instance xw_instance_id) {
  auto* extension_instance = GetExtensionInstance(xw_instance_id);
  return extension_instance ? extension_instance->GetInstanceData() : nullptr;
}

void MessagingRegister(XW_Extension xw_extension_id,
                       XW_HandleMessageCallback handle_message) {
  auto* extension_interface = GetExtensionInterface(xw_extension_id);
  if (extension_interface) {
    extension_interface->RegisterHandleMessageCallback(handle_message);
  }
}

void MessagingPostMessage(XW_Instance xw_instance_id, const char* message) {
  auto* extension_instance = GetExtensionInstance(xw_instance_id);
  if (extension_instance && message) {
    extension_instance->PostMessageToJS(message);
  }
}

void MessagingRegisterBinaryMessageCallback(
    XW_Extension xw_extension_id,
    XW_HandleBinaryMessageCallback handle_message) {
  // NOT SUPPORTED
}

void MessagingPostBinaryMessage(XW_Instance xw_instance_id,
                                const char* message,
                                size_t size) {
  // NOT SUPPORTED
}

void SyncMessagingRegister(XW_Extension xw_extension_id,
                           XW_HandleSyncMessageCallback handle_sync_message) {
  auto* extension_interface = GetExtensionInterface(xw_extension_id);
  if (extension_interface) {
    extension_interface->RegisterHandleSyncMsgCallback(handle_sync_message);
  }
}

void SyncMessagingSetSyncReply(XW_Instance xw_instance_id, const char* reply) {
  auto* extension_instance = GetExtensionInstance(xw_instance_id);
  if (extension_instance) {
    extension_instance->SyncReplyToJS(reply);
  }
}

void SyncMessagingSetSyncBinaryReply(XW_Instance xw_instance_id,
                                     const std::vector<uint8_t>& reply) {
  LOG(INFO) << "Not supported in service application";
}

void EntryPointsSetExtraJSEntryPoints(XW_Extension xw_extension_id,
                                      const char** entry_points) {
  auto* extension_interface = GetExtensionInterface(xw_extension_id);
  if (!extension_interface) {
    return;
  }

  for (int i = 0; entry_points[i]; ++i) {
    extension_interface->PushEntryPoint(entry_points[i]);
  }
}

int PermissionsCheckAPIAccessControl(XW_Extension xw_extension_id,
                                     const char* api_name) {
  return XW_ERROR;
}

int PermissionsRegisterPermissions(XW_Extension xw_extension_id,
                                   const char* perm_table) {
  return XW_ERROR;
}

void RuntimeGetStringVariable(XW_Extension xw_extension_id,
                              const char* key,
                              char* value,
                              unsigned int value_len) {
  auto* extension_service = XWalkExtensionNode::GetInstance();
  auto variable = extension_service->GetRuntimeVariable(key);
  strncpy(value, variable.c_str(), value_len);
}

const void* GetInterfaceSet(const char* name) {
  std::string interface_name(name);
  if (interface_name == XW_CORE_INTERFACE_1) {
    static const XW_CoreInterface_1 coreInterface1 = {
        CoreSetExtensionName,          CoreSetJavaScriptAPI,
        CoreRegisterInstanceCallbacks, CoreRegisterShutdownCallback,
        CoreSetInstanceData,           CoreGetInstanceData};
    return &coreInterface1;
  } else if (interface_name == XW_MESSAGING_INTERFACE_1) {
    static const XW_MessagingInterface_1 messagingInterface1 = {
        MessagingRegister, MessagingPostMessage};
    return &messagingInterface1;
  } else if (interface_name == XW_MESSAGING_INTERFACE_2) {
    static const XW_MessagingInterface_2 messagingInterface2 = {
        MessagingRegister, MessagingPostMessage,
        MessagingRegisterBinaryMessageCallback, MessagingPostBinaryMessage};
    return &messagingInterface2;
  } else if (interface_name == XW_INTERNAL_SYNC_MESSAGING_INTERFACE_1) {
    static const XW_Internal_SyncMessagingInterface_1 syncMessagingInterface1 =
        {SyncMessagingRegister, SyncMessagingSetSyncReply,
         SyncMessagingSetSyncBinaryReply};
    return &syncMessagingInterface1;
  } else if (interface_name == XW_INTERNAL_ENTRY_POINTS_INTERFACE_1) {
    static const XW_Internal_EntryPointsInterface_1 entryPointsInterface1 = {
        EntryPointsSetExtraJSEntryPoints};
    return &entryPointsInterface1;
  } else if (interface_name == XW_INTERNAL_PERMISSIONS_INTERFACE_1) {
    static const XW_Internal_PermissionsInterface_1 permissionsInterface1 = {
        PermissionsCheckAPIAccessControl, PermissionsRegisterPermissions};
    return &permissionsInterface1;
  } else if (interface_name == XW_INTERNAL_RUNTIME_INTERFACE_1) {
    static const XW_Internal_RuntimeInterface_1 runtimeInterface1 = {
        RuntimeGetStringVariable};
    return &runtimeInterface1;
  }
  LOG(ERROR) << "Interface '" << name << "' is not supported.";
  return nullptr;
}

}  // namespace

// static
XWalkExtensionNode* XWalkExtensionNode::GetInstance() {
  static XWalkExtensionNode self;
  return &self;
}

XWalkExtensionNode::XWalkExtensionNode() {
  uv_mutex_init(&thread_lock_);
  uv_mutex_init(&instances_lock_);
  runtime_status_ = "running";
}

XWalkExtensionNode::~XWalkExtensionNode() {
  LOG(INFO) << "~XWalkExtensionNode";
  instances_.clear();
