#define MOUNT_ARGS_PRELOAD_CHROMIUM \
  PATH_PRELOAD_CHROMIUM_EFL_IMG " " LIB_RO_ROOT_DIR " -t squashfs -o loop,ro"

#define CHROMIUM_UPGRADE_LIB_PATH \
  LIB_UPGRADE_ROOT_DIR "/lib/" CHROMIUM_IMPL_LIB_FILE

