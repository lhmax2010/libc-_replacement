   }
   time_t before=time(nullptr);bool valid=call(input,out);time_t after=time(nullptr);
   bool expiry=k==10?(out.expiry_date_utc>=before+60&&out.expiry_date_utc<=after+60):out.expiry_date_utc==want.expiry_date_utc;
