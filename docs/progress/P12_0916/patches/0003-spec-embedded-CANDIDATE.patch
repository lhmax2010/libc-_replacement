--- a/packaging/chromium-efl.spec
+++ b/packaging/chromium-efl.spec
@@ -741,6 +741,14 @@
   $ccache_gn_arg
 %endif  # _skip_gn
 
+# Candidate adaptor payload/config must be supplied and reviewed by product packaging.
+test -n "%{?ewk_adaptor_payload}" && test -n "%{?ewk_adaptor_config}" || exit 1
+test "%{__enable_ewk_interface}" = "1" || exit 1
+python3 "%{ewk_adaptor_payload}/package_build.py" "%{ewk_adaptor_config}" "$PWD/p12-adaptor" --mode embedded
+cat "$PWD/p12-adaptor/gn.args" >> "%{OUTPUT_FOLDER}/args.gn"
+# Ninja regenerates the existing GN graph, then builds this target only.
+bash "%{ewk_adaptor_payload}/src/limit_build.sh" ninja -j1 -C "%{OUTPUT_FOLDER}" ewk-interface
+
 ninja %{?_ninja_debug:-v -d stats -d explain} %{_smp_mflags} -C "%{OUTPUT_FOLDER}" \
 %if 0%{?build_ewk_unittests}
   ewk_unittests \
