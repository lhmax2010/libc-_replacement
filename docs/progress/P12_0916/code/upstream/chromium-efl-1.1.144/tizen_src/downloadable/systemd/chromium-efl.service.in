[Unit]
Description=Chromium-EFL Preload Library Mount
ConditionPathExists=@RO_APP_PATH@/res/chromium-efl.img
ConditionPathExists=!@RW_APP_PATH@/res/chromium-efl.img

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/mount @RO_APP_PATH@/res/chromium-efl.img @MOUNT_POINT@ -t squashfs -o loop,ro
ExecStop=/bin/sh -c '/bin/umount -dl @MOUNT_POINT@'
SmackProcessLabel=System::Privileged

[Install]
WantedBy=multi-user.target
