[Unit]
Description=Chromium-EFL Updated Library Mount
ConditionPathExists=@RW_APP_PATH@/res/chromium-efl.img
PartOf=chromium-efl.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/mount @RW_APP_PATH@/res/chromium-efl.img @MOUNT_POINT@ -t squashfs -o loop,ro
ExecStop=/bin/sh -c '/bin/umount -dl @MOUNT_POINT@'
SmackProcessLabel=System::Privileged

[Install]
WantedBy=multi-user.target
