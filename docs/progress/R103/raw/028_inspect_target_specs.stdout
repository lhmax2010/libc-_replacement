329-## ========== AOT package installation ==========
330-
331-# Install AOT headers (include/ from extracted tarball)
332-# Install to both %{_includedir} (for development) and %{_datadir} (for LLVM TENSORFLOW_AOT_PATH)
333:mkdir -p %{buildroot}%{_includedir}/tensorflow2/aot
334:cp -r aot/include %{buildroot}%{_includedir}/tensorflow2/aot/
335-
336:# Install xla_aot_runtime_src and include/ to %{_datadir} (for LLVM TENSORFLOW_AOT_PATH)
337:# LLVM CMake uses TENSORFLOW_AOT_PATH=%{_datadir}/tensorflow2/aot and expects:
338-#   ${TENSORFLOW_AOT_PATH}/include/          — C++ headers for AOT compilation
339:#   ${TENSORFLOW_AOT_PATH}/xla_aot_runtime_src/ — XLA runtime source
340:mkdir -p %{buildroot}%{_datadir}/tensorflow2/aot
341:cp -r aot/xla_aot_runtime_src %{buildroot}%{_datadir}/tensorflow2/aot/
342:cp -r aot/include %{buildroot}%{_datadir}/tensorflow2/aot/
343-
344-# Install saved_model_cli (AOT compiler tool)
345-# Note: saved_model_cli is a Python script; fix shebang to use system python3
346-if [ -f aot/bin/saved_model_cli ]; then
347:  mkdir -p %{buildroot}%{_datadir}/tensorflow2/aot/bin
348:  sed '1s|^#!.*python.*|#!/usr/bin/python3|' aot/bin/saved_model_cli > %{buildroot}%{_datadir}/tensorflow2/aot/bin/saved_model_cli
349:  chmod 0755 %{buildroot}%{_datadir}/tensorflow2/aot/bin/saved_model_cli
350-fi
351-
352-# Install AOT runtime static library
353:install -m 0644 build-aot/libtf_xla_runtime.a %{buildroot}%{_libdir}/libtf_xla_runtime.a
354-
355-# Install AOT pc file
356-cp %{SOURCE1003} .
357-sed -i 's:@libdir@:%{_libdir}:g
358-    s:@includedir@:%{_includedir}:g
359:    s:@aot_path@:%{_datadir}/tensorflow2/aot:g
360-    s:@VERSION@:%{version}:g
361-    s:@prefix@:%{_prefix}:g
362:    s:@exec_prefix@:%{_exec_prefix}:g' ./tensorflow2-aot.pc.in
363:install -m 0644 tensorflow2-aot.pc.in %{buildroot}%{_libdir}/pkgconfig/tensorflow2-aot.pc
