    90	void TfLiteLayer::finalize(InitLayerContext &context) {
    91	  tflite::ops::builtin::BuiltinOpResolver resolver;
    92	  model = tflite::FlatBufferModel::BuildFromFile(
    93	    std::get<PropsTflModelPath>(*tfl_layer_props).get().c_str());
    94	  NNTR_THROW_IF(!model, std::invalid_argument)
    95	    << "Failed to build tflite model";
    96	
    97	  tflite::InterpreterBuilder(*model.get(), resolver)(&interpreter);
    98	  NNTR_THROW_IF(!interpreter, std::invalid_argument)
    99	    << "Failed to build tflite interpreter";
   100	
   101	  NNTR_THROW_IF(interpreter->AllocateTensors() != kTfLiteOk, std::runtime_error)
   102	    << "Failed to allocate tensors!";
   103	
   104	  std::vector<TensorDim> dims;
   105	  setDimensions(interpreter->inputs(), dims, false);
   106	  const std::vector<TensorDim> &input_dims = context.getInputDimensions();
   107	
   108	  NNTR_THROW_IF(dims.size() != input_dims.size(), std::invalid_argument)
   109	    << "Provided number of input dimensions mismatch";
