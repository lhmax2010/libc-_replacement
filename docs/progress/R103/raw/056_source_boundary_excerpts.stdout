   451	 * @brief Internal implementation of TFLiteCore's loadModel()
   452	 * @return 0 if OK. non-zero if error.
   453	 */
   454	int
   455	TFLiteInterpreter::loadModel (int num_threads, tflite_delegate_e delegate_e)
   456	{
   457	  TfLiteDelegate *delegate;
   458	#if (DBG)
   459	  gint64 start_time, stop_time;
   460	  start_time = g_get_monotonic_time ();
   461	#endif
   462	
   463	  model = tflite::FlatBufferModel::BuildFromFile (model_path);
   464	  if (!model) {
   465	    ml_loge ("Failed to mmap model\n");
   466	    return -1;
   467	  }
   468	
   469	  /**
   470	   * If got any trouble at model, active below code. It'll be help to analyze.
   471	   * model->error_reporter ();
   472	   */
   473	
   474	  interpreter = nullptr;
   475	
   476	#ifdef TFLITE_RESOLVER_WITHOUT_DEFAULT_DELEGATES
   477	  tflite::ops::builtin::BuiltinOpResolverWithoutDefaultDelegates resolver;
   478	#else
   479	  tflite::ops::builtin::BuiltinOpResolver resolver;
   480	#endif
   481	  tflite::InterpreterBuilder (*model, resolver) (&interpreter);
   482	  if (!interpreter) {
   483	    ml_loge ("Failed to construct interpreter\n");
   484	    return -2;
   485	  }
   486	
   487	  if (num_threads > 0) {
   488	    int n = static_cast<int> (std::thread::hardware_concurrency ());
   489	
   490	    num_threads = MIN (n, num_threads);
   491	    ml_logi ("Set the number of threads (%d)", num_threads);
   492	    interpreter->SetNumThreads (num_threads);
   493	  }
   494	
   495	  /** set delegate after the accelerator prop */
