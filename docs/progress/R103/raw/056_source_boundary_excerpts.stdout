===== progress/R103/inputs/source_git/inference-engine-tflite/src/inference_engine_tflite.cpp =====
   135			}
   136			file.close();
   137	
   138			// Verify TFLite magic number (TFL3)
   139			if (buffer[0] != 'T' || buffer[1] != 'F' || buffer[2] != 'L' || buffer[3] != '3') {
   140				LOGE("Invalid TFLite magic number in %s", mWeightFile.c_str());
   141				return INFERENCE_ENGINE_ERROR_INVALID_DATA;
   142			}
   143	
   144			// Check minimum reasonable size for a valid TFLite model
   145			if (size < 100) {
   146				LOGE("Model file too small to be valid: %s (size=%zd)", mWeightFile.c_str(), size);
   147				return INFERENCE_ENGINE_ERROR_INVALID_DATA;
   148			}
   149	
   150			mFlatBuffModel =
   151					tflite::FlatBufferModel::BuildFromFile(mWeightFile.c_str());
   152			if (!mFlatBuffModel) {
   153				LOGE("Failed to mmap model %s", mWeightFile.c_str());
   154				return INFERENCE_ENGINE_ERROR_INVALID_DATA;
   155			}
   156	
   157			// Validate model initialization
   158			if (!mFlatBuffModel->initialized()) {
   159				LOGE("Model is not properly initialized: %s", mWeightFile.c_str());
   160				return INFERENCE_ENGINE_ERROR_INVALID_DATA;
   161			}
   162	
   163			// Validate model flatbuffer structure before constructing interpreter
   164			const tflite::Model* model = mFlatBuffModel->GetModel();
   165			if (!model || !model->subgraphs() || model->subgraphs()->size() == 0) {
   166				LOGE("Invalid model: no subgraphs in %s", mWeightFile.c_str());
   167				return INFERENCE_ENGINE_ERROR_INVALID_DATA;
   168			}
   169	
   170			for (size_t i = 0; i < model->subgraphs()->size(); i++) {
   171				auto subgraph = model->subgraphs()->Get(i);
   172				if (!subgraph->tensors()) {
   173					LOGE("Invalid model: subgraph %zu has no tensors in %s", i, mWeightFile.c_str());
   174					return INFERENCE_ENGINE_ERROR_INVALID_DATA;
   175				}
   176			}
   177	
   178			tflite::ops::builtin::BuiltinOpResolver resolver;
   179	
   180			TfLiteStatus builder_status = 
   181				tflite::InterpreterBuilder(*mFlatBuffModel, resolver)(&mInterpreter);
   182			if (builder_status != kTfLiteOk || !mInterpreter) {
   183				LOGE("Failed to construct interpreter, status: %d", builder_status);
   184				return INFERENCE_ENGINE_ERROR_INVALID_OPERATION;
   185			}
   186	
   187			LOGI("Inferece targets are: [%d]", mTargetTypes);
   188	
   189			if (mTargetTypes == INFERENCE_TARGET_GPU) {
   190				TfLiteGpuDelegateOptionsV2 options = TfLiteGpuDelegateOptionsV2Default();
   191				mDelegate = TfLiteGpuDelegateV2Create(&options);
   192				if (!mDelegate){
   193					LOGE("Failed to GPU delegate");
   194					return INFERENCE_ENGINE_ERROR_INVALID_OPERATION;
   195				}
