INFERENCE_CMAKE
     1	
     2	CMAKE_MINIMUM_REQUIRED(VERSION 2.6)
     3	SET(fw_name "inference-engine-tflite")
     4	
     5	PROJECT(${fw_name})
     6	
     7	SET(CMAKE_INSTALL_PREFIX /usr)
     8	SET(PREFIX ${CMAKE_INSTALL_PREFIX})
     9	
    10	SET(CMAKE_POSITION_INDEPENDENT_CODE ON)
    11	
    12	SET(INC_DIR "${PROJECT_SOURCE_DIR}/include")
    13	SET(dependents "dlog inference-engine-interface-common tensorflow2-lite")
    14	
    15	INCLUDE(FindPkgConfig)
    16	pkg_check_modules(${fw_name}_DEP REQUIRED ${dependents})
    17	
    18	ADD_DEFINITIONS("-DPREFIX=\"${CMAKE_INSTALL_PREFIX}\"")
    19	ADD_DEFINITIONS("-DTIZEN_DEBUG")
    20	
    21	aux_source_directory(src SOURCES)
    22	ADD_LIBRARY(${fw_name} SHARED ${SOURCES})
    23	
    24	TARGET_INCLUDE_DIRECTORIES(${fw_name} PUBLIC include ${${fw_name}_DEP_INCLUDE_DIRS})
    25	TARGET_LINK_LIBRARIES(${fw_name} ${${fw_name}_DEP_LIBRARIES})
    26	
    27	SET_TARGET_PROPERTIES(${fw_name}
    28	     PROPERTIES
    29	     CLEAN_DIRECT_OUTPUT 1
    30	)
    31	
    32	INSTALL(TARGETS ${fw_name} DESTINATION ${LIB_INSTALL_DIR})
    33	INSTALL(
    34	        DIRECTORY ${INC_DIR}/ DESTINATION include/media
    35	        FILES_MATCHING
    36	        PATTERN "*_private.h" EXCLUDE
    37	        PATTERN "*.h"
    38	        )
    39	
    40	SET(PC_NAME ${fw_name})
    41	SET(PC_REQUIRED ${pc_dependents})
    42	SET(PC_LDFLAGS -l${fw_name})
    43	SET(PC_CFLAGS -I\${includedir}/media)
