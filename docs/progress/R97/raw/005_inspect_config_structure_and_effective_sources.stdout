     1	################################################################################
     2	# OBS Project config for Tizen:Base
     3	#
     4	# RE contacts:
     5	#
     6	#
     7	# vim: set syntax=spec:
     8	################################################################################
     9	
    10	Patterntype: rpm-md comps
    11	Release: <CI_CNT>.<B_CNT>
    12	Support: build
    13	Support: build-compare build-mkbaselibs
    14	# Support: rpmlint-mini rpmlint-tizen
    15	
    16	# new cycle handling (gbs version >= 0.25.29)
    17	BuildFlags: genmetaalgo:1
    18	
    19	############################# conflicts resolution #############################
    20	
    21	Prefer: util-linux
    22	Prefer: toybox
    23	Prefer: mono-wcf
    24	Prefer: monodoc
    25	Prefer: mono-extras
    26	Prefer: mono-web
    27	Prefer: mono-data
    28	Prefer: mono-mvc
    29	Prefer: mono-winforms
    30	Prefer: mono-data-sqlite
    31	
    32	# Set a preference for ambiguous libs to use *-64bit libs
    33	#     *-64bit libs on 32bit build environment are required for .Net build (e.g., coreclr, corefx)
    34	#     But when building 64bit target, they could make 'have choice' error with original libs in 64bit repository.
    35	#     e.g., libstdc++ and libstdc++-64bit provides same libs. It's ambiguous to choose appropriate one.
    36	#     Owner : Jiyoung Yun (jy910.yun@samsung.com)
    37	#     libopenssl* : Dongsun Lee (ds73.lee@samsung.com), Dariusz Michaluk (d.michaluk@samsung.com)
    38	Prefer: libgcc libstdc++ libunwind libuuid zlib libopenssl libopenssl11 libopenssl3
    39	Prefer: lldb
    40	
    41	############################# base definition ###############################
    42	
    43	# %release_name and %tizen_full_version are used in platform/upstream/tizen-release
    44	
    45	Macros:
    46	%release_name Tizen11.0/Unified
    47	
    48	%tizen_version_major 11
    49	%tizen_version_minor 0
    50	%tizen_version_patch 0
    51	
    52	%tizen_version %{tizen_version_major}.%{tizen_version_minor}
    53	%tizen_full_version %{tizen_version}.%{tizen_version_patch}
    54	%tizen %tizen_version
    55	%vendor tizen
    56	%_vendor tizen
    57	%_with_tizen 1
    58	
    59	#### %__spec_check_pre exit 0
    60	#### %run_check_section 0
    61	
    62	%opensuse_bs 1
    63	%_default_patch_fuzz   2
    64	
    65	%_binary_payload w5T.xzdio
    66	:Macros
    67	
    68	#### %%__spec_check_pre exit 0
    69	#### %%run_check_section 0
    70	
    71	# skip %%check section
    72	Macros:
    73	# skip package list
    74	%_skip_check_packages autogen bison boost expat findutils flex fribidi glibc \\\
    75	gmp gn golang grep libgc libgcrypt libogg libsigc++ libvorbis libxml2 libzio \\\
    76	m4 nspr openssl openssl1.1 perl-Devel-Symdump perl-gettext perl-Pod-Coverage \\\
    77	perl-Test-Pod perl-Test-Pod-Coverage perl-TimeDate procps-ng python3-mako \\\
    78	python3-mock python3-ply python-funcsigs python-mako python-mock python-ply \\\
    79	setup zlib openssl3 autoconf libxcrypt
    80	
    81	%__spec_check_pre \
    82	for name in %_skip_check_packages \
    83	do \
    84	    if [ "$name" = "%{name}" ]; then \
    85	        exit 0 \
    86	    fi \
    87	done \
    88	%{___build_pre} \
    89	%{nil}
    90	
    91	:Macros
    92	
    93	############################# build config #####################################
    94	
    95	########## targets ##########
    96	
    97	%ifarch i586
    98	Target: i686-tizen-linux
    99	%endif
   100	
   101	%ifarch armv7hl
   102	Target: armv7hl-tizen-linux
   103	%endif
   104	
   105	%ifarch armv7l
   106	Target: armv7l-tizen-linux
   107	%endif
   108	
   109	%ifarch aarch64
   110	Target: aarch64-tizen-linux
   111	%endif
   112	
   113	%ifarch riscv64
   114	Target: riscv64-tizen-linux
   115	%endif
   116	
   117	########## cross build ##########
   118	
   119	%define build_hostarch x86_64
   120	Macros:
   121	%build_hostarch x86_64
   122	:Macros
   123	
   124	%ifarch riscv64 %arm armv7l armv7hl aarch64
   125	Hostarch: x86_64
   126	# cross build support for the build hosts
   127	Preinstall: qemu-linux-user-%{build_hostarch}-cross
   128	Runscripts: qemu-linux-user-%{build_hostarch}-cross
   129	Keep: qemu-linux-user-%{build_hostarch}-cross
   130	Macros:
   131	%qemu_user_space_build 1
   132	:Macros
   133	%endif
   134	
   135	%ifarch armv7l
   136	Preinstall: qemu-accel-%{build_hostarch}-armv7l
   137	Runscripts: qemu-accel-%{build_hostarch}-armv7l
   138	Preinstall: libmount libblkid libuuid
   139	%endif
   140	
   141	%ifarch armv7hl
   142	Preinstall: qemu-accel-%{build_hostarch}-armv7hl
   143	Runscripts: qemu-accel-%{build_hostarch}-armv7hl
   144	Preinstall: libmount libblkid libuuid
   145	%endif
   146	
   147	%ifarch aarch64
   148	Preinstall: qemu-accel-%{build_hostarch}-aarch64
   149	Runscripts: qemu-accel-%{build_hostarch}-aarch64
   150	Preinstall: libmount libblkid libuuid
   151	%endif # aarch64
   152	
   153	%ifarch riscv64
   154	Preinstall: qemu-accel-%{build_hostarch}-riscv64
   155	Runscripts: qemu-accel-%{build_hostarch}-riscv64
   156	Preinstall: libmount libblkid libuuid
   157	%endif # riscv64
   158	
   159	Substitute: python-accel-armv7l-cross-arm python-accel-%{build_hostarch}-armv7l
   160	Substitute: python-accel-armv7hl-cross-arm python-accel-%{build_hostarch}-armv7hl
   161	Substitute: python-accel-aarch64-cross-aarch64 python-accel-%{build_hostarch}-aarch64
   162	Substitute: python-accel-riscv64-cross-riscv64 python-accel-%{build_hostarch}-riscv64
   163	
   164	Substitute: clang-accel-armv7l-cross-arm clang-accel-%{build_hostarch}-armv7l
   165	Substitute: clang-accel-armv7hl-cross-arm clang-accel-%{build_hostarch}-armv7hl
   166	Substitute: clang-accel-aarch64-cross-aarch64 clang-accel-%{build_hostarch}-aarch64
   167	Substitute: clang-accel-riscv64-cross-riscv64 clang-accel-%{build_hostarch}-riscv64
   168	
   169	########## exports for different architectures ##########
   170	
   171	ExportFilter: \.armv7l\.rpm$ armv7l
   172	ExportFilter: \.armv7hl\.rpm$ armv7hl
   173	ExportFilter: \.aarch64\.rpm$ aarch64
   174	ExportFilter: \.i586\.rpm$ i586
   175	ExportFilter: \.x86_64\.rpm$ x86_64
   176	ExportFilter: \.riscv64\.rpm$ riscv64
   177	
   178	########## buildroot config ##########
   179	
   180	# Bootstrap stage: Optimal order for bash → dash /bin/sh transition
   181	# Timeline: filesystem → bash (/bin/sh=bash) → setup → dash (/bin/sh=dash)
   182	
   183	Preinstall: filesystem
   184	Preinstall: bash
   185	RunScripts: setup
   186	Preinstall: dash
   187	Preinstall: bzip2 coreutils toybox diffutils grep rpm
   188	Preinstall: glibc libacl libattr libxcrypt
   189	Preinstall: libcap
   190	Preinstall: libgcc
