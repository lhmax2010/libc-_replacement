    40	namespace Starfish {
    41	
    42	// This class is used as a key to clear pending idlers in the message loop
    43	// when a worker terminates.
    44	class WorkerProxyGlobalScope : public GlobalScope, public gc {
    45	public:
    46	    WorkerProxyGlobalScope()
    47	        : GlobalScope(nullptr)
    48	    {
    49	    }
    50	
    51	    ExecutionContext* executionContext() const
    52	    {
    53	        STARFISH_ASSERT_NOT_REACHED();
    54	        return nullptr;
    55	    }
    56	};
    57	
    58	void WorkerThreadClient::onThreadStarted(Thread* thread)
    59	{
    60	}
    61	
    62	void WorkerThreadClient::onThreadFinished(Thread* thread)
    63	{
    64	    if (m_threadFinishedCallback) {
    65	        m_threadFinishedCallback(m_threadFinishedCallbackData);
    66	    }
    67	}
    68	
    69	void WorkerThreadClient::setThreadFinishedCallback(
    70	    ThreadFinishedCallback callback, void* data)
    71	{
    72	    m_threadFinishedCallback = callback;
    73	    m_threadFinishedCallbackData = data;
    74	}
    75	
    76	WorkerThread::WorkerThread(Starfish* starfish, MessageLoop* messageLoop)
    77	    : m_starfish(starfish)
    78	    , m_messageLoop(messageLoop)
    79	    , m_mutex(new Mutex())
    80	    , m_runLoop(nullptr)
    81	    , m_state(State::None)
    82	    , m_workerMessageLoopGlobalScope(new WorkerProxyGlobalScope())
    83	    , m_childThreadDataLock(new Mutex())
    84	{
    85	    m_mainThreadClient = new WorkerThreadClient();
    86	    m_mainThread = new Thread(m_mainThreadClient);
    87	}
    88	
    89	WorkerThread::WorkerThread(Starfish* starfish, MessageLoop* messageLoop,
    90	                           const WorkerHostInitData& initData)
    91	    : WorkerThread(starfish, messageLoop)
    92	{
    93	    m_workerHostInitData = initData;
    94	}
    95	
    96	WorkerThread::WorkerThread(WebBase* webBase, ResourceURL* scriptURL)
    97	    : WorkerThread(webBase->starfish(), webBase->messageLoop())
    98	{
    99	    m_workerHostInitData.url = scriptURL->urlString()->toUTF8NonGCString();
   100	    m_workerHostInitData.baseURL = scriptURL->baseURI()->toUTF8NonGCString();
   101	    m_workerHostInitData.locale = webBase->locale();
   102	    m_workerHostInitData.timezoneID =
   103	        webBase->timezoneID()->toUTF8NonGCString();
   104	    m_workerHostInitData.userAgent = webBase->userAgent()->toUTF8NonGCString();
   105	}
   106	
   107	WorkerThread::~WorkerThread() = default;
   108	
   109	void* WorkerThread::workerMainThreadWork(void* data,
   110	                                         std::future<void>&& stopTask)
   111	{
   112	    WorkerThread* self = static_cast<WorkerThread*>(data);
   113	
   114	    TRACE(WORKER, "start worker thread", getCurrentThreadID());
   115	
   116	    std::promise<void> workerHostThreadSignal;
   117	    auto workerHostThreadFuture = workerHostThreadSignal.get_future();
   118	    self->m_workerThread = std::thread(
   119	        [](std::promise<void> signal, void* data) {
   120	            auto* workerThread = static_cast<WorkerThread*>(data);
   121	            workerThread->initializeWorkerThread();
   122	
   123	            WorkerHost::run(data);
   124	
   125	            signal.set_value();
   126	        },
   127	        std::move(workerHostThreadSignal), data);
   128	    stopTask.wait();
   129	
   130	    if (workerHostThreadFuture.wait_for(std::chrono::seconds(1)) ==
   131	        std::future_status::timeout) {
   132	        self->destroyWorkerThread();
   133	    }
   134	
   135	    self->terminateChildThreads();
   136	
   137	    if (self->m_workerThread.joinable()) {
   138	        self->m_workerThread.join();
   139	    }
   140	
   141	    TRACE(WORKER, "finish worker thread", getCurrentThreadID());
   142	    return nullptr;
   143	}
   144	
   145	void WorkerThread::start()
   146	{
   147	    STARFISH_ASSERT(m_messageLoop->calledOnValidThread());
   148	
   149	    m_state = State::Running;
   150	
   151	    Locker<Mutex> locker(*m_mutex);
   152	
   153	    m_mainThread->run(m_messageLoop, workerMainThreadWork, this);
   154	}
   155	
   156	void WorkerThread::terminate()
   157	{
   158	    TRACE(WORKER);
   159	
   160	    if (m_state != State::Running) {
   161	        return;
   162	    }
   163	
   164	    m_state = State::Terminated;
   165	
   166	    Locker<Mutex> locker(*m_mutex);
   167	
   168	    stopWorkerRunLoop();
   169	    m_mainThread->stop();
   170	}
   171	
   172	void WorkerThread::setOnTerminatedCallback(
   173	    WorkerThreadClient::ThreadFinishedCallback callback, void* data)
   174	{
   175	    m_mainThreadClient->setThreadFinishedCallback(callback, data);
   176	}
   177	
   178	void WorkerThread::initializeWorkerThread()
   179	{
   180	#if defined(OS_POSIX) && !defined(STARFISH_ANDROID)
   181	    pthread_setcancelstate(PTHREAD_CANCEL_ENABLE, NULL);
   182	    pthread_setcanceltype(PTHREAD_CANCEL_ASYNCHRONOUS, NULL);
   183	#else
   184	    STARFISH_UNSUPPORTED("Unsupported platform");
   185	#endif
   186	}
   187	
   188	void WorkerThread::destroyWorkerThread()
   189	{
   190	#if defined(OS_POSIX) && !defined(STARFISH_ANDROID)
   191	    pthread_cancel(m_workerThread.native_handle());
   192	#else
   193	    STARFISH_UNSUPPORTED("Unsupported platform");
   194	#endif
   195	}
   196	
   197	void WorkerThread::onWorkerRunLoopStarted(RunLoop* runLoop)
   198	{
   199	    Locker<Mutex> locker(*m_mutex);
   200	
   201	    STARFISH_ASSERT(!m_runLoop);
   202	    m_runLoop = runLoop;
   203	}
   204	
   205	bool WorkerThread::stopWorkerRunLoop()
   206	{
   207	    if (!m_runLoop) {
   208	        return false;
   209	    }
