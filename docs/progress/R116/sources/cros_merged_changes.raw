9/3857199/8"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/99/3857199/8"}},"commit":{"parents":[{"commit":"32fedbc27e601681d347ef3712b2588bb3732595","subject":"Bump CHROMEOS_BUILD number for source branch main after creating branch firmware-duplo-15151.B"}],"author":{"name":"Christopher Di Bella","email":"cjdb@google.com","date":"2022-08-25 22:25:01.000000000","tz":0},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2022-10-05 17:04:52.000000000","tz":0},"subject":"llvm: upgrade to db1978b67431ca3462ad8935bf662c15750b8252 (r465103)","message":"llvm: upgrade to db1978b67431ca3462ad8935bf662c15750b8252 (r465103)\n\nThe following packages have been updated:\nsys-devel/llvm\nsys-libs/compiler-rt\nsys-libs/llvm-libunwind\n\nBUG\u003db:238678030\n\nChange-Id: I26f3475d4b56629625228d1ccac65bd1c96a2c1a\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3857199\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nCommit-Queue: Christopher Di Bella \u003ccjdb@google.com\u003e\nTested-by: Christopher Di Bella \u003ccjdb@google.com\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3878402","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I585d56ca44530852057f91169071bc0b74f6e25d","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1508123":{"account":{"_account_id":1508123},"last_update":"2022-09-07 12:54:45.000000000","reason":"Change was submitted"},"1458627":{"account":{"_account_id":1458627},"last_update":"2022-09-06 23:59:08.000000000","reason":"\u003cGERRIT_ACCOUNT_1458627\u003e replied on the change","reason_account":{"_account_id":1458627}}},"hashtags":[],"change_id":"I585d56ca44530852057f91169071bc0b74f6e25d","subject":"dev-embedded/hps-sdk: update Rust to 1.62.1","status":"MERGED","created":"2022-09-06 23:50:53.000000000","updated":"2022-09-07 12:54:45.000000000","submitted":"2022-09-07 12:54:45.000000000","submitter":{"_account_id":1530088},"insertions":117,"deletions":81,"total_comment_count":1,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3878402","meta_rev_id":"beff0fe60d2fca2c59b74b065266fc17c1dfeff3","_number":3878402,"virtual_id_number":3878402,"owner":{"_account_id":1508123},"current_revision_number":2,"current_revision":"032a2158b97f1db3fb30f80a7866f697cd53e879","revisions":{"032a2158b97f1db3fb30f80a7866f697cd53e879":{"kind":"REWORK","_number":2,"created":"2022-09-07 12:54:45.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/02/3878402/2","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/02/3878402/2"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/02/3878402/2"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/02/3878402/2"}},"commit":{"parents":[{"commit":"65c8fa73dcac87a3fd008d52c7e47805ee173202","subject":"Marking set of ebuilds as stable"}],"author":{"name":"Dan Callaghan","email":"dcallagh@google.com","date":"2022-09-06 23:32:47.000000000","tz":600},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2022-09-07 12:54:45.000000000","tz":0},"subject":"dev-embedded/hps-sdk: update Rust to 1.62.1","message":"dev-embedded/hps-sdk: update Rust to 1.62.1\n\nPatches are taken as is from dev-lang/rust.\n\nThe copy of miri bundled with rustc under src/tools/miri does not\ncompile, so we replace it with a slightly later version of miri from its\nupstream git repo, after it had been updated to account for all the\ncompiler changes in 1.62.\n\nBUG\u003db:241835221\nTEST\u003dsudo emerge hps-sdk \u0026\u0026 emerge-brya hps-firmware{,-tools}\nTEST\u003dscripts/run-tests\nTEST\u003dcargo miri setup \u0026\u0026 scripts/run-tests-miri\nTEST\u003dscripts/test-models\n\nChange-Id: I585d56ca44530852057f91169071bc0b74f6e25d\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3878402\nTested-by: Dan Callaghan \u003cdcallagh@chromium.org\u003e\nReviewed-by: David Lattimore \u003cdml@chromium.org\u003e\nCommit-Queue: Dan Callaghan \u003cdcallagh@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3831381","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I4dac14bbc3e8a27ea2ca785462cb02b11360c041","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1511402":{"account":{"_account_id":1511402},"last_update":"2022-08-15 16:14:42.000000000","reason":"Change was submitted"},"1158719":{"account":{"_account_id":1158719},"last_update":"2022-08-15 08:12:09.000000000","reason":"removed on reply"}},"hashtags":[],"change_id":"I4dac14bbc3e8a27ea2ca785462cb02b11360c041","subject":"dev-lang/{rust, rust-host}: upgrade to Rust 1.62.1","status":"MERGED","created":"2022-08-15 00:35:44.000000000","updated":"2022-08-15 16:14:42.000000000","submitted":"2022-08-15 16:14:42.000000000","submitter":{"_account_id":1511402},"insertions":57,"deletions":88,"total_comment_count":0,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3831383","meta_rev_id":"d853cae5530f264ce7b70f4b328ba68a845897f8","_number":3831381,"virtual_id_number":3831381,"owner":{"_account_id":1511402},"current_revision_number":2,"current_revision":"fbcc7a84377407282a9def2949e446f01b23fd29","revisions":{"fbcc7a84377407282a9def2949e446f01b23fd29":{"kind":"REWORK","_number":2,"created":"2022-08-15 16:14:42.000000000","uploader":{"_account_id":1511402},"ref":"refs/changes/81/3831381/2","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/81/3831381/2"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/81/3831381/2"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/81/3831381/2"}},"commit":{"parents":[{"commit":"ab6a03d8b8881d39437c12ddab30b711c268b9a2","subject":"Generate and/or use PGO profiles in the Rust compiler."}],"author":{"name":"Michael Benfield","email":"mbenfield@google.com","date":"2022-07-13 23:20:28.000000000","tz":0},"committer":{"name":"Michael Benfield","email":"mbenfield@google.com","date":"2022-08-15 16:14:42.000000000","tz":0},"subject":"dev-lang/{rust, rust-host}: upgrade to Rust 1.62.1","message":"dev-lang/{rust, rust-host}: upgrade to Rust 1.62.1\n\nThis upgrades Rust to 1.62.1 from 1.60.0.\n\nrust-1.60.0-fix-libunwind-backtrace-visibility.patch: removed\nbecause it has been merged upstream.\n\nSome other patches just have changes necessary to get them to apply.\n\nDrop the version number from patches as they no longer serve our needs\nand just cause clutter to uprev CLs.\n\nAlso, we need `static-libstdcpp \u003d false` in Rust\u0027s `config.toml` due to\nthis commit:\nca82e6cf18bb0f7765a978229f4899c33c5fdc7d\nin the Rust repository, which apparently did something to make dynamic\nlinking with the C++ standard library the default for LLVM tools.\nWithout this we will get a linking error.\n\nrust-Bump-cc-version-in-bootstrap-to-fix-build-of-uefi-ta.patch: bump cc\nup again to 1.0.73, since 1.0.72 is no longer vendored.\n\ncros-rust.eclass: get rid of Cargo.toml.orig if it exists when running\n`cargo package`, as that file is now reserved. See\nhttps://github.com/rust-lang/cargo/pull/10551\n\nAlso use -Cllvm-args\u003d-experimental-debug-variable-locations\u003d0 when\nbuilding Rust packages with fuzzing, to work around\nhttps://github.com/rust-lang/rust/issues/99886\nrather than using a patch, as the command line option will probably be\nless burdensome.\n\nFinally, this uprev uses PGO for the Rust compiler for the first time.\n\nBUG\u003db:237786394,b:234046818\nTEST\u003dCQ\n\nCq-Include-Trybots: chromeos/cq:cq-llvm-orchestrator\nChange-Id: I4dac14bbc3e8a27ea2ca785462cb02b11360c041\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3831381\nTested-by: Michael Benfield \u003cmbenfield@google.com\u003e\nReviewed-by: George Burgess \u003cgbiv@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3816974","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~stabilize-15033.B~I7613ba90960152631a1b1f08831bd45ef49ae6ca","project":"chromiumos/overlays/chromiumos-overlay","branch":"stabilize-15033.B","full_branch":"refs/heads/stabilize-15033.B","attention_set":{},"removed_from_attention_set":{"1511402":{"account":{"_account_id":1511402},"last_update":"2022-08-11 18:32:44.000000000","reason":"Change was abandoned"}},"hashtags":[],"change_id":"I7613ba90960152631a1b1f08831bd45ef49ae6ca","subject":"dev-lang/{rust, rust-host}: upgrade to Rust 1.62.1","status":"MERGED","created":"2022-08-08 19:18:59.000000000","updated":"2022-08-12 19:30:33.000000000","submitted":"2022-08-12 19:30:33.000000000","submitter":{"_account_id":1511402},"insertions":57,"deletions":88,"total_comment_count":0,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3816974","cherry_pick_of_change":3762716,"cherry_pick_of_patch_set":17,"meta_rev_id":"1657fe24d66b06c388b2facf7d779308302fae8d","_number":3816974,"virtual_id_number":3816974,"owner":{"_account_id":1511402},"current_revision_number":3,"current_revision":"358679e3301c835b2bf469f47c6d1101236528cd","revisions":{"358679e3301c835b2bf469f47c6d1101236528cd":{"kind":"NO_CODE_CHANGE","_number":3,"created":"2022-08-12 19:30:33.000000000","uploader":{"_account_id":1511402},"ref":"refs/changes/74/3816974/3","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/74/3816974/3"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/74/3816974/3"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/74/3816974/3"}},"commit":{"parents":[{"commit":"9bc3d5c786bf39f62f6927a7e4618b1ff03ac01d","subject":"Generate and/or use PGO profiles in the Rust compiler."}],"author":{"name":"Michael Benfield","email":"mbenfield@google.com","date":"2022-07-13 23:20:28.000000000","tz":0},"committer":{"name":"Michael Benfield","email":"mbenfield@google.com","date":"2022-08-12 19:30:33.000000000","tz":0},"subject":"dev-lang/{rust, rust-host}: upgrade to Rust 1.62.1","message":"dev-lang/{rust, rust-host}: upgrade to Rust 1.62.1\n\nThis upgrades Rust to 1.62.1 from 1.60.0.\n\nrust-1.60.0-fix-libunwind-backtrace-visibility.patch: removed\nbecause it has been merged upstream.\n\nSome other patches just have changes necessary to get them to apply.\n\nDrop the version number from patches as they no longer serve our needs\nand just cause clutter to uprev CLs.\n\nAlso, we need `static-libstdcpp \u003d false` in Rust\u0027s `config.toml` due to\nthis commit:\nca82e6cf18bb0f7765a978229f4899c33c5fdc7d\nin the Rust repository, which apparently did something to make dynamic\nlinking with the C++ standard library the default for LLVM tools.\nWithout this we will get a linking error.\n\nrust-Bump-cc-version-in-bootstrap-to-fix-build-of-uefi-ta.patch: bump cc\nup again to 1.0.73, since 1.0.72 is no longer vendored.\n\ncros-rust.eclass: get rid of Cargo.toml.orig if it exists when running\n`cargo package`, as that file is now reserved. See\nhttps://github.com/rust-lang/cargo/pull/10551\n\nAlso use -Cllvm-args\u003d-experimental-debug-variable-locations\u003d0 when\nbuilding Rust packages with fuzzing, to work around\nhttps://github.com/rust-lang/rust/issues/99886\nrather than using a patch, as the command line option will probably be\nless burdensome.\n\nFinally, this uprev uses PGO for the Rust compiler for the first time.\n\nBUG\u003db:237786394,b:234046818\nTEST\u003dCQ\n\nCq-Include-Trybots: chromeos/cq:cq-llvm-orchestrator\nChange-Id: I7613ba90960152631a1b1f08831bd45ef49ae6ca\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3816974\nReviewed-by: George Burgess \u003cgbiv@chromium.org\u003e\nTested-by: Michael Benfield \u003cmbenfield@google.com\u003e\n"},"branch":"refs/heads/stabilize-15033.B"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3829868","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~Ia964a71227b79639dbd647784a94fb850d699f47","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1511402":{"account":{"_account_id":1511402},"last_update":"2022-08-12 19:15:30.000000000","reason":"Change was submitted"},"1158719":{"account":{"_account_id":1158719},"last_update":"2022-08-12 19:02:52.000000000","reason":"\u003cGERRIT_ACCOUNT_1158719\u003e replied on the change","reason_account":{"_account_id":1158719}},"1171009":{"account":{"_account_id":1171009},"last_update":"2022-08-12 19:01:44.000000000","reason":"\u003cGERRIT_ACCOUNT_1171009\u003e replied on the change","reason_account":{"_account_id":1171009}}},"hashtags":[],"change_id":"Ia964a71227b79639dbd647784a94fb850d699f47","subject":"Revert 3 commits due to an incomplete Rust roll.","status":"MERGED","created":"2022-08-12 18:58:13.000000000","updated":"2022-08-12 19:15:30.000000000","submitted":"2022-08-12 19:15:30.000000000","submitter":{"_account_id":1158719},"insertions":130,"deletions":475,"total_comment_count":2,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3829868","meta_rev_id":"4b7336d0535ef4b46cafa250e8342af3e6ac9a06","_number":3829868,"virtual_id_number":3829868,"owner":{"_account_id":1511402},"current_revision_number":3,"current_revision":"c0dc905ba192fd947a7c79a3186a7fa141a94e70","revisions":{"c0dc905ba192fd947a7c79a3186a7fa141a94e70":{"kind":"REWORK","_number":3,"created":"2022-08-12 19:15:30.000000000","uploader":{"_account_id":1158719},"ref":"refs/changes/68/3829868/3","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/68/3829868/3"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/68/3829868/3"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/68/3829868/3"}},"commit":{"parents":[{"commit":"702b42cdc6cf44dd353d1e3c09aa33024c78ad81","subject":"Marking set of ebuilds as stable"}],"author":{"name":"Michael Benfield","email":"mbenfield@google.com","date":"2022-08-12 18:50:59.000000000","tz":0},"committer":{"name":"George Burgess","email":"gbiv@chromium.org","date":"2022-08-12 19:15:30.000000000","tz":0},"subject":"Revert 3 commits due to an incomplete Rust roll.","message":"Revert 3 commits due to an incomplete Rust roll.\n\nRevert \"rust: add more bisection scripts, documentation\"\n\nThis reverts commit 9bbdd58cf3fd521e99ee3f0a2f9a509825dee158.\n\nRevert \"Generate and/or use PGO profiles in the Rust compiler.\"\n\nThis reverts commit 781355124c0a2e01a6f887329651264bf4763d5a.\n\nRevert \"dev-lang/{rust, rust-host}: upgrade to Rust 1.62.1\"\n\nThis reverts commit 0135d5ceb3c2e13fe7a512e8db9a8287f8b45deb.\n\nBUG\u003db:242236958,b:242227982,b:242256941\nTEST\u003dCQ\n\nChange-Id: Ia964a71227b79639dbd647784a94fb850d699f47\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3829868\nTested-by: George Burgess \u003cgbiv@chromium.org\u003e\nReviewed-by: George Burgess \u003cgbiv@chromium.org\u003e\nReviewed-by: Lizzy Presland \u003czland@google.com\u003e\nAuto-Submit: Michael Benfield \u003cmbenfield@google.com\u003e\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3762716","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I7613ba90960152631a1b1f08831bd45ef49ae6ca","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1511402":{"account":{"_account_id":1511402},"last_update":"2022-08-11 18:25:50.000000000","reason":"removed on reply"},"1158719":{"account":{"_account_id":1158719},"last_update":"2022-08-10 18:30:10.000000000","reason":"removed on reply"},"1222289":{"account":{"_account_id":1222289},"last_update":"2022-08-11 18:27:31.000000000","reason":"Change was submitted"}},"hashtags":[],"change_id":"I7613ba90960152631a1b1f08831bd45ef49ae6ca","subject":"dev-lang/{rust, rust-host}: upgrade to Rust 1.62.1","status":"MERGED","created":"2022-07-14 19:23:52.000000000","updated":"2022-08-11 18:27:31.000000000","submitted":"2022-08-11 18:27:31.000000000","submitter":{"_account_id":1511402},"insertions":57,"deletions":88,"total_comment_count":6,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3762716","meta_rev_id":"c917ef97c912c365926458276825edec9a888c22","_number":3762716,"virtual_id_number":3762716,"owner":{"_account_id":1511402},"current_revision_number":18,"current_revision":"0135d5ceb3c2e13fe7a512e8db9a8287f8b45deb","revisions":{"0135d5ceb3c2e13fe7a512e8db9a8287f8b45deb":{"kind":"REWORK","_number":18,"created":"2022-08-11 18:27:31.000000000","uploader":{"_account_id":1511402},"ref":"refs/changes/16/3762716/18","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/16/3762716/18"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/16/3762716/18"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/16/3762716/18"}},"commit":{"parents":[{"commit":"781355124c0a2e01a6f887329651264bf4763d5a","subject":"Generate and/or use PGO profiles in the Rust compiler."}],"author":{"name":"Michael Benfield","email":"mbenfield@google.com","date":"2022-07-13 23:20:28.000000000","tz":0},"committer":{"name":"Michael Benfield","email":"mbenfield@google.com","date":"2022-08-11 18:27:31.000000000","tz":0},"subject":"dev-lang/{rust, rust-host}: upgrade to Rust 1.62.1","message":"dev-lang/{rust, rust-host}: upgrade to Rust 1.62.1\n\nThis upgrades Rust to 1.62.1 from 1.60.0.\n\nrust-1.60.0-fix-libunwind-backtrace-visibility.patch: removed\nbecause it has been merged upstream.\n\nSome other patches just have changes necessary to get them to apply.\n\nDrop the version number from patches as they no longer serve our needs\nand just cause clutter to uprev CLs.\n\nAlso, we need `static-libstdcpp \u003d false` in Rust\u0027s `config.toml` due to\nthis commit:\nca82e6cf18bb0f7765a978229f4899c33c5fdc7d\nin the Rust repository, which apparently did something to make dynamic\nlinking with the C++ standard library the default for LLVM tools.\nWithout this we will get a linking error.\n\nrust-Bump-cc-version-in-bootstrap-to-fix-build-of-uefi-ta.patch: bump cc\nup again to 1.0.73, since 1.0.72 is no longer vendored.\n\ncros-rust.eclass: get rid of Cargo.toml.orig if it exists when running\n`cargo package`, as that file is now reserved. See\nhttps://github.com/rust-lang/cargo/pull/10551\n\nAlso use -Cllvm-args\u003d-experimental-debug-variable-locations\u003d0 when\nbuilding Rust packages with fuzzing, to work around\nhttps://github.com/rust-lang/rust/issues/99886\nrather than using a patch, as the command line option will probably be\nless burdensome.\n\nFinally, this uprev uses PGO for the Rust compiler for the first time.\n\nBUG\u003db:237786394,b:234046818\nTEST\u003dCQ\n\nCq-Include-Trybots: chromeos/cq:cq-llvm-orchestrator\nChange-Id: I7613ba90960152631a1b1f08831bd45ef49ae6ca\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3762716\nReviewed-by: George Burgess \u003cgbiv@chromium.org\u003e\nTested-by: Michael Benfield \u003cmbenfield@google.com\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3755890","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~If1d613365baba35c081e0f928f7243e3e7525400","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1511402":{"account":{"_account_id":1511402},"last_update":"2022-07-14 17:25:53.000000000","reason":"removed on reply"},"1222289":{"account":{"_account_id":1222289},"last_update":"2022-07-11 20:00:55.000000000","reason":"\u003cGERRIT_ACCOUNT_1222289\u003e replied on the change","reason_account":{"_account_id":1222289}}},"hashtags":[],"change_id":"If1d613365baba35c081e0f928f7243e3e7525400","subject":"dev-lang/rust: upgrade to Rust 1.60.0","status":"MERGED","created":"2022-07-11 17:08:20.000000000","updated":"2022-07-21 18:04:04.000000000","submitted":"2022-07-14 17:38:41.000000000","submitter":{"_account_id":1511402},"insertions":122,"deletions":35,"total_comment_count":9,"unresolved_comment_count":1,"has_review_started":true,"submission_id":"3755890","meta_rev_id":"fb7f7d8b346761b1b0e06d0d9d83229b04b9ded5","_number":3755890,"virtual_id_number":3755890,"owner":{"_account_id":1511402},"current_revision_number":3,"current_revision":"b5128bf7a40a77127aed93050411d045f1cb9bb3","revisions":{"b5128bf7a40a77127aed93050411d045f1cb9bb3":{"kind":"REWORK","_number":3,"created":"2022-07-14 17:38:41.000000000","uploader":{"_account_id":1511402},"ref":"refs/changes/90/3755890/3","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/90/3755890/3"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/90/3755890/3"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/90/3755890/3"}},"commit":{"parents":[{"commit":"b593eb780a3ac203b033478159f0ef20411c665b","subject":"Marking set of ebuilds as stable"}],"author":{"name":"Bob Haarman","email":"inglorion@chromium.org","date":"2022-04-11 18:27:38.000000000","tz":-420},"committer":{"name":"Michael Benfield","email":"mbenfield@google.com","date":"2022-07-14 17:38:41.000000000","tz":0},"subject":"dev-lang/rust: upgrade to Rust 1.60.0","message":"dev-lang/rust: upgrade to Rust 1.60.0\n\nThis upgrades Rust to 1.60.0 from 1.58.1.\n\nSince instrument-coverage is now stable, this changes\ncros-rust.eclass to pass -Cinstrument-coverage instead of\n-Zinstrument-coverage. Except we actually have instrument\ncoverage commented out for Rust (b:230127632), so we keep\nit that way.\n\nTo avoid b:229824406 (relocation refers to discarded section),\nthis change includes a patch which fixes the issue by causing\n-Cpasses\u003d to only affect pre-link stages, not link-time\noptimization. The upstream pull request for this fix is\nhttps://github.com/rust-lang/rust/pull/97969, and has\nbeen merged into upstream rust.\n\nAlso added the patch\n\nrust-1.60.0-Revert-DebugInfo-Re-enable-instruction-referencing-f.patch\n\nto fix a segfault that appears when doing `sudo emerge-betty chunnel`\nwhen Betty is built with a fuzzer profile.\n\nAlso install Rust sources, which will be needed by\nrust-analyzer (see b:235120448), and disable a few\nshellcheck warnings.\n\nBUG\u003db:228448006, b:221426668, b:235120448\nTEST\u003dUse CQ to test the new Rust version\n\nChange-Id: If1d613365baba35c081e0f928f7243e3e7525400\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3755890\nReviewed-by: Bob Haarman \u003cinglorion@chromium.org\u003e\nTested-by: Michael Benfield \u003cmbenfield@google.com\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3760325","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I5543ac1e3b3e9b137636bc2d427625351dcffecc","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1508123":{"account":{"_account_id":1508123},"last_update":"2022-07-18 03:24:45.000000000","reason":"\u003cGERRIT_ACCOUNT_1508123\u003e replied on the change","reason_account":{"_account_id":1508123}},"1458627":{"account":{"_account_id":1458627},"last_update":"2022-07-14 00:02:42.000000000","reason":"\u003cGERRIT_ACCOUNT_1458627\u003e replied on the change","reason_account":{"_account_id":1458627}}},"hashtags":[],"change_id":"I5543ac1e3b3e9b137636bc2d427625351dcffecc","subject":"dev-embedded/hps-sdk: update Rust to 1.60.0","status":"MERGED","created":"2022-07-13 08:45:19.000000000","updated":"2022-07-18 08:34:35.000000000","submitted":"2022-07-18 08:34:35.000000000","submitter":{"_account_id":1530088},"insertions":104,"deletions":32,"total_comment_count":3,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3760325","meta_rev_id":"eeaee367fa10e9707d96dcba74999bed3b4dec2b","_number":3760325,"virtual_id_number":3760325,"owner":{"_account_id":1508123},"current_revision_number":2,"current_revision":"1142cf4776f4e9c261a616aed0d540c2135fe56c","revisions":{"1142cf4776f4e9c261a616aed0d540c2135fe56c":{"kind":"REWORK","_number":2,"created":"2022-07-18 08:34:35.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/25/3760325/2","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/25/3760325/2"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/25/3760325/2"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/25/3760325/2"}},"commit":{"parents":[{"commit":"eb3f17075258a9cc0aecd030b93081d6d8658ab7","subject":"chromeos-languagepacks: Create DLC for Handwriting Library"}],"author":{"name":"Dan Callaghan","email":"dcallagh@google.com","date":"2022-07-13 08:43:40.000000000","tz":600},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2022-07-18 08:34:35.000000000","tz":0},"subject":"dev-embedded/hps-sdk: update Rust to 1.60.0","message":"dev-embedded/hps-sdk: update Rust to 1.60.0\n\nPatches are taken as is from dev-lang/rust.\n\nBUG\u003db:238816718\nTEST\u003dsudo emerge hps-sdk \u0026\u0026 emerge-brya hps-firmware{,-tools}\nTEST\u003dscripts/test-models\n\nChange-Id: I5543ac1e3b3e9b137636bc2d427625351dcffecc\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3760325\nCommit-Queue: Dan Callaghan \u003cdcallagh@chromium.org\u003e\nReviewed-by: David Lattimore \u003cdml@chromium.org\u003e\nTested-by: Dan Callaghan \u003cdcallagh@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3765888","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~Ie1662a86868e79fe551e30f9b9a60640504c5715","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1158719":{"account":{"_account_id":1158719},"last_update":"2022-07-16 19:40:52.000000000","reason":"removed on reply"},"1504745":{"account":{"_account_id":1504745},"last_update":"2022-07-16 21:34:42.000000000","reason":"Change was submitted"},"1171009":{"account":{"_account_id":1171009},"last_update":"2022-07-15 19:33:58.000000000","reason":"\u003cGERRIT_ACCOUNT_1171009\u003e replied on the change","reason_account":{"_account_id":1171009}}},"hashtags":[],"change_id":"Ie1662a86868e79fe551e30f9b9a60640504c5715","subject":"llvm: Update patch_manager hunk handling","status":"MERGED","created":"2022-07-15 18:20:48.000000000","updated":"2022-07-16 21:34:42.000000000","submitted":"2022-07-16 21:34:42.000000000","submitter":{"_account_id":1530088},"insertions":693,"deletions":648,"total_comment_count":8,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3765888","meta_rev_id":"e22b77c0fe08d3cda12185849a96768bcda7b8d9","_number":3765888,"virtual_id_number":3765888,"owner":{"_account_id":1504745},"current_revision_number":4,"current_revision":"9300e7df5b01c27f6a2b9662ed78ee07d342aa12","revisions":{"9300e7df5b01c27f6a2b9662ed78ee07d342aa12":{"kind":"REWORK","_number":4,"created":"2022-07-16 21:34:42.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/88/3765888/4","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/88/3765888/4"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/88/3765888/4"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/88/3765888/4"}},"commit":{"parents":[{"commit":"9ae4fdd9f40842d150f72be99354dbf76bd77fbd","subject":"Marking set of ebuilds as stable"}],"author":{"name":"Jordan R Abrahams-Whitehead","email":"ajordanr@google.com","date":"2022-07-15 17:59:11.000000000","tz":0},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2022-07-16 21:34:42.000000000","tz":0},"subject":"llvm: Update patch_manager hunk handling","message":"llvm: Update patch_manager hunk handling\n\nAt present, patch_manager in the LLVM portage package is\nout of date. This CL updates it to the new version which\nhas better patch hunk debugging abilities.\n\nBUG\u003db:188465085\nTEST\u003dCQ\n\nChange-Id: Ie1662a86868e79fe551e30f9b9a60640504c5715\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3765888\nCommit-Queue: George Burgess \u003cgbiv@chromium.org\u003e\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nTested-by: George Burgess \u003cgbiv@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3758866","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~stabilize-14964.B~If1d613365baba35c081e0f928f7243e3e7525400","project":"chromiumos/overlays/chromiumos-overlay","branch":"stabilize-14964.B","full_branch":"refs/heads/stabilize-14964.B","attention_set":{},"removed_from_attention_set":{"1511402":{"account":{"_account_id":1511402},"last_update":"2022-07-12 17:26:50.000000000","reason":"\u003cGERRIT_ACCOUNT_1511402\u003e replied on the change","reason_account":{"_account_id":1511402}}},"hashtags":[],"change_id":"If1d613365baba35c081e0f928f7243e3e7525400","subject":"dev-lang/rust: upgrade to Rust 1.60.0","status":"MERGED","created":"2022-07-12 17:05:37.000000000","updated":"2022-07-12 17:27:09.000000000","submitted":"2022-07-12 17:27:09.000000000","submitter":{"_account_id":1511402},"insertions":122,"deletions":35,"total_comment_count":0,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3758866","cherry_pick_of_change":3755890,"cherry_pick_of_patch_set":2,"meta_rev_id":"f017acf2acd5c201bbb5d0f0bd19456ceb6ff3f3","_number":3758866,"virtual_id_number":3758866,"owner":{"_account_id":1511402},"current_revision_number":2,"current_revision":"8b15efdde5a8eb7920f7a7cf561ef0b70efe6fc1","revisions":{"8b15efdde5a8eb7920f7a7cf561ef0b70efe6fc1":{"kind":"NO_CODE_CHANGE","_number":2,"created":"2022-07-12 17:27:09.000000000","uploader":{"_account_id":1511402},"ref":"refs/changes/66/3758866/2","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/66/3758866/2"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/66/3758866/2"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/66/3758866/2"}},"commit":{"parents":[{"commit":"83cfd80c6a565ed704f23f601db1475b58f8e665","subject":"Bump CHROMEOS_BRANCH number after creating branch stabilize-14964.B"}],"author":{"name":"Bob Haarman","email":"inglorion@chromium.org","date":"2022-04-11 18:27:38.000000000","tz":-420},"committer":{"name":"Michael Benfield","email":"mbenfield@google.com","date":"2022-07-12 17:27:09.000000000","tz":0},"subject":"dev-lang/rust: upgrade to Rust 1.60.0","message":"dev-lang/rust: upgrade to Rust 1.60.0\n\nThis upgrades Rust to 1.60.0 from 1.58.1.\n\nSince instrument-coverage is now stable, this changes\ncros-rust.eclass to pass -Cinstrument-coverage instead of\n-Zinstrument-coverage. Except we actually have instrument\ncoverage commented out for Rust (b:230127632), so we keep\nit that way.\n\nTo avoid b:229824406 (relocation refers to discarded section),\nthis change includes a patch which fixes the issue by causing\n-Cpasses\u003d to only affect pre-link stages, not link-time\noptimization. The upstream pull request for this fix is\nhttps://github.com/rust-lang/rust/pull/97969, and has\nbeen merged into upstream rust.\n\nAlso added the patch\n\nrust-1.60.0-Revert-DebugInfo-Re-enable-instruction-referencing-f.patch\n\nto fix a segfault that appears when doing `sudo emerge-betty chunnel`\nwhen Betty is built with a fuzzer profile.\n\nAlso install Rust sources, which will be needed by\nrust-analyzer (see b:235120448), and disable a few\nshellcheck warnings.\n\nBUG\u003db:228448006, b:221426668, b:235120448\nTEST\u003dUse CQ to test the new Rust version\n\nChange-Id: If1d613365baba35c081e0f928f7243e3e7525400\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3758866\nReviewed-by: George Burgess \u003cgbiv@chromium.org\u003e\nTested-by: Michael Benfield \u003cmbenfield@google.com\u003e\n"},"branch":"refs/heads/stabilize-14964.B"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3749715","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I5d66f62a1191327ee72bf9852c60b7372a02b07e","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1457772":{"account":{"_account_id":1457772},"last_update":"2022-07-12 14:10:26.000000000","reason":"Change was submitted"},"1347075":{"account":{"_account_id":1347075},"last_update":"2022-07-12 14:05:46.000000000","reason":"\u003cGERRIT_ACCOUNT_1347075\u003e replied on the change","reason_account":{"_account_id":1347075}},"1171009":{"account":{"_account_id":1171009},"last_update":"2022-07-11 22:40:37.000000000","reason":"\u003cGERRIT_ACCOUNT_1171009\u003e replied on the change","reason_account":{"_account_id":1171009}}},"hashtags":[],"change_id":"I5d66f62a1191327ee72bf9852c60b7372a02b07e","subject":"llvm-next/google3: upgrade to db1978b67431ca3462ad8935bf662c15750b8252 (r465103)","status":"MERGED","created":"2022-07-06 23:12:55.000000000","updated":"2022-07-12 14:10:26.000000000","submitted":"2022-07-12 14:10:26.000000000","submitter":{"_account_id":1347075},"insertions":6,"deletions":6,"total_comment_count":2,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3749715","meta_rev_id":"8c46e37d38c56038a0aa1f7ef7eb6057c1851d50","_number":3749715,"virtual_id_number":3749715,"owner":{"_account_id":1457772},"current_revision_number":4,"current_revision":"caa2850a8602ff966566428a7c67d904c80573b4","revisions":{"caa2850a8602ff966566428a7c67d904c80573b4":{"kind":"REWORK","_number":4,"created":"2022-07-12 14:10:26.000000000","uploader":{"_account_id":1347075},"ref":"refs/changes/15/3749715/4","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/15/3749715/4"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/15/3749715/4"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/15/3749715/4"}},"commit":{"parents":[{"commit":"87b4c5428c604f86a442e429286db356abf5d144","subject":"Marking set of ebuilds as stable"}],"author":{"name":"Christopher Di Bella","email":"cjdb@google.com","date":"2022-07-06 23:12:47.000000000","tz":0},"committer":{"name":"Denis Nikitin","email":"denik@chromium.org","date":"2022-07-12 14:10:26.000000000","tz":0},"subject":"llvm-next/google3: upgrade to db1978b67431ca3462ad8935bf662c15750b8252 (r465103)","message":"llvm-next/google3: upgrade to db1978b67431ca3462ad8935bf662c15750b8252 (r465103)\n\nThe following packages have been updated:\ndev-util/lldb-server\nsys-devel/llvm\nsys-libs/compiler-rt\nsys-libs/libcxx\nsys-libs/libcxxabi\nsys-libs/llvm-libunwind\n\nBUG\u003db:238678030\nTEST\u003dCQ\n\nChange-Id: I5d66f62a1191327ee72bf9852c60b7372a02b07e\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3749715\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nTested-by: Denis Nikitin \u003cdenik@chromium.org\u003e\nAuto-Submit: Christopher Di Bella \u003ccjdb@google.com\u003e\nReviewed-by: Denis Nikitin \u003cdenik@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3697359","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~Id97664b29ae84fb9736927d22ba8ac505f63703e","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1314845":{"account":{"_account_id":1314845},"last_update":"2022-06-27 20:37:22.000000000","reason":"Change was submitted"},"1171009":{"account":{"_account_id":1171009},"last_update":"2022-06-27 20:37:22.000000000","reason":"Change was submitted"}},"hashtags":[],"change_id":"Id97664b29ae84fb9736927d22ba8ac505f63703e","subject":"sys-libs/libcxx,llvm-unwind: Turn off PIC for baremetal toolchains","status":"MERGED","created":"2022-06-09 00:05:17.000000000","updated":"2022-06-27 20:37:22.000000000","submitted":"2022-06-27 20:37:22.000000000","submitter":{"_account_id":1171009},"insertions":2,"deletions":0,"total_comment_count":2,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3697359","meta_rev_id":"8f9ef3652a914993599e4de1e7235add99a4d8bb","_number":3697359,"virtual_id_number":3697359,"owner":{"_account_id":1314845},"current_revision_number":4,"current_revision":"218ef03663da94ec0738cb4e7bc674d713f917d6","revisions":{"218ef03663da94ec0738cb4e7bc674d713f917d6":{"kind":"REWORK","_number":4,"created":"2022-06-27 20:37:22.000000000","uploader":{"_account_id":1171009},"ref":"refs/changes/59/3697359/4","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/59/3697359/4"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/59/3697359/4"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/59/3697359/4"}},"commit":{"parents":[{"commit":"7b32e1bc6e1578cf429c136e2a38a45d253de546","subject":"Marking set of ebuilds as stable"}],"author":{"name":"Tom Hughes","email":"tomhughes@chromium.org","date":"2022-06-16 16:44:49.000000000","tz":-420},"committer":{"name":"Manoj Gupta","email":"manojgupta@chromium.org","date":"2022-06-27 20:37:22.000000000","tz":0},"subject":"sys-libs/libcxx,llvm-unwind: Turn off PIC for baremetal toolchains","message":"sys-libs/libcxx,llvm-unwind: Turn off PIC for baremetal toolchains\n\nBUG\u003db:234507656, b:234181908, b:172020503\nTEST\u003dCQ passes\n\nChange-Id: Id97664b29ae84fb9736927d22ba8ac505f63703e\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3697359\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nTested-by: Tom Hughes \u003ctomhughes@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3720699","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I40dd03cbc723125e82d040cff433d98009aa206f","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1474527":{"account":{"_account_id":1474527},"last_update":"2022-06-26 02:01:22.000000000","reason":"Change was submitted"},"1171009":{"account":{"_account_id":1171009},"last_update":"2022-06-25 15:44:50.000000000","reason":"\u003cGERRIT_ACCOUNT_1171009\u003e replied on the change","reason_account":{"_account_id":1171009}}},"hashtags":[],"change_id":"I40dd03cbc723125e82d040cff433d98009aa206f","subject":"sys-libs/libunwind: disable stack-protector on armv7a","status":"MERGED","created":"2022-06-23 10:09:44.000000000","updated":"2022-06-26 02:01:22.000000000","submitted":"2022-06-26 02:01:22.000000000","submitter":{"_account_id":1530088},"insertions":9,"deletions":1,"total_comment_count":4,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3720699","meta_rev_id":"6f4f2706caad07ed0546be385a40b58bf56d9aec","_number":3720699,"virtual_id_number":3720699,"owner":{"_account_id":1474527},"current_revision_number":3,"current_revision":"571375fce17f67b4b4cb656fd346cc5bfdba58a2","revisions":{"571375fce17f67b4b4cb656fd346cc5bfdba58a2":{"kind":"REWORK","_number":3,"created":"2022-06-26 02:01:22.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/99/3720699/3","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/99/3720699/3"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/99/3720699/3"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/99/3720699/3"}},"commit":{"parents":[{"commit":"0e6c04cf04dd35e2a4af1b7bc1a76718ad254f2a","subject":"Uprev protofiles and VERSION to Chromium 105.0.5134."}],"author":{"name":"Adrian Ratiu","email":"adrian.ratiu@collabora.corp-partner.google.com","date":"2022-06-23 09:53:47.000000000","tz":180},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2022-06-26 02:01:22.000000000","tz":0},"subject":"sys-libs/libunwind: disable stack-protector on armv7a","message":"sys-libs/libunwind: disable stack-protector on armv7a\n\nWhile testing a glibc 2.35 upgrade locally the following\nfailure was noticed which turns out is due to an old boot\nstrapping bug in libgcc because arm uses a global var for\nthe stack guard canary while x64 and arm64 use TCB vars,\nwhich causes arm glibc builds against libgcc to fail.\n\nThere is an open bug report to fix this in GCC:\nhttps://gcc.gnu.org/bugzilla/show_bug.cgi?id\u003d102352\n\nI do not know of any bug report opened for libunwind but\naccording to glibc maintainer Adhemerval, the accepted\nworkaround is to build arm without the stack protector.\n\n/usr/x86_64-pc-linux-gnu/armv7a-cros-linux-gnueabihf/binutils-bin/2.36.1/ld.bfd.real: /usr/armv7a-cros-linux-gnueabihf/usr/lib/libgcc_eh.a(Unwind-EHABI.cpp.o): in function `_Unwind_VRS_Interpret\u0027:\n Unwind-EHABI.cpp:(.text._Unwind_VRS_Interpret+0x35c): undefined reference to `__stack_chk_guard\u0027\n /usr/x86_64-pc-linux-gnu/armv7a-cros-linux-gnueabihf/binutils-bin/2.36.1/ld.bfd.real: Unwind-EHABI.cpp:(.text._Unwind_VRS_Interpret+0x360): undefined reference to `__stack_chk_guard\u0027\n /usr/x86_64-pc-linux-gnu/armv7a-cros-linux-gnueabihf/binutils-bin/2.36.1/ld.bfd.real: /usr/armv7a-cros-linux-gnueabihf/usr/lib/libgcc_eh.a(Unwind-EHABI.cpp.o): in function `_Unwind_VRS_Pop\u0027:\n Unwind-EHABI.cpp:(.text._Unwind_VRS_Pop+0x13c): undefined reference to `__stack_chk_guard\u0027\n /usr/x86_64-pc-linux-gnu/armv7a-cros-linux-gnueabihf/binutils-bin/2.36.1/ld.bfd.real: Unwind-EHABI.cpp:(.text._Unwind_VRS_Pop+0x140): undefined reference to `__stack_chk_guard\u0027\n /usr/x86_64-pc-linux-gnu/armv7a-cros-linux-gnueabihf/binutils-bin/2.36.1/ld.bfd.real: /usr/armv7a-cros-linux-gnueabihf/usr/lib/libgcc_eh.a(Unwind-EHABI.cpp.o): in function `(anonymous namespace)::unwindOneFrame(unsigned int, _Unwind_Control_Block*, _Unwind_Context*)\u0027:\n\nBUG\u003db:235960683\nTEST\u003dLocal builds against glibc 2.35.\n\nChange-Id: I40dd03cbc723125e82d040cff433d98009aa206f\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3720699\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nCommit-Queue: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nTested-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3688140","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I9d635d2ab6005e1af3cec389aaeaadf87a54eb3a","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1504745":{"account":{"_account_id":1504745},"last_update":"2022-06-15 16:53:41.000000000","reason":"\u003cGERRIT_ACCOUNT_1504745\u003e replied on the change","reason_account":{"_account_id":1504745}},"1347075":{"account":{"_account_id":1347075},"last_update":"2022-06-16 00:48:36.000000000","reason":"Change was submitted"},"1171009":{"account":{"_account_id":1171009},"last_update":"2022-06-15 16:48:19.000000000","reason":"\u003cGERRIT_ACCOUNT_1171009\u003e replied on the change","reason_account":{"_account_id":1171009}}},"hashtags":[],"change_id":"I9d635d2ab6005e1af3cec389aaeaadf87a54eb3a","subject":"llvm: upgrade to a58d0af058038595c93de961b725f86997cf8d4a (r458507)","status":"MERGED","created":"2022-06-02 21:14:31.000000000","updated":"2022-06-17 20:13:30.000000000","submitted":"2022-06-16 00:48:36.000000000","submitter":{"_account_id":1530088},"insertions":14,"deletions":14,"total_comment_count":0,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3688140","meta_rev_id":"1c09899cf77faf69facdb79b37995f7185e34fa2","_number":3688140,"virtual_id_number":3688140,"owner":{"_account_id":1504745},"current_revision_number":6,"current_revision":"334e9272d8a24941ee5e4244570f4766b92749f0","revisions":{"334e9272d8a24941ee5e4244570f4766b92749f0":{"kind":"REWORK","_number":6,"created":"2022-06-16 00:48:36.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/40/3688140/6","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/40/3688140/6"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/40/3688140/6"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/40/3688140/6"}},"commit":{"parents":[{"commit":"d3debcfc28bba6690e1c4b5c0eed14595d6b6535","subject":"Marking set of ebuilds as stable"}],"author":{"name":"Jordan R Abrahams-Whitehead","email":"ajordanr@google.com","date":"2022-06-02 21:14:26.000000000","tz":0},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2022-06-16 00:48:36.000000000","tz":0},"subject":"llvm: upgrade to a58d0af058038595c93de961b725f86997cf8d4a (r458507)","message":"llvm: upgrade to a58d0af058038595c93de961b725f86997cf8d4a (r458507)\n\nThe following packages have been updated:\nsys-devel/llvm\nsys-libs/compiler-rt\nsys-libs/libcxx\nsys-libs/libcxxabi\nsys-libs/llvm-libunwind\ndev-util/lldb-server\n\nDisables llvm_pgo_use manually temporarily.\n\nBUG\u003db:231351802\nTEST\u003dsudo emerge llvm \u0026\u0026 build_packages --board\u003damd64-generic\n\nCq-Depend: chromium:3690006\nChange-Id: I9d635d2ab6005e1af3cec389aaeaadf87a54eb3a\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3688140\nTested-by: Jordan Abrahams-Whitehead \u003cajordanr@google.com\u003e\nTested-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nCommit-Queue: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nCommit-Queue: Jordan Abrahams-Whitehead \u003cajordanr@google.com\u003e\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3683668","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I2534a208ade33965cc3ed8f55041c4fdfd7a2082","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1504745":{"account":{"_account_id":1504745},"last_update":"2022-06-02 15:32:02.000000000","reason":"Change was submitted"},"1347075":{"account":{"_account_id":1347075},"last_update":"2022-06-01 22:13:50.000000000","reason":"\u003cGERRIT_ACCOUNT_1347075\u003e replied on the change","reason_account":{"_account_id":1347075}},"1171009":{"account":{"_account_id":1171009},"last_update":"2022-06-02 15:32:02.000000000","reason":"Change was submitted"}},"hashtags":[],"change_id":"I2534a208ade33965cc3ed8f55041c4fdfd7a2082","subject":"libcxx, libunwind: Add support for baremetal c++","status":"MERGED","created":"2022-06-01 17:16:37.000000000","updated":"2022-06-02 15:32:20.000000000","submitted":"2022-06-02 15:32:02.000000000","submitter":{"_account_id":1171009},"insertions":47,"deletions":4,"total_comment_count":5,"unresolved_comment_count":1,"has_review_started":true,"submission_id":"3683668","meta_rev_id":"ffaf1fde2266a8be1369e64e70d9a160915752c7","_number":3683668,"virtual_id_number":3683668,"owner":{"_account_id":1171009},"current_revision_number":2,"current_revision":"ffc37b438953456384d87ffa8ab29c719fd77016","revisions":{"ffc37b438953456384d87ffa8ab29c719fd77016":{"kind":"REWORK","_number":2,"created":"2022-06-02 15:32:02.000000000","uploader":{"_account_id":1171009},"ref":"refs/changes/68/3683668/2","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/68/3683668/2"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/68/3683668/2"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/68/3683668/2"}},"commit":{"parents":[{"commit":"ae17f8b7c80cc2a459e0f21b5ca86133a4f1776f","subject":"Update Metadata Cache"}],"author":{"name":"Manoj Gupta","email":"manojgupta@google.com","date":"2022-06-01 17:13:41.000000000","tz":-420},"committer":{"name":"Manoj Gupta","email":"manojgupta@chromium.org","date":"2022-06-02 15:32:02.000000000","tz":0},"subject":"libcxx, libunwind: Add support for baremetal c++","message":"libcxx, libunwind: Add support for baremetal c++\n\nAdd support to allow building libc++ for baremetal toolchains\nlike armv7m-cros-eabi.\n\nThis CL only adds the requisite checks, the actual c++ enablement\nwill be done in a separate CL.\n\nBUG\u003db:234507656\nTEST\u003dsudo emerge cross-armv7m-cros-eabi/{llvm-libunwind,libcxx}\n\nChange-Id: I2534a208ade33965cc3ed8f55041c4fdfd7a2082\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3683668\nReviewed-by: Denis Nikitin \u003cdenik@chromium.org\u003e\nAuto-Submit: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nTested-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3533218","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I57ede356f0abbf407361d660bc4bbb06d59f6492","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1158719":{"account":{"_account_id":1158719},"last_update":"2022-04-27 19:20:58.000000000","reason":"\u003cGERRIT_ACCOUNT_1158719\u003e replied on the change","reason_account":{"_account_id":1158719}},"1347075":{"account":{"_account_id":1347075},"last_update":"2022-05-23 19:43:36.000000000","reason":"Change was submitted"},"1171009":{"account":{"_account_id":1171009},"last_update":"2022-05-20 23:18:57.000000000","reason":"\u003cGERRIT_ACCOUNT_1171009\u003e replied on the change","reason_account":{"_account_id":1171009}}},"hashtags":[],"change_id":"I57ede356f0abbf407361d660bc4bbb06d59f6492","subject":"perf: Upgrade to 5.15","status":"MERGED","created":"2022-03-17 18:34:13.000000000","updated":"2022-05-23 19:43:36.000000000","submitted":"2022-05-23 19:43:36.000000000","submitter":{"_account_id":1530088},"insertions":750,"deletions":5345,"total_comment_count":98,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3533218","meta_rev_id":"f71567c43804683f58c23e235a7ecdca9877fba6","_number":3533218,"virtual_id_number":3533218,"owner":{"_account_id":1347075},"current_revision_number":5,"current_revision":"4117553074d5e0cbf907a4c8917d9767b87385db","revisions":{"4117553074d5e0cbf907a4c8917d9767b87385db":{"kind":"REWORK","_number":5,"created":"2022-05-23 19:43:36.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/18/3533218/5","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/18/3533218/5"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/18/3533218/5"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/18/3533218/5"}},"commit":{"parents":[{"commit":"3224373879c6fc506019ec19980a5501f019485a","subject":"quipper: Add quipper patch for perf-5.15"}],"author":{"name":"Denis Nikitin","email":"denik@google.com","date":"2022-03-17 18:00:58.000000000","tz":-420},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2022-05-23 19:43:36.000000000","tz":0},"subject":"perf: Upgrade to 5.15","message":"perf: Upgrade to 5.15\n\nUpgrade to the latest Gentoo version.\n\nMost of the patches from perf 5.3.7 landed in 5.15 except:\n- perf inject: Add vmlinux and ignore-vmlinux arguments;\n- perf tools: Refactor out kernel symbol argument sanity checking;\n- perf inject: Add vmlinux and ignore-vmlinux arguments;\n- perf dso: Fix /proc/kcore access on 32 bit systems.\n\nKeeping the local patch:\n- perf: Don\u0027t install self-tests.\n\nNew patch fixing perf in 32b userspace:\n- perf session: Remap buf if there is no space for event.\n\nThe patch \"${PV}-Fix-hugepage-text.patch\" had conflicts which can\u0027t be easily\nresolved. The patch is dropped. Missing hugepages workaround does\nnot impact AFDO pipeline, see details in b/223842077.\nIf there are any other implications we will have two options:\n- disable hugepages in Chromium (estimated performance loss is about 1%);\n- re-design hugepage_text.cc and replace the anonymous pages.\n\nMigrated CrOS changes from 5.3.7 ebuild:\n- sys-libs/llvm-libunwind change;\n- linux-headers-4.4 DEPEND;\n- changes to correctly apply LINUX_PATCH and PATCHES;\n- coresight changes;\n- XMLTO flag changes.\n\nOther changes in CrOS ebuild:\n- PYTHON_COMPAT changed to python3_6.\n\nBUG\u003db:223842077\nTEST\u003dcq\nTEST\u003dperf record/report on Intel/Arm\nTEST\u003dquipper with perf commands used by CWP.\n\nCq-Depend: chromium:3655928\nChange-Id: I57ede356f0abbf407361d660bc4bbb06d59f6492\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3533218\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nTested-by: Denis Nikitin \u003cdenik@chromium.org\u003e\nCommit-Queue: Denis Nikitin \u003cdenik@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3658041","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~Idab748984b45645e7702f1059ad7d356756407f3","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1347075":{"account":{"_account_id":1347075},"last_update":"2022-05-21 02:14:05.000000000","reason":"\u003cGERRIT_ACCOUNT_1347075\u003e replied on the change","reason_account":{"_account_id":1347075}},"1171009":{"account":{"_account_id":1171009},"last_update":"2022-05-21 04:19:27.000000000","reason":"Change was submitted"},"1222289":{"account":{"_account_id":1222289},"last_update":"2022-05-21 04:19:27.000000000","reason":"Change was submitted"}},"hashtags":[],"change_id":"Idab748984b45645e7702f1059ad7d356756407f3","subject":"llvm-libunwind: Add libunwind_shared.so","status":"MERGED","created":"2022-05-21 01:18:17.000000000","updated":"2022-05-21 04:19:27.000000000","submitted":"2022-05-21 04:19:27.000000000","submitter":{"_account_id":1171009},"insertions":2,"deletions":1,"total_comment_count":0,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3658041","meta_rev_id":"522b24cc3954401acfad440a3fce333cdbdf9c3c","_number":3658041,"virtual_id_number":3658041,"owner":{"_account_id":1171009},"current_revision_number":2,"current_revision":"2795958bdda4ebdd913a6885bafdd428cc30cf4d","revisions":{"2795958bdda4ebdd913a6885bafdd428cc30cf4d":{"kind":"REWORK","_number":2,"created":"2022-05-21 04:19:27.000000000","uploader":{"_account_id":1171009},"ref":"refs/changes/41/3658041/2","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/41/3658041/2"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/41/3658041/2"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/41/3658041/2"}},"commit":{"parents":[{"commit":"0a64b1b2f016c62f25fbba96f14eb6ddcd93d02c","subject":"autofdo: Add upstream patch to fix with tot llvm."}],"author":{"name":"Manoj Gupta","email":"manojgupta@google.com","date":"2022-05-21 01:16:47.000000000","tz":-420},"committer":{"name":"Manoj Gupta","email":"manojgupta@chromium.org","date":"2022-05-21 04:19:27.000000000","tz":0},"subject":"llvm-libunwind: Add libunwind_shared.so","message":"llvm-libunwind: Add libunwind_shared.so\n\nUpstream expects libunwind install to contain libunwind_shared.so\nso add it.\n\nBUG\u003db:233414672\nTEST\u003dCQ; equery-\u003cboard\u003e f llvm-libunwind|grep libunwind_shared\n\nChange-Id: Idab748984b45645e7702f1059ad7d356756407f3\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3658041\nReviewed-by: Denis Nikitin \u003cdenik@chromium.org\u003e\nTested-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nCommit-Queue: Denis Nikitin \u003cdenik@chromium.org\u003e\nAuto-Submit: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nCommit-Queue: Manoj Gupta \u003cmanojgupta@c