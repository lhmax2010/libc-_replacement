t\nsys-libs/libcxx\nsys-libs/libcxxabi\nsys-libs/llvm-libunwind\n\nBUG\u003db:205983804\nTEST\u003dtest matrix https://docs.google.com/spreadsheets/d/157on3GIMGDzGwNyDkDcZ4eiE_LpUrqE78vUnyj1M4bQ\n\nChange-Id: Ib5289c8b9b25ee646711f2c90d00f058d703dbb2\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3325081\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nTested-by: Denis Nikitin \u003cdenik@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3310954","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I9b3640ee40906a025d9b4de398a51531585974bc","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1457772":{"account":{"_account_id":1457772},"last_update":"2021-12-14 19:53:49.000000000","reason":"\u003cGERRIT_ACCOUNT_1457772\u003e replied on the change","reason_account":{"_account_id":1457772}},"1171009":{"account":{"_account_id":1171009},"last_update":"2021-12-13 18:55:03.000000000","reason":"\u003cGERRIT_ACCOUNT_1171009\u003e replied on the change","reason_account":{"_account_id":1171009}},"1000221":{"account":{"_account_id":1000221},"last_update":"2021-12-14 19:54:27.000000000","reason":"Change was submitted"},"1163154":{"account":{"_account_id":1163154},"last_update":"2021-12-14 19:54:27.000000000","reason":"Change was submitted"}},"hashtags":[],"change_id":"I9b3640ee40906a025d9b4de398a51531585974bc","subject":"libunwind: globally enables libunwind as the default unwind library","status":"MERGED","created":"2021-12-01 18:41:45.000000000","updated":"2021-12-20 03:52:31.000000000","submitted":"2021-12-14 19:54:27.000000000","submitter":{"_account_id":1457772},"insertions":7,"deletions":13,"total_comment_count":7,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3310954","meta_rev_id":"38d75cb99b19e7ecb2f54b8f263179e5b656eca1","_number":3310954,"virtual_id_number":3310954,"owner":{"_account_id":1457772},"current_revision_number":16,"current_revision":"01f6154eabd943becf0d117739dc211578d6744e","revisions":{"01f6154eabd943becf0d117739dc211578d6744e":{"kind":"REWORK","_number":16,"created":"2021-12-14 19:54:27.000000000","uploader":{"_account_id":1457772},"ref":"refs/changes/54/3310954/16","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/54/3310954/16"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/54/3310954/16"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/54/3310954/16"}},"commit":{"parents":[{"commit":"e8806c6fbcb725bfed130988ee14f5eddb1eb3b5","subject":"Marking set of ebuilds as stable"}],"author":{"name":"Christopher Di Bella","email":"cjdb@google.com","date":"2021-12-01 18:39:10.000000000","tz":0},"committer":{"name":"Christopher Di Bella","email":"cjdb@google.com","date":"2021-12-14 19:54:27.000000000","tz":0},"subject":"libunwind: globally enables libunwind as the default unwind library","message":"libunwind: globally enables libunwind as the default unwind library\n\nThis patch enables libunwind for *all* boards\n\nBUG\u003db:187785190\nTEST\u003dTested on nami, reef, cyan, jacuzzi, and trogdor64 independently\n\nCq-Depend: chrome-internal:4313879\nChange-Id: I9b3640ee40906a025d9b4de398a51531585974bc\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3310954\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nReviewed-by: Ilja Friedel \u003cihf@chromium.org\u003e\nTested-by: Christopher Di Bella \u003ccjdb@google.com\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3343875","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I0368528eb1ac0644a5aa288a3d8633e43a85f832","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1433229":{"account":{"_account_id":1433229},"last_update":"2021-12-16 04:17:40.000000000","reason":"Reviewer/Cc was removed"},"1330845":{"account":{"_account_id":1330845},"last_update":"2021-12-16 17:40:43.000000000","reason":"Change was submitted"},"1000985":{"account":{"_account_id":1000985},"last_update":"2021-12-16 17:31:32.000000000","reason":"\u003cGERRIT_ACCOUNT_1000985\u003e replied on the change","reason_account":{"_account_id":1000985}},"1171009":{"account":{"_account_id":1171009},"last_update":"2021-12-16 17:32:27.000000000","reason":"\u003cGERRIT_ACCOUNT_1171009\u003e replied on the change","reason_account":{"_account_id":1171009}}},"hashtags":[],"change_id":"I0368528eb1ac0644a5aa288a3d8633e43a85f832","subject":"implicit-system: Add llvm-libunwind","status":"MERGED","created":"2021-12-16 04:15:12.000000000","updated":"2021-12-16 17:40:43.000000000","submitted":"2021-12-16 17:40:43.000000000","submitter":{"_account_id":1111084},"insertions":1,"deletions":0,"total_comment_count":0,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3343875","meta_rev_id":"d688f271841ab78cb0edd0f2f65921c16e1e0452","_number":3343875,"virtual_id_number":3343875,"owner":{"_account_id":1171009},"current_revision_number":2,"current_revision":"088fefb00ece5456f26d4170a54995d6539afa9e","revisions":{"088fefb00ece5456f26d4170a54995d6539afa9e":{"kind":"REWORK","_number":2,"created":"2021-12-16 17:40:43.000000000","uploader":{"_account_id":1111084},"ref":"refs/changes/75/3343875/2","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/75/3343875/2"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/75/3343875/2"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/75/3343875/2"}},"commit":{"parents":[{"commit":"1c78357a265b86c06b278816e911862e9782951f","subject":"Marking set of ebuilds as stable"}],"author":{"name":"Manoj Gupta","email":"manojgupta@google.com","date":"2021-12-16 04:12:00.000000000","tz":-480},"committer":{"name":"Commit Bot","email":"commit-bot@chromium.org","date":"2021-12-16 17:40:43.000000000","tz":0},"subject":"implicit-system: Add llvm-libunwind","message":"implicit-system: Add llvm-libunwind\n\nWe are using llvm-libunwind to provide libgcc_s.so so\nadd it to implicit system dependencies.\n\nBUG\u003db:210927982\nTEST\u003dCQ\n\nChange-Id: I0368528eb1ac0644a5aa288a3d8633e43a85f832\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3343875\nTested-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nAuto-Submit: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nReviewed-by: Jorge Lucangeli Obes \u003cjorgelo@chromium.org\u003e\nCommit-Queue: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3319892","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~If9c4e4c9d9244833ed62c56fd1ac2fba0121e2f8","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1504745":{"account":{"_account_id":1504745},"last_update":"2021-12-15 19:58:45.000000000","reason":"Change was submitted"},"1171009":{"account":{"_account_id":1171009},"last_update":"2021-12-15 00:29:07.000000000","reason":"\u003cGERRIT_ACCOUNT_1171009\u003e replied on the change","reason_account":{"_account_id":1171009}}},"hashtags":[],"change_id":"If9c4e4c9d9244833ed62c56fd1ac2fba0121e2f8","subject":"Migrate PATCHES.json to new metadata schema","status":"MERGED","created":"2021-12-07 06:36:27.000000000","updated":"2021-12-15 19:58:45.000000000","submitted":"2021-12-15 19:58:45.000000000","submitter":{"_account_id":1111084},"insertions":2057,"deletions":650,"total_comment_count":2,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3319892","meta_rev_id":"bea977226a0fab97338fbab92d62c038e8950aca","_number":3319892,"virtual_id_number":3319892,"owner":{"_account_id":1504745},"current_revision_number":10,"current_revision":"300270ed67890688f1001f53be3e5ab1a754d11f","revisions":{"300270ed67890688f1001f53be3e5ab1a754d11f":{"kind":"REWORK","_number":10,"created":"2021-12-15 19:58:45.000000000","uploader":{"_account_id":1111084},"ref":"refs/changes/92/3319892/10","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/92/3319892/10"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/92/3319892/10"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/92/3319892/10"}},"commit":{"parents":[{"commit":"0b9f11c6e57bf0d196ff1c1b0f38b557263d40de","subject":"Marking set of ebuilds as stable"}],"author":{"name":"Jordan R Abrahams","email":"ajordanr@google.com","date":"2021-12-07 06:25:41.000000000","tz":0},"committer":{"name":"Commit Bot","email":"commit-bot@chromium.org","date":"2021-12-15 19:58:45.000000000","tz":0},"subject":"Migrate PATCHES.json to new metadata schema","message":"Migrate PATCHES.json to new metadata schema\n\nIn an effort to automate patch synchronization between CrOS and\nAndroid LLVM, we\u0027re moving the \"comment\" and \"bugs_tests\" fields\nin PATCHES.json into a \"metadata\" dictionary entry instead.\n\nAdditionally, this sorts the key fields in PATCHES.json so that\nkeys won\u0027t be shuffled around as we apply new patches from different\nprograms.\n\nFinally, this adds default values for every key to aid in\nself-documenting the schema.\n\nBUG\u003db:209493133\nTEST\u003dsudo emerge sys-devel/llvm\nTEST\u003dCQ\n\nChange-Id: If9c4e4c9d9244833ed62c56fd1ac2fba0121e2f8\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3319892\nTested-by: Jordan Abrahams \u003cajordanr@google.com\u003e\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nCommit-Queue: Jordan Abrahams \u003cajordanr@google.com\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3339453","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~Ifad72e2f44ce69f6455cf1690295330da5ba2bbb","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1457772":{"account":{"_account_id":1457772},"last_update":"2021-12-14 19:53:53.000000000","reason":"\u003cGERRIT_ACCOUNT_1457772\u003e replied on the change","reason_account":{"_account_id":1457772}},"1171009":{"account":{"_account_id":1171009},"last_update":"2021-12-14 19:54:32.000000000","reason":"Change was submitted"}},"hashtags":[],"change_id":"Ifad72e2f44ce69f6455cf1690295330da5ba2bbb","subject":"chromeos: updates SDK versions for libunwind migration","status":"MERGED","created":"2021-12-14 19:41:08.000000000","updated":"2021-12-14 19:54:32.000000000","submitted":"2021-12-14 19:54:32.000000000","submitter":{"_account_id":1457772},"insertions":3,"deletions":3,"total_comment_count":0,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3339453","meta_rev_id":"21780b8c6c876036b4033c782f0223950d57f172","_number":3339453,"virtual_id_number":3339453,"owner":{"_account_id":1457772},"current_revision_number":5,"current_revision":"645c99bf80c4e9862e72801f7608bb655c70f85a","revisions":{"645c99bf80c4e9862e72801f7608bb655c70f85a":{"kind":"REWORK","_number":5,"created":"2021-12-14 19:54:32.000000000","uploader":{"_account_id":1457772},"ref":"refs/changes/53/3339453/5","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/53/3339453/5"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/53/3339453/5"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/53/3339453/5"}},"commit":{"parents":[{"commit":"01f6154eabd943becf0d117739dc211578d6744e","subject":"libunwind: globally enables libunwind as the default unwind library"}],"author":{"name":"Christopher Di Bella","email":"cjdb@google.com","date":"2021-12-14 19:38:33.000000000","tz":0},"committer":{"name":"Christopher Di Bella","email":"cjdb@google.com","date":"2021-12-14 19:54:32.000000000","tz":0},"subject":"chromeos: updates SDK versions for libunwind migration","message":"chromeos: updates SDK versions for libunwind migration\n\nUpdate the SDK version based on the successful tryjob for rolling out\nlibunwind based on CL.\n\nBUG\u003db:187785190\nTEST\u003dTested in CL:3310954.\n\nChange-Id: Ifad72e2f44ce69f6455cf1690295330da5ba2bbb\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3339453\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nCommit-Queue: Christopher Di Bella \u003ccjdb@google.com\u003e\nTested-by: Christopher Di Bella \u003ccjdb@google.com\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3288389","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~Ib627a19ef94071b7f8c690e0976280b8239df1db","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","topic":"samba-uprev","attention_set":{},"removed_from_attention_set":{"1000768":{"account":{"_account_id":1000768},"last_update":"2021-12-10 02:19:26.000000000","reason":"removed on reply"},"1397805":{"account":{"_account_id":1397805},"last_update":"2021-12-14 09:19:14.000000000","reason":"Change was submitted"},"1413373":{"account":{"_account_id":1413373},"last_update":"2021-12-14 07:59:39.000000000","reason":"\u003cGERRIT_ACCOUNT_1413373\u003e replied on the change","reason_account":{"_account_id":1413373}}},"hashtags":[],"change_id":"Ib627a19ef94071b7f8c690e0976280b8239df1db","subject":"net-fs/samba: Uprev version from 4.11.13 to 4.15.1","status":"MERGED","created":"2021-11-17 06:14:41.000000000","updated":"2021-12-14 09:19:14.000000000","submitted":"2021-12-14 09:19:14.000000000","submitter":{"_account_id":1111084},"insertions":227,"deletions":7083,"total_comment_count":29,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3288389-samba-uprev","meta_rev_id":"c380fdff8d725245ca81dd2798e5012817356a9d","_number":3288389,"virtual_id_number":3288389,"owner":{"_account_id":1413373},"current_revision_number":18,"current_revision":"0f91d00dbc8a3ab1f0046ae67e6c68a7a5915f25","revisions":{"0f91d00dbc8a3ab1f0046ae67e6c68a7a5915f25":{"kind":"REWORK","_number":18,"created":"2021-12-14 09:19:14.000000000","uploader":{"_account_id":1111084},"ref":"refs/changes/89/3288389/18","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/89/3288389/18"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/89/3288389/18"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/89/3288389/18"}},"commit":{"parents":[{"commit":"4487c63a07a8a30c2f1c4b07009535487172d5d1","subject":"sys-libs/ldb: Move back to portage-stable"}],"author":{"name":"Ben Reich","email":"benreich@chromium.org","date":"2021-11-17 06:12:53.000000000","tz":660},"committer":{"name":"Commit Bot","email":"commit-bot@chromium.org","date":"2021-12-14 09:19:14.000000000","tz":0},"subject":"net-fs/samba: Uprev version from 4.11.13 to 4.15.1","message":"net-fs/samba: Uprev version from 4.11.13 to 4.15.1\n\nSamba currently has a few security vulnerabilities that necessitate an\nuprev (namely CVE-2021-3671).\n\nNotable changes that require this to live in chromiumos-overlay and not\nportage-stable:\n\n  - Python version updated from 8..10 to 6..9 to reflect what is in the\n    ChromeOS build toolchain.\n  - Removed dev-libs/icu and instead added chrome-base/icu in runtime\n    dependencies instead.\n  - Moved the python dependency as inline conditional.\n  - Removed sys-libs/libunwind dependency as we can\u0027t build with it.\n  - Kept Chrome OS specific patches not incorporated into upstream.\n  - Added PERLVER to simplify specifying PERL5LIB to WAF configure /\n    build.\n  - Added PERL5LIB and YAPP env vars to WAF configure and build so it\n    can find Parse-Yapp.\n  - Removed plus symbol from regedit and explicitly added the\n    --without-regedit flag to disable.\n  - Removed --systemd-install-services from configure flags to prevent\n    service installation. smbd is still used in tests but started and\n    stopped manually instead of using systemd.\n  - Kept async DNS plugin installation for amd64.\n  - Added ldap flag to sys-libs/ldb as it\u0027s required to build.\n  - Removed net-dns/bind-tools[gssapi] as previously it was gated\n    behind an addns USE flag but in this version it has moved behind\n    adc which is set (addns was unset). This causes build problems and\n    given it was not previously used, remove it.\n  - Add a Copyright notice to {arm,arm64}_waf_config_answers files.\n  - Remove the liburing COMMON_DEPEND due to build errors that don\u0027t\n    need to be resolved as we don\u0027t utilise the VFS module that relies\n    upon the dependency.\n\nBUG\u003dchromium:1157650\nTEST\u003demerge-{hatch,hana,kevin64} net-fs/samba\nTEST\u003dtast run filemanager.SMB\nTEST\u003dtast run kerberos.ManualTicketAccessFileSystem\n\nCq-Depend: chromium:3260296, chromium:3260297, chromium:3260298\nCq-Depend: chromium:3260299, chromium:3260300, chromium:3288388\nChange-Id: Ib627a19ef94071b7f8c690e0976280b8239df1db\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3288389\nReviewed-by: Josh Simmons \u003csimmonsjosh@google.com\u003e\nReviewed-by: Mike Frysinger \u003cvapier@chromium.org\u003e\nTested-by: Ben Reich \u003cbenreich@chromium.org\u003e\nCommit-Queue: Ben Reich \u003cbenreich@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3335237","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~stabilize-14396.B~I9b3640ee40906a025d9b4de398a51531585974bc","project":"chromiumos/overlays/chromiumos-overlay","branch":"stabilize-14396.B","full_branch":"refs/heads/stabilize-14396.B","attention_set":{},"removed_from_attention_set":{"1457772":{"account":{"_account_id":1457772},"last_update":"2021-12-13 19:18:52.000000000","reason":"Change was submitted"},"1171009":{"account":{"_account_id":1171009},"last_update":"2021-12-13 18:30:12.000000000","reason":"\u003cGERRIT_ACCOUNT_1171009\u003e replied on the change","reason_account":{"_account_id":1171009}},"1000221":{"account":{"_account_id":1000221},"last_update":"2021-12-13 19:18:52.000000000","reason":"Change was submitted"},"1163154":{"account":{"_account_id":1163154},"last_update":"2021-12-13 19:06:16.000000000","reason":"removed on reply"}},"hashtags":[],"change_id":"I9b3640ee40906a025d9b4de398a51531585974bc","subject":"libunwind: globally enables libunwind as the default unwind library","status":"MERGED","created":"2021-12-13 18:29:19.000000000","updated":"2021-12-13 20:23:14.000000000","submitted":"2021-12-13 19:18:52.000000000","submitter":{"_account_id":1457772},"insertions":7,"deletions":13,"total_comment_count":0,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3335237","cherry_pick_of_change":3310954,"cherry_pick_of_patch_set":15,"meta_rev_id":"357c68bcfc6610fbb2721a12fc6a182341664b8d","_number":3335237,"virtual_id_number":3335237,"owner":{"_account_id":1457772},"current_revision_number":2,"current_revision":"cee0368aa596f11504d473956dd532f96c883d9b","revisions":{"cee0368aa596f11504d473956dd532f96c883d9b":{"kind":"NO_CODE_CHANGE","_number":2,"created":"2021-12-13 19:18:52.000000000","uploader":{"_account_id":1457772},"ref":"refs/changes/37/3335237/2","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/37/3335237/2"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/37/3335237/2"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/37/3335237/2"}},"commit":{"parents":[{"commit":"36c0c917f5935d2b41a1d7ef1b4bc65a3365c264","subject":"Bump CHROMEOS_BRANCH number after creating branch stabilize-14396.B"}],"author":{"name":"Christopher Di Bella","email":"cjdb@google.com","date":"2021-12-01 18:39:10.000000000","tz":0},"committer":{"name":"Christopher Di Bella","email":"cjdb@google.com","date":"2021-12-13 19:18:52.000000000","tz":0},"subject":"libunwind: globally enables libunwind as the default unwind library","message":"libunwind: globally enables libunwind as the default unwind library\n\nThis patch enables libunwind for *all* boards\n\nBUG\u003db:187785190\nTEST\u003dTested on nami, reef, cyan, jacuzzi, and trogdor64 independently\n\nCq-Depend: chrome-internal:4313879\nChange-Id: I9b3640ee40906a025d9b4de398a51531585974bc\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3335237\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nTested-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nReviewed-by: Chad Versace \u003cchadversary@chromium.org\u003e\n"},"branch":"refs/heads/stabilize-14396.B"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3285738","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I0f0fc9a22740f45248a23fa0595a3cca61bea0c0","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1001271":{"account":{"_account_id":1001271},"last_update":"2021-11-30 17:48:53.000000000","reason":"Change was submitted"},"1347075":{"account":{"_account_id":1347075},"last_update":"2021-11-30 17:48:00.000000000","reason":"\u003cGERRIT_ACCOUNT_1347075\u003e replied on the change","reason_account":{"_account_id":1347075}},"1171009":{"account":{"_account_id":1171009},"last_update":"2021-11-19 01:33:05.000000000","reason":"\u003cGERRIT_ACCOUNT_1171009\u003e replied on the change","reason_account":{"_account_id":1171009}},"1474597":{"account":{"_account_id":1474597},"last_update":"2021-11-24 22:38:38.000000000","reason":"\u003cGERRIT_ACCOUNT_1474597\u003e replied on the change","reason_account":{"_account_id":1474597}}},"hashtags":[],"change_id":"I0f0fc9a22740f45248a23fa0595a3cca61bea0c0","subject":"llvm-next: upgrade to 79d58b4d3017d159bf09a77398c9a116128de193 (r437112)","status":"MERGED","created":"2021-11-16 19:43:23.000000000","updated":"2021-11-30 17:48:53.000000000","submitted":"2021-11-30 17:48:53.000000000","submitter":{"_account_id":1347075},"insertions":2161,"deletions":7,"total_comment_count":16,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3285738","meta_rev_id":"2e2b3c55679b51f0a3321acfaba40fbf8babc0cd","_number":3285738,"virtual_id_number":3285738,"owner":{"_account_id":1347075},"current_revision_number":10,"current_revision":"daabd5fb7616bcf6b6b9e423d359449bf27e3ab6","revisions":{"daabd5fb7616bcf6b6b9e423d359449bf27e3ab6":{"kind":"REWORK","_number":10,"created":"2021-11-30 17:48:53.000000000","uploader":{"_account_id":1347075},"ref":"refs/changes/38/3285738/10","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/38/3285738/10"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/38/3285738/10"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/38/3285738/10"}},"commit":{"parents":[{"commit":"a4f28c914fb6e5a9d3c859c2a70c18be450c7d22","subject":"Set POSTSUBMIT_BINHOST\u003dgs://chromeos-prebuilt/board/arm64-generic/postsubmit-R98-14371.0.0-27084-8829129256455771473/packages."}],"author":{"name":"Denis Nikitin","email":"denik@google.com","date":"2021-11-16 19:43:14.000000000","tz":-480},"committer":{"name":"Denis Nikitin","email":"denik@chromium.org","date":"2021-11-30 17:48:53.000000000","tz":0},"subject":"llvm-next: upgrade to 79d58b4d3017d159bf09a77398c9a116128de193 (r437112)","message":"llvm-next: upgrade to 79d58b4d3017d159bf09a77398c9a116128de193 (r437112)\n\nThe following packages have been updated:\ndev-util/lldb-server\nsys-devel/llvm\nsys-libs/compiler-rt\nsys-libs/libcxx\nsys-libs/libcxxabi\n\nFor the package sys-devel/llvm:\nThe patch metadata file PATCHES.json was modified.\nThe following patch was disabled:\ndisable-dk_linker-assert.patch (fixed upstream)\n\nThe following reverts were added to resolve conflicts of applying\nrevert-f5446b769a7929806f72256fccd4826d66502e59.patch (b/194845770):\n- revert-30dfd3449e45ac371012c6e46c77ab9089496d4e.patch;\n- revert-17db125b487faa69d789b80d47b19da49522b168.patch;\n- revert-88003cea1c6eb3ebcb18b4f1b9d0e2052dd76fe4.patch;\n- revert-596004a94748e427ff59956e74d8ed4eb0e109d4.patch.\n\nFor the package sys-libs/compiler-rt\nthe patch metadata file PATCHES.json was modified:\nfuzzer-enable-arm32.patch was replaced with the upstream patch\nhttps://reviews.llvm.org/rG2782cb8da0b3c180fa7c8627cb255a026f3d25a2\nat r436311.\n\nBUG\u003db:194845770,b:205983804,b:202073091\nTEST\u003dcq+1\n\nChange-Id: I0f0fc9a22740f45248a23fa0595a3cca61bea0c0\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3285738\nTested-by: Denis Nikitin \u003cdenik@chromium.org\u003e\nCommit-Queue: Denis Nikitin \u003cdenik@chromium.org\u003e\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3298526","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~Id2ead566dbf07b4351e69d02b84ce27c7f109946","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1000768":{"account":{"_account_id":10007