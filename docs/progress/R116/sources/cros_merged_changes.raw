overlays/chromiumos-overlay","ref":"refs/changes/43/4167043/4"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/43/4167043/4"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/43/4167043/4"}},"commit":{"parents":[{"commit":"4bd5a2831aa238d7853b75671336a37a2b62fe01","subject":"Bump CHROMEOS_BUILD number for source branch main after creating branch stabilize-15317.B"}],"author":{"name":"Jordan R Abrahams-Whitehead","email":"ajordanr@google.com","date":"2023-01-17 21:15:51.000000000","tz":0},"committer":{"name":"Jordan Abrahams-Whitehead","email":"ajordanr@google.com","date":"2023-01-18 01:57:05.000000000","tz":0},"subject":"PATCHES.json: Reformat all PATCHES.json files","message":"PATCHES.json: Reformat all PATCHES.json files\n\ncros format now complains about the indentation scheme of\nour PATCHES.json. Now that patch_sync and get_upstream_patches\npreserve the indentation type, we can format all these files\naccording to cros format\u0027s wishes.\n\nThis CL makes no real changes. It\u0027s only formatting only.\n\nBUG\u003db:265348099\nTEST\u003dcros format --check passes\n\nChange-Id: Iade25a7fba53c155d570fc57f279b16864c42cce\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4167043\nReviewed-by: George Burgess \u003cgbiv@chromium.org\u003e\nTested-by: Jordan Abrahams-Whitehead \u003cajordanr@google.com\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~4133805","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I1a72745b2c89fd0e4e5d66f2efec9973339009fb","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1474597":{"account":{"_account_id":1474597},"last_update":"2023-01-09 19:53:46.000000000","reason":"\u003cGERRIT_ACCOUNT_1474597\u003e replied on the chang