000","reason":"Change was submitted"},"1171009":{"account":{"_account_id":1171009},"last_update":"2023-03-06 20:34:09.000000000","reason":"\u003cGERRIT_ACCOUNT_1171009\u003e replied on the change","reason_account":{"_account_id":1171009}}},"hashtags":[],"change_id":"I2c19c6bbc7b948559a7f255d48dd10538704cdaf","subject":"sys-libs/libcxx: Add linux headers as a dependency","status":"MERGED","created":"2023-03-06 20:19:53.000000000","updated":"2023-03-09 17:27:15.000000000","submitted":"2023-03-09 17:27:15.000000000","submitter":{"_account_id":1365249},"insertions":12,"deletions":1,"total_comment_count":3,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"4312391","meta_rev_id":"1a07560fe543ce7d87ace897666b02907df3b34f","_number":4312391,"virtual_id_number":4312391,"owner":{"_account_id":1270601},"current_revision_number":4,"current_revision":"30de511bdb68310c86f6d4120736f10d03303297","revisions":{"30de511bdb68310c86f6d4120736f10d03303297":{"kind":"REWORK","_number":4,"created":"2023-03-09 17:27:15.000000000","uploader":{"_account_id":1365249},"ref":"refs/changes/91/4312391/4","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/91/4312391/4"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/91/4312391/4"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/91/4312391/4"}},"commit":{"parents":[{"commit":"149c22002bb596f0c0e2cbac06a52701155de3d9","subject":"Set POSTSUBMIT_BINHOST\u003dgs://chromeos-prebuilt/board/amd64-generic/postsubmit-R113-15377.0.0-47741-8787086534260424945/packages. go/bbid/8787086534260424945"}],"author":{"name":"Raul E Rangel","email":"rrangel@chromium.org","date":"2023-03-06 20:31:06.000000000","tz":-420},"committer":{"name":"Abhishek Pandit-Subedi","email":"abhishekpandit@google.com","date":"2023-03-09 17:27:15.000000000","tz":0},"subject":"sys-libs/libcxx: Add linux headers as a dependency","message":"sys-libs/libcxx: Add linux headers as a dependency\n\nlibcxx is one of the primordial packages that needs to be\ninstalled when setting up a board\u0027s sysroot. We need to ensure that\nthe linux headers are installed before we try and build the package.\n\n    In file included from /build/arm64-generic/tmp/portage/sys-libs/libcxx-16.0_pre475826-r2/work/libcxx-16.0_pre475826/libcxx/src/filesystem/directory_iterator.cpp:11:\n    In file included from include/c++/v1/errno.h:31:\n    In file included from /build/arm64-generic/usr/include/errno.h:28:\n    /build/arm64-generic/usr/include/bits/errno.h:26:11: fatal error: \u0027linux/errno.h\u0027 file not found\n    # include \u003clinux/errno.h\u003e\n              ^~~~~~~~~~~~~~~\n    1 error generated.\n\nBUG\u003db:262460834\nTEST\u003dBOARD\u003darm64-generic bazel build -k @portage//sys-libs/libcxx\n\nChange-Id: I2c19c6bbc7b948559a7f255d48dd10538704cdaf\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4312391\nTested-by: Raul Rangel \u003crrangel@chromium.org\u003e\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~4189828","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I46097d36f958e718675e94c4a12ffbcc66f3afb1","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1000768":{"account":{"_account_id":1000768},"last_update":"2023-01-30 18:07:26.000000000","reason":"Change was submitted"},"1413373":{"account":{"_account_id":1413373},"last_update":"2023-01-30 01:38:10.000000000","reason":"\u003cGERRIT_ACCOUNT_1413373\u003e replied on the change","reason_account":{"_account_id":1413373}},"1265562":{"account":{"_account_id":1265562},"last_update":"2023-01-30 16:57:27.000000000","reason":"\u003cGERRIT_ACCOUNT_1265562\u003e replied on the change","reaso