2d337b","subject":"Set POSTSUBMIT_BINHOST\u003dgs://chromeos-prebuilt/board/arm-generic/postsubmit-R104-14854.0.0-34729-8813639173689459985/packages."}],"author":{"name":"Jordan R Abrahams-Whitehead","email":"ajordanr@google.com","date":"2022-05-03 21:06:39.000000000","tz":0},"committer":{"name":"Manoj Gupta","email":"manojgupta@chromium.org","date":"2022-05-20 17:29:53.000000000","tz":0},"subject":"llvm-next/google3: upgrade to a58d0af058038595c93de961b725f86997cf8d4a (r458507)","message":"llvm-next/google3: upgrade to a58d0af058038595c93de961b725f86997cf8d4a (r458507)\n\nThe following packages have been updated:\ndev-util/lldb-server\nsys-devel/llvm\nsys-libs/compiler-rt\nsys-libs/libcxx\nsys-libs/libcxxabi\nsys-libs/llvm-libunwind\n\nThis is a manual LLVM Next roll.\nThis does not affect the current version of LLVM,\nand only has an effect when USE\u003d\u0027llvm-next\u0027 is enabled.\n\nBUG\u003db:231351802\nTEST\u003dCQ\n\nChange-Id: If06a87c38ad4095113b97842d0dc044e8b8fb772\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3625790\nTested-by: Jordan Abrahams-Whitehead \u003cajordanr@google.com\u003e\nAuto-Submit: Jordan Abrahams-Whitehead \u003cajordanr@google.com\u003e\nCommit-Queue: Jordan Abrahams-Whitehead \u003cajordanr@google.com\u003e\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3614506","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~Ieba6ac59787c5653e16c1158859eff13f2c19e67","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1457772":{"account":{"_account_id":1457772},"last_update":"2022-04-30 04:06:25.000000000","reason":"Change was submitted"},"1171009":{"account":{"_account_id":1171009},"last_update":"2022-04-28 17:19:28.000000000","reason":"\u003cGERRIT_ACCOUNT_1171009\u003e replied on the change","reason_account":{"_account_id":1171009}}},"hashtags":[],"change_id":"Ieba6ac59787c5653e16c1158859eff13f2c19e67","subject":"llvm: get patches from upstream","status":"MERGED","created":"2022-04-28 17:12:28.000000000","updated":"2022-04-30 04:06:25.000000000","submitted":"2022-04-30 04:06:25.000000000","submitter":{"_account_id":1530088},"insertions":219,"deletions":0,"total_comment_count":0,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3614506","meta_rev_id":"3f7a71b3fe79195d24621498a045a80cb537ae9e","_number":3614506,"virtual_id_number":3614506,"owner":{"_account_id":1457772},"current_revision_number":3,"current_revision":"17dac9a6a4f819766812dd2ac39d0e0199492144","revisions":{"17dac9a6a4f819766812dd2ac39d0e0199492144":{"kind":"REWORK","_number":3,"created":"2022-04-30 04:06:25.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/06/3614506/3","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/06/3614506/3"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/06/3614506/3"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/06/3614506/3"}},"commit":{"parents":[{"commit":"944bc10be8444ac9c73cc97b4a6017258996e52b","subject":"Marking set of ebuilds as stable"}],"author":{"name":"Christopher Di Bella","email":"cjdb@google.com","date":"2022-04-28 17:12:20.000000000","tz":0},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2022-04-30 04:06:25.000000000","tz":0},"subject":"llvm: get patches from upstream","message":"llvm: get patches from upstream\n\nreviews.llvm.org/rGf326df34bc179e41ea17d31e1ffba4a479e45589\n\nf326df34bc17 [libunwind][AArch64] Fix _Unwind_ForcedUnwind via sigreturn.\n\nTEST\u003dTested upstream\nBUG\u003db:209923640\n\nChange-Id: Ieba6ac59787c5653e16c1158859eff13f2c19e67\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3614506\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nTested-by: Christopher Di Bella \u003ccjdb@google.com\u003e\nCommit-Queue: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nAuto-Submit: Christopher Di Bella \u003ccjdb@google.com\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3575635","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I87d895e89b126279e7c22c47f26fa32caf7bbc49","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1504745":{"account":{"_account_id":1504745},"last_update":"2022-04-27 07:52:51.000000000","reason":"Change was submitted"},"1001271":{"account":{"_account_id":1001271},"last_update":"2022-04-07 06:25:40.000000000","reason":"\u003cGERRIT_ACCOUNT_1001271\u003e replied on the change","reason_account":{"_account_id":1001271}},"1171009":{"account":{"_account_id":1171009},"last_update":"2022-04-27 07:52:51.000000000","reason":"Change was submitted"}},"hashtags":[],"change_id":"I87d895e89b126279e7c22c47f26fa32caf7bbc49","subject":"llvm: Add continue-on-patch-failure USE flag","status":"MERGED","created":"2022-04-07 01:32:14.000000000","updated":"2022-04-27 07:52:51.000000000","submitted":"2022-04-27 07:52:51.000000000","submitter":{"_account_id":1530088},"insertions":20,"deletions":5,"total_comment_count":3,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3575635","meta_rev_id":"70aff43d109a44846971c2f6fa5054a9a38502f8","_number":3575635,"virtual_id_number":3575635,"owner":{"_account_id":1504745},"current_revision_number":9,"current_revision":"f59c06abc09cf0acff0f34d71764a8808fa56a5f","revisions":{"f59c06abc09cf0acff0f34d71764a8808fa56a5f":{"kind":"REWORK","_number":9,"created":"2022-04-27 07:52:51.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/35/3575635/9","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/35/3575635/9"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/35/3575635/9"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/35/3575635/9"}},"commit":{"parents":[{"commit":"cd041a1ecdf96af45692ffd63aa256df532ecdeb","subject":"cryptohome: Add shill-client dep to ebuild"}],"author":{"name":"Jordan R Abrahams-Whitehead","email":"ajordanr@google.com","date":"2022-04-07 01:24:43.000000000","tz":0},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2022-04-27 07:52:51.000000000","tz":0},"subject":"llvm: Add continue-on-patch-failure USE flag","message":"llvm: Add continue-on-patch-failure USE flag\n\nThis adds a new USE flag for all LLVM ebuilds which\nallows control over whether the ebuild process should\nignore patch failures. The two most common failure modes\nare \"fail\" (the default) and \"continue\" (ignores any failures)\n\nThe \"continue\" failure mode is useful when debugging LLVM\nfailures, as it can be used during the local bisection process\n(some patch ranges are slightly inaccurate so they cause unrelated\nerrors during bisection).\n\nBUG\u003db:226987500\nTEST\u003dCQ\nTEST\u003dsudo USE\u003d\u0027continue-on-patch-failure\u0027 emerge llvm\n\nChange-Id: I87d895e89b126279e7c22c47f26fa32caf7bbc49\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3575635\nReviewed-by: George Burgess \u003cgbiv@chromium.org\u003e\nTested-by: Jordan Abrahams-Whitehead \u003cajordanr@google.com\u003e\nCommit-Queue: Jordan Abrahams-Whitehead \u003cajordanr@google.com\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3540343","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I51cc8aa1879b7ef214a7da3b27553c7b8a766333","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","topic":"go-modules-conversion","attention_set":{},"removed_from_attention_set":{"1001271":{"account":{"_account_id":1001271},"last_update":"2022-04-06 05:23:37.000000000","reason":"Change was submitted"},"1474527":{"account":{"_account_id":1474527},"last_update":"2022-04-05 17:58:26.000000000","reason":"\u003cGERRIT_ACCOUNT_1474527\u003e replied on the change","reason_account":{"_account_id":1474527}},"1171009":{"account":{"_account_id":1171009},"last_update":"2022-04-06 05:23:37.000000000","reason":"Change was submitted"}},"hashtags":[],"change_id":"I51cc8aa1879b7ef214a7da3b27553c7b8a766333","subject":"dev-go/ep-pvg: add missing afero \u0026 its deps","status":"MERGED","created":"2022-03-21 15:30:05.000000000","updated":"2022-04-06 05:23:37.000000000","submitted":"2022-04-06 05:23:37.000000000","submitter":{"_account_id":1530088},"insertions":134,"deletions":0,"total_comment_count":10,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3540343-go-modules-conversion","meta_rev_id":"b8b10ba70645e7041c1a653465f19d1a0a27e211","_number":3540343,"virtual_id_number":3540343,"owner":{"_account_id":1474527},"current_revision_number":16,"current_revision":"98d97f1ef702ddab237da29bb9efbf1a03fccbc6","revisions":{"98d97f1ef702ddab237da29bb9efbf1a03fccbc6":{"kind":"REWORK","_number":16,"created":"2022-04-06 05:23:37.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/43/3540343/16","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/43/3540343/16"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/43/3540343/16"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/43/3540343/16"}},"commit":{"parents":[{"commit":"2c34fbb1d191586ff7812d2af62a54181cb829d1","subject":"Marking set of ebuilds as stable"}],"author":{"name":"Adrian Ratiu","email":"adrian.ratiu@collabora.corp-partner.google.com","date":"2022-03-21 14:22:20.000000000","tz":120},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2022-04-06 05:23:37.000000000","tz":0},"subject":"dev-go/ep-pvg: add missing afero \u0026 its deps","message":"dev-go/ep-pvg: add missing afero \u0026 its deps\n\nThese deps are explicitly required by the ep-pvg go.mod\nso they need to be added to be able to transition to\nGo module dependency management.\n\nBUG\u003db:187795288\nTEST\u003dLocal builds; CQ.\n\nChange-Id: I51cc8aa1879b7ef214a7da3b27553c7b8a766333\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3540343\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nCommit-Queue: Adrian Ratiu \u003cadrian.ratiu@collabora.corp-partner.google.com\u003e\nTested-by: Adrian Ratiu \u003cadrian.ratiu@collabora.corp-partner.google.com\u003e\nAuto-Submit: Adrian Ratiu \u003cadrian.ratiu@collabora.corp-partner.google.com\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3402181","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I85dcc415bdfcde81d1fdc2a7c7712904061327b8","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1504745":{"account":{"_account_id":1504745},"last_update":"2022-04-02 13:53:02.000000000","reason":"Change was submitted"},"1000768":{"account":{"_account_id":1000768},"last_update":"2022-03-31 00:46:22.000000000","reason":"removed on reply"},"1105321":{"account":{"_account_id":1105321},"last_update":"2022-04-02 13:53:02.000000000","reason":"Change was submitted"},"1457772":{"account":{"_account_id":1457772},"last_update":"2022-03-31 17:05:46.000000000","reason":"\u003cGERRIT_ACCOUNT_1457772\u003e replied on the change","reason_account":{"_account