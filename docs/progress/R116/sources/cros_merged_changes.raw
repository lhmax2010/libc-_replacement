45/packages."}],"author":{"name":"Christopher Di Bella","email":"cjdb@google.com","date":"2021-11-23 23:27:29.000000000","tz":0},"committer":{"name":"Commit Bot","email":"commit-bot@chromium.org","date":"2021-11-26 03:29:23.000000000","tz":0},"subject":"sys-devel/binutils: explicitly adds -lpthread","message":"sys-devel/binutils: explicitly adds -lpthread\n\nDuring the transition from libgcc_eh to libunwind, binutils stopped\nlinking against pthread. This patch fixes that.\n\nBUG\u003db:207022271, b:207578937\nTEST\u003dTested locally\n\nChange-Id: Id2ead566dbf07b4351e69d02b84ce27c7f109946\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3298526\nCommit-Queue: Christopher Di Bella \u003ccjdb@google.com\u003e\nTested-by: Christopher Di Bella \u003ccjdb@google.com\u003e\nAuto-Submit: Christopher Di Bella \u003ccjdb@google.com\u003e\nReviewed-by: Luis Lozano \u003cllozano@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3298525","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I12a86d8b22d3b89b99c0b17ce3a523bffa5a3435","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1001271":{"account":{"_account_id":1001271},"last_update":"2021-11-24 07:19:08.000000000","reason":"\u003cGERRIT_ACCOUNT_1001271\u003e replied on the change","reason_account":{"_account_id":1001271}},"1457772":{"account":{"_account_id":1457772},"last_update":"2021-11-27 01:18:14.000000000","reason":"\u003cGERRIT_ACCOUNT_1457772\u003e replied on the change","reason_account":{"_account_id":1457772}},"1222289":{"account":{"_account_id":1222289},"last_update":"2021-11-24 01:00:37.000000000","reason":"\u003cGERRIT_ACCOUNT_1222289\u003e replied on the change","reason_account":{"_account_id":1222289}}},"hashtags":[],"change_id":"I12a86d8b22d3b89b99c0b17ce3a523bffa5a3435","subjec