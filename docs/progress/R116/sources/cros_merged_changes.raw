ingle source of truth for this file.\nNow that the llvm-9999.ebuild has landed, we can now make\nthis unifying change that mirrors the patch_manager/ directory.\n\nBUG\u003dNone\nTEST\u003dcros_uprev --force --overlay-type public --packages \\\n     \u0027dev-libs/libclc:dev-util/lldb-server:sys-devel/llvm:sys-libs/llvm-libc:sys-libs/compiler-rt:sys-libs/libcxx:sys-libs/llvm-libunwind\u0027\n\nChange-Id: I21b23c587adbba1d816d3f110bcbb7009cbdc0eb\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4920172\nTested-by: George Burgess \u003cgbiv@chromium.org\u003e\nTested-by: Jordan Abrahams-Whitehead \u003cajordanr@google.com\u003e\nReviewed-by: George Burgess \u003cgbiv@chromium.org\u003e\nCommit-Queue: George Burgess \u003cgbiv@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~4887789","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I682c4f803617fb559c4beb1688e0ee648314cb2f","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","topic":"b/221091499_reland","attention_set":{},"removed_from_attention_set":{"1297197":{"account":{"_account_id":1297197},"last_update":"2023-09-28 16:32:30.000000000","reason":"\u003cGERRIT_ACCOUNT_1297197\u003e replied on the change","reason_account":{"_account_id":1297197}},"1158719":{"account":{"_account_id":1158719},"last_update":"2023-09-25 23:08:48.000000000","reason":"\u003cGERRIT_ACCOUNT_1158719\u003e replied on the change","reason_account":{"_account_id":1158719}},"1270601":{"account":{"_account_id":1270601},"last_update":"2023-09-28 19:26:35.000000000","reason":"Change was submitted"}},"hashtags":[],"change_id":"I682c4f803617fb559c4beb1688e0ee648314cb2f","subject":"Reland \"Replace march znver3 with znver2\"","status":"MERGED","created":"2023-09-22 16:34:38.000000000","updated":"2023-09-28 19:26:35.000000000","submitted":"2023-09-28 19:26:35.000000000","submitter":{"_account_id":1530088},"insertions":14,"deletions":5,"total_comment_count":10,"unresolved_comment_count":0,"has_review_started":true,"revert_of":4887500,"submission_id":"4887789-b/221091499_reland","meta_rev_id":"cc795f29b7f168dd10e8f7819d663423d60579df","_number":4887789,"virtual_id_number":4887789,"owner":{"_account_id":1297197},"current_revision_number":11,"current_revision":"3813986428b14de9cf65f5a3663c579c25e7ceb6","revisions":{"3813986428b14de9cf65f5a3663c579c25e7ceb6":{"kind":"REWORK","_number":11,"created":"2023-09-28 19:26:35.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/89/4887789/11","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/89/4887789/11"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/89/4887789/11"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/89/4887789/11"}},"commit":{"parents":[{"commit":"fb338abde887bab8becd59a6dd12b2a29b7fb180","subject":"Set POSTSUBMIT_BINHOST\u003dgs://chromeos-prebuilt/board/amd64-generic/postsubmit-R119-15629.0.0-56374-8768685884486368593/packages. go/bbid/8768685884486368593"}],"author":{"name":"Tim Van Patten","email":"timvp@google.com","date":"2023-09-22 16:34:38.000000000","tz":0},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2023-09-28 19:26:35.000000000","tz":0},"subject":"Reland \"Replace march znver3 with znver2\"","message":"Reland \"Replace march znver3 with znver2\"\n\nThis reverts commit cc3711d6640b9e3956bf209643ebe110c2e091bd.\n\nReason for revert: Always replace znver3 with znver2 when\nrunning GCC, rather than checking the version number, since we\ndon\u0027t expect GCC to ever be updated.\n\nOriginal change\u0027s description:\n\u003e Revert \"Replace march znver3 with znver2\"\n\u003e\n\u003e This reverts commit 12b13f8602f1b783ecce338636a6fbc9422ece36.\n\u003e\n\u003e Reason for revert: Broke the build:\n\u003e https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4879388/comment/5edc00b9_be45c487/\n\u003e\n\u003e Original change\u0027s description:\n\u003e \u003e Replace march znver3 with znver2\n\u003e \u003e\n\u003e \u003e Replace -march\u003dznver3 with znver2 due to missing support in GCC/clang\n\u003e \u003e for the following packages.\n\u003e \u003e\n\u003e \u003e BUG\u003db:221091499\n\u003e \u003e TEST\u003dbuild-packages, build-image guybrush/skyrim\n\u003e \u003e\n\u003e \u003e Change-Id: I93d7bd731d0952f02ac919f4072a6c53bcd78252\n\u003e \u003e Reviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4879388\n\u003e \u003e Tested-by: Tim Van Patten \u003ctimvp@google.com\u003e\n\u003e \u003e Commit-Queue: Tim Van Patten \u003ctimvp@google.com\u003e\n\u003e \u003e Reviewed-by: George Burgess \u003cgbiv@chromium.org\u003e\n\u003e\n\u003e BUG\u003db:221091499\n\u003e\n\u003e Change-Id: Ic63883b1f13afa322e1f8fdfd9ef4c7118a8032c\n\u003e Reviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4887500\n\u003e Tested-by: Tim Van Patten \u003ctimvp@google.com\u003e\n\u003e Commit-Queue: Raul Rangel \u003crrangel@chromium.org\u003e\n\u003e Auto-Submit: Tim Van Patten \u003ctimvp@google.com\u003e\n\u003e Reviewed-by: Raul Rangel \u003crrangel@chromium.org\u003e\n\u003e Commit-Queue: Tim Van Patten \u003ctimvp@google.com\u003e\n\nBUG\u003db:221091499\n\nChange-Id: I682c4f803617fb559c4beb1688e0ee648314cb2f\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4887789\nCommit-Queue: Tim Van Patten \u003ctimvp@google.com\u003e\nReviewed-by: George Burgess \u003cgbiv@chromium.org\u003e\nTested-by: Tim Van Patten \u003ctimvp@google.com\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~4799285","triplet_id":"chromiumos%2Fov