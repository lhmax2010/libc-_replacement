n","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3435049","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~stabilize-14496.B~I307be498b0c6795f9153e68c5fced1b05891ec6c","project":"chromiumos/overlays/chromiumos-overlay","branch":"stabilize-14496.B","full_branch":"refs/heads/stabilize-14496.B","attention_set":{},"removed_from_attention_set":{"1158719":{"account":{"_account_id":1158719},"last_update":"2022-02-03 03:03:22.000000000","reason":"\u003cGERRIT_ACCOUNT_1158719\u003e replied on the change","reason_account":{"_account_id":1158719}}},"hashtags":[],"change_id":"I307be498b0c6795f9153e68c5fced1b05891ec6c","subject":"rust: land 1.58.1","status":"MERGED","created":"2022-02-03 02:56:12.000000000","updated":"2022-02-03 18:13:45.000000000","submitted":"2022-02-03 03:03:30.000000000","submitter":{"_account_id":1158719},"insertions":104,"deletions":467,"total_comment_count":1,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3435049","cherry_pick_of_change":3408134,"cherry_pick_of_patch_set":9,"meta_rev_id":"71f8b6d3796ec15db7fa7a2fc670ef66afb122bf","_number":3435049,"virtual_id_number":3435049,"owner":{"_account_id":1158719},"current_revision_number":2,"current_revision":"b0dbce89433cd9886d81acd21c2c7c7e026bf3ef","revisions":{"b0dbce89433cd9886d81acd21c2c7c7e026bf3ef":{"kind":"NO_CODE_CHANGE","_number":2,"created":"2022-02-03 03:03:30.000000000","uploader":{"_account_id":1158719},"ref":"refs/changes/49/3435049/2","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/49/3435049/2"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/49/3435049/2"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/49/3435049/2"}},"commit":{"parents":[{"commit":"20e613de71fa8d0b91e13b382f728f24284c4459","subject":"Bump CHROMEOS_BRANCH number after creating branch stabilize-14496.B"}],"author":{"name":"George Burges