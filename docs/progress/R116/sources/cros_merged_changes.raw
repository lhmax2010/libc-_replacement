er":{"_account_id":1111084},"insertions":7,"deletions":0,"total_comment_count":13,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3182900","meta_rev_id":"8f83fd4c9f0e872b5390ec30410427f90af4864d","_number":3182900,"virtual_id_number":3182900,"owner":{"_account_id":1358213},"current_revision_number":3,"current_revision":"2ba16bea098f6f052d33486f7a804f8eb96b931f","revisions":{"2ba16bea098f6f052d33486f7a804f8eb96b931f":{"kind":"REWORK","_number":3,"created":"2021-10-21 05:14:12.000000000","uploader":{"_account_id":1111084},"ref":"refs/changes/00/3182900/3","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/00/3182900/3"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/00/3182900/3"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/00/3182900/3"}},"commit":{"parents":[{"commit":"61fabe7bdb1f173a9d40eb036b9a855f77d5bf51","subject":"Marking set of ebuilds as stable"}],"author":{"name":"Laurent Pinchart","email":"laurent.pinchart@ideasonboard.com","date":"2021-09-24 17:07:55.000000000","tz":180},"committer":{"name":"Commit Bot","email":"commit-bot@chromium.org","date":"2021-10-21 05:14:12.000000000","tz":0},"subject":"media-libs/libcamera: Don\u0027t omit unwind tables when USE\u003ddebug","message":"media-libs/libcamera: Don\u0027t omit unwind tables when USE\u003ddebug\n\nChrome OS disables exceptions by default in C++ projects, which results\nin the -fno-unwind-tables and -fno-asynchronous-unwind-table CXXFLAGS\nbeing set. Omitting the unwind tables has the undesired side effect of\npreventing libunwind or the glibc\u0027s backtrace() function from walking up\nthe call stack to generate a backtrace. This hurts debugging, as\nlibcamera prints backtraces on ASSERT() and will soon use backtraces to\nhelp with resource leakage debugging.\n\nTo fix this, call cros_enable_cxx_exceptions to enable unwind tables\nwhen the debug USE flag is set.\n\nBUG\u003dNone\nTEST\u003dBuilt libcamera and verified that backtrace is correct with ASSERT()\n\nChange-Id: Id1c0f6104ac25b63dfa7bb4dd4630ebdf43737e8\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3182900\nReviewed-by: Mike Frysinger \u003cvapier@chromium.org\u003e\nReviewed-by: Tomasz Figa \u003ctfiga@chromium.org\u003e\nTested-by: Laurent Pinchart \u003claurent.pinchart@ideasonboard.com\u003e\nCommit-Queue: Tomasz Figa \u003ctfiga@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}},"_more_changes":true}]
