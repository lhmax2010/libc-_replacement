undles crrev.com/c/4133825 to move LLVM Next flags to LLVM\ncurrent flags in th compiler wrapper.\n\nBUG\u003db:254289728\nTEST\u003dCQ\n\nChange-Id: I1a72745b2c89fd0e4e5d66f2efec9973339009fb\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4133805\nCommit-Queue: Ryan Beltran \u003cryanbeltran@chromium.org\u003e\nTested-by: Ryan Beltran \u003cryanbeltran@chromium.org\u003e\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~4058984","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~If896e92339f0aecf532adfd8ebf1d45680af45b8","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1474597":{"account":{"_account_id":1474597},"last_update":"2022-12-12 18:35:46.000000000","reason":"Change was submitted"}},"hashtags":[],"change_id":"If896e92339f0aecf532adfd8ebf1d45680af45b8","subject":"llvm-next: upgrade to 11897708c0229c92802e747564e7c34b722f045f (r475826)","status":"MERGED","created":"2022-11-27 02:30:30.000000000","updated":"2022-12-12 18:35:46.000000000","submitted":"2022-12-12 18:35:46.000000000","submitter":{"_account_id":1530088},"insertions":6,"deletions":7,"total_comment_count":0,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"4058984","meta_rev_id":"fe98899747a7c5940615a7b750948820f44d294f","_number":4058984,"virtual_id_number":4058984,"owner":{"_account_id":1474597},"current_revision_number":13,"current_revision":"6c8d922a496a2222182fec874241dee4a1213575","revisions":{"6c8d922a496a2222182fec874241dee4a1213575":{"kind":"REWORK","_number":13,"created":"2022-12-12 18:35:46.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/84/4058984/13","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/84/4058984/13"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/84/4058984/13"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/84/4058984/13"}},"commit":{"parents":[{"commit":"a9f8ddf6fa23fc50a3436722a7906f00e9e83926","subject":"Set POSTSUBMIT_BINHOST\u003dgs://chromeos-prebuilt/board/arm-generic/postsubmit-R110-15275.0.0-43848-8794962580046726545/packages. go/bbid/8794962580046726545"}],"author":{"name":"Ryan Beltran","email":"ryanbeltran@chromium.org","date":"2022-11-27 02:30:17.000000000","tz":0},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2022-12-12 18:35:46.000000000","tz":0},"subject":"llvm-next: upgrade to 11897708c0229c92802e747564e7c34b722f045f (r475826)","message":"llvm-next: upgrade to 11897708c0229c92802e747564e7c34b722f045f (r475826)\n\nThe following packages have been updated:\nsys-libs/compiler-rt\nsys-devel/llvm\nsys-libs/llvm-libunwind\ndev-util/lldb-server\nsys-libs/libcxx\n\nFor the package sys-libs/libcxx:\nThe patch metadata file PATCHES.json was modified\nThe following patches were disabled:\n0001-libcxx-makes-it-possible-to-strip-debug-info-from-li-v2.patch\n\nThis CL no longer sets LLVM next and is therefore a noop in CQ as it\ndoes not modify any behaviors for LLVM current.\n\nBUG\u003db:254289728, b:255646454\nTEST\u003dCQ\n\nChange-Id: If896e92339f0aecf532adfd8ebf1d45680af45b8\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4058984\nCommit-Queue: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nTested-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~4024130","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I136ba7829188f7e02c5989733fbda14fd290038d","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1158719":{"account":{"_account_id":1158719},"last_update":"2022-11-14 16:44:29.000000000","reason":"removed on reply"},"1504745":{"account":{"_account_id":1504745},"last_update":"2022-11-14 19:54:03.000000000","reason":"\u003cGERRIT_ACCOUNT_1504745\u003e replied on the change","reason_account":{"_account_id":1504745}},"1171009":{"account":{"_account_id":1171009},"last_update":"2022-11-14 20:45:57.000000000","reason":"Change was submitted"}},"hashtags":[],"change_id":"I136ba7829188f7e02c5989733fbda14fd290038d","subject":"netcat: Ignore -Wno-int-conversion","status":"MERGED","created":"2022-11-11 23:25:34.000000000","updated":"2022-11-14 20:45:57.000000000","submitted":"2022-11-14 20:45:57.000000000","submitter":{"_account_id":1530088},"insertions":11,"deletions":0,"total_comment_count":2,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"4024130","meta_rev_id":"71cc12d8d7bc052d06247456771a93894d8d213e","_number":4024130,"virtual_id_number":4024130,"owner":{"_account_id":1504745},"current_revision_number":3,"current_revision":"1c6f92ca217cc19fce112bce8fc64125345e735b","revisions":{"1c6f92ca217cc19fce112bce8fc64125345e735b":{"kind":"REWORK","_number":3,"created":"2022-11-14 20:45:57.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/30/4024130/3","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/30/4024130/3"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/30/4024130/3"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/30/4024130/3"}},"commit":{"parents":[{"commit":"3307fb3164e06346e47a163447b4fa563554942f","subject":"Update Metadata Cache"}],"author":{"name":"Jordan R Abrahams-Whitehead","email":"ajordanr@google.com","date":"2022-11-11 23:18:31.000000000","tz":0},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2022-11-14 20:45:57.000000000","tz":0},"subject":"netcat: Ignore -Wno-int-conversion","message":"netcat: Ignore -Wno-int-conversion\n\nWith newer versions of LLVM (e.g. r478178),\nthe -Wno-int-conversion warning has expanded.\nNetcat now breaks with this warning.\n\nThe net-analyzer/netcat package is an upstream package\nheavily affected by code rot and hasn\u0027t been updated\nin the over 4 years.\n\nGiven this, our quick and ugly hack is to force ignore\nthese warnings.\n\nLongterm, we should either upstream an ebuild change itself, or we\nshould actually fix all the bad warnings in netcat.\n\nBUG\u003db:249835037\nTEST\u003dnetcat builds with llvm r478178\n\nChange-Id: I136ba7829188f7e02c5989733fbda14fd290038d\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4024130\nCommit-Queue: Jordan Abrahams-Whitehead \u003cajordanr@google.com\u003e\nTested-by: Jordan Abrahams-Whitehead \u003cajordanr@google.com\u003e\nReviewed-by: George Burgess \u003cgbiv@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3966264","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I90dc58616a5d7916f7b6fa658cd20162c198d413","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1158719":{"account":{"_account_id":1158719},"last_update":"2022-11-01 05:17:26.000000000","reason":"Change was submitted"},"1314845":{"account":{"_account_id":1314845},"last_update":"2022-10-31 15:35:39.000000000","reason":"removed on reply"},"1171009":{"account":{"_account_id":1171009},"last_update":"2022-10-28 20:13:05.000000000","reason":"\u003cGERRIT_ACCOUNT_1171009\u003e replied on the change","reason_account":{"_account_id":1171009}}},"hashtags":[],"change_id":"I90dc58616a5d7916f7b6fa658cd20162c198d413