2920333f8c","subject":"Set POSTSUBMIT_BINHOST\u003dgs://chromeos-prebuilt/board/arm64-generic/postsubmit-R117-15556.0.0-53781-8774489563274381809/packages. go/bbid/8774489563274381809"}],"author":{"name":"Matt Turner","email":"msturner@google.com","date":"2023-07-13 20:38:13.000000000","tz":0},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2023-07-26 17:54:10.000000000","tz":0},"subject":"sys-libs/llvm-libunwind: Remove ChromeOS workaround","message":"sys-libs/llvm-libunwind: Remove ChromeOS workaround\n\nNow that cmake-multilib.eclass has been updated (crrev/c/4622029), it\nnow defaults to using cmake.eclass instead of cmake-utils.eclass. As a\nresult, we can remove this workaround.\n\nBUG\u003dnone\nTEST\u003dCQ passes\n\nChange-Id: If4bc90365a5ea793ba1bbcc51220b62cac1537a6\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4685180\nAuto-Submit: Matt Turner \u003cmsturner@google.com\u003e\nTested-by: Matt Turner \u003cmsturner@google.com\u003e\nCommit-Queue: Matt Turner \u003cmsturner@google.com\u003e\nReviewed-by: Jordan Abrahams-Whitehead \u003cajordanr@google.com\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~4685179","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I2b977fc9a4d37ac6d12f7ebfff0e277f59e999bd","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1158719":{"account":{"_account_id":1158719},"last_update":"2023-07-19 01:06:34.000000000","reason":"Change was submitted"},"1473373":{"account":{"_account_id":1473373},"last_update":"2023-07-18 21:25:04.000000000","reason":"\u003cGERRIT_ACCOUNT_1473373\u003e replied on the change","reason_account":{"_account_id":1473373}},"1474597":{"account":{"_account_id":1474597},"last_update":"2023-07-19 01:06:34.000000000","reason":"Change was submitted"}},"hashtags":[],"change_id":"I2b977fc9a4d37ac6d12f7ebfff0e277f59e999bd","subject":"sys-libs/llvm-libunwind: Switch from cmake-utils.eclass to cmake.eclass","status":"MERGED","created":"2023-07-13 20:38:39.000000000","updated":"2023-07-19 01:06:34.000000000","submitted":"2023-07-19 01:06:34.000000000","submitter":{"_account_id":1530088},"insertions":13,"deletions":4,"total_comment_count":2,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"4685179","meta_rev_id":"997b6199e4abed46506aa00b39ef04b625d3911c","_number":4685179,"virtual_id_number":4685179,"owner":{"_account_id":1473373},"current_revision_number":5,"current_revision":"a193e50ddc1fdfc023bc4c2b104f0260011bac0c","revisions":{"a193e50ddc1fdfc023bc4c2b104f0260011bac0c":{"kind":"REWORK","_number":5,"created":"2023-07-19 01:06:34.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/79/4685179/5","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/79/4685179/5"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/79/4685179/5"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/79/4685179/5"}},"commit":{"parents":[{"commit":"a10a32bd0d57851490f7a1cc6ee0bb02fff65315","subject":"Set POSTSUBMIT_BINHOST\u003dgs://chromeos-prebuilt/board/amd64-generic/postsubmit-R117-15544.0.0-53451-8775189955122049281/packages. go/bbid/8775189955122049281"}],"author":{"name":"Matt Turner","email":"msturner@google.com","date":"2023-07-13 20:29:04.000000000","tz":0},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2023-07-19 01:06:34.000000000","tz":0},"subject":"sys-libs/llvm-libunwind: Switch from cmake-utils.eclass to cmake.eclass","message":"sys-libs/llvm-libunwind: Switch from cmake-utils.eclass to cmake.eclass\n\ncmake-utils.eclass is deprecated and gone from Gentoo upstream.\n\nNote that we must add \u0027append-cppflags -DNDEBUG\u0027 to match cmake-utils\u0027\nbehavior of appending -DNDEBUG if the package does not have a debug USE\nflag or the debug USE flag is disabled.\n\nBUG\u003dnone\nTEST\u003dCQ passes\n\nChange-Id: I2b977fc9a4d37ac6d12f7ebfff0e277f59e999bd\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4685179\nAuto-Submit: Matt Turner \u003cmsturner@google.com\u003e\nCommit-Queue: Matt Turner \u003cmsturner@google.com\u003e\nTested-by: Matt Turner \u003cmsturner@google.com\u003e\nReviewed-by: George Burgess \u003cgbiv@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~4437286","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I2f1fe610875df734a2d6149d7e3fe34ce76ecdf6","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1158719":{"account":{"_account_id":1158719},"last_update":"2023-07-17 17:16:22.000000000","reason":"Change was submitted"},"1504745":{"account":{"_account_id":1504745},"last_update":"2023-07-17 23:25:41.000000000","reason":"\u003cGERRIT_ACCOUNT_1504745\u003e replied on the change","reason_account":{"_account_id":1504745}},"1171009":{"account":{"_account_id":1171009},"last_update":"2023-07-13 17:29:04.000000000","reason":"\u003cGERRIT_ACCOUNT_1171009\u003e replied on the change","reason_account":{"_account_id":1171009}}},"hashtags":[],"change_id":"I2f1fe610875df734a2d6149d7e3fe34ce76ecdf6","subject":"sys-libs: Add libcxx-9999 ebuild","status":"MERGED","created":"2023-04-18 03:02:38.000000000","updated":"2023-07-17 23:25:41.000000000","submitted":"2023-07-17 17:16:22.000000000","submitter":{"_account_id":1530088},"insertions":61,"deletions":13,"total_comment_count":56,"unresolved_comment_count":2,"has_review_started":true,"submission_id":"4437286","meta_rev_id":"4afd508c7bb69c23bea0bc12b8c5c666c2952557","_number":4437286,"virtual_id_number":4437286,"owner":{"_account_id":1504745},"current_revision_number":13,"current_revision":"9a6b514ce65873b3b50e6533243021c96727ba09","revisions":{"9a6b514ce65873b3b50e6533243021c96727ba09":{"kind":"REWORK","_number":13,"created":"2023-07-17 17:16:22.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/86/4437286/13","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/86/4437286/13"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/86/4437286/13"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/86/4437286/13"}},"commit":{"parents":[{"commit":"f6966789f8193e2f4ec6595483991948c7d3c862","subject":"libec: Add missing dependencies"}],"author":{"name":"Jordan R Abrahams-Whitehead","email":"ajordanr@google.com","date":"2023-07-12 22:54:50.000000000","tz":0},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2023-07-17 17:16:22.000000000","tz":0},"subject":"sys-libs: Add libcxx-9999 ebuild","message":"sys-libs: Add libcxx-9999 ebuild\n\nThis implements the libcxx-9999 ebuild using the\nCROS_WORKON_PRECLONE_HOOK method, as described in\ngo/crostc-update-revamp. We write the llvm SVN revision\nto a temp file, which we read back later during the prepare\nphase.\n\nAdditionally, this commit introduces the `chromeos-version.sh`\nscript, which extracts the current version info from the\nllvm-project. This relies on llvm-project containing the necessary\n.git information.\n\nThe CrOSTC team will still need to rename the ebuild versions,\nbut we won\u0027t have conflicts with the revision number.\n\nBUG\u003db:275877115\nTEST\u003dcros-workon --host start libcxx with libcxx-9999.ebuild\nTEST\u003dcros_uprev --force --overlay-type public --packages \\\n     sys-libs/libcxx\n\nChange-Id: I2f1fe610875df734a2d6149d7e3fe34ce76ecdf6\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4437286\nCommit-Queue: Jordan Abrahams-Whitehead \u003cajordanr@google.com\u003e\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nTested-by: Jordan Abrahams-Whitehead \u003cajordanr@google.com\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~4677913","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I78da6d59e5c3e4d7937d8fec90b94440d887ed9b","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1158719":{"account":{"_account_id":1158719},"last_update":"2023-07-11 23:09:23.000000000","reason":"\u003cGERRIT_ACCOUNT_1158719\u003e replied on the change","reason_account":{"_account_id":1158719}},"1504745":{"account":{"_account_id":1504745},"last_update":"2023-07-11 23:08:01.000000000","reason":"\u003cGERRIT_ACCOUNT_1504745\u003e replied on the change","reason_account":{"_account_id":1504745}}},"hashtags":[],"change_id":"I78da6d59e5c3e4d7937d8fec90b94440d887ed9b","subject":"glibc: stop using llvm-libunwind if it\u0027s installed","status":"MERGED","created":"2023-07-11 15:46:55.000000000","updated":"2023-07-12 15:38:45.000000000","submitted":"2023-07-12 08:04:05.000000000","submitter":{"_account_id":1530088},"insertions":32,"deletions":5,"total_comment_count":8,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"4677913","meta_rev_id":"027d47e89c4967647825783efe36929cbaa15d52","_number":4677913,"virtual_id_number":4677913,"owner":{"_account_id":1158719},"current_revision_number":3,"current_revision":"f0894a0a76231c7f290537306f86c770190e3046","revisions":{"f0894a0a76231c7f290537306f86c770190e3046":{"kind":"REWORK","_number":3,"created":"2023-07-12 08:04:05.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/13/4677913/3","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/13/4677913/3"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/13/4677913/3"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/13/4677913/3"}},"commit":{"parents":[{"commit":"8357b222188958cb87c15e70ad1725b25bcf5f0f","subject":"Set POSTSUBMIT_BINHOST\u003dgs://chromeos-prebuilt/board/tael/postsubmit-R117-15539.0.0-53190-8775793588446111889/packages. go/bbid/8775793588446111889"}],"author":{"name":"George Burgess IV","email":"gbiv@google.com","date":"2023-07-11 15:44:36.000000000","tz":-360},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2023-07-12 08:04:05.000000000","tz":0},"subject":"glibc: stop using llvm-libunwind if it\u0027s installed","message":"glibc: stop using llvm-libunwind if it\u0027s installed\n\nAt the moment, the toolchain CQ is broken since cross-*/llvm-libunwind\nis brought in earlier than it used to be (it\u0027s now installed during\nchroot init, rather than some crossdev invocation). Since glibc seems to\nbuild fine without automatic `--sysroot` application, we can disable\nthat for the glibc ebuild.\n\nBUG\u003db:290144273\nTEST\u003darmv7a\u0027s `crossdev` command completes successfully\n\nChange-Id: I78da6d59e5c3e4d7937d8fec90b94440d887ed9b\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4677913\nCommit-Queue: George Burgess \u003cgbiv@chromium.org\u003e\nReviewed-by: Jordan Abrahams-Whitehead \u003cajordanr@google.com\u003e\nTested-by: George Burgess \u003cgbiv@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~4594983","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~Ie11c2a29d6e762ab804bd0d794c0a1ad1523d9c0","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1158719":{"account":{"_account_id":1158719},"last_update":"2023-06-30 17:12:30.000000000","reason":"Change was submitted"},"1222289":{"account":{"_account_id":1222289},"last_update":"2023-06-30 16:12:58.000000000","reason":"\u003cGERRIT_ACCOUNT_1222289\u003e replied on the change","reason_account":{"_account_id":1222289}}},"hashtags":[],"change_id":"Ie11c2a29d6e762ab804bd0d794c0a1ad1523d9c0","subject":"rust: update to 1.70","status":"MERGED","created":"2023-06-06 18:21:07.000000000","updated":"2023-06-30 17:12:30.000000000","submitted":"2023-06-30 17:12:30.000000000","submitter":{"_account_id":1158719},"insertions":27,"deletions":22,"total_comment_count":9,"unresolved_comment_count":1,"has_review_started":true,"submission_id":"4594983","meta_rev_id":"62764c36c5acb4afd55a708a0b39bede979299c7","_number":4594983,"virtual_id_number":4594983,"owner":{"_account_id":1158719},"current_revision_number":15,"current_revision":"474cfc6441ca42567470acd07e341f38a1094717","revisions":{"474cfc6441ca42567470acd07e341f38a1094717":{"kind":"REWORK","_number":15,"created":"2023-06-30 17:12:30.000000000","uploader":{"_account_id":1158719},"ref":"refs/changes/83/4594983/15","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/83/4594983/15"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/83/4594983/15"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/83/4594983/15"}},"commit":{"parents":[{"commit":"c8d168810dae2ea278b8c9d96f0edd2660cdaaf8","subject":"rust-bootstrap: add ccache support"}],"author":{"name":"George Burgess IV","email":"gbiv@google.com","date":"2023-06-05 23:02:11.000000000","tz":-360},"committer":{"name":"George Burgess","email":"gbiv@chromium.org","date":"2023-06-30 17:12:30.000000000","tz":0},"subject":"rust: update to 1.70","message":"rust: update to 1.70\n\nThis updates Rust to 1.70. No significant changes to Rust itself were\nneeded in this upgrade.\n\nAlso, move back to lto \u003d \"thin\" - this provides slightly better\nrustc performance than \"thin-local\", as the LTO is performed more\nbroadly.\n\nBUG\u003db:285580185, b:284162551\nTEST\u003dCQ\n\nChange-Id: Ie11c2a29d6e762ab804bd0d794c0a1ad1523d9c0\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4594983\nReviewed-by: Raul Rangel \u003crrangel@chromium.org\u003e\nReviewed-by: Bob Haarman \u003cinglorion@chromium.org\u003e\nTested-by: George Burgess \u003cgbiv@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~4638962","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I6ef7ba33015d0fd1e93b362ad68a807c879fad13","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1158719":{"account":{"_account_id":1158719},"last_update":"2023-06-28 22:11:27.000000000","reason":"\u003cGERRIT_ACCOUNT_1158719\u003e replied on the change","reason_account":{"_account_id":1158719}},"1270601":{"account":{"_account_id":1270601},"last_update":"2023-06-28 22:19:19.000000000","reason":"\u003cGERRIT_ACCOUNT_1270601\u003e replied on the change","reason_account":{"_account_id":1270601}},"1171009":{"account":{"_account_id":1171009},"last_update":"2023-06-29 04:19:50.000000000","reason":"Change was submitted"}},"hashtags":[],"change_id":"I6ef7ba33015d0fd1e93b362ad68a807c879fad13","subject":"sys-devel/gcc,sys-libs/glibc: Add support for -bootstrap packages","status":"MERGED","created":"2023-06-22 22:03:06.000000000","updated":"2023-06-29 04:19:50.000000000","submitted":"2023-06-29 04:19:50.000000000","submitter":{"_account_id":1530088},"insertions":59,"deletions":4,"total_comment_count":3,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"4638962","meta_rev_id":"c6637918190819b9a116542e00284e52e0927828","_number":4638962,"virtual_id_number":4638962,"owner":{"_account_id":1270601},"current_revision_number":3,"current_revision":"16a281e5d57fa354a1b7278ad51c0273f163e3c2","revisions":{"16a281e5d57fa354a1b7278ad51c0273f163e3c2":{"kind":"REWORK","_number":3,"created":"2023-06-29 04:19:50.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/62/4638962/3","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/62/4638962/3"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/62/4638962/3"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/62/4638962/3"}},"commit":{"parents":[{"commit":"f5fe7aa3123bd09a86a6b1d21e284ac9e6550eef","subject":"Set POSTSUBMIT_BINHOST\u003dgs://chromeos-prebuilt/board/tatl/postsubmit-R117-15522.0.0-52630-8776986829308822161/packages. go/bbid/8776986829308822161"}],"author":{"name":"Raul E Rangel","email":"rrangel@chromium.org","date":"2023-05-30 15:43:01.000000000","tz":-360},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2023-06-29 04:19:50.000000000","tz":0},"subject":"sys-devel/gcc,sys-libs/glibc: Add support for -bootstrap packages","message":"sys-devel/gcc,sys-libs/glibc: Add support for -bootstrap packages\n\nWhen using crossdev to build a cross compiler it builds `gcc` twice.\nThe first time it builds it with essentially USE\u003d-*. This is the stage1\ncompiler. This stage1 compiler is then used to build glibc. The second\nbuild of gcc (with the actual USE flags) uses the newly built `glibc`\nand the stage 1 gcc to build `libgcc`, etc.\n\nBazel/alchemist doesn\u0027t have support for building a package multiple\ntimes with different USE flags. This would require a large change in\nalchemist that is only used for this one case. To work around the issue\nwe define a new gcc package with a -bootstrap category suffix. We can\nset different USE flags on this package via package.use, and treat it\nlike a regular dependency. We use the || operator when declaring the GCC\ndependency so that crossdev continues to function correctly.\n\nBUG\u003db:283969886, b:264959615\nTEST\u003d/usr/bin/crossdev --stable --show-fail-log --env \u0027FEATURES\u003dsplitdebug\u0027 -P --oneshot --overlays \u0027/mnt/host/source/src/third_party/chromiumos-overlay /mnt/host/source/src/third_party/eclass-overlay /mnt/host/source/src/third_party/portage-stable\u0027 --ov-output /usr/local/portage/crossdev -t armv7a-cros-linux-gnueabihf --ex-pkg sys-libs/libxcrypt --ex-pkg sys-libs/compiler-rt --ex-pkg sys-libs/llvm-libunwind --ex-pkg sys-libs/libcxx --ex-pkg dev-lang/go --binutils \u0027[stable]\u0027 --gcc \u0027[stable]\u0027 --kernel \u0027[stable]\u0027 --libc \u0027[stable]\u0027 --ex-gdb\nTEST\u003dBOARD\u003damd64-generic bazel build -k --config\u003dprebuilts/stage2 @portage//internal/packages/stage2/host/toolchains/cross-aarch64-cros-linux-gnu/...\n\nChange-Id: I6ef7ba33015d0fd1e93b362ad68a807c879fad13\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4638962\nTested-by: Raul Rangel \u003crrangel@chromium.org\u003e\nReviewed-by: George Burgess \u003cgbiv@chromium.org\u003e\nCommit-Queue: Raul Rangel \u003crrangel@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~4586450","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~Ia767922f9077124651d1c0a5e993999993f25bfa","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1158719":{"account":{"_account_id":1158719},"last_update":"2023-06-28 22:05:57.000000000","reason":"removed on reply"},"1270601":{"account":{"_account_id":1270601},"last_update":"2023-06-29 03:36:50.000000000","reason":"Change was submitted"},"1171009":{"account":{"_account_id":1171009},"last_update":"2023-06-29 03:36:50.000000000","reason":"Change was submitted"}},"hashtags":[],"change_id":"Ia767922f9077124651d1c0a5e993999993f25bfa","subject":"sys-libs/llvm-libunwind: Fix deps for cross- packages","status":"MERGED","created":"2023-06-03 14:45:07.000000000","updated":"2023-06-29 03:36:50.000000000","submitted":"2023-06-29 03:36:50.000000000","submitter":{"_account_id":1530088},"insertions":14,"deletions":2,"total_comment_count":6,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"4586450","meta_rev_id":"bc5c4fbd835f581ca4ebb85352aa3825cccf6a0b","_number":4586450,"virtual_id_number":4586450,"owner":{"_account_id":1270601},"current_revision_number":4,"current_revision":"4c91afe8af36efe3060bcf74433aae656eedc234","revisions":{"4c91afe8af36efe3060bcf74433aae656eedc234":{"kind":"REWORK","_number":4,"created":"2023-06-29 03:36:50.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/50/4586450/4","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/50/4586450/4"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/50/4586450/4"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/50/4586450/4"}},"commit":{"parents":[{"commit":"95243ae79e09348739a30dcb5d266edfba9601b3","subject":"sys-libs/libcxx: Fix deps for cross- packages"}],"author":{"name":"Raul E Rangel","email":"rrangel@chromium.org","date":"2023-06-01 21:29:31.000000000","tz":-360},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2023-06-29 03:36:50.000000000","tz":0},"subject":"sys-libs/llvm-libunwind: Fix deps for cross- packages","message":"sys-libs/llvm-libunwind: Fix deps for cross- packages\n\nWhen building the cross- variant of the package we need to ensure\ncompiler-rt has been installed for the non-x86 boards.\n\nWe also don\u0027t need the host\u0027s linux-headers or glibc when building a\ncross- package.\n\nBUG\u003db:283969886\nTEST\u003dBOARD\u003damd64-generic bazel build -k --config\u003dprebuilts/stage2 @portage//internal/packages/stage2/host/toolchains/...\n\nChange-Id: Ia767922f9077124651d1c0a5e993999993f25bfa\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4586450\nTested-by: Raul Rangel \u003crrangel@chromium.org\u003e\nReviewed-by: George Burgess \u003cgbiv@chromium.org\u003e\nCommit-Queue: Raul Rangel \u003crrangel@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~4598105","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~Ibbac88dfe48ec42ba27bfb310562f4ec393c4057","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1504745":{"account":{"_account_id":1504745},"last_update":"2023-06-22 22:50:34.000000000","reason":"\u003cGERRIT_ACCOUNT_1504745\u003e replied on the change","reason_account":{"_account_id":1504745}},"1474597":{"account":{"_account_id":1474597},"last_update":"2023-06-22 23:00:39.000000000","reason":"Change was submitted"},"1222289":{"account":{"_account_id":1222289},"last_update":"2023-06-22 23:00:39.000000000","reason":"Change was submitted"}},"hashtags":[],"change_id":"Ibbac88dfe48ec42ba27bfb310562f4ec393c4057","subject":"llvm-next: upgrade to 14f0776550b5a49e1c42f49a00213f7f3fa047bf (r498229)","status":"MERGED","created":"2023-06-07 20:32:58.000000000","updated":"2023-06-22 23:00:39.000000000","submitted":"2023-06-22 23:00:39.000000000","submitter":{"_account_id":1530088},"insertions":6,"deletions":6,"total_comment_count":2,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"4598105","meta_rev_id":"ff816a46e3603fedad5b6663f7b9cd2092817191","_number":4598105,"virtual_id_number":4598105,"owner":{"_account_id":1504745},"current_revision_number":4,"current_revision":"9946a79e0a9dee710f4f38e220c3ffcdb2e92971","revisions":{"9946a79e0a9dee710f4f38e220c3ffcdb2e92971":{"kind":"REWORK","_number":4,"created":"2023-06-22 23:00:39.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/05/4598105/4","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/05/4598105/4"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/05/4598105/4"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/05/4598105/4"}},"commit":{"parents":[{"commit":"6ed5e4019ca503a550221d76ab11392a3122b3ac","subject":"Set POSTSUBMIT_BINHOST\u003dgs://chromeos-prebuilt/board/arm-generic/postsubmit-R117-15513.0.0-52351-8777551062425642065/packages. go/bbid/8777551062425642065"}],"author":{"name":"Jordan R Abrahams-Whitehead","email":"ajordanr@google.com","date":"2023-06-07 20:32:48.000000000","tz":0},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2023-06-22 23:00:39.000000000","tz":0},"subject":"llvm-next: upgrade to 14f0776550b5a49e1c42f49a00213f7f3fa047bf (r498229)","message":"llvm-next: upgrade to 14f0776550b5a49e1c42f49a00213f7f3fa047bf (r498229)\n\nThe following packages have been updated:\ndev-util/lldb-server\nsys-libs/compiler-rt\nsys-libs/libcxx\nsys-libs/scudo\nsys-libs/llvm-libunwind\nsys-devel/llvm\n\nBUG\u003db:288331280\nTEST\u003dCQ\n\nChange-Id: Ibbac88dfe48ec42ba27bfb310562f4ec393c4057\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4598105\nTested-by: Jordan Abrahams-Whitehead \u003cajordanr@google.com\u003e\nReviewed-by: George Burgess \u003cgbiv@chromium.org\u003e\nCommit-Queue: Jordan Abrahams-Whitehead \u003cajordanr@google.com\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~4609370","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I7e790a24d826f6455550554c1b2d5008c73b51f4","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1158719":{"account":{"_account_id":1158719},"last_update":"2023-06-13 22:28:05.000000000","reason":"Change was submitted"},"1314845":{"account":{"_account_id":1314845},"last_update":"2023-06-13 22:18:29.000000000","reason":"removed on reply"},"1171009":{"account":{"_account_id":1171009},"last_update":"2023-06-13 00:04:03.000000000","reason":"\u003cGERRIT_ACCOUNT_1171009\u003e replied on the change","reason_account":{"_account_id":1171009}}},"hashtags":[],"change_id":"I7e790a24d826f6455550554c1b2d5008c73b51f4","subject":"sys-libs/[compiler-rt,libcxx,llvm-unwind]: Set floating point compile flags for baremetal","status":"MERGED","created":"2023-06-12 21:44:23.000000000","updated":"2023-06-13 22:28:05.000000000","submitted":"2023-06-13 22:28:05.000000000","submitter":{"_account_id":1530088},"insertions":13,"deletions":5,"total_comment_count":9,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"4609370","meta_rev_id":"09efabffac645f2c76108d70124b15c2b9b6ea0c","_number":4609370,"virtual_id_number":4609370,"owner":{"_account_id":1314845},"current_revision_number":6,"current_revision":"bd305553630e4c4bb9f97dd62a8d42bfce22fa71","revisions":{"bd305553630e4c4bb9f97dd62a8d42bfce22fa71":{"kind":"REWORK","_number":6,"created":"2023-06-13 22:28:05.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/70/4609370/6","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/70/4609370/6"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/70/4609370/6"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/70/4609370/6"}},"commit":{"parents":[{"commit":"5c24e60efc715efde00a530da3c734c73529a225","subject":"Set POSTSUBMIT_BINHOST\u003dgs://chromeos-prebuilt/board/amd64-generic/postsubmit-R116-15500.0.0-51948-8778370265501616417/packages. go/bbid/8778370265501616417"}],"author":{"name":"Tom Hughes","email":"tomhughes@chromium.org","date":"2023-06-12 21:20:04.000000000","tz":-420},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2023-06-13 22:28:05.000000000","tz":0},"subject":"sys-libs/[compiler-rt,libcxx,llvm-unwind]: Set floating point compile flags for baremetal","message":"sys-libs/[compiler-rt,libcxx,llvm-unwind]: Set floating point compile flags for baremetal\n\nThe previous flags were generating instructions such as \"vmov.f64\",\nwhich is a 64-bit floating point instruction that is not supported on\nCortex-M4.\n\nBy explicitly setting \"-mcpu\u003dcortex-m4\", clang will choose the correct\nFPU type\n(https://lists.llvm.org/pipermail/llvm-dev/2018-September/126468.html)\nand the flags will match the ones we are using in the EC repo.\n\nBUG\u003db:286910996\nTEST\u003dsudo emerge cross-armv7m-cros-eabi/libcxx\nTEST\u003dsudo emerge cross-armv7m-cros-eabi/compiler-rt\nTEST\u003dsudo emerge cross-armv7m-cros-eabi/llvm-libunwind\n\nChange-Id: I7e790a24d826f6455550554c1b2d5008c73b51f4\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4609370\nCommit-Queue: Tom Hughes \u003ctomhughes@chromium.org\u003e\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nTested-by: Tom Hughes \u003ctomhughes@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~4312390","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I14662a74cb633d5f30ac86f18c7f08e074745c2b","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1270601":{"account":{"_account_id":1270601},"last_update":"2023-06-06 16:20:05.000000000","reason":"Removed by \u003cGERRIT_ACCOUNT_1270601\u003e using the hovercard menu","reason_account":{"_account_id":1270601}},"1171009":{"account":{"_account_id":1171009},"last_update":"2023-03-07 15:52:45.000000000","reason":"\u003cGERRIT_ACCOUNT_1171009\u003e replied on the change","reason_account":{"_account_id":1171009}}},"hashtags":[],"change_id":"I14662a74cb633d5f30ac86f18c7f08e074745c2b","subject":"sys-libs/llvm-libunwind: Add linux-headers as a dependency","status":"MERGED","created":"2023-03-06 20:19:53.000000000","updated":"2023-06-06 16:20:05.000000000","submitted":"2023-03-08 21:32:19.000000000","submitter":{"_account_id":1530088},"insertions":10,"deletions":1,"total_comment_count":7,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"4312390","meta_rev_id":"e7c3790f5baa146a4016f43288f4df0e9a8be952","_number":4312390,"virtual_id_number":4312390,"owner":{"_account_id":1270601},"current_revision_number":4,"current_revision":"c6b568c5c49464e29ef9376e91fc72c93378c058","revisions":{"c6b568c5c49464e29ef9376e91fc72c93378c058":{"kind":"REWORK","_number":4,"created":"2023-03-08 21:32:19.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/90/4312390/4","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/90/4312390/4"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/90/4312390/4"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/90/4312390/4"}},"commit":{"parents":[{"commit":"0c45b27d3e2c34704692e76921ad001c05e0f34c","subject":"Set POSTSUBMIT_BINHOST\u003dgs://chromeos-prebuilt/board/arm-generic/postsubmit-R113-15376.0.0-47706-8787159924953266097/packages. go/bbid/8787159924953266097"}],"author":{"name":"Raul E Rangel","email":"rrangel@chromium.org","date":"2023-03-06 20:29:54.000000000","tz":-420},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2023-03-08 21:32:19.000000000","tz":0},"subject":"sys-libs/llvm-libunwind: Add linux-headers as a dependency","message":"sys-libs/llvm-libunwind: Add linux-headers as a dependency\n\nllvm-libunwind is one of the primordial packages that needs to be\ninstalled when setting up a board\u0027s sysroot. We need to ensure that\nthe linux headers are installed before we try and build the package.\n\n    In file included from /build/arm64-generic/tmp/portage/sys-libs/llvm-libunwind-16.0_pre475826-r2/work/llvm-libunwind-16.0_pre475826/libunwind/src/UnwindCursor.hpp:35:\n    /build/arm64-generic/usr/include/sys/syscall.h:24:10: fatal error: \u0027asm/unistd.h\u0027 file not found\n    #include \u003casm/unistd.h\u003e\n\nBUG\u003db:262460834\nTEST\u003dBOARD\u003darm64-generic bazel build -k @portage//sys-libs/llvm-libunwind\n\nChange-Id: I14662a74cb633d5f30ac86f18c7f08e074745c2b\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4312390\nReviewed-by: Raul Rangel \u003crrangel@chromium.org\u003e\nCommit-Queue: Raul Rangel \u003crrangel@chromium.org\u003e\nTested-by: Raul Rangel \u003crrangel@chromium.org\u003e\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~4517739","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I56bb5446e80faa762620066218c4a8e7661d536c","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1158719":{"account":{"_account_id":1158719},"last_update":"2023-05-18 16:05:58.000000000","reason":"\u003cGERRIT_ACCOUNT_1158719\u003e replied on the change","reason_account":{"_account_id":1158719}},"1314845":{"account":{"_account_id":1314845},"last_update":"2023-05-16 18:50:30.000000000","reason":"\u003cGERRIT_ACCOUNT_1314845\u003e replied on the change","reason_account":{"_account_id":1314845}},"1171009":{"account":{"_account_id":1171009},"last_update":"2023-05-18 17:33:05.000000000","reason":"removed on reply"}},"hashtags":[],"change_id":"I56bb5446e80faa762620066218c4a8e7661d536c","subject":"libcxx/llvm-libunwind: Add baremetal c++ support for armv6m","status":"MERGED","created":"2023-05-09 18:31:35.000000000","updated":"2023-05-18 21:16:28.000000000","submitted":"2023-05-18 21:16:28.000000000","submitter":{"_account_id":1530088},"insertions":18,"deletions":0,"total_comment_count":7,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"4517739","meta_rev_id":"fc5ec2a072c52035a460e86f544c5227a2cabab3","_number":4517739,"virtual_id_number":4517739,"owner":{"_account_id":1171009},"current_revision_number":5,"current_revision":"8f788ed3cdf09d9a5c7cb88fb8cb12bbe7333b9e","revisions":{"8f788ed3cdf09d9a5c7cb88fb8cb12bbe7333b9e":{"kind":"REWORK","_number":5,"created":"2023-05-18 21:16:28.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/39/4517739/5","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/39/4517739/5"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/39/4517739/5"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/39/4517739/5"}},"commit":{"parents":[{"commit":"43efd837fefc677eb0bedcc6cc3930ca5536135b","subject":"Update Metadata Cache"}],"author":{"name":"Manoj Gupta","email":"manojgupta@google.com","date":"2023-05-09 05:00:08.000000000","tz":0},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2023-05-18 21:16:28.000000000","tz":0},"subject":"libcxx/llvm-libunwind: Add baremetal c++ support for armv6m","message":"libcxx/llvm-libunwind: Add baremetal c++ support for armv6m\n\nUses arm-none-eabi to provide armv6m C++ support\nto avoid creating a full new ABI.\n\nBUG\u003db:281531340\nTEST\u003dcros_setup_toolchains.\n\nCq-Depend: chromium:4539406\nCha