/libcxx\nsys-libs/libcxxabi\nsys-libs/llvm-libunwind\n\nBUG\u003db:213618377\nTEST\u003dCQ\n\nChange-Id: I69237191a5211d35ea2517ee6d59a6464637eb4b\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3418200\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nCommit-Queue: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nTested-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3470074","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~If6df41b89fb74afc0c0517617a4d7876464a60d3","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1508123":{"account":{"_account_id":1508123},"last_update":"2022-02-16 20:57:23.000000000","reason":"\u003cGERRIT_ACCOUNT_1508123\u003e replied on the change","reason_account":{"_account_id":1508123}},"1330845":{"account":{"_account_id":1330845},"last_update":"2022-02-16 21:00:23.000000000","reason":"\u003cGERRIT_ACCOUNT_1330845\u003e replied on the change","reason_account":{"_account_id":1330845}},"1458627":{"account":{"_account_id":1458627},"last_update":"2022-02-16 21:00:32.000000000","reason":"Change was submitted"}},"hashtags":[],"change_id":"If6df41b89fb74afc0c0517617a4d7876464a60d3","subject":"Revert \"dev-embedded/hps-sdk: add armv7a and aarch64 Linux targets\"","status":"MERGED","created":"2022-02-16 20:55:59.000000000","updated":"2022-02-16 21:00:32.000000000","submitted":"2022-02-16 21:00:32.000000000","submitter":{"_account_id":1330845},"insertions":5,"deletions":406,"total_comment_count":2,"unresolved_comment_count":0,"has_review_started":true,"revert_of":3463279,"submission_id":"3470074","meta_rev_id":"5689a68a943e91f8ab7d2f43067eac0acfa8aced","_number":3470074,"virtual_id_number":3470074,"owner":{"_account_id":1330845},"current_revision_number":2,"current_revision":"9c59ea31b2b034e60c4d37c68525c08af0d49948","revisions":{"9c59ea31b2b034e60c4d37c68525c08af0d49948":{"kind":"REWORK","_number":2,"created":"2022-02-16 21:00:32.000000000","uploader":{"_account_id":1330845},"ref":"refs/changes/74/3470074/2","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/74/3470074/2"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/74/3470074/2"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/74/3470074/2"}},"commit":{"parents":[{"commit":"59fcef684b8d89b3a2c0389453409d7821fdb0b3","subject":"Marking set of ebuilds as stable"}],"author":{"name":"Jack Rosenthal","email":"jrosenth@chromium.org","date":"2022-02-16 20:55:59.000000000","tz":0},"committer":{"name":"Jack Rosenthal","email":"jrosenth@chromium.org","date":"2022-02-16 21:00:32.000000000","tz":0},"subject":"Revert \"dev-embedded/hps-sdk: add armv7a and aarch64 Linux targets\"","message":"Revert \"dev-embedded/hps-sdk: add armv7a and aarch64 Linux targets\"\n\nThis reverts commit 7710f710b6e35980dd51812ed5ec7c8b38fd1c30.\n\nReason for revert: broke CQ\n\nBUG\u003db:219958360\nTEST\u003dnone\n\nOriginal change\u0027s description:\n\u003e dev-embedded/hps-sdk: add armv7a and aarch64 Linux targets\n\u003e\n\u003e Although HPS is not (yet) included with any ARM boards, we nevertheless\n\u003e need to build for these targets because hps-firmware is included in\n\u003e arm-generic and arm64-generic.\n\u003e\n\u003e Also add the complete set of patches copied from dev-lang/rust, because\n\u003e they include some import fixes which we need.\n\u003e\n\u003e BUG\u003db:201365430\n\u003e TEST\u003demerge hps-sdk\n\u003e\n\u003e Change-Id: I12c64dd00de20c7c0d3e9e1fb2bcb4e3a28ca102\n\u003e Reviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3463279\n\u003e Tested-by: Dan Callaghan \u003cdcallagh@chromium.org\u003e\n\u003e Reviewed-by: David Lattimore \u003cdml@chromium.org\u003e\n\u003e Commit-Queue: Dan Callaghan \u003cdcallagh@chromium.org\u003e\n\nBug: b:201365430\nChange-Id: If6df41b89fb74afc0c0517617a4d7876464a60d3\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3470074\nReviewed-by: Dan Callaghan \u003cdcallagh@chromium.org\u003e\nReviewed-by: Sergey Frolov \u003csfrolov@google.com\u003e\nTested-by: Jack Rosenthal \u003cjrosenth@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3463279","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I12c64dd00de20c7c0d3e9e1fb2bcb4e3a28ca102","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1508123":{"account":{"_account_id":1508123},"last_update":"2022-02-15 22:19:31.000000000","reason":"\u003cGERRIT_ACCOUNT_1508123\u003e replied on the change","reason_account":{"_account_id":1508123}},"1377969":{"account":{"_account_id":1377969},"last_update":"2022-02-15 20:53:56.000000000","reason":"\u003cGERRIT_ACCOUNT_1508123\u003e replied on the change","reason_account":{"_account_id":1508123}},"1458627":{"account":{"_account_id":1458627},"last_update":"2022-02-15 20:53:56.000000000","reason":"\u003cGERRIT_ACCOUNT_1508123\u003e replied on the change","reason_account":{"_account_id":1508123}}},"hashtags":[],"change_id":"I12c64dd00de20c7c0d3e9e1fb2bcb4e3a28ca102","subject":"dev-embedded/hps-sdk: add armv7a and aarch64 Linux targets","status":"MERGED","created":"2022-02-15 07:31:07.000000000","updated":"2022-02-16 20:55:59.000000000","submitted":"2022-02-16 06:25:24.000000000","submitter":{"_account_id":1111084},"insertions":406,"deletions":5,"total_comment_count":6,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3463279","meta_rev_id":"b9ab2af02aeab2ea9d623bac0480360b3a662c3d","_number":3463279,"virtual_id_number":3463279,"owner":{"_account_id":1508123},"current_revision_number":3,"current_revision":"7710f710b6e35980dd51812ed5ec7c8b38fd1c30","revisions":{"7710f710b6e35980dd51812ed5ec7c8b38fd1c30":{"kind":"REWORK","_number":3,"created":"2022-02-16 06:25:24.000000000","uploader":{"_account_id":1111084},"ref":"refs/changes/79/3463279/3","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/79/3463279/3"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/79/3463279/3"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/79/3463279/3"}},"commit":{"parents":[{"commit":"62f182598c746582dc2741856c41360628102348","subject":"Update Metadata Cache"}],"author":{"name":"Dan Callaghan","email":"dcallagh@google.com","date":"2022-02-15 08:21:47.000000000","tz":660},"committer":{"name":"Commit Bot","email":"commit-bot@chromium.org","date":"2022-02-16 06:25:24.000000000","tz":0},"subject":"dev-embedded/hps-sdk: add armv7a and aarch64 Linux targets","message":"dev-embedded/hps-sdk: add armv7a and aarch64 Linux targets\n\nAlthough HPS is not (yet) included with any ARM boards, we nevertheless\nneed to build for these targets because hps-firmware is included in\narm-generic and arm64-generic.\n\nAlso add the complete set of patches copied from dev-lang/rust, because\nthey include some import fixes which we need.\n\nBUG\u003db:201365430\nTEST\u003demerge hps-sdk\n\nChange-Id: I12c64dd00de20c7c0d3e9e1fb2bcb4e3a28ca102\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3463279\nTested-by: Dan Callaghan \u003cdcallagh@chromium.org\u003e\nReviewed-by: David Lattimore \u003cdml@chromium.org\u003e\nCommit-Queue: Dan Callaghan \u003cdcallagh@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3449597","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~Ic8b46b6168d43f06b730ee8a0f815a640b8ff645","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1508123":{"account":{"_account_id":1508123},"last_update":"2022-02-11 21:25:28.000000000","reason":"\u003cGERRIT_ACCOUNT_1508123\u003e replied on the change","reason_account":{"_account_id":1508123}},"1373235":{"account":{"_account_id":1373235},"last_update":"2022-02-09 21:23:36.000000000","reason":"\u003cGERRIT_ACCOUNT_1373235\u003e replied on the change","reason_account":{"_account_id":1373235}},"1171009":{"account":{"_account_id":1171009},"last_update":"2022-02-15 22:09:47.000000000","reason":"\u003cGERRIT_ACCOUNT_1171009\u003e replied on the change","reason_account":{"_account_id":1171009}}},"hashtags":[],"change_id":"Ic8b46b6168d43f06b730ee8a0f815a640b8ff645","subject":"dev-embedded/hps-sdk: new package","status":"MERGED","created":"2022-02-09 09:35:46.000000000","updated":"2022-02-15 22:11:32.000000000","submitted":"2022-02-12 07:41:27.000000000","submitter":{"_account_id":1111084},"insertions":203,"deletions":0,"total_comment_count":15,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3449597","meta_rev_id":"5ef73331a8bcb22f745bd8c81a7adc34e255ce30","_number":3449597,"virtual_id_number":3449597,"owner":{"_account_id":1508123},"current_revision_number":4,"current_revision":"f47f6a62fd3d33d08334500341ef330a7cc869e6","revisions":{"f47f6a62fd3d33d08334500341ef330a7cc869e6":{"kind":"REWORK","_number":4,"created":"2022-02-12 07:41:27.000000000","uploader":{"_account_id":1111084},"ref":"refs/changes/97/3449597/4","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/97/3449597/4"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/97/3449597/4"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/97/3449597/4"}},"commit":{"parents":[{"commit":"a42d25bb8cc2cbb63dc6fe98942359b0927ce077","subject":"Marking set of ebuilds as stable"}],"author":{"name":"Dan Callaghan","email":"dcallagh@google.com","date":"2022-02-09 21:43:10.000000000","tz":660},"committer":{"name":"Commit Bot","email":"commit-bot@chromium.org","date":"2022-02-12 07:41:27.000000000","tz":0},"subject":"dev-embedded/hps-sdk: new package","message":"dev-embedded/hps-sdk: new package\n\nThis package is intended to contain compilers and tools for HPS firmware\ntargetting RISC-V, which is not supported in the main Chrome OS\ntoolchain. For now this package just builds Rust, but it will eventually\nbuild a RISC-V C++ compiler too.\n\nThis ebuild is largely based on the existing dev-lang/rust ebuild, but\ncut down to the bare minimum and simplified, with some inspiration taken\nfrom dev-embedded/ti50-sdk.\n\nThis new package\u0027s installed size on disk is 307MB.\n\nBUG\u003db:201365430\nTEST\u003demerge hps-sdk\n\nChange-Id: Ic8b46b6168d43f06b730ee8a0f815a640b8ff645\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3449597\nTested-by: Dan Callaghan \u003cdcallagh@chromium.org\u003e\nReviewed-by: Alan Green \u003cavg@chromium.org\u003e\nCommit-Queue: Dan Callaghan \u003cdcallagh@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3451306","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I4efe19a362bc7fe08357283528288c647619d724","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1504745":{"account":{"_account_id":1504745},"last_update":"2022-02-11 18:27:20.000000000","reason":"\u003cGERRIT_ACCOUNT_1504745\u003e replied on the change","reason_account":{"_account_id":1504745}},"1000768":{"account":{"_account_id":1000768},"last_update":"2022-02-11 11:07:57.000000000","reason":"\u003cGERRIT_ACCOUNT_1000768\u003e replied on the change","reason_account":{"_account_id":1000768}},"1171009":{"account":{"_account_id":1171009},"last_update":"2022-02-10 00:20:41.000000000","reason":"\u003cGERRIT_ACCOUNT_1171009\u003e replied on the change","reason_account":{"_account_id":1171009}}},"hashtags":[],"change_id":"I4efe19a362bc7fe08357283528288c647619d724","subject":"sys-libs + dev-util: Add partial cros-workon to toolchain packages","status":"MERGED","created":"2022-02-09 23:40:03.000000000","updated":"2022-02-12 05:11:51.000000000","submitted":"2022-02-12 05:11:51.000000000","submitter":{"_account_id":1111084},"insertions":56,"deletions":11,"total_comment_count":9,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"3451306","meta_rev_id":"41138e430717c5e72c7506748e63b6d36eabf454","_number":3451306,"virtual_id_number":3451306,"owner":{"_account_id":1504745},"current_revision_number":4,"current_revision":"b2091e6601871c2acf482433b4217e96bae068a6","revisions":{"b2091e6601871c2acf482433b4217e96bae068a6":{"kind":"REWORK","_number":4,"created":"2022-02-12 05:11:51.000000000","uploader":{"_account_id":1111084},"ref":"refs/changes/06/3451306/4","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/06/3451306/4"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/06/3451306/4"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/06/3451306/4"}},"commit":{"parents":[{"commit":"2f984990428ec9d0992dd06b5a7e1b348e4cef41","subject":"Marking set of ebuilds as stable"}],"author":{"name":"Jordan R Abrahams","email":"ajordanr@google.com","date":"2022-02-09 21:23:39.000000000","tz":0},"committer":{"name":"Commit Bot","email":"commit-bot@chromium.org","date":"2022-02-12 05:11:51.000000000","tz":0},"subject":"sys-libs + dev-util: Add partial cros-workon to toolchain packages","message":"sys-libs + dev-util: Add partial cros-workon to toolchain packages\n\nCurrently, the packages lldb-server, compiler-rt, libcxxabi,\nllvm-libunwind must always clone down llvm-project separately. This\ncan increase download time quite significantly (llvm-project is\n~700MB).\n\nBy enabling partial cros-workon-ability, these projects can\nnow pull from a local source (src/third_party/llvm-project), which is\ndownloaded using the \u0027notdefault\u0027 repo manifest group. This means\nwe can clone from a local source on-device, when this directory\nexists.\n\nDid not successfully emerge lldb-server or llvm-libunwind, though that\u0027s\ndue to the build configuration than this actual change. They do pass\nthe prepare/configure stages, so they should be okay given the edits.\n\nMinor changes to get shellcheck to approve of libunwind and\nlibcxxabi.\n\nBUG\u003db:199918481\nTEST\u003demerge-amd64-generic sys-libs/compiler-rt \\\n                          sys-libs/libcxxabi\n\nChange-Id: I4efe19a362bc7fe08357283528288c647619d724\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/3451306\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nReviewed-by: Mike Frysinger \u003cvapier@chromium.org\u003e\nCommit-Queue: Jordan Abrahams-Whitehead \u003cajordanr@google.com\u003e\nTested-by: Jordan Abrahams-Whitehead \u003cajordanr@google.com\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~3408134","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I307be498b0c6795f9153e68c5fced1b05891ec6c","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1158719":{"account":{"_account_id":1158719},"last_update":"2022-02-04 18:43:42.000000000","reason":"\u003cGERRIT_ACCOUNT_1158719\u003e replied on the change","reason_account":{"_account_id":1158719}}},"hashtags":[],"change_id":"I307be498b0c6795f9153e68c5fced1b05891ec6c","subject":"rust: land 1.58.1","status"