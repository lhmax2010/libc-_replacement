,"_number":4730467,"virtual_id_number":4730467,"owner":{"_account_id":1504745},"current_revision_number":9,"current_revision":"4eb4cfe7274a5c29446523228a6335a4c70daeba","revisions":{"4eb4cfe7274a5c29446523228a6335a4c70daeba":{"kind":"REWORK","_number":9,"created":"2023-08-25 20:46:36.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/67/4730467/9","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/67/4730467/9"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/67/4730467/9"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/67/4730467/9"}},"commit":{"parents":[{"commit":"779660eefb8299ae6ae201107519244d2984926d","subject":"Set POSTSUBMIT_BINHOST\u003dgs://chromeos-prebuilt/board/amd64-generic/postsubmit-R118-15592.0.0-55059-8771762422853791409/packages. go/bbid/8771762422853791409"}],"author":{"name":"Jordan R Abrahams-Whitehead","email":"ajordanr@google.com","date":"2023-08-24 05:33:01.000000000","tz":0},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2023-08-25 20:46:36.000000000","tz":0},"subject":"sys-libs: llvm-libunwind-9999.ebuild version","message":"sys-libs: llvm-libunwind-9999.ebuild version\n\nThis commit migrates the llvm-libunwind package\nto an 9999 ebuild. This makes use of identical code\nto the libcxx implementation (https://crrev.com/c/4691210).\n\nBUG\u003db:275877115\nTEST\u003dcros-workon --host start sys-libs/llvm-libunwind\nTEST\u003dsetup_board --board\u003dskyrim\nTEST\u003dcros_uprev --force --overlay-type public --packages \\\n     sys-libs/llvm-libunwind\nTEST\u003dcd ~/chromiumos/src \u0026\u0026 \\\n     BOARD\u003darm64-generic bazel build @portage//sys-libs/llvm-libunwind\n\nChange-Id: I59a9898d02a4c80c94248c961be7ccf866518109\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4730467\nReviewed-by: Raul Rangel \u003crrangel@chromium.org\u003e\nCommit-Queue: Jordan Abrahams-Whitehead \u003cajordanr@google.com\u003e\nReviewed-by: George Burgess \u003cgbiv@chromium.org\u003e\nTested-by: Jordan Abrahams-Whitehead \u003cajordanr@google.com\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~4811972","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I69e6236b746cbe417f3f4f5e10bf12cc28d085c3","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1504745":{"account":{"_account_id":1504745},"last_update":"2023-08-29 02:56:55.000000000","reason":"\u003cGERRIT_ACCOUNT_1504745\u003e replied on the change","reason_account":{"_account_id":1504745}},"1000768":{"account":{"_account_id":1000768},"last_update":"2023-08-28 02:49:19.000000000","reason":"\u003cGERRIT_ACCOUNT_1000768\u003e replied on the change","reason_account":{"_account_id":1000768}},"1270601":{"account":{"_account_id":1270601},"last_update":"2023-08-28 18:41:14.000000000","reason":"\u003cGERRIT_ACCOUNT_1270601\u003e replied on the change","reason_account":{"_account_id":1270601}}},"hashtags":[],"change_id":"I69e6236b746cbe417f3f4f5e10bf12cc28d085c3","subject":"cros-llvm: Move _preclone_hook to cros-llvm.eclass","status":"MERGED","created":"2023-08-25 23:24:42.000000000","updated":"2023-08-29 08:31:24.000000000","submitted":"2023-08-29 08:31:24.000000000","submitter":{"_account_id":1530088},"insertions":22,"deletions":20,"total_comment_count":3,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"4811972","meta_rev_id":"a1cfb780d633a120f7961efde95626087fde5b06","_number":4811972,"virtual_id_number":4811972,"owner":{"_account_id":1504745},"current_revision_number":3,"current_revision":"0cc7e7b6a9732cde99f11a731c145cdc0fb6f7fa","revisions":{"0cc7e7b6a9732cde99f11a731c145cdc0fb6f7fa":{"kind":"REWORK","_number":3,"created":"2023-08-29 08:31:24.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/72/4811972/3","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/72/4811972/3"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/72/4811972/3"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/72/4811972/3"}},"commit":{"parents":[{"commit":"5127e910497218d1c7fd132fc0728a1e85a6287c","subject":"Update Metadata Cache"}],"author":{"name":"Jordan R Abrahams-Whitehead","email":"ajordanr@google.com","date":"2023-08-25 23:21:31.000000000","tz":0},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2023-08-29 08:31:24.000000000","tz":0},"subject":"cros-llvm: Move _preclone_hook to cros-llvm.eclass","message":"cros-llvm: Move _preclone_hook to cros-llvm.eclass\n\nGeneral clean-up CL, should not have any functional change.\n\nThis allows the duplicate code that every cros-llvm inheritor\nwill use for its CROS_WORKON_PRECLONE_HOOK support.\n\nBUG\u003dNone\nTEST\u003dcros-workon --host start sys-libs/libcxx \\\n     \u0026\u0026 sudo emerge sys-libs/libcxx\nTEST\u003dcros-workon --host start sys-libs/llvm-libunwind \\\n     \u0026\u0026 sudo emerge sys-libs/llvm-libunwind\n\nChange-Id: I69e6236b746cbe417f3f4f5e10bf12cc28d085c3\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4811972\nCommit-Queue: Jordan Abrahams-Whitehead \u003cajordanr@google.com\u003e\nTested-by: Jordan Abrahams-Whitehead \u003cajordanr@google.com\u003e\nReviewed-by: Mike Frysinger \u003cvapier@chromium.org\u003e\nReviewed-by: Raul Rangel \u003crrangel@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~4798997","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I09ead6f6ba7bd8fe29254e146323f1989a14946d","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1520537":{"account":{"_account_id":1520537},"last_update":"2023-08-24 03:16:04.000000000","reason":"Change was submitted"},"1158719":{"account":{"_account_id":1158719},"last_update":"2023-08-24 03:16:04.000000000","reason":"Change was submitted"},"1504745":{"account":{"_account_id":1504745},"last_update":"2023-08-24 03:16:04.000000000","reason":"Change was submitted"},"1270601":{"account":{"_account_id":1270601},"last_update":"2023-08-24 17:29:27.000000000","reason":"\u003cGERRIT_ACCOUNT_1270601\u003e replied on the change","reason_account":{"_account_id":1270601}}},"hashtags":[],"change_id":"I09ead6f6ba7bd8fe29254e146323f1989a14946d","subject":"llvm-project: Use SVN revision from ebuild version for normal builds","status":"MERGED","created":"2023-08-21 22:06:07.000000000","updated":"2023-08-24 17:29:27.000000000","submitted":"2023-08-24 03:16:04.000000000","submitter":{"_account_id":1530088},"insertions":120,"deletions":46,"total_comment_count":31,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"4798997","meta_rev_id":"42d9bbfc9e276443bbab5a5085704ef37cda6f80","_number":4798997,"virtual_id_number":4798997,"owner":{"_account_id":1270601},"current_revision_number":6,"current_revision":"dc94f8a2501cc4df1120cd6855b415a161ef1415","revisions":{"dc94f8a2501cc4df1120cd6855b415a161ef1415":{"kind":"REWORK","_number":6,"created":"2023-08-24 03:16:04.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/97/4798997/6","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/97/4798997/6"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/97/4798997/6"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/97/4798997/6"}},"commit":{"parents":[{"commit":"04158c45b4f358862391b1be4abd7b073f396658","subject":"eclass/cros-rustc: Remove dependency on LLVM .git directory"}],"author":{"name":"Raul E Rangel","email":"rrangel@chromium.org","date":"2023-08-21 19:34:35.000000000","tz":-360},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2023-08-24 03:16:04.000000000","tz":0},"subject":"llvm-project: Use SVN revision from ebuild version for normal builds","message":"llvm-project: Use SVN revision from ebuild version for normal builds\n\nWe are currently trying to stabilize our bazel CQ builder. Right now\nwe are timing out after 8 hours. We want to enable RBE caching, but we\ncan\u0027t do that because we are currently injecting the .git repository\ninto the \"llvm-project\" ebuilds. The .git repository is required because\n`get_most_recent_revision` uses it to compute the number of commits\nsince some fixed commit. The SVN revision number is actually encoded\nin the ebuild version. e.g., 17.0_pre496208 -\u003e 496208\n\nThis change makes it so that all the llvm-project ebuilds use the SVN\nrevision encoded in the ebuild version for non-9999 ebuilds, and\nnon-llvm-{next,tot} builds. For the 9999 and llvm-{next,tot} builds, we\nwill still fall back to looking at the .git repository. This means that\nwe won\u0027t be able to build these special builds using bazel for the short\nterm.\n\nThe ebuilds have a lot of 9999 logic in them, but we don\u0027t actually\nhave any 9999 ebuilds checked in (except libcxx). I\u0027m keeping this logic\nto make migrating them to 9999 easier.\n\nI also made the llvm-{next,tot} USE flags only apply to non-9999 ebuilds\nbecause it doesn\u0027t really make sense with a 9999 ebuild. I didn\u0027t do\nthis for the `llvm` ebuild because we use the USE flags in the `SRC_URI`\nvariable.\n\nI also moved the checks for \"versioned\" ebuilds into\n`get_most_recent_revision`. We could in theory also create a\n`cros-llvm-src_unpack` method, but I didn\u0027t do that in this CL to avoid\ncausing any problems for `cros-rustc.eclass` since it\u0027s a consumer of\n`cros-llvm`.\n\nBUG\u003db:267209587, b:280673549\nTEST\u003dBOARD\u003darm64-generic bazel build -k @portage//internal/sdk/stage2/target/board:aarch64-cros-linux-gnu\n\nChange-Id: I09ead6f6ba7bd8fe29254e146323f1989a14946d\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4798997\nReviewed-by: Jordan Abrahams-Whitehead \u003cajordanr@google.com\u003e\nTested-by: Raul Rangel \u003crrangel@chromium.org\u003e\nCommit-Queue: Raul Rangel \u003crrangel@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~4621261","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~Ib10393062d6f7056788de28f30c7aa332bd93f1a","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1000768":{"account":{"_account_id":1000768},"last_update":"2023-08-11 19:47:37.000000000","reason":"removed on reply"},"1330845":{"account":{"_account_id":1330845},"last_update":"2023-08-11 19:48:19.000000000","reason":"\u003cGERRIT_ACCOUNT_1330845\u003e replied on the change","reason_account":{"_account_id":1330845}}},"hashtags":[],"change_id":"Ib10393062d6f7056788de28f30c7aa332bd93f1a","subject":"sdk: Force more toolchain packages onto Python 3.8","status":"MERGED","created":"2023-06-16 21:16:32.000000000","updated":"2023-08-12 02:44:02.000000000","submitted":"2023-08-12 02:44:02.000000000","submitter":{"_account_id":1530088},"insertions":18,"deletions":1,"total_comment_count":2,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"4621261","meta_rev_id":"6b07c1e850f9081ece46c9f832414264f12ea0f4","_number":4621261,"virtual_id_number":4621261,"owner":{"_account_id":1330845},"current_revision_number":5,"current_revision":"cc7f8b14e2ec6e3e9a50496f53f0a6dd3bb7f130","revisions":{"cc7f8b14e2ec6e3e9a50496f53f0a6dd3bb7f130":{"kind":"REWORK","_number":5,"created":"2023-08-12 02:44:02.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/61/4621261/5","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/61/4621261/5"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/61/4621261/5"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/61/4621261/5"}},"commit":{"parents":[{"commit":"b3ba292f871db7b7b4be40a545b0e8b0e474a507","subject":"Set POSTSUBMIT_BINHOST\u003dgs://chromeos-prebuilt/board/arm-generic/postsubmit-R118-15576.0.0-54476-8773006082849717585/packages. go/bbid/8773006082849717585"}],"author":{"name":"Jack Rosenthal","email":"jrosenth@chromium.org","date":"2023-06-16 21:14:08.000000000","tz":-360},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2023-08-12 02:44:02.000000000","tz":0},"subject":"sdk: Force more toolchain packages onto Python 3.8","message":"sdk: Force more toolchain packages onto Python 3.8\n\nRevbump toolchain packages that we pull in as binpkgs only, and set\nuse flags to change to Python 3.8.\n\nBUG\u003db:187794810\nTEST\u003dmonitor SDK builder after submission\n\nChange-Id: Ib10393062d6f7056788de28f30c7aa332bd93f1a\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4621261\nCommit-Queue: Mike Frysinger \u003cvapier@chromium.org\u003e\nTested-by: Jack Rosenthal \u003cjrosenth@chromium.org\u003e\nReviewed-by: Mike Frysinger \u003cvapier@chromium.org\u003e\nCommit-Queue: Jack Rosenthal \u003cjrosenth@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~4736263","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~Ifd2d369c07cc7ad4d3711386f705e6923ac59970","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1504745":{"account":{"_account_id":1504745},"last_update":"2023-08-03 20:37:59.000000000","reason":"\u003cGERRIT_ACCOUNT_1504745\u003e replied on the change","reason_account":{"_account_id":1504745}},"1000768":{"account":{"_account_id":1000768},"last_update":"2023-08-01 14:44:30.000000000","reason":"removed on reply"},"1171009":{"account":{"_account_id":1171009},"last_update":"2023-08-01 01:15:12.000000000","reason":"\u003cGERRIT_ACCOUNT_1171009\u003e replied on the change","reason_account":{"_account_id":1171009}}},"hashtags":[],"change_id":"Ifd2d369c07cc7ad4d3711386f705e6923ac59970","subject":"sys-devel: Fix one letter typo in crossdev XPKGS","status":"MERGED","created":"2023-08-01 01:14:23.000000000","updated":"2023-08-04 20:08:43.000000000","submitted":"2023-08-04 20:08:43.000000000","submitter":{"_account_id":1504745},"insertions":4,"deletions":4,"total_comment_count":4,"unresolved_comment_count":0,"has_review_started":true,"submission_id":"4736263","meta_rev_id":"bd10a3d6f3c19c9bd5ae0a5c3717823607172c95","_number":4736263,"virtual_id_number":4736263,"owner":{"_account_id":1504745},"current_revision_number":3,"current_revision":"e4c5af49fbfbe878c9f6f770f6393a83b14e342d","revisions":{"e4c5af49fbfbe878c9f6f770f6393a83b14e342d":{"kind":"REWORK","_number":3,"created":"2023-08-04 20:08:43.000000000","uploader":{"_account_id":1504745},"ref":"refs/changes/63/4736263/3","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/63/4736263/3"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/63/4736263/3"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/63/4736263/3"}},"commit":{"parents":[{"commit":"5327367cfdac721fe9b745118d8b05fb17dfb2c8","subject":"Set POSTSUBMIT_BINHOST\u003dgs://chromeos-prebuilt/board/tatl/postsubmit-R117-15568.0.0-54164-8773666461602645697/packages. go/bbid/8773666461602645697"}],"author":{"name":"Jordan R Abrahams-Whitehead","email":"ajordanr@google.com","date":"2023-08-01 01:06:25.000000000","tz":0},"committer":{"name":"Jordan Abrahams-Whitehead","email":"ajordanr@google.com","date":"2023-08-04 20:08:43.000000000","tz":0},"subject":"sys-devel: Fix one letter typo in crossdev XPKGS","message":"sys-devel: Fix one letter typo in crossdev XPKGS\n\nTracking down why the package.accepted_keywords was still\nputting in the unstable ARCH values in the keyword files lead\nme to this typo.\n\nBUG\u003db:293898274\nTEST\u003drm /etc/portage/package.accept_keywords/cross-armv7m-cros-eabi\n     \u0026\u0026 crossdev --stable --show-fail-log --env \u0027FEATURES\u003dsplitdebug\u0027 \\\n     -P --oneshot \\\n     --overlays \\\n     \u0027/mnt/host/source/src/third_party/chromiumos-overlay /mnt/host/source/src/third_party/eclass-overlay /mnt/host/source/src/third_party/portage-stable\u0027 \\\n     --ov-output /usr/local/portage/crossdev \\\n     -t armv7m-cros-eabi \\\n     --ex-pkg sys-libs/compiler-rt \\\n     --ex-pkg sys-libs/llvm-libunwind \\\n     --ex-pkg sys-libs/libcxx \\\n     --binutils \u0027[stable]\u0027 \\\n     --gcc \u0027[stable]\u0027 \\\n     --libc \u0027[stable]\u0027 \\\n     --ex-gdb\n\nDisallow-Recycled-Builds: test-failures\nChange-Id: Ifd2d369c07cc7ad4d3711386f705e6923ac59970\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4736263\nTested-by: Jordan Abrahams-Whitehead \u003cajordanr@google.com\u003e\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\nReviewed-by: Mike Frysinger \u003cvapier@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~4740204","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~stabilize-15564.B~Ifd2d369c07cc7ad4d3711386f705e6923ac59970","project":"chromiumos/overlays/chromiumos-overlay","branch":"stabilize-15564.B"