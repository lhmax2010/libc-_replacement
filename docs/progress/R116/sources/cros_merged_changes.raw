ccount":{"_account_id":1171009},"last_update":"2023-03-30 23:17:02.000000000","reason":"\u003cGERRIT_ACCOUNT_1171009\u003e replied on the change","reason_account":{"_account_id":1171009}}},"hashtags":[],"change_id":"I270dad362452549d976b06cacb990c5033b8256f","subject":"sys-libs/{libcxx,llvm-libunwind}: Add glibc as a DEPEND","status":"MERGED","created":"2023-03-30 16:18:36.000000000","updated":"2023-03-31 09:27:50.000000000","submitted":"2023-03-31 09:27:50.000000000","submitter":{"_account_id":1530088},"insertions":4,"deletions":0,"total_comment_count":2,"unresolved_comment_count":1,"has_review_started":true,"submission_id":"4384865","meta_rev_id":"e5ac75a2c6c6c0134881c99508e01d07c8c79dec","_number":4384865,"virtual_id_number":4384865,"owner":{"_account_id":1270601},"current_revision_number":5,"current_revision":"016ceabf44e4019ef91f57d13c16d2445eec7c48","revisions":{"016ceabf44e4019ef91f57d13c16d2445eec7c48":{"kind":"REWORK","_number":5,"created":"2023-03-31 09:27:50.000000000","uploader":{"_account_id":1530088},"ref":"refs/changes/65/4384865/5","fetch":{"repo":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/65/4384865/5"},"http":{"url":"https://chromium.googlesource.com/chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/65/4384865/5"},"depot_tools":{"url":"chromiumos/overlays/chromiumos-overlay","ref":"refs/changes/65/4384865/5"}},"commit":{"parents":[{"commit":"ce89be9778a08833b0c68fa196332a6ce69018ba","subject":"Set POSTSUBMIT_BINHOST\u003dgs://chromeos-prebuilt/board/arm64-generic/postsubmit-R114-15406.0.0-48696-8785121698713248305/packages. go/bbid/8785121698713248305"}],"author":{"name":"Raul E Rangel","email":"rrangel@chromium.org","date":"2023-03-30 16:16:42.000000000","tz":-360},"committer":{"name":"Chromeos LUCI","email":"chromeos-scoped@luci-project-accounts.iam.gserviceaccount.com","date":"2023-03-31 09:27:50.000000000","tz":0},"subject":"sys-libs/{libcxx,llvm-libunwind}: Add glibc as a DEPEND","message":"sys-libs/{libcxx,llvm-libunwind}: Add glibc as a DEPEND\n\nThese are primordial packages that we use to bootstrap the system. We\nneed to add the glibc dependency so that the packages get built in the\ncorrect order.\n\nThis should be a nop for the portage build since glibc is added\ninto package.provided by setup_board.\n\nI\u0027m not sure how the cross- packages work. Do we need to have glibc\nlisted there?\n\nBUG\u003db:266979761\nTEST\u003dBOARD\u003darm64-generic bazel build -k --config\u003dprebuilts/arm64-generic  --//bazel/sdk:new-sdk @portage//virtual/target-os:all\n\nChange-Id: I270dad362452549d976b06cacb990c5033b8256f\nReviewed-on: https://chromium-review.googlesource.com/c/chromiumos/overlays/chromiumos-overlay/+/4384865\nTested-by: Raul Rangel \u003crrangel@chromium.org\u003e\nCommit-Queue: Raul Rangel \u003crrangel@chromium.org\u003e\nReviewed-by: Manoj Gupta \u003cmanojgupta@chromium.org\u003e\n"},"branch":"refs/heads/main","description":"Rebase"}}},{"id":"chromiumos%2Foverlays%2Fchromiumos-overlay~4157471","triplet_id":"chromiumos%2Foverlays%2Fchromiumos-overlay~main~I4658e5a69c1e7d94061a6cbe0c2caf252d6ff662","project":"chromiumos/overlays/chromiumos-overlay","branch":"main","full_branch":"refs/heads/main","attention_set":{},"removed_from_attention_set":{"1171009":{"account":{"_account_id":1171009},"last_update":"2023-03-29 16:47:09.000000000","reason":"\u003cGERRIT_ACCOUNT_1171009\u003e replied on the change","reason_account":{"_account_id":1171009}},"1474597":{"account":{"_account_id":1474597},"last_update":"2023-03-29 21:23:05.000000000","reason":"Change was submitted"},"1222289":{"account":{"_account_id":1222289},"last_update":"2023-03-29 21:19:14.000000000","reason":"\u003cGERRIT_ACCOUNT_1222289\u003e replied on the change","reason_account":{"_account_id":1222289}}},"hashtags":[],"change_id":"I4658e5a69c1e7d94061a6cbe0c2caf252d6ff662","subject":"llvm-next: upgrade to 2916b99182752b1aece8cc4479d8d6a20b5e02da (r484197)","status":"MERGED","created":"2023-01-11 17:1