    50	class _LIBCPP_EXPORTED_FROM_ABI bad_function_call : public exception {
    51	public:
    52	  _LIBCPP_HIDE_FROM_ABI bad_function_call() _NOEXCEPT                                    = default;
    53	  _LIBCPP_HIDE_FROM_ABI bad_function_call(const bad_function_call&) _NOEXCEPT            = default;
    54	  _LIBCPP_HIDE_FROM_ABI bad_function_call& operator=(const bad_function_call&) _NOEXCEPT = default;
    55	// Note that when a key function is not used, every translation unit that uses
    56	// bad_function_call will end up containing a weak definition of the vtable and
    57	// typeinfo.
    58	#  if _LIBCPP_AVAILABILITY_HAS_BAD_FUNCTION_CALL_KEY_FUNCTION
