    43	template <size_t _Len, size_t _Align = __aligned_storage_alignment<_Len> >
    44	struct _LIBCPP_DEPRECATED_IN_CXX23 _LIBCPP_NO_SPECIALIZATIONS aligned_storage {
    45	  union _ALIGNAS(_Align) type {
    46	    unsigned char __data[(_Len + _Align - 1) / _Align * _Align];
    47	  };
    48	};
