    60	#  else
    61	  _LIBCPP_HIDE_FROM_ABI_VIRTUAL ~bad_function_call() _NOEXCEPT override {}
    62	#  endif
    63	
    64	#  if _LIBCPP_AVAILABILITY_HAS_BAD_FUNCTION_CALL_GOOD_WHAT_MESSAGE
    65	  const char* what() const _NOEXCEPT override;
    66	#  endif
