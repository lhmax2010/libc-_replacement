   104	    _Base_ptr		_M_left;
   105	    _Base_ptr		_M_right;
   106	
   107	    static _Base_ptr
   108	    _S_minimum(_Base_ptr __x) _GLIBCXX_NOEXCEPT
   109	    {
   110	      while (__x->_M_left != 0) __x = __x->_M_left;
