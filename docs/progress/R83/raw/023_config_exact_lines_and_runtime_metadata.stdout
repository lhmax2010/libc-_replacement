    44	Macros:
    45	%release_name Tizen11.0/Unified
    46	
    47	%tizen_version_major 11
    48	%tizen_version_minor 0
   120	%__ar_clang llvm-ar
   121	%__ranlib_clang llvm-ranlib
   122	%__cc_clang %{_host}-clang
   123	%__cxx_clang %{_host}-clang++
   124	%__optflags_toolchain_clang -Os -fstack-protector -Wno-unused-command-line-argument -Wno-error=unused-but-set-variable -Wno-error=unused-command-line-argument %{?___optflags_toolchain_clang:%{___optflags_toolchain_clang}}
   125	
   126	# gcc utils
   127	%__ar_gcc gcc-ar
   128	%__ranlib_gcc gcc-ranlib
   129	%__cc_gcc %{_host}-gcc
   130	%__cxx_gcc %{_host}-g++
