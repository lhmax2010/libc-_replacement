   132	
   133	%_toolchain %{?_toolchain_override}%{!?_toolchain_override:clang}
   134	%toolchain_is() %((echo "%_toolchain" | %{__grep} -qE "%{1}") && echo 1 || echo 0)
   135	
   136	%__ar %{expand:%%{__ar_%{_toolchain}}}
   137	%__ranlib %{expand:%%{__ranlib_%{_toolchain}}}
   138	%__cc %{expand:%%{__cc_%{_toolchain}}}
