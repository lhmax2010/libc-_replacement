  1710	
  1711	add_custom_target(generate-cxx-headers ALL DEPENDS ${_all_includes})
  1712	
  1713	add_library(cxx-headers INTERFACE)
  1714	target_link_libraries(cxx-headers INTERFACE runtimes-libc-headers libcxx-abi-headers)
  1715	add_dependencies(cxx-headers generate-cxx-headers)
  1716	# It's important that the arch directory be included first so that its header files
  1717	# which interpose on the default include dir be included instead of the default ones.
  1718	target_include_directories(cxx-headers INTERFACE ${LIBCXX_GENERATED_INCLUDE_TARGET_DIR}
  1719	                                                 ${LIBCXX_GENERATED_INCLUDE_DIR})
  1720	
  1721	# Make sure to map the generated include directory back to libc++'s actual source directory when generating
  1722	# debug information. Otherwise, the debug information will refer to generated headers which are created during
  1723	# the build and generally not persistent.
  1724	target_add_compile_flags_if_supported(cxx-headers INTERFACE "-fdebug-prefix-map=${LIBCXX_GENERATED_INCLUDE_DIR}=${LIBCXX_SOURCE_DIR}/include")
  1725	
  1726	if (LIBCXX_INSTALL_HEADERS)
  1727	  foreach(file ${files})
  1728	    get_filename_component(dir ${file} DIRECTORY)
  1729	    install(FILES ${file}
  1730	      DESTINATION "${LIBCXX_INSTALL_INCLUDE_DIR}/${dir}"
  1731	      COMPONENT cxx-headers
  1732	      PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ
  1733	    )
  1734	  endforeach()
  1735	
  1736	  # Install the generated __config_site file to the per-target include dir.
  1737	  install(FILES "${LIBCXX_GENERATED_INCLUDE_TARGET_DIR}/__config_site"
  1738	    DESTINATION "${LIBCXX_INSTALL_INCLUDE_TARGET_DIR}"
  1739	    PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ
  1740	    COMPONENT cxx-headers)
  1741	
  1742	  # Install the generated __assertion_handler file to the generic include dir.
  1743	  install(FILES "${LIBCXX_GENERATED_INCLUDE_DIR}/__assertion_handler"
  1744	    DESTINATION "${LIBCXX_INSTALL_INCLUDE_DIR}"
  1745	    PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ
  1746	    COMPONENT cxx-headers)
  1747	
  1748	  # Install the generated IWYU file to the generic include dir.
  1749	  install(FILES "${LIBCXX_GENERATED_INCLUDE_DIR}/libcxx.imp"
  1750	    DESTINATION "${LIBCXX_INSTALL_INCLUDE_DIR}"
  1751	    PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ
  1752	    COMPONENT cxx-headers)
  1753	
  1754	  # Install the generated modulemap file to the generic include dir.
  1755	  install(FILES "${LIBCXX_GENERATED_INCLUDE_DIR}/module.modulemap"
  1756	    DESTINATION "${LIBCXX_INSTALL_INCLUDE_DIR}"
  1757	    PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ
  1758	    COMPONENT cxx-headers)
  1759	
  1760	  if (NOT CMAKE_CONFIGURATION_TYPES)
  1761	    add_custom_target(install-cxx-headers
  1762	      DEPENDS cxx-headers
  1763	      COMMAND "${CMAKE_COMMAND}" --install "${CMAKE_BINARY_DIR}" --component cxx-headers)
  1764	    # Stripping is a no-op for headers
  1765	    add_custom_target(install-cxx-headers-stripped DEPENDS install-cxx-headers)
