===== packaging/libcxx-runtimes.spec =====
     1	%define llvm_major 22
     2	%define llvm_version 22.1.8
     3	
     4	Name:           libcxx-runtimes
     5	Version:        22.1.8
     6	Release:        1
     7	ExclusiveArch:  armv7l aarch64 x86_64
     8	Summary:        LLVM libc++ and libc++abi runtimes
     9	Group:          Development/Toolchain
    10	License:        Apache-2.0 WITH LLVM-exception
    11	URL:            https://llvm.org/
    12	Source0:        llvm-%{version}.tar.gz
    13	Source1:        libcxx-llvm22.map
    14	Source2:        libcxx-runtimes.manifest
    15	Source3:        SOURCE_PROVENANCE
    16	
    17	BuildRequires:  clang = %{version}
    18	BuildRequires:  cmake
    19	BuildRequires:  ninja
    20	BuildRequires:  python3
    21	BuildRequires:  glibc-devel
    22	BuildRequires:  libgcc
    23	
    24	%description
    25	Source package for the LLVM libc++ standard library and libc++abi runtime.
    26	The libraries use libgcc_s as the unwinder and export only default-version
    27	LLVM_22 symbols.
    28	
    29	%package -n libc++
    30	Summary:        LLVM C++ standard library runtime
    31	Requires:       libc++abi = %{version}-%{release}
    32	
    33	%description -n libc++
    34	Shared LLVM libc++ runtime, built against libc++abi and libgcc_s.
    35	
    36	%package -n libc++-devel
    37	Summary:        LLVM C++ standard library headers and development files
    38	Requires:       libc++ = %{version}-%{release}
    39	Requires:       libc++abi-devel = %{version}-%{release}
    40	
    41	%description -n libc++-devel
    42	Headers, ABI linker script, module metadata, and development files for LLVM
    43	libc++.
    44	
    45	%package -n libc++abi
    46	Summary:        LLVM C++ ABI runtime
    47	
    48	%description -n libc++abi
    49	Shared LLVM libc++abi runtime using libgcc_s rather than LLVM libunwind.
    50	
    51	%package -n libc++abi-devel
    52	Summary:        LLVM C++ ABI development files
    53	Requires:       libc++abi = %{version}-%{release}
    54	
    55	%description -n libc++abi-devel
    56	Linker name for LLVM libc++abi.  Its public headers are installed in the
    57	common c++/v1 tree shipped by libc++-devel.
    58	
    59	%prep
    60	%setup -q -n llvm-%{version}
    61	cp %{SOURCE2} .
    62	cp %{SOURCE3} .
    63	
    64	%build
    65	mkdir -p build
    66	cd build
    67	
    68	cmake -G Ninja \
    69	  -DCMAKE_BUILD_TYPE=Release \
    70	  -DCMAKE_C_COMPILER=%{__cc} \
    71	  -DCMAKE_CXX_COMPILER=%{__cxx} \
    72	  -DCMAKE_ASM_COMPILER=%{__cc} \
    73	  -DCMAKE_C_COMPILER_TARGET=%{_host} \
    74	  -DCMAKE_CXX_COMPILER_TARGET=%{_host} \
    75	  -DCMAKE_ASM_COMPILER_TARGET=%{_host} \
    76	  -DCMAKE_C_FLAGS="$CFLAGS --rtlib=libgcc" \
    77	  -DCMAKE_CXX_FLAGS="$CXXFLAGS --rtlib=libgcc" \
    78	  -DCMAKE_ASM_FLAGS="$CFLAGS" \
    79	  -DCMAKE_SHARED_LINKER_FLAGS="-Wl,--version-script=%{SOURCE1} -Wl,-z,now --rtlib=libgcc" \
    80	  -DCMAKE_EXE_LINKER_FLAGS="--rtlib=libgcc" \
    81	  -DCMAKE_INSTALL_PREFIX=%{_prefix} \
    82	  -DCMAKE_INSTALL_LIBDIR=%{_lib} \
    83	  -DLIBCXX_INSTALL_LIBRARY_DIR=%{_lib} \
    84	  -DLIBCXXABI_INSTALL_LIBRARY_DIR=%{_lib} \
    85	  -DLLVM_ENABLE_RUNTIMES="libcxxabi;libcxx" \
    86	  -DLLVM_DEFAULT_TARGET_TRIPLE=%{_host} \
    87	  -DLLVM_INCLUDE_TESTS=OFF \
    88	  -DLIBCXX_ENABLE_SHARED=ON \
    89	  -DLIBCXX_ENABLE_STATIC=OFF \
    90	  -DLIBCXX_INSTALL_SHARED_LIBRARY=ON \
    91	  -DLIBCXX_INSTALL_STATIC_LIBRARY=OFF \
    92	  -DLIBCXX_CXX_ABI=libcxxabi \
    93	  -DLIBCXX_ENABLE_STATIC_ABI_LIBRARY=OFF \
    94	  -DLIBCXX_ENABLE_ABI_LINKER_SCRIPT=ON \
    95	  -DLIBCXX_USE_COMPILER_RT=OFF \
    96	  -DLIBCXXABI_ENABLE_SHARED=ON \
    97	  -DLIBCXXABI_ENABLE_STATIC=OFF \
    98	  -DLIBCXXABI_INSTALL_SHARED_LIBRARY=ON \
    99	  -DLIBCXXABI_INSTALL_STATIC_LIBRARY=OFF \
   100	  -DLIBCXXABI_USE_COMPILER_RT=OFF \
   101	  -DLIBCXXABI_USE_LLVM_UNWINDER=OFF \
   102	  -DLIBCXXABI_ENABLE_STATIC_UNWINDER=OFF \
   103	  -DLIBCXXABI_STATICALLY_LINK_UNWINDER_IN_SHARED_LIBRARY=OFF \
   104	  -DLIBCXXABI_STATICALLY_LINK_UNWINDER_IN_STATIC_LIBRARY=OFF \
   105	  -DLIBCXXABI_ENABLE_NEW_DELETE_DEFINITIONS=ON \
   106	  -DLIBCXX_INCLUDE_TESTS=OFF \
   107	  -DLIBCXXABI_INCLUDE_TESTS=OFF \
   108	  -DLIBCXX_INCLUDE_BENCHMARKS=OFF \
   109	  ../runtimes
   110	
   111	cmake --build . --target cxxabi cxx cxx_experimental %{?_smp_mflags}
   112	
   113	%install
   114	cd build
   115	DESTDIR=%{buildroot} cmake --install .
   116	
   117	install -d %{buildroot}%{_datadir}/doc/%{name}
   118	install -m 0644 ../SOURCE_PROVENANCE \
   119	  %{buildroot}%{_datadir}/doc/%{name}/SOURCE_PROVENANCE
   120	
   121	%files -n libc++
   122	%manifest %{name}.manifest
   123	%defattr(-,root,root,-)
   124	%license libcxx/LICENSE.TXT
   125	%{_libdir}/libc++.so.1*
   126	
   127	%files -n libc++-devel
   128	%manifest %{name}.manifest
   129	%defattr(-,root,root,-)
   130	%{_includedir}/c++/v1
   131	%{_libdir}/libc++.so
   132	%{_libdir}/libc++experimental.a
   133	%{_libdir}/libc++.modules.json
   134	%{_datadir}/libc++/v1
   135	%{_datadir}/doc/%{name}/SOURCE_PROVENANCE
   136	
   137	%files -n libc++abi
   138	%manifest %{name}.manifest
   139	%defattr(-,root,root,-)
   140	%license libcxxabi/LICENSE.TXT
   141	%{_libdir}/libc++abi.so.1*
   142	
   143	%files -n libc++abi-devel
   144	%manifest %{name}.manifest
   145	%defattr(-,root,root,-)
   146	%{_libdir}/libc++abi.so
   147	
   148	%changelog
   149	* Tue Aug 04 2026 Toolchain ABI Team <toolchain@example.invalid> 22.1.8-1
   150	- Migrate to the verbatim platform llvm-22.1.8 source tarball and LLVM_22 symbol node.
   151	- Preserve the adjudicated 21.1.1 multi-architecture packaging decisions.
   152	
   153	* Sat Jul 25 2026 Toolchain ABI Team <toolchain@example.invalid> 21.1.1-2
   154	- Build armv7l, aarch64, and x86_64 repository-candidate runtimes.
   155	
   156	* Thu Jul 23 2026 Toolchain ABI Team <toolchain@example.invalid> 21.1.1-1
   157	- Initial armv7l PoC packaging with LLVM_21 default symbol versions.
