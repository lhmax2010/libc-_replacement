    libcxx: preserve forced unwind across header catch-all sites
    
    Add a __forced_unwind handler before the catch-all handlers in the
    consumer-instantiated istream, future, and string paths. The handler
    preserves each path's existing state update where applicable and
    rethrows so POSIX cancellation can continue unwinding.
    
    This follows the corresponding libstdc++ guard shape. It depends on a
    libc++abi that exposes the GNU-compatible __forced_unwind type and
    correctly resumes foreign forced unwinds.
    
    Validated on x86_64 and ARMv7l for blocking getline and packaged_task
    cancellation, plus selected upstream iostream, future, and string tests.
    Not covered: AArch64, LTO, concurrent cancellation stress, or mixed
    runtime frame traversal beyond the validation cases.
    
    中文说明：在消费者实例化的 istream、future 与 string 头文件路径中，
    于 catch-all 前加入 forced-unwind 重抛防护；保持原有状态设置语义，
    并依赖 libc++abi 提供兼容类型与正确的外来强制展开重抛支持。

diff --git a/libcxx/include/future b/libcxx/include/future
index 4cd5e8a..a6b89e8 100644
--- a/libcxx/include/future
+++ b/libcxx/include/future
@@ -367,6 +367,7 @@ template <class R, class Alloc> struct uses_allocator<packaged_task<R>, Alloc>;
 
 #  if _LIBCPP_HAS_THREADS
 
+#    include <cxxabi.h>
 #    include <__assert>
 #    include <__chrono/duration.h>
 #    include <__chrono/steady_clock.h>
@@ -789,6 +790,8 @@ void __deferred_assoc_state<_Rp, _Fp>::__execute() {
 #    endif // _LIBCPP_HAS_EXCEPTIONS
     this->set_value(__func_());
 #    if _LIBCPP_HAS_EXCEPTIONS
+  } catch (const __cxxabiv1::__forced_unwind&) {
+    throw;
   } catch (...) {
     this->set_exception(current_exception());
   }
@@ -820,6 +823,8 @@ void __deferred_assoc_state<void, _Fp>::__execute() {
     __func_();
     this->set_value();
 #    if _LIBCPP_HAS_EXCEPTIONS
+  } catch (const __cxxabiv1::__forced_unwind&) {
+    throw;
   } catch (...) {
     this->set_exception(current_exception());
   }
@@ -850,6 +855,8 @@ void __async_assoc_state<_Rp, _Fp>::__execute() {
 #    endif // _LIBCPP_HAS_EXCEPTIONS
     this->set_value(__func_());
 #    if _LIBCPP_HAS_EXCEPTIONS
+  } catch (const __cxxabiv1::__forced_unwind&) {
+    throw;
   } catch (...) {
     this->set_exception(current_exception());
   }
@@ -887,6 +894,8 @@ void __async_assoc_state<void, _Fp>::__execute() {
     __func_();
     this->set_value();
 #    if _LIBCPP_HAS_EXCEPTIONS
+  } catch (const __cxxabiv1::__forced_unwind&) {
+    throw;
   } catch (...) {
     this->set_exception(current_exception());
   }
@@ -1661,6 +1670,8 @@ void packaged_task<_Rp(_ArgTypes...)>::operator()(_ArgTypes... __args) {
 #    endif // _LIBCPP_HAS_EXCEPTIONS
     __p_.set_value(__f_(std::forward<_ArgTypes>(__args)...));
 #    if _LIBCPP_HAS_EXCEPTIONS
+  } catch (const __cxxabiv1::__forced_unwind&) {
+    throw;
   } catch (...) {
     __p_.set_exception(current_exception());
   }
@@ -1678,6 +1689,8 @@ void packaged_task<_Rp(_ArgTypes...)>::make_ready_at_thread_exit(_ArgTypes... __
 #    endif // _LIBCPP_HAS_EXCEPTIONS
     __p_.set_value_at_thread_exit(__f_(std::forward<_ArgTypes>(__args)...));
 #    if _LIBCPP_HAS_EXCEPTIONS
+  } catch (const __cxxabiv1::__forced_unwind&) {
+    throw;
   } catch (...) {
     __p_.set_exception_at_thread_exit(current_exception());
   }
@@ -1761,6 +1774,8 @@ void packaged_task<void(_ArgTypes...)>::operator()(_ArgTypes... __args) {
     __f_(std::forward<_ArgTypes>(__args)...);
     __p_.set_value();
 #    if _LIBCPP_HAS_EXCEPTIONS
+  } catch (const __cxxabiv1::__forced_unwind&) {
+    throw;
   } catch (...) {
     __p_.set_exception(current_exception());
   }
@@ -1779,6 +1794,8 @@ void packaged_task<void(_ArgTypes...)>::make_ready_at_thread_exit(_ArgTypes... _
     __f_(std::forward<_ArgTypes>(__args)...);
     __p_.set_value_at_thread_exit();
 #    if _LIBCPP_HAS_EXCEPTIONS
+  } catch (const __cxxabiv1::__forced_unwind&) {
+    throw;
   } catch (...) {
     __p_.set_exception_at_thread_exit(current_exception());
   }
@@ -1862,6 +1879,8 @@ async(launch __policy, _Fp&& __f, _Args&&... __args) {
     if (__does_policy_contain(__policy, launch::async))
       return std::__make_async_assoc_state<_Rp>(_BF(std::forward<_Fp>(__f), std::forward<_Args>(__args)...));
 #      if _LIBCPP_HAS_EXCEPTIONS
+  } catch (const __cxxabiv1::__forced_unwind&) {
+    throw;
   } catch (...) {
     if (__policy == launch::async)
       throw;
