    92	#else
    93	  _Unwind_RaiseException (&header->exc.unwindHeader);
    94	#endif
    95	
    96	  // Some sort of unwinding error.  Note that terminate is a handler.
    97	  __cxa_begin_catch (&header->exc.unwindHeader);
    98	  std::terminate ();
    99	}
