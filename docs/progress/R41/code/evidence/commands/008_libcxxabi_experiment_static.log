   630	/*
   631	    There are 3 types of scans needed:
   632	
   633	    1.  Scan for handler with native or foreign exception.  If handler found,
   634	        save state and return _URC_HANDLER_FOUND, else return _URC_CONTINUE_UNWIND.
   635	        May also report an error on invalid input.
   636	        May terminate for invalid exception table.
   637	        _UA_SEARCH_PHASE
   638	
   639	    2.  Scan for handler with foreign exception.  Must return _URC_HANDLER_FOUND,
   640	        or call terminate.
   641	        _UA_CLEANUP_PHASE && _UA_HANDLER_FRAME && !native_exception
   642	
   643	    3.  Scan for cleanups.  If a handler is found and this isn't forced unwind,
   644	        then terminate, otherwise ignore the handler and keep looking for cleanup.
   645	        If a cleanup is found, return _URC_HANDLER_FOUND, else return _URC_CONTINUE_UNWIND.
   646	        May also report an error on invalid input.
   647	        May terminate for invalid exception table.
   648	        _UA_CLEANUP_PHASE && !_UA_HANDLER_FRAME
   649	*/
   650	
   651	static void scan_eh_tab(scan_results &results, _Unwind_Action actions,
   652	                        bool native_exception,
   653	                        _Unwind_Exception *unwind_exception,
   654	                        _Unwind_Context *context) {
   655	    // Initialize results to found nothing but an error
   656	    results.ttypeIndex = 0;
   657	    results.actionRecord = 0;
   658	    results.languageSpecificData = 0;
   659	    results.landingPad = 0;
   660	    results.adjustedPtr = 0;
   661	    results.reason = _URC_FATAL_PHASE1_ERROR;
   662	    // Check for consistent actions
   663	    if (actions & _UA_SEARCH_PHASE)
   664	    {
   665	        // Do Phase 1
   666	        if (actions & (_UA_CLEANUP_PHASE | _UA_HANDLER_FRAME | _UA_FORCE_UNWIND))
   667	        {
   668	            // None of these flags should be set during Phase 1
   669	            //   Client error
   670	            results.reason = _URC_FATAL_PHASE1_ERROR;
   671	            return;
   672	        }
   673	    }
   674	    else if (actions & _UA_CLEANUP_PHASE)
   675	    {
   676	        if ((actions & _UA_HANDLER_FRAME) && (actions & _UA_FORCE_UNWIND))
   677	        {
   678	            // _UA_HANDLER_FRAME should only be set if phase 1 found a handler.
   679	            // If _UA_FORCE_UNWIND is set, phase 1 shouldn't have happened.
   680	            //    Client error
   681	            results.reason = _URC_FATAL_PHASE2_ERROR;
   682	            return;
   683	        }
   684	    }
   685	    else // Neither _UA_SEARCH_PHASE nor _UA_CLEANUP_PHASE is set
   686	    {
   687	        // One of these should be set.
   688	        //   Client error
   689	        results.reason = _URC_FATAL_PHASE1_ERROR;
   690	        return;
   691	    }
   692	    // Start scan by getting exception table address.
   693	    const uint8_t *lsda = (const uint8_t *)_Unwind_GetLanguageSpecificData(context);
   694	    if (lsda == 0)
   695	    {
   696	        // There is no exception table
   697	        results.reason = _URC_CONTINUE_UNWIND;
   698	        return;
   699	    }
   700	    results.languageSpecificData = lsda;
   701	#if defined(_AIX)
   702	    uintptr_t base = _Unwind_GetDataRelBase(context);
   703	#else
   704	    uintptr_t base = 0;
   705	#endif
   706	    // Get the current instruction pointer and offset it before next
   707	    // instruction in the current frame which threw the exception.
   708	    uintptr_t ip = _Unwind_GetIP(context) - 1;
   709	    // Get beginning current frame's code (as defined by the
   710	    // emitted dwarf code)
   711	    uintptr_t funcStart = _Unwind_GetRegionStart(context);
   712	#if defined(__USING_SJLJ_EXCEPTIONS__) || defined(__WASM_EXCEPTIONS__)
   713	    if (ip == uintptr_t(-1))
   714	    {
   715	        // no action
   716	        results.reason = _URC_CONTINUE_UNWIND;
   717	        return;
   718	    }
   719	    else if (ip == 0)
   720	        call_terminate(native_exception, unwind_exception);
   721	    // ip is 1-based index into call site table
   722	#else  // !__USING_SJLJ_EXCEPTIONS__ && !__WASM_EXCEPTIONS__
   723	    uintptr_t ipOffset = ip - funcStart;
   724	#endif // !__USING_SJLJ_EXCEPTIONS__ && !__WASM_EXCEPTIONS__
   725	    const uint8_t* classInfo = NULL;
   726	    // Note: See JITDwarfEmitter::EmitExceptionTable(...) for corresponding
   727	    //       dwarf emission
   728	    // Parse LSDA header.
   729	    uint8_t lpStartEncoding = *lsda++;
   730	    const uint8_t* lpStart = lpStartEncoding == DW_EH_PE_omit
   731	                                 ? (const uint8_t*)funcStart
   732	                                 : (const uint8_t*)readEncodedPointer(&lsda, lpStartEncoding, base);
