   648	                "R40_RETHROW_STATE arch=armv7l reserved1=0x%lx reserved4=0x%lx unwind=%p\n",
   649	                static_cast<unsigned long>(exception_header->unwindHeader.unwinder_cache.reserved1),
   650	                static_cast<unsigned long>(exception_header->unwindHeader.unwinder_cache.reserved4),
   651	                static_cast<void*>(&exception_header->unwindHeader));
   652	#else
   653	        fprintf(stderr,
   654	                "R40_RETHROW_STATE arch=x86_64 private_1=0x%lx private_2=0x%lx unwind=%p\n",
   655	                static_cast<unsigned long>(exception_header->unwindHeader.private_1),
   656	                static_cast<unsigned long>(exception_header->unwindHeader.private_2),
