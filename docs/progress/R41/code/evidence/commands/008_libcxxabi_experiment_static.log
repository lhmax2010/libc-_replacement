   734	    if (ttypeEncoding != DW_EH_PE_omit)
   735	    {
   736	        // Calculate type info locations in emitted dwarf code which
   737	        // were flagged by type info arguments to llvm.eh.selector
   738	        // intrinsic
   739	        uintptr_t classInfoOffset = readULEB128(&lsda);
   740	        classInfo = lsda + classInfoOffset;
   741	    }
   742	    // Walk call-site table looking for range that
   743	    // includes current PC.
   744	    uint8_t callSiteEncoding = *lsda++;
   745	#if defined(__USING_SJLJ_EXCEPTIONS__) || defined(__WASM_EXCEPTIONS__)
   746	    (void)callSiteEncoding;  // When using SjLj/Wasm exceptions, callSiteEncoding is never used
   747	#endif
   748	    uint32_t callSiteTableLength = static_cast<uint32_t>(readULEB128(&lsda));
   749	    const uint8_t* callSiteTableStart = lsda;
   750	    const uint8_t* callSiteTableEnd = callSiteTableStart + callSiteTableLength;
   751	    const uint8_t* actionTableStart = callSiteTableEnd;
   752	    const uint8_t* callSitePtr = callSiteTableStart;
   753	    while (callSitePtr < callSiteTableEnd)
   754	    {
   755	        // There is one entry per call site.
   756	#if !defined(__USING_SJLJ_EXCEPTIONS__) && !defined(__WASM_EXCEPTIONS__)
   757	        // The call sites are non-overlapping in [start, start+length)
   758	        // The call sites are ordered in increasing value of start
   759	        uintptr_t start = readEncodedPointer(&callSitePtr, callSiteEncoding);
   760	        uintptr_t length = readEncodedPointer(&callSitePtr, callSiteEncoding);
   761	        landing_pad_t landingPad = readEncodedPointer(&callSitePtr, callSiteEncoding);
   762	        uintptr_t actionEntry = readULEB128(&callSitePtr);
   763	        if ((start <= ipOffset) && (ipOffset < (start + length)))
   764	#else  // __USING_SJLJ_EXCEPTIONS__ || __WASM_EXCEPTIONS__
   765	        // ip is 1-based index into this table
   766	        landing_pad_t landingPad = readULEB128(&callSitePtr);
   767	        uintptr_t actionEntry = readULEB128(&callSitePtr);
   768	        if (--ip == 0)
   769	#endif // __USING_SJLJ_EXCEPTIONS__ || __WASM_EXCEPTIONS__
   770	        {
   771	            // Found the call site containing ip.
   772	#if !defined(__USING_SJLJ_EXCEPTIONS__) && !defined(__WASM_EXCEPTIONS__)
   773	            if (landingPad == 0)
   774	            {
   775	                // No handler here
   776	                results.reason = _URC_CONTINUE_UNWIND;
   777	                return;
   778	            }
   779	            landingPad = (uintptr_t)lpStart + landingPad;
   780	#else  // __USING_SJLJ_EXCEPTIONS__ || __WASM_EXCEPTIONS__
   781	            ++landingPad;
   782	#endif // __USING_SJLJ_EXCEPTIONS__ || __WASM_EXCEPTIONS__
   783	            results.landingPad = landingPad;
   784	            if (actionEntry == 0)
   785	            {
   786	                // Found a cleanup
   787	                results.reason = (actions & _UA_SEARCH_PHASE) ? _URC_CONTINUE_UNWIND : _URC_HANDLER_FOUND;
   788	                return;
   789	            }
   790	            // Convert 1-based byte offset into
   791	            const uint8_t* action = actionTableStart + (actionEntry - 1);
   792	            bool hasCleanup = false;
   793	            // Scan action entries until you find a matching handler, cleanup, or the end of action list
   794	            while (true)
   795	            {
   796	                const uint8_t* actionRecord = action;
   797	                int64_t ttypeIndex = readSLEB128(&action);
   798	                if (ttypeIndex > 0)
   799	                {
   800	                    // Found a catch, does it actually catch?
   801	                    // First check for catch (...)
   802	                    const __shim_type_info* catchType =
   803	                        get_shim_type_info(static_cast<uint64_t>(ttypeIndex),
   804	                                           classInfo, ttypeEncoding,
   805	                                           native_exception, unwind_exception,
   806	                                           base);
   807	                    if (catchType == 0)
   808	                    {
   809	                        // Found catch (...) catches everything, including
   810	                        // foreign exceptions. This is search phase, cleanup
   811	                        // phase with foreign exception, or forced unwinding.
   812	                        assert(actions & (_UA_SEARCH_PHASE | _UA_HANDLER_FRAME |
   813	                                          _UA_FORCE_UNWIND));
   814	                        results.ttypeIndex = ttypeIndex;
   815	                        results.actionRecord = actionRecord;
   816	                        results.adjustedPtr =
   817	                            get_thrown_object_ptr(unwind_exception);
   818	                        results.reason = _URC_HANDLER_FOUND;
   819	                        return;
   820	                    }
   821	                    // Else this is a catch (T) clause and will never
   822	                    //    catch a foreign exception
   823	                    else if (!native_exception &&
   824	                             (actions & _UA_FORCE_UNWIND))
   825	                    {
   826	                        void* adjustedPtr =
   827	                            get_thrown_object_ptr(unwind_exception);
   828	                        const __shim_type_info* forcedType =
   829	                            static_cast<const __shim_type_info*>(
   830	                                &typeid(__cxxabiv1::__forced_unwind));
   831	                        if (catchType->can_catch(forcedType, adjustedPtr))
   832	                        {
   833	                            results.ttypeIndex = ttypeIndex;
   834	                            results.actionRecord = actionRecord;
   835	                            results.adjustedPtr = adjustedPtr;
   836	                            results.reason = _URC_HANDLER_FOUND;
   837	                            return;
   838	                        }
   839	                    }
   840	                    else if (native_exception)
   841	                    {
   842	                        __cxa_exception* exception_header = (__cxa_exception*)(unwind_exception+1) - 1;
   843	                        void* adjustedPtr = get_thrown_object_ptr(unwind_exception);
   844	                        const __shim_type_info* excpType =
   845	                            static_cast<const __shim_type_info*>(exception_header->exceptionType);
   846	                        if (adjustedPtr == 0 || excpType == 0)
   847	                        {
   848	                            // Something very bad happened
   849	                            call_terminate(native_exception, unwind_exception);
   850	                        }
