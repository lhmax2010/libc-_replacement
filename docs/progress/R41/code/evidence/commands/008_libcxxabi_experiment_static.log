  1171	static void save_results_to_barrier_cache(_Unwind_Exception* unwind_exception,
  1172	                                          const scan_results& results)
  1173	{
  1174	    unwind_exception->barrier_cache.bitpattern[0] = (uint32_t)results.adjustedPtr;
  1175	    unwind_exception->barrier_cache.bitpattern[1] = (uint32_t)results.actionRecord;
  1176	    unwind_exception->barrier_cache.bitpattern[2] = (uint32_t)results.languageSpecificData;
  1177	    unwind_exception->barrier_cache.bitpattern[3] = (uint32_t)results.landingPad;
  1178	    unwind_exception->barrier_cache.bitpattern[4] = (uint32_t)results.ttypeIndex;
  1179	}
  1180	
  1181	static void load_results_from_barrier_cache(scan_results& results,
  1182	                                            const _Unwind_Exception* unwind_exception)
  1183	{
  1184	    results.adjustedPtr = (void*)unwind_exception->barrier_cache.bitpattern[0];
  1185	    results.actionRecord = (const uint8_t*)unwind_exception->barrier_cache.bitpattern[1];
  1186	    results.languageSpecificData = (const uint8_t*)unwind_exception->barrier_cache.bitpattern[2];
  1187	    results.landingPad = (uintptr_t)unwind_exception->barrier_cache.bitpattern[3];
  1188	    results.ttypeIndex = (int64_t)(int32_t)unwind_exception->barrier_cache.bitpattern[4];
  1189	}
