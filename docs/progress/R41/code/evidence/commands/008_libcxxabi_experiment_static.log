  1055	                    (int version, _Unwind_Action actions, uint64_t exceptionClass,
  1056	                     _Unwind_Exception* unwind_exception, _Unwind_Context* context)
  1057	{
  1058	    if (version != 1 || unwind_exception == 0 || context == 0)
  1059	        return _URC_FATAL_PHASE1_ERROR;
  1060	
  1061	    bool native_exception = (exceptionClass     & get_vendor_and_language) ==
  1062	                            (kOurExceptionClass & get_vendor_and_language);
  1063	    scan_results results;
  1064	    // Process a catch handler for a native exception first.
  1065	    if (actions == (_UA_CLEANUP_PHASE | _UA_HANDLER_FRAME) &&
  1066	        native_exception) {
  1067	        // Reload the results from the phase 1 cache.
  1068	        __cxa_exception* exception_header =
  1069	            (__cxa_exception*)(unwind_exception + 1) - 1;
  1070	        results.ttypeIndex = exception_header->handlerSwitchValue;
  1071	        results.actionRecord = exception_header->actionRecord;
  1072	        results.languageSpecificData = exception_header->languageSpecificData;
  1073	        set_landing_pad(results, exception_header->catchTemp);
  1074	        results.adjustedPtr = exception_header->adjustedPtr;
  1075	
  1076	        // Jump to the handler.
  1077	        set_registers(unwind_exception, context, results);
  1078	        // Cache base for calculating the address of ttype in
  1079	        // __cxa_call_unexpected.
  1080	        if (results.ttypeIndex < 0) {
  1081	#if defined(_AIX)
  1082	          exception_header->catchTemp = (void *)_Unwind_GetDataRelBase(context);
  1083	#else
  1084	          exception_header->catchTemp = 0;
  1085	#endif
  1086	        }
  1087	        return _URC_INSTALL_CONTEXT;
  1088	    }
  1089	
  1090	    // In other cases we need to scan LSDA.
  1091	    scan_eh_tab(results, actions, native_exception, unwind_exception, context);
  1092	    if (results.reason == _URC_CONTINUE_UNWIND ||
  1093	        results.reason == _URC_FATAL_PHASE1_ERROR)
  1094	        return results.reason;
  1095	
  1096	    if (actions & _UA_SEARCH_PHASE)
  1097	    {
  1098	        // Phase 1 search:  All we're looking for in phase 1 is a handler that
  1099	        //   halts unwinding
  1100	        assert(results.reason == _URC_HANDLER_FOUND);
  1101	        if (native_exception) {
  1102	            // For a native exception, cache the LSDA result.
  1103	            __cxa_exception* exc = (__cxa_exception*)(unwind_exception + 1) - 1;
  1104	            exc->handlerSwitchValue = static_cast<int>(results.ttypeIndex);
  1105	            exc->actionRecord = results.actionRecord;
  1106	            exc->languageSpecificData = results.languageSpecificData;
  1107	            get_landing_pad(exc->catchTemp, results);
  1108	            exc->adjustedPtr = results.adjustedPtr;
  1109	#ifdef __WASM_EXCEPTIONS__
  1110	            // Wasm only uses a single phase (_UA_SEARCH_PHASE), so save the
  1111	            // results here.
  1112	            set_registers(unwind_exception, context, results);
  1113	#endif
  1114	        }
  1115	        return _URC_HANDLER_FOUND;
  1116	    }
  1117	
  1118	    assert(actions & _UA_CLEANUP_PHASE);
  1119	    assert(results.reason == _URC_HANDLER_FOUND);
  1120	    set_registers(unwind_exception, context, results);
