    18	namespace std {
    19	
    20	bool uncaught_exception() noexcept { return uncaught_exceptions() > 0; }
    21	
    22	int uncaught_exceptions() noexcept {
    23	#if _LIBCPPABI_VERSION > 1001
    24	  return abi::__cxa_uncaught_exceptions();
    25	#else
    26	  return abi::__cxa_uncaught_exception() ? 1 : 0;
    27	#endif
    28	}
    29	
