    61	  __throw_bad_cast()
    62	  { _GLIBCXX_THROW_OR_ABORT(bad_cast()); }
    63	
    64	  void
    65	  __throw_bad_typeid()
    66	  { _GLIBCXX_THROW_OR_ABORT(bad_typeid()); }
    67	
    68	  void
    69	  __throw_logic_error(const char* __s __attribute__((unused)))
    70	  { _GLIBCXX_THROW_OR_ABORT(logic_error(_(__s))); }
    71	
    72	  void
    73	  __throw_domain_error(const char* __s __attribute__((unused)))
    74	  { _GLIBCXX_THROW_OR_ABORT(domain_error(_(__s))); }
    75	
    76	  void
    77	  __throw_invalid_argument(const char* __s __attribute__((unused)))
    78	  { _GLIBCXX_THROW_OR_ABORT(invalid_argument(_(__s))); }
    79	
    80	  void
    81	  __throw_length_error(const char* __s __attribute__((unused)))
    82	  { _GLIBCXX_THROW_OR_ABORT(length_error(_(__s))); }
    83	
    84	  void
    85	  __throw_out_of_range(const char* __s __attribute__((unused)))
    86	  { _GLIBCXX_THROW_OR_ABORT(out_of_range(_(__s))); }
    87	
    88	  void
    89	  __throw_out_of_range_fmt(const char* __fmt, ...)
    90	  {
    91	#if _GLIBCXX_HOSTED && _GLIBCXX_VERBOSE && __cpp_exceptions
    92	    const size_t __len = __builtin_strlen(__fmt);
    93	    // We expect at most 2 numbers, and 1 short string. The additional
    94	    // 512 bytes should provide more than enough space for expansion.
    95	    const size_t __alloca_size = __len + 512;
    96	    char *const __s = static_cast<char*>(__builtin_alloca(__alloca_size));
    97	    va_list __ap;
    98	
    99	    va_start(__ap, __fmt);
   100	    __gnu_cxx::__snprintf_lite(__s, __alloca_size, _(__fmt), __ap);
   101	    throw out_of_range(__s);
   102	    va_end(__ap);  // Not reached.
   103	#else
   104	    __throw_out_of_range(__fmt);
   105	#endif
   106	  }
   107	
   108	  void
   109	  __throw_runtime_error(const char* __s __attribute__((unused)))
   110	  { _GLIBCXX_THROW_OR_ABORT(runtime_error(_(__s))); }
   111	
   112	  void
   113	  __throw_range_error(const char* __s __attribute__((unused)))
   114	  { _GLIBCXX_THROW_OR_ABORT(range_error(_(__s))); }
