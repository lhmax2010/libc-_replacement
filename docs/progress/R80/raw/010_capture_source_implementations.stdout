   143	
   144	  __cow_string::__cow_string(const __cow_string& s) noexcept
   145	  : _M_str(s._M_str) { }
   146	
   147	  __cow_string&
   148	  __cow_string::operator=(const __cow_string& s) noexcept
   149	  {
   150	    _M_str = s._M_str;
   151	    return *this;
   152	  }
   153	
   154	  __cow_string::~__cow_string() { _M_str.~basic_string(); }
