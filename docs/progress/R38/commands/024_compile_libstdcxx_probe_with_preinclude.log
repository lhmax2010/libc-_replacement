PWD=/home/toolchain/development/libc++_replacement
COMMAND= bash -lc $'set -euo pipefail\nworkspace=/home/toolchain/development/libc++_replacement\nout=$workspace/tmp/R38/probes-armv7l\nsource_file=$workspace/progress/R34B/src/s1_rethrow_probe.cpp\nshim=$workspace/progress/R38/code/ehabi_field_map_after_headers.h\ntest -x "$out/s1_libcxx_strict"\ntest ! -e "$out/s1_libstdcxx_strict"\nprintf "STRICT_SOURCE_SHA256="; sha256sum "$source_file" | awk "{print \\\\\\$1}"\nprintf "PREINCLUDE_SHA256="; sha256sum "$shim" | awk "{print \\\\\\$1}"\nprintf "COMPILE_ADAPTATION=-include %s\\n" "$shim"\nexport CMAKE_BUILD_PARALLEL_LEVEL=2\nexport LLVM_PARALLEL_LINK_JOBS=1\nnice -n 15 ionice -c 3 "$workspace/progress/R36/tools/armv7l-clang++" -O0 -g -fexceptions -pthread -include "$shim" "$source_file" -Wl,-z,now -o "$out/s1_libstdcxx_strict"\nfile "$out/s1_libstdcxx_strict"\nsha256sum "$out/s1_libcxx_strict" "$out/s1_libstdcxx_strict"\nfor file in "$out/s1_libcxx_strict" "$out/s1_libstdcxx_strict"; do\n  printf "=== DYNAMIC %s ===\\n" "$file"\n  readelf -dW "$file"\n  readelf --dyn-syms -W "$file" | grep -E "(__forced_unwind|__gxx_personality|__cxa_rethrow|_Unwind_| UND )" || true\ndone\n'
STRICT_SOURCE_SHA256=awk: 1: unexpected character '\'
EXIT_CODE=2
