===== Revert-libc-Replace-__resize_default_init-with-resize-v2.patch =====
title=Revert [libc++] Replace __resize_default_init with
3f6d3450117fd2fbb7ee7126cd90854bf30fa6b6f61526fea5fc3064bc128d80  /home/toolchain/development/libc++_replacement/tmp/W4/android-llvm-toolchain-r596125/patches/Revert-libc-Replace-__resize_default_init-with-resize-v2.patch
 libcxx/include/string                              |   40 +++++++++--
 libcxx/src/filesystem/format_string.h              |   13 ++-
 libcxx/test/benchmarks/containers/string.bench.cpp |   18 -----
 .../resize_default_initialized.pass.cpp            |   75 ++++++++++++++++++++
 .../directory_entry.mods/last_write_time.pass.cpp  |    1 
 .../filesystems/convert_file_time.pass.cpp         |    1 
 .../resize_default_initialized.pass.cpp            |   75 ++++++++++++++++++++
 7 files changed, 192 insertions(+), 31 deletions(-)
From cdf12660730fe7950854b57ab0e80d97abe9b99d Mon Sep 17 00:00:00 2001
From: Sharjeel Khan <sharjeelkhan@google.com>
Date: Fri, 10 Oct 2025 19:01:39 +0000
Subject: [PATCH] Revert "[libc++] Replace __resize_default_init with
 resize_and_overwrite (#157121)"

This reverts commit 92f5d8df361bb1bb6dea88f86faeedfd295ab970.
---
 libcxx/include/string                         | 40 ++++++++--
 libcxx/src/filesystem/format_string.h         | 13 ++--
 .../benchmarks/containers/string.bench.cpp    | 18 +----
 .../resize_default_initialized.pass.cpp       | 75 +++++++++++++++++++
 .../last_write_time.pass.cpp                  |  1 +
 .../filesystems/convert_file_time.pass.cpp    |  1 +
 .../resize_default_initialized.pass.cpp       | 75 +++++++++++++++++++
 7 files changed, 192 insertions(+), 31 deletions(-)
 create mode 100644 libcxx/test/libcxx-03/strings/basic.string/string.modifiers/resize_default_initialized.pass.cpp
 create mode 100644 libcxx/test/libcxx/strings/basic.string/string.modifiers/resize_default_initialized.pass.cpp

diff --git a/libcxx/include/string b/libcxx/include/string
index 8f80afbc2fd3..0833873d7579 100644
--- a/libcxx/include/string
+++ b/libcxx/include/string
@@ -1314,17 +1314,13 @@ public:
   _LIBCPP_HIDE_FROM_ABI constexpr void resize_and_overwrite(size_type __n, _Op __op) {
     using __result_type = decltype(std::move(__op)(data(), auto(__n)));
     static_assert(__integer_like<__result_type>, "Operation return type must be integer-like");
-    size_type __sz  = size();
-    size_type __cap = capacity();
-    if (__n > __cap)
-      __grow_by_without_replace(__cap, __n - __cap, __sz, __sz, 0);
-    __annotate_delete();
-    __set_size(__n);
-    __annotate_new(__n);
-    __erase_to_end(std::move(__op)(data(), auto(__n)));
+    __resize_default_init(__n);
+    __erase_to_end(std::move(__op)(data(), _LIBCPP_AUTO_CAST(__n)));
   }
 #  endif
 
+  _LIBCPP_HIDE_FROM_ABI _LIBCPP_CONSTEXPR_SINCE_CXX20 void __resize_default_init(size_type __n);
+
 #  if _LIBCPP_STD_VER < 26 || defined(_LIBCPP_ENABLE_CXX26_REMOVED_STRING_RESERVE)
   _LIBCPP_DEPRECATED_IN_CXX20 _LIBCPP_HIDE_FROM_ABI void reserve() _NOEXCEPT { shrink_to_fit(); }
 #  endif
@@ -1416,6 +1412,8 @@ public:
   _LIBCPP_CONSTEXPR_SINCE_CXX20 basic_string& append(const value_type* _LIBCPP_DIAGNOSE_NULLPTR __s);
   _LIBCPP_CONSTEXPR_SINCE_CXX20 basic_string& append(size_type __n, value_type __c);
 
+  _LIBCPP_HIDE_FROM_ABI _LIBCPP_CONSTEXPR_SINCE_CXX20 void __append_default_init(size_type __n);
+
   template <class _InputIterator, __enable_if_t<__has_exactly_input_iterator_category<_InputIterator>::value, int> = 0>
   _LIBCPP_HIDE_FROM_ABI _LIBCPP_HIDE_FROM_ABI _LIBCPP_CONSTEXPR_SINCE_CXX20 basic_string&
   append(_InputIterator __first, _InputIterator __last) {
@@ -3041,6 +3039,22 @@ basic_string<_CharT, _Traits, _Allocator>::append(size_type __n, value_type __c)
   return *this;
 }
 
+template <class _CharT, class _Traits, class _Allocator>
+_LIBCPP_CONSTEXPR_SINCE_CXX20 inline void
+basic_string<_CharT, _Traits, _Allocator>::__append_default_init(size_type __n) {
+  if (__n == 0)
+    return;
+  size_type __cap = capacity();
+  size_type __sz  = size();
+  if (__cap - __sz < __n)
+    __grow_by_without_replace(__cap, __sz + __n - __cap, __sz, __sz, 0);
+  __annotate_increase(__n);
+  pointer __p = __get_pointer();
+  __sz += __n;
+  __set_size(__sz);
+  traits_type::assign(__p[__sz], value_type());
+}
+
 template <class _CharT, class _Traits, class _Allocator>
 _LIBCPP_CONSTEXPR_SINCE_CXX20 void basic_string<_CharT, _Traits, _Allocator>::push_back(value_type __c) {
   bool __is_short = !__is_long();
@@ -3379,6 +3393,16 @@ _LIBCPP_CONSTEXPR_SINCE_CXX20 void basic_string<_CharT, _Traits, _Allocator>::re
     __erase_to_end(__n);
 }
