From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: R51 Evidence <r51@example.invalid>
Date: Thu, 20 Aug 2026 20:20:59 +0800
Subject: [PATCH 2/4] libc++abi: expose GNU forced-unwind marker type
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

GNU C++ code protects pthread cancellation with a handler for
__cxxabiv1::__forced_unwind, but libc++abi does not expose or map that marker.
Define the same abstract class shape used by libstdc++, with an out-of-line
virtual destructor so libc++abi owns one exported strong typeinfo definition.
Map a forced foreign exception to this type during personality matching.

This extension depends on the Layer A forced-unwind rethrow and ARM EHABI
handler fixes, at least on armv7l, because the matched handler rethrows the
foreign exception. Validation covers x86_64 native and armv7l hardware with
libgcc_s. It does not cover aarch64, LLVM libunwind, concurrent cancellation,
or mixed-runtime frame traversal.

中文说明：移植 GNU 强制展开标记类型及 personality 映射；采用抽象类
和库内 key function，保证消费者引用 libc++abi 中唯一的强 typeinfo。
该扩展在 armv7l 上依赖层 A。

diff --git a/libcxxabi/include/cxxabi.h b/libcxxabi/include/cxxabi.h
index 9ea93680f62e..da75b45c84fe 100644
--- a/libcxxabi/include/cxxabi.h
+++ b/libcxxabi/include/cxxabi.h
@@ -37,6 +37,14 @@ class type_info; // forward declaration
 // runtime routines use C calling conventions, but are in __cxxabiv1 namespace
 namespace __cxxabiv1 {
 
+// An out-of-line key function makes the runtime library own the unique
+// exported typeinfo definition. Keep the libstdc++ abstract class shape so
+// this marker can only be caught by reference.
+class _LIBCXXABI_TYPE_VIS __forced_unwind {
+  virtual ~__forced_unwind();
+  virtual void __pure_dummy() = 0;
+};
+
 struct __cxa_exception;
 
 extern "C"  {
diff --git a/libcxxabi/src/cxa_exception.cpp b/libcxxabi/src/cxa_exception.cpp
index 0a346f344b66..3a6a0b8b8e17 100644
--- a/libcxxabi/src/cxa_exception.cpp
+++ b/libcxxabi/src/cxa_exception.cpp
@@ -36,6 +36,8 @@
 
 namespace __cxxabiv1 {
 
+__forced_unwind::~__forced_unwind() = default;
+
 //  Utility routines
 static
 inline
diff --git a/libcxxabi/src/cxa_personality.cpp b/libcxxabi/src/cxa_personality.cpp
index 3fd12fce9a16..559000728bcb 100644
--- a/libcxxabi/src/cxa_personality.cpp
+++ b/libcxxabi/src/cxa_personality.cpp
@@ -819,6 +819,23 @@ static void scan_eh_tab(scan_results &results, _Unwind_Action actions,
                     }
                     // Else this is a catch (T) clause and will never
                     //    catch a foreign exception
+                    else if (!native_exception &&
+                             (actions & _UA_FORCE_UNWIND))
+                    {
+                        void* adjustedPtr =
+                            get_thrown_object_ptr(unwind_exception);
+                        const __shim_type_info* forcedType =
+                            static_cast<const __shim_type_info*>(
+                                &typeid(__cxxabiv1::__forced_unwind));
+                        if (catchType->can_catch(forcedType, adjustedPtr))
+                        {
+                            results.ttypeIndex = ttypeIndex;
+                            results.actionRecord = actionRecord;
+                            results.adjustedPtr = adjustedPtr;
+                            results.reason = _URC_HANDLER_FOUND;
+                            return;
+                        }
+                    }
                     else if (native_exception)
                     {
                         __cxa_exception* exception_header = (__cxa_exception*)(unwind_exception+1) - 1;
