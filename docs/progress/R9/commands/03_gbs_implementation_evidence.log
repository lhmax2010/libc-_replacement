   219	                     directory=True)
   220	
   221	    gbp_args = create_gbp_export_args(repo, commit, export_dir, tmp.path,
   222	                                      spec, args, force_native=False,
   223	                                      create_tarball=create_tarball)
   224	    try:
   225	        ret = gbp_build(gbp_args)
   226	        if ret == 2 and not is_native_pkg(repo, args):
   227	            errmsg = ("Generating upstream tarball and/or generating patches "
   228	                      "failed. GBS tried this as you have upstream branch in "
   229	                      "you git tree. Fix the problem by either:\n"
   230	                      "  1. Update your upstream branch and/or fix the spec "
   231	                      "file. Also, check the upstream tag format.\n"
   232	                      "  2. Remove or rename the upstream branch (change the "
