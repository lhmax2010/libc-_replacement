   246	def format_patch(outdir, repo, commit_info, series, numbered=True,
   247	                 path_exclude_regex=None, topic=''):
   248	    """Create patch of a single commit"""
   249	
   250	    # Determine filename and path
   251	    outdir = os.path.join(outdir, topic)
   252	    if not os.path.exists(outdir):
   253	        os.makedirs(outdir)
   254	    num_prefix = '%04d-' % (len(series) + 1)
   255	    suffix = '.patch'
   256	    base_maxlen = 63 - len(num_prefix) - len(suffix)
   257	    base = commit_info['patchname'][:base_maxlen]
   258	    filename = (num_prefix if numbered else '') + base + suffix
   259	    filepath = os.path.join(outdir, filename)
   260	    # Make sure that we don't overwrite existing patches in the series
   261	    if filepath in series:
   262	        presuffix = '-%d' % len(series)
   263	        base = base[:base_maxlen-len(presuffix)] + presuffix
   264	        filename = (num_prefix if numbered else '') + base + suffix
   265	        filepath = os.path.join(outdir, filename)
   266	
   267	    # Determine files to include
   268	    paths = patch_path_filter(commit_info['files'], path_exclude_regex)
   269	
   270	    # Finally, create the patch
   271	    patch = None
   272	    if paths:
   273	        diff = repo.diff('%s^!' % commit_info['id'], paths=paths, stat=80,
   274	                         summary=True, text=True)
   275	        patch = write_patch_file(filepath, commit_info, diff)
   276	        if patch:
   277	            series.append(patch)
   278	    return patch
