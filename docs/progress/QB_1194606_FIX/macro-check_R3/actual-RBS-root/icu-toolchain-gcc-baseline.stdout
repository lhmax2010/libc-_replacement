












Name:      icu
Version:   78.1
Release:   1
Summary:   International Components for Unicode
Group:     System/Libraries
License:   ICU and Unicode-TOU and BSD-2.0
URL:       http://www.icu-project.org/
Source0:   icu-78.1.tar.gz
Source1:   tzdata2025b.tar.gz
Source2:   set_disable_renameing.patch
Source3:   Disable-the-default-LDFLAGSICUDT.patch
Source4:   Add_PIE_option_for_tzcode.patch
Source5:   Set_define_false_and_true.patch
Source6:   Change_localtime_path.patch
Source7:   Set_icu_timezone_files_dir.patch
Source1001: icu.manifest

BuildRequires: autoconf
BuildRequires: pkgconfig(python3)





%description
Tools and utilities for developing with icu.

%package -n libicu
Summary: International Components for Unicode - libraries

%description -n libicu
The International Components for Unicode (ICU) libraries provide
robust and full-featured Unicode services on a wide variety of
platforms. ICU supports the most current version of the Unicode
standard, and they provide support for supplementary Unicode
characters (needed for GB 18030 repertoire support).
As computing environments become more heterogeneous, software
portability becomes more important. ICU lets you produce the same
results across all the various platforms you support, without
sacrificing performance. It offers great flexibility to extend and
customize the supplied services.

%package  -n libicu-devel
Summary:  Development files for International Components for Unicode
Requires: libicu = 78.1-1
Requires: pkgconfig

%description -n libicu-devel
Includes and definitions for developing with icu.

%package  -n libicu-tzdata
Summary:  package for ICU TimeZone Updating
Requires: libicu = 78.1-1
Requires: pkgconfig

%description -n libicu-tzdata
Initial setup for ICU timezone .res file

%prep
%setup -q
cp /home/toolchain/rpmbuild/SOURCES/icu.manifest .
/bin/patch -p1 < /home/toolchain/rpmbuild/SOURCES/set_disable_renameing.patch
/bin/patch -p1 < /home/toolchain/rpmbuild/SOURCES/Disable-the-default-LDFLAGSICUDT.patch
/bin/patch -p1 < /home/toolchain/rpmbuild/SOURCES/Add_PIE_option_for_tzcode.patch
/bin/patch -p1 < /home/toolchain/rpmbuild/SOURCES/Set_define_false_and_true.patch
/bin/patch -p1 < /home/toolchain/rpmbuild/SOURCES/Change_localtime_path.patch
/bin/patch -p1 < /home/toolchain/rpmbuild/SOURCES/Set_icu_timezone_files_dir.patch

cp /home/toolchain/rpmbuild/SOURCES/tzdata2025b.tar.gz ./source/tools/tzcode

%build
export CFLAGS="$CFLAGS -D_TIZEN_FEATURE_ -fPIC"
export CXXFLAGS="$CXXFLAGS -D_TIZEN_FEATURE_ -fPIC"
export LINKFLAGS=" -pie"
export LANG=C.UTF-8

cd source

  
 
  
  CFLAGS="${CFLAGS:--O2 -g -m64 -fmessage-length=0 -Wp,-D_FORTIFY_SOURCE=2 -fstack-protector -funwind-tables -fasynchronous-unwind-tables}" ; export CFLAGS ; 
  CXXFLAGS="${CXXFLAGS:--O2 -g -m64 -fmessage-length=0 -Wp,-D_FORTIFY_SOURCE=2 -fstack-protector -funwind-tables -fasynchronous-unwind-tables}" ; export CXXFLAGS ; 
  LDFLAGS="${LDFLAGS:-}" ; export LDFLAGS; 
  ./configure --build=x86_64-tizen-linux-gnu --host=x86_64-tizen-linux-gnu \
        --program-prefix= \
        --prefix=/usr \
        --exec-prefix=/usr \
        --bindir=/usr/bin \
        --sbindir=/usr/sbin \
        --sysconfdir=/etc \
        --datadir=/usr/share \
        --includedir=/usr/include \
        --libdir=/usr/lib64 \
        --libexecdir=/usr/libexec \
        --localstatedir=/var \
        --sharedstatedir=/usr/com \
        --mandir=/usr/share/man \
        --infodir=/usr/share/info --enable-static=no \
            --enable-renaming=no \
            --enable-shared \
            --enable-plugins=yes \
            --enable-samples=no \
            --with-data-packaging=library
/bin/make -j20

%check
#    pushd source
#    /bin/make check || exit 0
#    popd

%install
cd source

  /bin/make \
        DESTDIR=/home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64 \
        INSTALL_ROOT=/home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64 \
  install  
  rm -f /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/usr/share/info/dir 
  find /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64 -regex ".*\.la$" | xargs rm -f -- 
  find /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64 -regex ".*\.a$" | xargs rm -f --

# bugs of rpmdeps
chmod +x /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64//usr/lib64/lib*.so.*
mkdir -p /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/opt/share/icu_tzdata/
mkdir -p /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/usr/share/icu_zoneinfo/
export ICUDATA_NAME=`cat ./data/makedata.mak  | grep "^U_ICUDATA_NAME=" | head -n 1 | sed -e 's/^.*=//g' | sed -e 's/\r$//g'`
export ICUDATA_ENDIAN_SUFFIX=`cat ./data/makedata.mak  | grep "^U_ICUDATA_ENDIAN_SUFFIX=" | head -n 1 | sed -e 's/^.*=//g' | sed -e 's/\r$//g'`
echo "============================================="
echo "ICUDATA_NAME [$ICUDATA_NAME]"
echo "ICUDATA_ENDIAN_SUFFIX [$ICUDATA_ENDIAN_SUFFIX]"
echo "============================================="
cp -af ./data/out/build/"$ICUDATA_NAME$ICUDATA_ENDIAN_SUFFIX"/zoneinfo64.res /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/usr/share/icu_zoneinfo/
cp -af ./data/out/build/"$ICUDATA_NAME$ICUDATA_ENDIAN_SUFFIX"/metaZones.res /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/usr/share/icu_zoneinfo/
cp -af ./data/out/build/"$ICUDATA_NAME$ICUDATA_ENDIAN_SUFFIX"/timezoneTypes.res /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/usr/share/icu_zoneinfo/
ln -sf /usr/share/icu_zoneinfo/zoneinfo64.res /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/opt/share/icu_tzdata/zoneinfo64.res
ln -sf /usr/share/icu_zoneinfo/metaZones.res /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/opt/share/icu_tzdata/metaZones.res
ln -sf /usr/share/icu_zoneinfo/timezoneTypes.res /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/opt/share/icu_tzdata/timezoneTypes.res
cp -af ./data/misc/timezoneTypes.txt /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/opt/share/icu_tzdata/
cp -af ./data/misc/metaZones.txt /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/opt/share/icu_tzdata/
cp -af ./tools/tzcode/zoneinfo /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/usr/share/icu_zoneinfo/
cp -af ./tools/tzcode/zone.tab /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/usr/share/icu_zoneinfo/
cp -af ./tools/tzcode/icu_zone.txt /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/usr/share/icu_zoneinfo/
cp -af ./tools/tzcode/zoneinfo64.txt /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/usr/share/icu_zoneinfo/
cp -af ./tools/tzcode/icuregions /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/usr/share/icu_zoneinfo/

mkdir -p /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/usr/sbin/icu_bin/
cp ./bin/zic /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/usr/sbin/icu_bin/
cp ./bin/tz2icu /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/usr/sbin/icu_bin/


  rm -rf /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/usr/share/info 
  rm -rf /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/usr/share/doc/packages 
  rm -rf /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/usr/share/doc/icu 
  rm -rf /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/usr/share/doc/icu-78.1 
  rm -rf /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/usr/share/gtk-doc 
  rm -rf /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/usr/share/doc 
  rm -rf /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64/usr/share/man 
  find /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64 -regex ".*/man/man./.*.[0-9]" | xargs rm -f -- 
  find /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64 -regex ".*/man/../man./.*.[0-9]" | xargs rm -f -- 
  find /home/toolchain/rpmbuild/BUILDROOT/icu-78.1-1.x86_64 -regex ".*/man/man./.*.[0-9]pm" | xargs rm -f --


%post -n libicu -p /sbin/ldconfig

%postun -n libicu -p /sbin/ldconfig

%files
%manifest icu.manifest
%license LICENSE

