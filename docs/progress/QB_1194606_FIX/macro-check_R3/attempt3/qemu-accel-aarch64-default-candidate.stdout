

































Name:           qemu-accel
Version:        0.4
Release:        0
AutoReqProv:    off
BuildRequires:  gcc-aarch64
BuildRequires:  binutils-aarch64
BuildRequires:  gcc-fortran

BuildRequires:  fdupes
BuildRequires:  gettext-runtime
BuildRequires:  gettext-tools
BuildRequires:  m4

BuildRequires:  vim
BuildRequires:  patchelf
BuildRequires:  elfutils
BuildRequires:  libxslt-tools
BuildRequires:  cmake
BuildRequires:  gawk
BuildRequires:  libstdc++
BuildRequires:  python libpython
BuildRequires:  python-xml
BuildRequires:  python-magic
BuildRequires:  python-rpm
BuildRequires:  python3-rpm
BuildRequires:  python-ply
BuildRequires:  file
BuildRequires:  libasan

BuildRequires:  liblsan

BuildRequires:  icecream
BuildRequires:  libunwind
BuildRequires:  libuuid
BuildRequires:  clang
BuildRequires:  pbzip2
BuildRequires:  python3
BuildRequires:  python3-base
BuildRequires:  glibc-accel-ldso
BuildRequires:  diffutils
BuildRequires:  libabigail


BuildRequires:  llvm-devel



Summary:        Native binaries for speeding up cross compile
License:        GPL-2.0
Group:          Development/Cross Compilation
ExclusiveArch:  x86_64

%description
This package is used in aarch64 architecture builds using qemu to speed up builds
with native binaries.
This should not be installed on systems, it is just intended for qemu environments.

%package -n python-accel
AutoReqProv: off
Requires: qemu-accel
Version: 0.4
Release: 0
Summary: Binaries for python acceleration
License:        GPL-2.0
Group:          Development/Cross Compilation

%description -n python-accel
This package is used in qemu-accel to accelerate python.

%post -n python-accel
ldconfig

%package -n clang-accel
AutoReqProv: off
Requires: qemu-accel
Version: 0.4
Release: 0
Summary: Binaries for clang acceleration
License:        GPL-2.0
Group:          Development/Cross Compilation
Requires: qemu-accel

%description -n clang-accel
This package is used in qemu-accel to accelerate clang compiler.

%post -n clang-accel

%prep

%build

%install
set +x
# gcc version major.minor.patch
gcc_version=`gcc --version | sed -ne '1s/[^0-9]*\(\([0-9]\.\?\)*\).*/\1/p'`
# Find cross-gcc install directory, like:
# - /usr/lib/gcc/armv7l-tizen-linux-gnueabi/6.2.1/ for armv7l,
# - /usr/lib64/gcc/aarch64-tizen-linux-gnu/6.2.1/ for aarch64
gcc_install_dir="$(aarch64-tizen-linux-gnu-gcc -print-file-name=)"

# just like it is determided in python.spec
host_python="python$(python2 --version 2>&1 | sed -ne '1s/.* //p' | head -c 3)"
host_python3="python$(python3 --version | sed -ne '1s/.* //p' | sed -e 's/^\(3\.[0-9]\+\).*/\1/')"

# Emul path inside buildroot for installation
buildroot_emul_path=/home/toolchain/rpmbuild/BUILDROOT/qemu-accel-0.4-0.x86_64/emul

# Collect all shared objects from glibc and libgcc
# excluding RTLD since it's processed in another way later
for lib in $(rpm -ql glibc) \
 $(rpm -ql libgcc)
do
 if echo "$lib" | grep -E '\.so(\.[[:digit:]]+)?$' > /dev/null && ! echo "$lib" | grep -q '/ld-'; then
   binaries="$binaries $lib"
 fi
done

  LD="/usr/lib64/ld-linux-x86-64.so.2"

# Disable bash acceleration for armv7hl due to corruption

  BASH_EXECUTABLE=/usr/bin/bash
  DASH_EXECUTABLE=/usr/bin/dash


for executable in /emul$LD \
   $BASH_EXECUTABLE \
   $DASH_EXECUTABLE \
   /usr/bin/rpm \
   /usr/bin/rpm2cpio \
   /usr/bin/rpmdb \
   /usr/bin/rpmkeys \
   /usr/bin/rpmqpack \
   /usr/bin/rpmbuild \
   /usr/bin/rpmsign \
   /usr/bin/rpmspec \
   /usr/bin/rpm2archive \
   /usr/lib64/rpm-plugins/ima.so \
   /usr/lib64/rpm-plugins/prioreset.so \
   /usr/lib64/rpm-plugins/syslog.so \
   /usr/lib64/libdb-4.8.so \
   /usr/lib64/libdb_cxx-4.8.so \
   /usr/bin/tar \
   /usr/bin/gzip \
   /usr/bin/bzip2 \
   /usr/bin/xz \
   /usr/bin/xzdec \
   /usr/bin/pbzip2 \
   /usr/bin/grep \
   /usr/bin/sed \
   /usr/lib64/libnssdbm3.so \
   /usr/lib64/libsoftokn3.so \
   /usr/lib64/libfreebl3.so \
   /usr/lib64/lib*san.so* \
   /usr/lib64/libssl.so* \
   /usr/lib64/libcrypto.so* \
   /usr/bin/cat \
   /usr/bin/expr \
   /usr/bin/mkdir \
   /usr/bin/mv \
   /usr/bin/rm \
   /usr/bin/rmdir \
   /usr/bin/msgexec \
   /usr/bin/msgfmt \
   /usr/bin/msgcat \
   /usr/bin/msgmerge \
   /usr/bin/make \
   /usr/bin/m4 \
   /usr/bin/awk \
   /usr/bin/gawk \
   /usr/bin/patch \
   /usr/bin/diff \
   /usr/bin/echo \
   /usr/bin/head \
   /usr/bin/eu-addr2line \
   /usr/bin/eu-ar \
   /usr/bin/eu-elfclassify \
   /usr/bin/eu-elfcmp \
   /usr/bin/eu-elfcompress \
   /usr/bin/eu-elflint \
   /usr/bin/eu-findtextrel \
   /usr/bin/eu-nm \
   /usr/bin/eu-objdump \
   /usr/bin/eu-ranlib \
   /usr/bin/eu-readelf \
   /usr/bin/eu-size \
   /usr/bin/eu-stack \
   /usr/bin/eu-strings \
   /usr/bin/eu-strip \
   /usr/bin/eu-unstrip \
   /usr/bin/xsltproc \
   /usr/bin/ccmake \
   /usr/bin/cmake \
   /usr/bin/cpack \
   /usr/bin/ctest \
   /usr/bin/aarch64-tizen-linux-gnu-addr2line \
   /usr/bin/aarch64-tizen-linux-gnu-ar \
   /usr/bin/aarch64-tizen-linux-gnu-as \
   /usr/bin/aarch64-tizen-linux-gnu-c++filt \
   /usr/bin/aarch64-tizen-linux-gnu-elfedit \
   /usr/bin/aarch64-tizen-linux-gnu-gprof \
   /usr/bin/aarch64-tizen-linux-gnu-ld \
   /usr/bin/aarch64-tizen-linux-gnu-ld.bfd \
   /usr/bin/aarch64-tizen-linux-gnu-nm \
   /usr/bin/aarch64-tizen-linux-gnu-objcopy \
   /usr/bin/aarch64-tizen-linux-gnu-objdump \
   /usr/bin/aarch64-tizen-linux-gnu-ranlib \
   /usr/bin/aarch64-tizen-linux-gnu-readelf \
   /usr/bin/aarch64-tizen-linux-gnu-size \
   /usr/bin/aarch64-tizen-linux-gnu-strings \
   /usr/bin/aarch64-tizen-linux-gnu-strip \
   /usr/bin/aarch64-tizen-linux-gnu-c++ \
   /usr/bin/aarch64-tizen-linux-gnu-g++ \
   /usr/bin/aarch64-tizen-linux-gnu-cpp \
   /usr/bin/aarch64-tizen-linux-gnu-gcc \
   /usr/bin/aarch64-tizen-linux-gnu-gcc-ar \
   /usr/bin/aarch64-tizen-linux-gnu-gcc-nm \
   /usr/bin/aarch64-tizen-linux-gnu-gcc-ranlib \
   /usr/bin/aarch64-tizen-linux-gnu-gcov \
   /usr/bin/aarch64-tizen-linux-gnu-gfortran \
   ${gcc_install_dir}cc1 \
   ${gcc_install_dir}cc1plus \
   ${gcc_install_dir}collect2 \
   ${gcc_install_dir}lto1 \
   ${gcc_install_dir}lto-wrapper \
   ${gcc_install_dir}liblto_plugin.so* \
   ${gcc_install_dir}f951 \
   /usr/bin/file \
   /usr/bin/icecc \
   /usr/bin/icerun \
   /usr/bin/find \
   /usr/bin/xargs \
   /usr/bin/readlink \
   /usr/bin/ls \
   /usr/bin/cpio \
   /usr/lib/rpm/debugedit \
   /usr/lib/rpm/*deps \
   /usr/lib64/libunwind*.so* \
   /usr/lib64/libuuid*.so* \
   /usr/bin/localedef \
   /usr/bin/abidw \
   /usr/bin/abidiff \
   /usr/bin/abicompat \
   /usr/bin/abipkgdiff \
   /usr/bin/kmidiff
do
  binaries="$binaries $executable"
done

# Add architecture-specific binaries (dwp and ld.gold are not available for riscv64)

for executable in /usr/bin/aarch64-tizen-linux-gnu-dwp \
   /usr/bin/aarch64-tizen-linux-gnu-ld.gold
do
  binaries="$binaries $executable"
done


prepare_package_list() {
  local bins=""
  local name=$1
  shift
  local executables="$@"
  echo "Setting up $name for $executables"
  ## Prepare the clang binaries separately
  for executable in $executables; do
    bins="$bins $executable `ldd $executable 2>/dev/null | sed -n 's,.*=> \(/[^ ]*\) .*,\1,p'`"
  done

  for b in $(echo "$bins" | tr ' ' '\n' | sort -u); do
    local orig_file=$(readlink -f $b)
    bins="$bins $orig_file"
    if ! echo "$b" | grep -q '/\.\./'; then
        # Ignore relative paths
        echo $b >> $name.list
    fi
    echo $orig_file >> $name.list
  done

  ## Store the resulting list for packaging, setting up the right prefix, removing duplication of /emul if one exists
  cat $name.list | \
      sed -e 's|^|/emul|;s| |\n/emul|g' | \
      grep -v "/emul/emul" | \
      sort -u > /home/toolchain/rpmbuild/SOURCES/$name-accel.list
  binaries=$(echo "$binaries $bins" | tr ' ' '\n' | sort -u)
}

prepare_package_list all \
  $binaries

prepare_package_list clang \
  /usr/bin/clang-* \
  /usr/bin/clang++ \
  /usr/bin/opt \
  /usr/bin/lli \
  /usr/bin/llc \
  /usr/bin/llvm-* \
  /usr/bin/lld \
  /usr/bin/ld.lld \
  /usr/lib64/libLTO.so* \
  /usr/lib64/LLVMgold.so*

prepare_package_list python \
  /usr/bin/${host_python} \
  /usr/lib64/${host_python}/lib-dynload/*.so \
  /usr/lib64/${host_python}/site-packages/*/*.so

prepare_package_list python3 \
  /usr/bin/${host_python3} \
  /usr/lib64/${host_python3}/lib-dynload/*.so \
  /usr/lib64/${host_python3}/site-packages/*/*.so

## dump list of binaries and list of packages
echo "### Binaries accelerated ###"
echo $binaries | sed -e 's/[^ ]*\///g;s/[^ ]*.so[^ ]* \?//g'
echo "### Packages used ###"
rpm -qf $binaries | grep -v "not owned" | sed -e "s/-[0-9].*//g" | sort -u
echo ""

patch_binary() {
  local binary=$1
  local rtld=$2
  # We don't need to accelerate shell scripts
  local filetype=`file --brief $binary`
  if echo "$filetype" | grep -q '^POSIX shell script'; then
    return
  fi

  local outfile=${buildroot_emul_path}$binary
  if ! test -e "$binary"; then
    echo "WARNING: File not found, ignoring"
    return
  fi
  if test -f "$outfile"; then
    echo "WARNING: File exists, ignoring"
    return
  fi
  mkdir -p ${outfile%/*}
  cp -aL $binary $outfile
  [ "$binary" = "$rtld" ] && return
  [ "$binary" = "/emul$rtld" ] && return

  # not all binaries have an .interp section
  if patchelf --print-interpreter $outfile 1>/dev/null 2>/dev/null; then
    patchelf --set-interpreter /emul$rtld $outfile
  fi

  # Only patch RUNPATH if one exists and is absolute
  local rpath=$(readelf -d "$outfile" | sed -e '/RUNPATH/{s~.*\[\(.*\)\]~\1~;n};d')
  if [ -n "$rpath" ]; then
    first_char=$(echo "$rpath" | cut -c1)
    if [ "$first_char" = "/" ]; then
      patchelf --set-rpath "/emul/usr/lib64" $outfile
    fi
  fi
}

# Process all binaries directly (parallel jobs with simple file-based coordination)
for binary in $binaries; do
    patch_binary "$binary" "$LD" &
done
wait

set -x



# create symlinks for bash
ln -s usr/bin "${buildroot_emul_path}/bin"
ln -sf bash "${buildroot_emul_path}/usr/bin/sh"
echo '/emul/usr/bin/sh' >> /home/toolchain/rpmbuild/SOURCES/all-accel.list

mv ${buildroot_emul_path}/lib64/* ${buildroot_emul_path}/usr/lib64/
rm -rf ${buildroot_emul_path}/lib64
ln -sf usr/lib64 ${buildroot_emul_path}/lib64


# rename binutils binaries
for binary in addr2line ar as c++filt dwp elfedit gprof ld ld.bfd ld.gold nm objcopy objdump ranlib readelf size strings strip
do
  mv ${buildroot_emul_path}/usr/bin/aarch64-tizen-linux-gnu-$binary ${buildroot_emul_path}/usr/bin/$binary
  sed -e "\|/emul/usr/bin/aarch64-tizen-linux-gnu-$binary|d" -i /home/toolchain/rpmbuild/SOURCES/all-accel.list
  echo "/emul/usr/bin/$binary" >> /home/toolchain/rpmbuild/SOURCES/all-accel.list
done

mkdir -p ${buildroot_emul_path}//usr/aarch64-tizen-linux-gnu/bin
for binary in ar as ld ld.bfd ld.gold nm objcopy objdump ranlib strip; do
  ln -sf /emul/usr/bin/$binary ${buildroot_emul_path}/usr/aarch64-tizen-linux-gnu/bin/$binary
  echo "/emul/usr/bin/$binary" >> /home/toolchain/rpmbuild/SOURCES/all-accel.list
  echo "/emul/usr/aarch64-tizen-linux-gnu/bin/$binary" >> /home/toolchain/rpmbuild/SOURCES/all-accel.list
done

# create symlinks for python
mv ${buildroot_emul_path}/usr/bin/${host_python} ${buildroot_emul_path}/usr/bin/${host_python}-orig
cat > ${buildroot_emul_path}/usr/bin/${host_python} << EOF
#!/bin/bash
if [ -z "\$PYTHONPATH" ]; then
  export PYTHONPATH="/usr/lib64/${host_python}"
else
  export PYTHONPATH+=":/usr/lib64/${host_python}"
fi
export PYTHONHOME="/emul/usr"
/emul/usr/bin/${host_python}-orig "\$@"
EOF
chmod +x ${buildroot_emul_path}/usr/bin/${host_python}

ln -s ${host_python} ${buildroot_emul_path}/usr/bin/python
ln -s ${host_python} ${buildroot_emul_path}/usr/lib64/python

# create symlinks for python3
mv ${buildroot_emul_path}/usr/bin/${host_python3} ${buildroot_emul_path}/usr/bin/${host_python3}-orig
cat > ${buildroot_emul_path}/usr/bin/${host_python3} << EOF
#!/bin/bash
if [ -z "\$PYTHONPATH" ]; then
  export PYTHONPATH="/usr/lib64/${host_python3}"
else
  export PYTHONPATH+=":/usr/lib64/${host_python3}"
fi
export PYTHONHOME="/emul/usr"
export LD_LIBRARY_PATH="/emul/usr/lib64:$LD_LIBRARY_PATH"
/emul/usr/bin/${host_python3}-orig "\$@"
EOF
chmod +x ${buildroot_emul_path}/usr/bin/${host_python3}

ln -s ${host_python3} ${buildroot_emul_path}/usr/bin/python3
ln -s ${host_python3} ${buildroot_emul_path}/usr/lib64/python3

#create symlinks for Scons & ply
#scons>=4.4.0 version now is python3 code
mkdir -p ${buildroot_emul_path}/usr/lib64/${host_python3}/site-packages
ln -sf /usr/lib64/${host_python3}/site-packages/SCons ${buildroot_emul_path}/usr/lib64/${host_python3}/site-packages/SCons
py3_version=$(python3 --version | sed -ne '1s/.* //p' | sed -e 's/^\(3\.[0-9]\+\).*/\1/')
ln -sf /usr/lib64/${host_python3}/site-packages/SCons-4.4.0-py${py3_version}.egg-info  ${buildroot_emul_path}/usr/lib64/${host_python3}/site-packages/SCons-4.4.0-py${py3_version}.egg-info
echo "/usr/lib64/${host_python3}/site-packages/SCons" >> python.list
echo "/usr/lib64/${host_python3}/site-packages/SCons-4.4.0-py${py3_version}.egg-info" >> python.list

mkdir -p ${buildroot_emul_path}/usr/lib64/${host_python}/site-packages
ln -sf /usr/lib64/${host_python}/site-packages/ply ${buildroot_emul_path}/usr/lib64/${host_python}/site-packages/ply
echo "/usr/lib64/${host_python}/site-packages/ply" >> python.list

mkdir -p ${buildroot_emul_path}/usr/lib64/${host_python}/site-packages/rpm/
mkdir -p ${buildroot_emul_path}/usr/lib64/${host_python3}/site-packages/rpm/
mkdir -p ${buildroot_emul_path}/usr/lib64/${host_python}/encodings/
cp /usr/lib64/${host_python}/site-packages/rpm/*.py ${buildroot_emul_path}/usr/lib64/${host_python}/site-packages/rpm/
cp /usr/lib64/${host_python3}/site-packages/rpm/*.py ${buildroot_emul_path}/usr/lib64/${host_python3}/site-packages/rpm/
cp /usr/lib64/${host_python}/*.py ${buildroot_emul_path}/usr/lib64/${host_python}/
cp /usr/lib64/${host_python}/encodings/*.py ${buildroot_emul_path}/usr/lib64/${host_python}/encodings/
cp -r /usr/lib64/${host_python3} ${buildroot_emul_path}/usr/lib64/
find ${buildroot_emul_path}/usr/lib64/${host_python3} -name *.pyc -exec rm {} \;
# Skip directories to not glob all inside them during #files processing
find /home/toolchain/rpmbuild/BUILDROOT/qemu-accel-0.4-0.x86_64 ! -type d -name 'python*' | sed -e "s|${buildroot_emul_path}||" | tee -a python.list

# rename gcc binaries
for bin in c++ g++ gcc gfortran cpp gcc-ar gcc-nm gcc-ranlib gcov
do
  mv ${buildroot_emul_path}/usr/bin/aarch64-tizen-linux-gnu-$bin ${buildroot_emul_path}/usr/bin/$bin
  ln -s $bin ${buildroot_emul_path}/usr/bin/aarch64-tizen-linux-gnu-$bin
  echo "/emul/usr/bin/$bin" >> /home/toolchain/rpmbuild/SOURCES/all-accel.list
done
ln -s gcc ${buildroot_emul_path}//usr/bin/cc
echo '/emul/usr/bin/cc' >> /home/toolchain/rpmbuild/SOURCES/all-accel.list

# rpmbuild when generating 'requires' tag for gobject-introspection binaries
# selects (64-bit) suffix for libs based on ${HOSTTYPE} bash variable
# so we replace x86_64 to armv7l to avoid bogus dependencies


# Default Tizen gcc build dir, must be synchronized with linaro-gcc spec
# definition. Expected to be 'home/abuild/rpmbuild/BUILD/gcc-${version}/obj/'
gcc_build_dir=/home/toolchain/rpmbuild/BUILD/gcc-${gcc_version}/obj

# create symlinks for gcc build (CC_FOR_TARGET)
mkdir -p ${buildroot_emul_path}${gcc_build_dir}/gcc
for binary in as cpp gcc-ar gcc-nm gcc-ranlib gcov nm
do
  ln -sf /emul/usr/bin/${binary} ${buildroot_emul_path}${gcc_build_dir}/gcc/${binary}
  echo "/emul${gcc_build_dir}/gcc/${binary}" >> /home/toolchain/rpmbuild/SOURCES/all-accel.list
done
for binary in cc1 cc1plus collect2 lto1 lto-wrapper f951
do
  ln -sf /emul${gcc_install_dir}${binary} ${buildroot_emul_path}${gcc_build_dir}/gcc/${binary}
  echo "/emul${gcc_build_dir}/gcc/${binary}" >> /home/toolchain/rpmbuild/SOURCES/all-accel.list
done
ln -sf /emul/usr/bin/gcc ${buildroot_emul_path}${gcc_build_dir}/gcc/xgcc
ln -sf /emul/usr/bin/g++ ${buildroot_emul_path}${gcc_build_dir}/gcc/xg++
echo "/emul${gcc_build_dir}/gcc/xgcc" >> /home/toolchain/rpmbuild/SOURCES/all-accel.list
echo "/emul${gcc_build_dir}/gcc/xg++" >> /home/toolchain/rpmbuild/SOURCES/all-accel.list

# support /lib/cpp
ln -sf /emul/usr/bin/cpp ${buildroot_emul_path}/usr/lib/cpp
echo '/emul/usr/lib/cpp' >> /home/toolchain/rpmbuild/SOURCES/all-accel.list

# generate baselibs.conf for current architecture to prevent rpm overwriting in download repo
echo  aarch64
cat > /home/toolchain/rpmbuild/SOURCES/baselibs_prologue << EOF
arch i686 targets aarch64:aarch64
arch i686 targets aarch64:x86-aarch64
arch x86_64 targets aarch64:aarch64
arch x86_64 targets aarch64:x86_64-aarch64
EOF
cat /home/toolchain/rpmbuild/SOURCES/baselibs_prologue /home/toolchain/rpmbuild/SOURCES/baselibs_body > /home/toolchain/rpmbuild/SOURCES/baselibs.conf

# By default this is ${gcc_install_dir}/liblto_plugin.so
target_liblto_plugin="$(aarch64-tizen-linux-gnu-gcc -print-file-name=liblto_plugin.so)"
# update baselibs.conf, overwrite LTO plugin
sed -e "s,#PLUGIN_POSTIN#,if [ -d $(dirname ${target_liblto_plugin}) ]; then\"\n  post \" mv ${target_liblto_plugin} ${target_liblto_plugin}_backup \&\& ln -sf /emul${target_liblto_plugin} ${target_liblto_plugin}\"\n  post \"fi," -i /home/toolchain/rpmbuild/SOURCES/baselibs.conf
sed -e "s,#PLUGIN_POSTUN#,mv ${target_liblto_plugin}_backup ${target_liblto_plugin}," -i /home/toolchain/rpmbuild/SOURCES/baselibs.conf

# Use /usr/lib for cross clang libdir on armv7l architecture




# Remove the ld-$VERSION.so to prevent name clashing with native ld.so
find ${buildroot_emul_path}/usr/lib64 -name 'ld-*.so' -delete
sed -e '\|/emul/usr/lib64/ld-[[:digit:]].*\.so|d' -i /home/toolchain/rpmbuild/SOURCES/all-accel.list

# allow build of baselibs.conf
sed -e "/targettype aarch64 block!/d" -i /home/toolchain/rpmbuild/SOURCES/baselibs.conf

# Various clang{,++}-* files in the original clang package are
# symlinks to clang-<major version>. prepare_package_list() above
# causes those files to be separate copies in ${builldroot_emul_path}.
# This recreates the original symlink structure in /emul
clang_major=`/usr/bin/clang --version | sed -ne 's/^.*[cC]lang version\s\+\([[:digit:]]\+\).*$/\1/p'`
clang="clang-$clang_major"
emul_bin="${buildroot_emul_path}/usr/bin"
for file in $emul_bin/clang-* $emul_bin/clang++; do
    if [ "$file" = "$emul_bin/$clang" ]; then
        continue
    fi
    if cmp "$file" "$emul_bin/$clang"; then
        rm "$file"
        ln -s $clang "$file"
    fi
done

# Plain clang binary is not copied by "prepare_package_list clang"
# call. We've just added it as symlink and now need to add it to the
# future rpm file list
ln -s $clang "$emul_bin/clang"
echo "/usr/bin/clang" >> clang.list

# Create target-triple symlinks and add them to file list
for bin in clang clang++; do
    ln -s $bin "$emul_bin/aarch64-tizen-linux-gnu-$bin"
    echo "/usr/bin/aarch64-tizen-linux-gnu-$bin" >> clang.list
done

## Prepare file lists for packages
# Change libdir to handle symlinks right
find . /home/toolchain/rpmbuild/SOURCES -name '*.list' -exec sed -e 's|/emul/lib64|/emul/usr/lib64|' -i {} \;
# Join native and multilib lists
cat /home/toolchain/rpmbuild/SOURCES/all-accel.list  | sort -u > /home/toolchain/rpmbuild/SOURCES/qemu-accel.list

## python-accel
# Generate list of all python files
find /home/toolchain/rpmbuild/BUILDROOT/qemu-accel-0.4-0.x86_64 -name '*.py' | sed -e "s|${buildroot_emul_path}||" >> python.list
# Generate list of all python3 files
find ${buildroot_emul_path}/usr/lib64/${host_python3} -type f | sed -e "s|${buildroot_emul_path}||" >> python.list
# Add python3 dependant libraries
for library in ffi gdbm ncursesw panelw python3 tinfow; do
  find ${buildroot_emul_path}/usr/lib64 -name "lib${library}.*" | sed -e "s|${buildroot_emul_path}||" >> python.list
done
sed -e 's|^|/emul|;s|/emul/lib64|/emul/usr/lib64|' python.list | sort -u > python-full.list
# Remove common files from python-accel
comm -13 /home/toolchain/rpmbuild/SOURCES/qemu-accel.list python-full.list | sort -u > /home/toolchain/rpmbuild/SOURCES/python-accel.list

## clang-accel
# Include copied libc++ SONAME paths in the generated file list.
for library in libc++.so.1 libc++abi.so.1; do
  if test -e "${buildroot_emul_path}/usr/lib64/$library"; then
    echo "/usr/lib64/$library" >> clang.list
  fi
done
# Prepare clang files list
sed -e 's|^|/emul|;s|/emul/lib64|/emul/usr/lib64|' clang.list | sort -u > clang-full.list
# Remove common files from clang-accel
comm -13 /home/toolchain/rpmbuild/SOURCES/qemu-accel.list clang-full.list > /home/toolchain/rpmbuild/SOURCES/clang-accel.list

#Fix build error with rpm 4.14.1:#Not a directory
# Add symlinks to qemu-accel packaging
echo '/emul/bin' >> /home/toolchain/rpmbuild/SOURCES/qemu-accel.list
echo '/emul/lib64' >> /home/toolchain/rpmbuild/SOURCES/qemu-accel.list


mv ${buildroot_emul_path}/emul$LD ${buildroot_emul_path}$LD
rm -rf ${buildroot_emul_path}/emul

%fdupes /home/toolchain/rpmbuild/BUILDROOT/qemu-accel-0.4-0.x86_64
 


%post
ldconfig

%postun
ldconfig

%postun -n python-accel
ldconfig

%files -f /home/toolchain/rpmbuild/SOURCES/qemu-accel.list
%defattr(-,root,root)
%exclude /emul%{py_libdir}/*

%files -n python-accel -f /home/toolchain/rpmbuild/SOURCES/python-accel.list
%defattr(-,root,root)

%files -n clang-accel -f /home/toolchain/rpmbuild/SOURCES/clang-accel.list
%defattr(-,root,root)

%changelog
