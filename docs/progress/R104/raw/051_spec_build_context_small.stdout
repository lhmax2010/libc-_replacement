FILE codes/R104/bcc-tools/packaging/bcc-tools.spec
    58	%build
    59	#DREVISION - number which will be put at back of the package name if repo isn't available
    60	LLVM_VERSION_MAJOR=$(llvm-config --version | cut -d. -f1)
    61	LLVM_SHARED_FLAG=
    62	if [ "${LLVM_VERSION_MAJOR}" -ge 22 ]; then
    63	    LLVM_SHARED_FLAG="-DENABLE_LLVM_SHARED=ON"
    64	fi
    65	
    66	%if %{with examples}
    67	%global install_cpp_examples ON
    68	%else
    69	%global install_cpp_examples OFF
    70	%endif
    71	
    72	cmake -DCMAKE_INSTALL_PREFIX=/usr -DINSTALL_CPP_EXAMPLES=%{install_cpp_examples} ${LLVM_SHARED_FLAG} -DREVISION="%{version}" -DCMAKE_USE_LIBBPF_PACKAGE:BOOL=TRUE .
    73	make %{?jobs:-j%jobs}
    74	
    75	%install
FILE codes/R104/bpftrace/packaging/bpftrace.spec
    67	%build
    68	%{?asan:/usr/bin/gcc-unforce-options}
    69	%{?ubsan:/usr/bin/gcc-unforce-options}
    70	
    71	mkdir build
    72	cd build
    73	cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_VERBOSE_MAKEFILE=ON -DBUILD_TESTING=OFF -DSTATIC_LINKING=OFF \
    74	         -DCMAKE_SKIP_RPATH:BOOL=ON -DCMAKE_INSTALL_PREFIX:PATH=%{_prefix}
    75	%make_build
    76	cd ..
    77	
    78	%install
FILE codes/R104/icu/packaging/icu.spec
    74	%build
    75	export CFLAGS="$CFLAGS -D_TIZEN_FEATURE_ -fPIC"
    76	export CXXFLAGS="$CXXFLAGS -D_TIZEN_FEATURE_ -fPIC"
    77	export LINKFLAGS=" -pie"
    78	export LANG=C.UTF-8
    79	
    80	cd source
    81	%{configure} --enable-static=no \
    82	            --enable-renaming=no \
    83	            --enable-shared \
    84	            --enable-plugins=yes \
    85	            --enable-samples=no \
    86	%ifarch armv7hl
    87	            --with-data-packaging=archive
    88	%else
    89	            --with-data-packaging=library
    90	%endif
    91	%{__make} %{?_smp_mflags}
    92	
    93	%check
    94	#    pushd source
    95	#    %__make check || exit 0
    96	#    popd
    97	
    98	%install
FILE codes/R104/jsoncpp/packaging/jsoncpp.spec
    35	%build
    36	mkdir build
    37	(cd build && \
    38	%cmake -DJSONCPP_WITH_TESTS=OFF \
    39	       -DJSONCPP_WITH_POST_BUILD_UNITTEST=OFF \
    40	       -DBUILD_SHARED_LIBS=ON \
    41	       -DBUILD_STATIC_LIBS=OFF \
    42	       .. && \
    43	%__make %{?_smp_mflags})
    44	
    45	# Build the doc
    46	# python doxybuild.py --doxygen %{_bindir}/doxygen
    47	
    48	#%check
    49	# Tests are run automatically in the build section
    50	# ctest -V %{?_smp_mflags}
    51	
    52	%install
FILE codes/R104/libsigc++/packaging/libsigc++.spec
    39	%build
    40	%meson \
    41	    -Dmaintainer-mode=true \
    42	    -Dbuild-deprecated-api=true \
    43	    -Dbuild-documentation=false \
    44	    -Dbuild-examples=false \
    45	    -Dbuild-tests=false \
    46	    -Dbenchmark=false \
    47	    -Dwarning_level=1
    48	
    49	%meson_build
    50	
    51	%install
FILE codes/R104/pcre/packaging/pcre.spec
    99	%build
   100	export CFLAGS="${CFLAGS} -fPIC"
   101	
   102	# Available JIT archs see sljit/sljitConfig.h
   103	autoreconf -fiv
   104	%configure \
   105	%ifarch %ix86 x86_64 %arm ppc ppc64 mips
   106		    --enable-jit \
   107	%endif
   108		    --enable-static \
   109		    --with-link-size=2 \
   110		    --with-match-limit=10000000 \
   111		    --enable-newline-is-lf \
   112		    --enable-utf8 \
   113	        --enable-unicode-properties
   114	make %{?_smp_mflags}
   115	
   116	
   117	# %check
   118	# export LANG=POSIX
   119	# make check || exit 0
   120	
   121	%install
FILE codes/R104/taglib/packaging/taglib.spec
    28	%build
    29	MAJORVER=`echo %{version} | awk 'BEGIN {FS="."}{print $1}'`
    30	%cmake . -DFULLVER=%{version} -DMAJORVER=${MAJORVER} -DVISIBILITY_HIDDEN=On
    31	
    32	make %{?jobs:-j%jobs}
    33	
    34	%install
