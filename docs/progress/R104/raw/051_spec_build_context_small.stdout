FILE codes/R104/abseil-cpp/packaging/abseil-cpp.spec
    45	%build
    46	mkdir -p cmake/build
    47	cd cmake/build
    48	%{cmake} -DABSL_USE_GOOGLETEST_HEAD=OFF ../..
    49	make %{?_smp_mflags}
