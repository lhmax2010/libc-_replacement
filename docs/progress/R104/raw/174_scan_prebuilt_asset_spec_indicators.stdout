codes/R104/llvm/packaging/llvm.spec:309:    test -f "${MLGO_AOT_DIR}/xla_runtime_objects/${mlgo_runtime_object}" || \
codes/R104/llvm/packaging/llvm.spec:310:        { echo "FATAL: missing MLGO runtime object: ${mlgo_runtime_object}"; exit 1; }
codes/R104/llvm/packaging/llvm.spec:314:  MLGO_EXPECT_MACHINE="ARM"
codes/R104/llvm/packaging/llvm.spec:317:  MLGO_EXPECT_MACHINE="AArch64"
codes/R104/llvm/packaging/llvm.spec:320:  MLGO_EXPECT_MACHINE="X86-64"
codes/R104/llvm/packaging/llvm.spec:322:  for mlgo_obj in lib/Analysis/InlinerSizeModel.o lib/CodeGen/RegAllocEvictModel.o; do
codes/R104/llvm/packaging/llvm.spec:323:    readelf -h "${mlgo_obj}" | grep -q "Machine:.*${MLGO_EXPECT_MACHINE}" || \
codes/R104/llvm/packaging/llvm.spec:324:      { echo "FATAL: ${mlgo_obj} arch mismatch (expected ${MLGO_EXPECT_MACHINE})"; exit 1; }
codes/R104/llvm/packaging/llvm.spec:326:  for mlgo_runtime_object in ${MLGO_REQUIRED_RUNTIME_OBJECTS}; do
codes/R104/llvm/packaging/llvm.spec:327:    mlgo_obj="${MLGO_AOT_DIR}/xla_runtime_objects/${mlgo_runtime_object}"
codes/R104/llvm/packaging/llvm.spec:328:    readelf -h "${mlgo_obj}" | grep -q "Machine:.*${MLGO_EXPECT_MACHINE}" || \
codes/R104/llvm/packaging/llvm.spec:329:      { echo "FATAL: ${mlgo_obj} arch mismatch (expected ${MLGO_EXPECT_MACHINE})"; exit 1; }
codes/R104/llvm/packaging/llvm.spec:338:  # Assertion 3: MLGO runtime is embedded and tf_xla_runtime is not exported.
codes/R104/llvm/packaging/llvm.spec:339:  grep -q '^LLVM_MLGO_EXPORT_TF_XLA_RUNTIME:BOOL=OFF$' "${MLGO_BUILD_DIR}/CMakeCache.txt" || \
codes/R104/llvm/packaging/llvm.spec:340:    { echo "FATAL: MLGO TensorFlow runtime export is not disabled"; exit 1; }
codes/R104/llvm/packaging/llvm.spec:341:  for mlgo_runtime_object in ${MLGO_REQUIRED_RUNTIME_OBJECTS}; do
codes/R104/llvm/packaging/llvm.spec:342:    grep -q "xla_runtime_objects/${mlgo_runtime_object}" "${MLGO_BUILD_DIR}/CMakeCache.txt" || \
codes/R104/llvm/packaging/llvm.spec:343:      { echo "FATAL: MLGO runtime object is not embedded: ${mlgo_runtime_object}"; exit 1; }
codes/R104/llvm/packaging/llvm.spec:345:  cmake --build . --target tf_xla_runtime || \
codes/R104/llvm/packaging/llvm.spec:346:    { echo "FATAL: tf_xla_runtime build failed"; exit 1; }
codes/R104/llvm/packaging/llvm.spec:347:  MLGO_PROBE_ROOT="$PWD/mlgo_probe_root"
codes/R104/llvm/packaging/llvm.spec:348:  rm -rf "${MLGO_PROBE_ROOT}"
codes/R104/llvm/packaging/llvm.spec:349:  mkdir -p "${MLGO_PROBE_ROOT}"
codes/R104/llvm/packaging/llvm.spec:350:  DESTDIR="${MLGO_PROBE_ROOT}" cmake --install . \
codes/R104/llvm/packaging/llvm.spec:351:    --prefix /usr --component tf_xla_runtime --verbose
codes/R104/llvm/packaging/llvm.spec:352:  ! find "${MLGO_PROBE_ROOT}" -name libtf_xla_runtime.a | grep -q . || \
codes/R104/llvm/packaging/llvm.spec:353:    { echo "FATAL: tf_xla_runtime archive should not be installed"; exit 1; }
