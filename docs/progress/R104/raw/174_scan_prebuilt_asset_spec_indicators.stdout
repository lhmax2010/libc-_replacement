codes/R104/tensorflow2/packaging/tensorflow2.spec:164:# Extract AOT components for LLVM MLGO support
codes/R104/tensorflow2/packaging/tensorflow2.spec:360:# Install saved_model_cli (AOT compiler tool)
codes/R104/tensorflow2/packaging/tensorflow2.spec:361:# Note: saved_model_cli is a Python script; fix shebang to use system python3
codes/R104/tensorflow2/packaging/tensorflow2.spec:362:if [ -f aot/bin/saved_model_cli ]; then
codes/R104/tensorflow2/packaging/tensorflow2.spec:364:  sed '1s|^#!.*python.*|#!/usr/bin/python3|' aot/bin/saved_model_cli > %{buildroot}%{_datadir}/tensorflow2/aot/bin/saved_model_cli
codes/R104/tensorflow2/packaging/tensorflow2.spec:365:  chmod 0755 %{buildroot}%{_datadir}/tensorflow2/aot/bin/saved_model_cli
codes/R104/tensorflow2/packaging/tensorflow2.spec:369:install -m 0644 build-aot/libtf_xla_runtime.a %{buildroot}%{_libdir}/libtf_xla_runtime.a
