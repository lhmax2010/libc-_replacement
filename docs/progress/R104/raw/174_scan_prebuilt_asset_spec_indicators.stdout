codes/R104/llvm/packaging/llvm.spec:198:# Set up MLGO AOT model paths from bundled verify assets
codes/R104/llvm/packaging/llvm.spec:199:%if %{with mlgo}
codes/R104/llvm/packaging/llvm.spec:200:MLGO_AOT_DIR="$PWD/mlgo_verify_assets"
codes/R104/llvm/packaging/llvm.spec:201:MLGO_BUILD_DIR="$PWD/build"
codes/R104/llvm/packaging/llvm.spec:202:MLGO_RUNTIME_OBJECTS="${MLGO_AOT_DIR}/xla_runtime_objects/xla_compiled_cpu_function.cc.o;${MLGO_AOT_DIR}/xla_runtime_objects/cpu_function_runtime.cc.o;${MLGO_AOT_DIR}/xla_runtime_objects/custom_call_status.cc.o;${MLGO_AOT_DIR}/xla_runtime_objects/executable_run_options.cc.o;${MLGO_AOT_DIR}/xla_runtime_objects/runtime_single_threaded_matmul_f32.cc.o"
codes/R104/llvm/packaging/llvm.spec:203:MLGO_REQUIRED_RUNTIME_OBJECTS="xla_compiled_cpu_function.cc.o cpu_function_runtime.cc.o custom_call_status.cc.o executable_run_options.cc.o runtime_single_threaded_matmul_f32.cc.o"
codes/R104/llvm/packaging/llvm.spec:273:%if %{with mlgo}
codes/R104/llvm/packaging/llvm.spec:275:    -DTENSORFLOW_AOT_PATH="${MLGO_AOT_DIR}/mlgo_sysroot" \
