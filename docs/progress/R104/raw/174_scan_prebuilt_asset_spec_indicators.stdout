codes/R104/llvm/packaging/llvm.spec:295:  # Assertion 0: MLGO_BUILD_DIR is correct (fail immediately with clear error if wrong)
codes/R104/llvm/packaging/llvm.spec:297:    { echo "FATAL: MLGO_BUILD_DIR wrong (CMakeCache.txt not found in $(pwd))"; exit 1; }
codes/R104/llvm/packaging/llvm.spec:298:%if %{with mlgo}
