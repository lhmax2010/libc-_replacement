docs/progress/R96/raw/002_review_r94_options_and_current_spec.command.txt:1:bash -lc $'\n  echo "[R94 options]"\n  sed -n "168,265p" docs/progress/R94/REPORT.md\n  echo "[R94 key matrix]"\n  cat docs/progress/R94/tables/build_matrix.tsv\n  echo "[current sandbox commit and spec]"\n  git -C tmp/R89/sandbox rev-parse HEAD\n  git -C tmp/R89/sandbox show dd4beffc30be18841818651756f4dbe1f54b0016:packaging/libcxx-runtimes.spec | nl -ba | sed -n "1,100p"\n  echo "[R91 one-line diff]"\n  git -C tmp/R89/sandbox --no-pager diff 48fc3a299ba20dd321a7d4a37c4e13ce095176cd dd4beffc30be18841818651756f4dbe1f54b0016 -- packaging/libcxx-runtimes.spec\n  echo "[R94 direct-Clang actual CMake and result]"\n  rg -n -C 2 "CMAKE_C_COMPILER=armv7l.*clang|compiler identification is Clang|Total succeeded built packages" docs/progress/R94/raw/022_build_armv7l_direct_cc_clang_probe.stdout\n  echo "[R94 output dependencies]"\n  cat docs/progress/R94/raw/027_inspect_actual_clang_driver_config.stdout\n' 
docs/progress/R96/raw/008_inspect_gbs_dependency_only_options.command.txt:1:gbs build --help 
docs/progress/R96/raw/006_locate_aarch64_existing_evidence.command.txt:1:bash -lc $'\n  echo "[existing aarch64 build roots]"\n  find tmp/GBS-ROOT GBS-ROOT-LLVM -maxdepth 5 -type d -name "scratch.aarch64.*" -print 2>/dev/null | sort || true\n  echo "[existing aarch64 compiler evidence]"\n  rg -n -m 40 "CMAKE_C_COMPILER=.*aarch64.*clang|The C compiler identification is Clang|aarch64-tizen-linux.*clang" progress docs/progress --glob "*.stdout" --glob "*.log" 2>/dev/null || true\n  echo "[project-config host references]"\n  for f in codes/qb/TIZEN/Tizen/Tizen-Base/project_config codes/qb/TIZEN/Tizen/Tizen-Unified/project_config codes/qb/TIZEN/Tizen/Tizen-Base-Toolchain/project_config codes/qb/TIZEN/Tizen/Tizen-Unified-Toolchain/project_config; do echo "===== $f ====="; rg -n -C 3 "aarch64|%_host|%__cc_clang" "$f" || true; done\n' 
docs/progress/R96/raw/007_inspect_existing_aarch64_buildroots.command.txt:1:bash -lc $'\n  for root in \\\n    tmp/GBS-ROOT/LIBCXX-2218-aarch64-20260804-r2/local/BUILD-ROOTS/scratch.aarch64.0 \\\n    tmp/GBS-ROOT/LIBCXX-2218-aarch64-20260806-c2/local/BUILD-ROOTS/scratch.aarch64.0 \\\n    tmp/GBS-ROOT/R30-final-security-libcxx-aarch64-20260812-01/local/BUILD-ROOTS/scratch.aarch64.0 \\\n    tmp/GBS-ROOT/R30-patched-libcynara-libcxx-aarch64-20260812-01/local/BUILD-ROOTS/scratch.aarch64.0; do\n    echo "===== $root ====="\n    test -d "$root" || { echo NOT_FOUND; continue; }\n    for p in "$root/bin/aarch64-tizen-linux-gnu-clang" "$root/usr/bin/aarch64-tizen-linux-gnu-clang" "$root/bin/aarch64-tizen-linux-gnu-clang++" "$root/usr/bin/aarch64-tizen-linux-gnu-clang++"; do if test -e "$p"; then ls -l "$p"; file -L "$p"; else echo "MISSING $p"; fi; done\n    if test -f "$root/usr/lib/rpm/macros"; then rg -n "^%__cc|^%__cxx|^%_host" "$root/usr/lib/rpm/macros" || true; fi\n    if test -f "$root/.build.log"; then rg -n -m 8 "--repository|CMAKE_C_COMPILER=|compiler identification" "$root/.build.log" || true; fi\n  done\n  echo "[exact historical aarch64 CMake evidence]"\n  rg -n -C 2 "CMAKE_C_COMPILER=aarch64-tizen-linux-gnu-clang|compiler identification is Clang" docs/progress/T3R2/build_aarch64.full.log docs/progress/R85/raw/059_build_id_flag_context.stdout docs/progress/R91/raw/030_unified_actual_macro_expansion.stdout\n' 
docs/progress/R96/raw/011_aarch64_compiler_name_gate_final.command.txt:1:bash -lc $'\n  root=tmp/GBS-ROOT/LIBCXX-2218-aarch64-20260804-r2/local/BUILD-ROOTS/scratch.aarch64.0\n  host=$(sed -n "s/^%_host[[:space:]]*//p" "$root/usr/lib/rpm/macros" | head -n 1)\n  cc="$root/usr/bin/${host}-clang"; cxx="$root/usr/bin/${host}-clang++"\n  echo "expanded_host=$host"; echo "cc=$cc"; echo "cxx=$cxx"\n  test "$host" = "aarch64-tizen-linux-gnu" || exit 3\n  test -L "$cc" -o -f "$cc" || exit 4\n  test -L "$cxx" -o -f "$cxx" || exit 5\n  cc_target=$(readlink -f "$cc"); cxx_target=$(readlink -f "$cxx")\n  echo "cc_target=$cc_target"; echo "cxx_target=$cxx_target"\n  test -f "$cc_target" || exit 6\n  test -f "$cxx_target" || exit 7\n  file "$cc_target" "$cxx_target"\n  echo "[actual historical execution evidence from this build family]"\n  rg -n -C 2 "CMAKE_C_COMPILER=aarch64-tizen-linux-gnu-clang|The C compiler identification is Clang 22\\.1\\.8|Found assembler: /bin/aarch64-tizen-linux-gnu-clang" docs/progress/T3R2/build_aarch64.full.log\n' 
