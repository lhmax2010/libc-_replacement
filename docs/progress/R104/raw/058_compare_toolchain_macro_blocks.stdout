FILE codes/qb/TIZEN/Tizen/Tizen-Base/project_config
    90	
    91	:Macros
    92	
    93	############################# build config #####################################
    94	
    95	########## targets ##########
    96	
    97	%ifarch i586
    98	Target: i686-tizen-linux
    99	%endif
   100	
   101	%ifarch armv7hl
   102	Target: armv7hl-tizen-linux
   103	%endif
   104	
   105	%ifarch armv7l
   106	Target: armv7l-tizen-linux
   107	%endif
   108	
   109	%ifarch aarch64
   110	Target: aarch64-tizen-linux
   111	%endif
   112	
   113	%ifarch riscv64
   114	Target: riscv64-tizen-linux
   115	%endif
   116	
   117	########## cross build ##########
   118	
   119	%define build_hostarch x86_64
   120	Macros:
   121	%build_hostarch x86_64
   122	:Macros
   123	
   124	%ifarch riscv64 %arm armv7l armv7hl aarch64
   125	Hostarch: x86_64
   126	# cross build support for the build hosts
   127	Preinstall: qemu-linux-user-%{build_hostarch}-cross
   128	Runscripts: qemu-linux-user-%{build_hostarch}-cross
   129	Keep: qemu-linux-user-%{build_hostarch}-cross
   130	Macros:
   131	%qemu_user_space_build 1
   132	:Macros
   133	%endif
   134	
   135	%ifarch armv7l
   136	Preinstall: qemu-accel-%{build_hostarch}-armv7l
   137	Runscripts: qemu-accel-%{build_hostarch}-armv7l
   138	Preinstall: libmount libblkid libuuid
   139	%endif
   140	
   141	%ifarch armv7hl
   142	Preinstall: qemu-accel-%{build_hostarch}-armv7hl
   143	Runscripts: qemu-accel-%{build_hostarch}-armv7hl
   144	Preinstall: libmount libblkid libuuid
   145	%endif
   146	
   147	%ifarch aarch64
   148	Preinstall: qemu-accel-%{build_hostarch}-aarch64
   149	Runscripts: qemu-accel-%{build_hostarch}-aarch64
   150	Preinstall: libmount libblkid libuuid
   151	%endif # aarch64
   152	
   153	%ifarch riscv64
   154	Preinstall: qemu-accel-%{build_hostarch}-riscv64
   155	Runscripts: qemu-accel-%{build_hostarch}-riscv64
   156	Preinstall: libmount libblkid libuuid
   157	%endif # riscv64
   158	
   159	Substitute: python-accel-armv7l-cross-arm python-accel-%{build_hostarch}-armv7l
   160	Substitute: python-accel-armv7hl-cross-arm python-accel-%{build_hostarch}-armv7hl
   161	Substitute: python-accel-aarch64-cross-aarch64 python-accel-%{build_hostarch}-aarch64
   162	Substitute: python-accel-riscv64-cross-riscv64 python-accel-%{build_hostarch}-riscv64
   163	
   164	Substitute: clang-accel-armv7l-cross-arm clang-accel-%{build_hostarch}-armv7l
   165	Substitute: clang-accel-armv7hl-cross-arm clang-accel-%{build_hostarch}-armv7hl
   166	Substitute: clang-accel-aarch64-cross-aarch64 clang-accel-%{build_hostarch}-aarch64
   167	Substitute: clang-accel-riscv64-cross-riscv64 clang-accel-%{build_hostarch}-riscv64
   168	
   169	########## exports for different architectures ##########
   170	
   171	ExportFilter: \.armv7l\.rpm$ armv7l
   172	ExportFilter: \.armv7hl\.rpm$ armv7hl
   173	ExportFilter: \.aarch64\.rpm$ aarch64
   174	ExportFilter: \.i586\.rpm$ i586
   175	ExportFilter: \.x86_64\.rpm$ x86_64
FILE codes/qb/TIZEN/Tizen/Tizen-Unified-Toolchain/project_config
    90	
    91	%if "%_repository" == "emulator"
    92	
    93	Prefer: libgbm
    94	Prefer: emulator-yagl emulator-yagl-devel
    95	
    96	%define _with_emulator 1
    97	Macros:
    98	%_with_emulator 1
    99	:Macros
   100	
   101	%endif
   102	
   103	############################# misc config flags ################################
   104	########## USAGE ##########
   105	#
   106	# IMPORTANT: please follow the following rules when playing with flags
   107	# ********************************************************************
   108	#
   109	# In spec file, call %bcond_with macro at the beginning and test with %with:
   110	# -------------------------
   111	# | %bcond_with myfeature
   112	# | [...]
   113	# | %if %{with myfeature}
   114	# | [...]
   115	# | %endif
   116	# | [...]
   117	# -------------------------
   118	#
   119	# To activate an option, use:
   120	# -------------------------
   121	# | %define _with_myfeature 1
   122	# | Macros:
   123	# | %_with_myfeature 1
   124	# | :Macros
   125	# -------------------------
   126	#
   127	# To disable an option, DON'T set the values to 0, as the option would still be defined
   128	# but simply comment the lines: this will undefine the option.
   129	# -------------------------
   130	# | #%define _with_myfeature 1
   131	# | #Macros:
   132	# | #%_with_myfeature 1
   133	# | #:Macros
   134	# -------------------------
   135	#
   136	# More information here:
   137	# https://en.opensuse.org/openSUSE:Build_Service_prjconf#.25bcond
   138	#
   139	
   140	########## flags ##########
   141	
   142	# Activate introspection
   143	# This is needed on GuPNP to build Rygel correctly in IVI
   144	# Impacts potentially packages that use gobject-introspection
   145	# Owner: Mikko <mikko.ylinen@intel.com>
   146	
   147	Macros:
   148	%_with_introspection 1
   149	:Macros
   150	
   151	Macros:
   152	%build %%build\
   153	export AR=%{__ar} RANLIB=%{__ranlib};\
   154	export CC=%{__cc} CXX=%{__cxx};\
   155	export MAKEFLAGS+=" -k";\
   156	%{nil}
   157	:Macros
   158	
   159	############################# other config #####################################
   160	# derived from Tizen:Base
   161	################################################################################
