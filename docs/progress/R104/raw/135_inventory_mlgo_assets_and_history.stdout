292:%if 0%{mlgo_verify_configure_only}
293-  # ---- configure-only probe: guard against §0 traps; check sentinels, GBS exit code non-0 is expected ----
294-  # Note: %%build does not guarantee set -e, so each assertion explicitly uses '|| { ...; exit 1; }'
295:  # Assertion 0: MLGO_BUILD_DIR is correct (fail immediately with clear error if wrong)
296-  test -f CMakeCache.txt || \
297:    { echo "FATAL: MLGO_BUILD_DIR wrong (CMakeCache.txt not found in $(pwd))"; exit 1; }
298-%if %{with mlgo}
299-  # Assertion 1: override actually took effect (COPYONLY artifacts exist from configure stage)
300-  test -f lib/Analysis/InlinerSizeModel.h || \
301-    { echo "FATAL: Missing InlinerSizeModel.h (override not effective, likely trap 1: silent fallback to none)"; exit 1; }
--
304-  test -f lib/CodeGen/RegAllocEvictModel.h || \
305-    { echo "FATAL: Missing RegAllocEvictModel.h(regalloc override not effective)"; exit 1; }
306-  test -f lib/CodeGen/RegAllocEvictModel.o || \
307-    { echo "FATAL: Missing RegAllocEvictModel.o(regalloc override not effective)"; exit 1; }
308:  for mlgo_runtime_object in ${MLGO_REQUIRED_RUNTIME_OBJECTS}; do
309:    test -f "${MLGO_AOT_DIR}/xla_runtime_objects/${mlgo_runtime_object}" || \
310:        { echo "FATAL: missing MLGO runtime object: ${mlgo_runtime_object}"; exit 1; }
311-  done
312-  # Assertion 1b: bundled objects must match the target arch.
313-%ifarch armv7l
