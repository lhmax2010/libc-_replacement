    19	Name:           abseil-cpp
    20	Version:        20250814.1
    21	Release:        0
    22	Summary:        C++11 libraries which augment the C++ stdlib
    23	License:        Apache-2.0
    24	URL:            https://abseil.io/
    25	Source0:        %{name}-%{version}.tar.gz
    26	BuildRequires:  cmake
    27	
    28	%description
    29	Abseil is a collection of C++11 libraries which augment the C++
    30	standard library. It also provides features incorporated into C++14
    31	and C++17 standards.
    32	
    33	%package devel
    34	Summary:        Header files for Abseil
    35	Requires:       %{name} = %{version}
    36	
    37	%description devel
    38	Abseil is a collection of C++11 libraries which augment the C++
    39	standard library.
    40	This package contains headers and build system files for it.
    41	
    42	%prep
    43	%setup -q
    44	
    45	%build
    46	mkdir -p cmake/build
    47	cd cmake/build
    48	%{cmake} -DABSL_USE_GOOGLETEST_HEAD=OFF ../..
    49	make %{?_smp_mflags}
    50	
    51	%install
    52	cd cmake/build
    53	make install DESTDIR=$RPM_BUILD_ROOT INSTALL="%{__install} -p"
    54	
    55	%files
    56	%license LICENSE
    57	%doc README.md
    58	%{_libdir}/libabsl_*.so.*
===== codes/R104/bcc-tools/packaging/bcc-tools.spec:1-82 =====
     1	%bcond_with examples
     2	
     3	Name: bcc-tools
     4	Version: 0.35.0
     5	Release: 0
     6	Summary: Tools for BPF-based Linux IO analysis, networking, monitoring
     7	License: Apache-2.0
     8	Vendor: None (open source)
     9	Group: Development/Compilers
    10	URL: https://github.com/iovisor/bcc
    11	Source0: %{name}-%{version}.tar.gz
    12	Requires: /sbin/ldconfig
    13	BuildRequires: gcc >= 3.4
    14	BuildRequires: cmake python3
    15	BuildRequires: python3-setuptools
    16	BuildRequires: bison flex llvm-devel clang-devel libelf-devel
    17	BuildRequires: llvm-static-devel
    18	BuildRequires: pkgconfig(zlib)
    19	BuildRequires: pkgconfig(libbpf)
    20	BuildRequires: zip
    21	BuildRequires:  libomp
    22	
    23	%description
    24	BCC is a toolkit for creating efficient kernel tracing and manipulation
    25	programs, and includes several useful tools and examples. It makes use
    26	of extended BPF (Berkeley Packet Filters), formally known as eBPF, a new
    27	feature that was first added to Linux 3.15. Much of what BCC uses
    28	requires Linux 4.1 and above.
    29	
    30	%package devel
    31	Summary: Developer package for BCC
    32	Requires: %{name} = %{version}-%{release}
    33	
    34	%description devel
    35	bcc tools - devel
    36	This package provides development libraries.
    37	
    38	%package static
    39	Summary: Static library for bcc development
    40	Requires: %{name}-devel = %{version}-%{release}
    41	
    42	%description static
    43	bcc tools - static
    44	This package provides development libraries.
    45	
    46	%if %{with examples}
    47	%package examples
    48	Summary: Example codes for BCC
    49	License: Apache-2.0
    50	
    51	%description examples
    52	This package provides example codes and documents.
    53	%endif
    54	
    55	%prep
    56	%setup -q -n bcc-tools-%{version}
    57	
    58	%build
    59	#DREVISION - number which will be put at back of the package name if repo isn't available
    60	LLVM_VERSION_MAJOR=$(llvm-config --version | cut -d. -f1)
    61	LLVM_SHARED_FLAG=
    62	if [ "${LLVM_VERSION_MAJOR}" -ge 22 ]; then
    63	    LLVM_SHARED_FLAG="-DENABLE_LLVM_SHARED=ON"
    64	fi
    65	
    66	%if %{with examples}
    67	%global install_cpp_examples ON
    68	%else
    69	%global install_cpp_examples OFF
    70	%endif
    71	
    72	cmake -DCMAKE_INSTALL_PREFIX=/usr -DINSTALL_CPP_EXAMPLES=%{install_cpp_examples} ${LLVM_SHARED_FLAG} -DREVISION="%{version}" -DCMAKE_USE_LIBBPF_PACKAGE:BOOL=TRUE .
    73	make %{?jobs:-j%jobs}
    74	
    75	%install
    76	make install DESTDIR=%{buildroot}
    77	
    78	%if %{without examples}
    79	rm -rf %{buildroot}%{_datadir}/bcc
    80	%endif
    81	
    82	%clean
