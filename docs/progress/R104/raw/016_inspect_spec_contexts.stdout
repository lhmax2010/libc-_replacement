    82	%description
    83	Boost provides free peer-reviewed portable C++ source libraries. The
    84	emphasis is on libraries that work well with the C++ Standard Library.
    85	One goal is to establish "existing practice" and provide reference
    86	implementations so that the Boost libraries are suitable for eventual
    87	standardization. Some of the libraries have already been proposed for
    88	inclusion in the C++ Standards Committee's upcoming C++ Standard
    89	Library Technical Report.
    90	
    91	Although Boost was begun by members of the C++ Standards Committee
    92	Library Working Group, membership has expanded to include nearly two
    93	thousand members of the C++ community at large.
    94	
    95	This package is mainly needed for updating from a prior version, the
    96	dynamic libraries are found in their respective package. For development
    97	using Boost, you also need the boost-devel package. For documentation,
    98	see the boost-doc package.
    99	
   100	%package        devel
   101	Summary:        Development package for Boost C++
   102	Group:          Development/Libraries/C and C++
   103	Requires:       %{all_libs}
   104	Requires:       libstdc++-devel
   105	
   106	%description    devel
   107	This package contains all that is needed to develop/compile
   108	applications that use the Boost C++ libraries. For documentation see
   109	the documentation packages (html, man or pdf).
   110	
   111	%package     -n boost-license
   112	Summary:        Boost License
===== codes/R104/boost/packaging/boost.spec:420-535 =====
   420	%setup -q -n %{name}_%{version}
   421	cp %{SOURCE1001} .
   422	%{__patch} -p1 < %{SOURCE1004}
   423	#everything in the tarball has the executable flag set ...
   424	find -type f ! \( -name \*.sh -o -name \*.py -o -name \*.pl \) -exec chmod -x {} +
   425	
   426	#stupid build machinery copies .orig files
   427	find . -name \*.orig -exec rm {} +
   428	
   429	%build
   430	CC="%{__cc}"
   431	export LDFLAGS="-Wl,--as-needed ${LDFLAGS}"
   432	%ifarch %arm
   433	CFLAGS="${CFLAGS} -Wp,-D_FILE_OFFSET_BITS=64"
   434	CXXFLAGS="${CXXFLAGS} -Wp,-D_FILE_OFFSET_BITS=64"
   435	%endif
   436	find . -type f -exec chmod u+w {} +
   437	
   438	# Create shared build instructions
   439	cat << \EOF >.build
   440	# Now build it
   441	J_P=%{jobs}
   442	J_G=$(getconf _NPROCESSORS_ONLN)
   443	JOBS=${JOBS-$J_P}
   444	[ $J_G -gt 64 ] && J_G=64
   445	
   446	if test -z "$JOBS"; then
   447	  JOBS=$J_G
   448	else
   449	  test 1 -gt "$JOBS" && JOBS=1
   450	fi
   451	
   452	%if %{disable_long_double}
   453	export LONG_DOUBLE_FLAGS="--disable-long-double"
   454	%endif
   455	BJAM_CONFIG="-d2 -j$JOBS -sICU_PATH=%{_prefix}"
   456	PYTHON_VERSION=$(python3 -c 'import sys; pyVer=sys.version.split(" ")[0].split(".");print("{0}.{1}".format(pyVer[0], pyVer[1]))')
   457	PYTHON_FLAGS=" --with-python-root=/usr/lib/python${PYTHON_VERSION} --with-python-version=${PYTHON_VERSION}"
   458	export REGEX_FLAGS="--with-icu"
   459	export EXPAT_INCLUDE=/usr/include EXPAT_LIBPATH=%{_libdir}
   460	export PYTHON_FLAGS
   461	LIBRARIES_FLAGS=--with-libraries=all
   462	
   463	%if !%{build_context}
   464	# coroutine/coroutine2 depend on context
   465	LIBRARIES_FLAGS="${LIBRARIES_FLAGS} --without-libraries=context,coroutine"
   466	%endif
   467	
   468	%if !%{build_fiber}
   469	LIBRARIES_FLAGS="${LIBRARIES_FLAGS} --without-libraries=fiber"
   470	%endif
   471	
   472	EOF
   473	
   474	touch user-config.jam
   475	
   476	# Read shared build instructions
   477	. ./.build
   478	
   479	%if %build_mpi
   480	# Set PATH, MANPATH and LD_LIBRARY_PATH for mpi
   481	. /var/mpi-selector/data/$(rpm --qf "%{NAME}-%{VERSION}" -q openmpi).sh
   482	%endif
   483	
   484	# use supplied bootstrap.sh instead of mucking with old bjam
   485	# see also: https://svn.boost.org/trac/boost/ticket/9304
   486	./bootstrap.sh $LIBRARIES_FLAGS \
   487	    --prefix=%{_prefix} --exec-prefix=%{_bindir} \
   488	    --libdir=%{_libdir} --includedir=%{_includedir} \
   489	    --with-toolset=${CC##*-}
   490	
   491	# add specific wishes in user-config.jam
   492	%if %build_docs
   493	cat << EOF >user-config.jam
   494	using xsltproc ;
   495	
   496	using boostbook
   497	    : /usr/share/xml/docbook/stylesheet/nwalsh/current
   498	    : /usr/share/xml/docbook/schema/dtd/4.2
   499	    ;
   500	
   501	using doxygen ;
   502	EOF
   503	%endif
   504	
   505	%if %build_mpi
   506	cat << EOF >>user-config.jam
   507	using mpi ;
   508	EOF
   509	%endif
   510	
   511	cat << EOF >>user-config.jam
   512	
   513	using python
   514	    : ${PYTHON_VERSION}
   515	    : /usr/bin/python3
   516	    : %{_includedir}/python${PYTHON_VERSION}
   517	    :
   518	    :
   519	    ;
   520	
   521	EOF
   522	
   523	# perform the compilation
   524	./b2 %{?_smp_mflags} --prefix=%{_prefix} --libdir=%{_libdir} \
   525	    --user-config=./user-config.jam ${CFLAGS:+cflags="$CFLAGS"} \
   526	    ${CXXFLAGS:+cxxflags="$CXXFLAGS"} ${LDFLAGS:+linkflags="$LDFLAGS"} \
   527	    target-os=unix
   528	
   529	
   530	%if %build_docs
   531	cd doc
   532	../b2 --user-config=../user-config.jam --v2 man
   533	%endif
   534	
   535	%if 0%{?run_tests}
===== codes/R104/bpftrace/packaging/bpftrace.spec:1-85 =====
     1	Name:           bpftrace
     2	Version:        0.24.2
     3	Release:        1
     4	Summary:        High-level tracing language for Linux eBPF
     5	License:        Apache-2.0
     6	
     7	Source0:        %{name}-%{version}.tar.gz
     8	Source1001:     %{name}.manifest
     9	Source1002:     prebuilt-static-bpftrace.tar.gz
    10	
    11	ExclusiveArch:  armv7l aarch64
    12	
    13	BuildRequires:  gcc-c++
    14	BuildRequires:  bison
    15	BuildRequires:  flex
    16	BuildRequires:  cmake
    17	BuildRequires:  pkgconfig(libelf)
    18	BuildRequires:  zlib-devel
    19	BuildRequires:  llvm-devel
    20	BuildRequires:  llvm-static-devel
    21	BuildRequires:  clang-devel
    22	BuildRequires:  bcc-tools-devel
    23	BuildRequires:  libbpf-devel
    24	# for xxd command
    25	BuildRequires:  vim
    26	BuildRequires:  cereal-devel
    27	BuildRequires:  tar
    28	BuildRequires:  libomp
    29	
    30	%description
    31	BPFtrace is a high-level tracing language for Linux enhanced Berkeley Packet
    32	Filter (eBPF) available in recent Linux kernels (4.x). BPFtrace uses LLVM as a
    33	backend to compile scripts to BPF-bytecode and makes use of BCC for
    34	interacting with the Linux BPF system, as well as existing Linux tracing
    35	capabilities: kernel dynamic tracing (kprobes), user-level dynamic tracing
    36	(uprobes), and tracepoints. The BPFtrace language is inspired by awk and C,
    37	and predecessor tracers such as DTrace and SystemTap
    38	
    39	%package common
    40	Summary: Common files for bpftrace (scripts, man pages, bash-completion)
    41	
    42	%description common
    43	This package contains architecture-independent files for bpftrace:
    44	- Example bpftrace scripts (.bt files)
    45	- Man pages
    46	- Bash completion
    47	
    48	%package static
    49	Summary: High-level tracing language for Linux eBPF (static binary)
    50	
    51	%description static
    52	BPFtrace is a high-level tracing language for Linux enhanced Berkeley Packet
    53	Filter (eBPF) available in recent Linux kernels (4.x). BPFtrace uses LLVM as a
    54	backend to compile scripts to BPF-bytecode and makes use of BCC for
    55	interacting with the Linux BPF system, as well as existing Linux tracing
    56	capabilities: kernel dynamic tracing (kprobes), user-level dynamic tracing
    57	(uprobes), and tracepoints. The BPFtrace language is inspired by awk and C,
    58	and predecessor tracers such as DTrace and SystemTap
    59	
    60	This package is the bpftrace static binary.
    61	
    62	%prep
    63	%setup -q
    64	cp %{SOURCE1001} .
    65	tar xzvf %{SOURCE1002}
    66	
    67	%build
    68	%{?asan:/usr/bin/gcc-unforce-options}
    69	%{?ubsan:/usr/bin/gcc-unforce-options}
    70	
    71	mkdir build
    72	cd build
    73	cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_VERBOSE_MAKEFILE=ON -DBUILD_TESTING=OFF -DSTATIC_LINKING=OFF \
    74	         -DCMAKE_SKIP_RPATH:BOOL=ON -DCMAKE_INSTALL_PREFIX:PATH=%{_prefix}
    75	%make_build
    76	cd ..
    77	
    78	%install
    79	cd build
    80	%make_install
    81	cd ..
    82	
    83	# Install bpftrace static binary
    84	install -m 0755 prebuilt-static-bpftrace/%{_arch}%{_bindir}/bpftrace %{buildroot}%{_bindir}/bpftrace-static
    85	
