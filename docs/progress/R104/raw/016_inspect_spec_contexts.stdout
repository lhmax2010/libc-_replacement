     8	Name:      icu
     9	Version:   78.1
    10	Release:   1
    11	Summary:   International Components for Unicode
    12	Group:     System/Libraries
    13	License:   ICU and Unicode-TOU and BSD-2.0
    14	URL:       http://www.icu-project.org/
    15	Source0:   %{name}-%{version}.tar.gz
    16	Source1:   tzdata%{tzdata_version}.tar.gz
    17	Source2:   set_disable_renameing.patch
    18	Source3:   Disable-the-default-LDFLAGSICUDT.patch
    19	Source4:   Add_PIE_option_for_tzcode.patch
    20	Source5:   Set_define_false_and_true.patch
    21	Source6:   Change_localtime_path.patch
    22	Source7:   Set_icu_timezone_files_dir.patch
    23	Source1001: icu.manifest
    24	
    25	BuildRequires: autoconf
    26	BuildRequires: pkgconfig(python3)
    27	
    28	%description
    29	Tools and utilities for developing with icu.
    30	
    31	%package -n libicu
    32	Summary: International Components for Unicode - libraries
    33	
    34	%description -n libicu
    35	The International Components for Unicode (ICU) libraries provide
    36	robust and full-featured Unicode services on a wide variety of
    37	platforms. ICU supports the most current version of the Unicode
    38	standard, and they provide support for supplementary Unicode
    39	characters (needed for GB 18030 repertoire support).
    40	As computing environments become more heterogeneous, software
    41	portability becomes more important. ICU lets you produce the same
    42	results across all the various platforms you support, without
    43	sacrificing performance. It offers great flexibility to extend and
    44	customize the supplied services.
    45	
    46	%package  -n libicu-devel
    47	Summary:  Development files for International Components for Unicode
    48	Requires: libicu = %{version}-%{release}
    49	Requires: pkgconfig
    50	
    51	%description -n libicu-devel
    52	Includes and definitions for developing with icu.
    53	
    54	%package  -n libicu-tzdata
    55	Summary:  package for ICU TimeZone Updating
    56	Requires: libicu = %{version}-%{release}
    57	Requires: pkgconfig
    58	
    59	%description -n libicu-tzdata
    60	Initial setup for ICU timezone .res file
    61	
    62	%prep
    63	%setup -q
    64	cp %{SOURCE1001} .
    65	%{__patch} -p1 < %{SOURCE2}
    66	%{__patch} -p1 < %{SOURCE3}
    67	%{__patch} -p1 < %{SOURCE4}
    68	%{__patch} -p1 < %{SOURCE5}
    69	%{__patch} -p1 < %{SOURCE6}
    70	%{__patch} -p1 < %{SOURCE7}
    71	
    72	cp %{SOURCE1} ./source/tools/tzcode
    73	
    74	%build
    75	export CFLAGS="$CFLAGS -D_TIZEN_FEATURE_ -fPIC"
    76	export CXXFLAGS="$CXXFLAGS -D_TIZEN_FEATURE_ -fPIC"
    77	export LINKFLAGS=" -pie"
    78	export LANG=C.UTF-8
    79	
    80	cd source
    81	%{configure} --enable-static=no \
    82	            --enable-renaming=no \
    83	            --enable-shared \
    84	            --enable-plugins=yes \
    85	            --enable-samples=no \
    86	%ifarch armv7hl
    87	            --with-data-packaging=archive
    88	%else
    89	            --with-data-packaging=library
    90	%endif
    91	%{__make} %{?_smp_mflags}
    92	
    93	%check
    94	#    pushd source
    95	#    %__make check || exit 0
===== codes/R104/jsoncpp/packaging/jsoncpp.spec:1-55 =====
     1	%global jsondir json
     2	
     3	Name:       jsoncpp
     4	Version:    1.9.6
     5	Release:    0
     6	Summary:    JSON library implemented in C++
     7	Group:      System Environment/Libraries
     8	License:    Public-domain or MIT
     9	URL:        https://github.com/open-source-parsers/jsoncpp
    10	Source0:    %{name}-%{version}.tar.gz
    11	Source1:    baselibs.conf
    12	Source1001: jsoncpp.manifest
    13	
    14	BuildRequires:  cmake
    15	
    16	%description
    17	%{name} is an implementation of a JSON (http://json.org) reader and writer in
    18	C++. JSON (JavaScript Object Notation) is a lightweight data-interchange format.
    19	It is easy for humans to read and write. It is easy for machines to parse and
    20	generate.
    21	
    22	
    23	%package devel
    24	Summary:    Development headers and library for %{name}
    25	Group:      Development/Libraries
    26	Requires:   %{name}%{?_isa} = %{version}-%{release}
    27	
    28	%description devel
    29	This package contains the development headers and library for %{name}.
    30	
    31	%prep
    32	%setup -q -n %{name}-%{version}
    33	cp %{SOURCE1001} .
    34	
    35	%build
    36	mkdir build
    37	(cd build && \
    38	%cmake -DJSONCPP_WITH_TESTS=OFF \
    39	       -DJSONCPP_WITH_POST_BUILD_UNITTEST=OFF \
    40	       -DBUILD_SHARED_LIBS=ON \
    41	       -DBUILD_STATIC_LIBS=OFF \
    42	       .. && \
    43	%__make %{?_smp_mflags})
    44	
    45	# Build the doc
    46	# python doxybuild.py --doxygen %{_bindir}/doxygen
    47	
    48	#%check
    49	# Tests are run automatically in the build section
    50	# ctest -V %{?_smp_mflags}
    51	
    52	%install
    53	(cd build && \
    54	%__make install DESTDIR=%{buildroot})
    55	
===== codes/R104/libsigc++/packaging/libsigc++.spec:1-58 =====
     1	Name:           libsigc++
     2	Version:        2.12.1
     3	Release:        1
     4	Summary:        Typesafe Signal Framework for C++
     5	License:        LGPL-2.1-or-later
     6	URL:            https://github.com/libsigcplusplus/libsigcplusplus
     7	Source0:        %{name}-%{version}.tar.gz
     8	Source1001:     %{name}.manifest
     9	
    10	BuildRequires:  meson
    11	BuildRequires:  pkg-config
    12	BuildRequires:  mm-common
    13	BuildRequires:  libxslt-tools
    14	BuildRequires:  doxygen
    15	BuildRequires:  m4
    16	BuildRequires:  python3
    17	
    18	%description
    19	This library implements a full callback system for use in widget
    20	libraries, abstract interfaces, and general programming. It is the most
    21	complete library of its kind with the ability to connect an abstract
    22	callback to a class method, function, or function object. It contains
    23	adaptor classes for connection of dissimilar callbacks and has an ease
    24	of use unmatched by other C++ callback libraries.
    25	
    26	%package devel
    27	Summary:        Development files for %{name}
    28	Requires:       %{name} = %{version}-%{release}
    29	
    30	%description devel
    31	Development files and headers for %{name}.
    32	This package contains libraries and header files for
    33	developing applications that use %{name}.
    34	
    35	%prep
    36	%setup -q -n %{name}-%{version}
    37	cp %{SOURCE1001} .
    38	
    39	%build
    40	%meson \
    41	    -Dmaintainer-mode=true \
    42	    -Dbuild-deprecated-api=true \
    43	    -Dbuild-documentation=false \
    44	    -Dbuild-examples=false \
    45	    -Dbuild-tests=false \
    46	    -Dbenchmark=false \
    47	    -Dwarning_level=1
    48	
    49	%meson_build
    50	
    51	%install
    52	%meson_install
    53	
    54	# Remove static libraries and libtool files
    55	find %{buildroot} -type f -name "*.a" -delete -print
    56	find %{buildroot} -type f -name "*.la" -delete -print
    57	
    58	%remove_docs
===== codes/R104/llvm/packaging/llvm.spec:1-70 =====
     1	%define keepstatic 1
     2	
     3	# MLGO AOT support for LLVM MLGO (Ahead-of-Time compilation)
     4	# TODO: switch back to a project_config-controlled macro after MLGO is enabled
     5	# for all required arches.
     6	# %%bcond_with mlgo
