TF_PC
     1	Name: tensorflow-lite
     2	Description: This is a standalone package of TensorFlow Lite.
     3	Version: 2.18.0
     4	Libs: -L@libdir@ -ltensorflow2-lite
     5	Cflags: -I@includedir@
     1	prefix=@prefix@
     2	exec_prefix=@exec_prefix@
     3	libdir=@libdir@
     4	includedir=@includedir@
     5	aot_path=@aot_path@
     6	
     7	Name: tensorflow2-aot
     8	Description: TensorFlow XLA AOT compilation support for LLVM MLGO
     9	Version: @VERSION@
    10	Requires: tensorflow2-lite
    11	Libs: -L${libdir} -ltf_xla_runtime
    12	Cflags: -I${includedir}/tensorflow2/aot/include
BCC_PKGCONFIG
FILE codes/R104/bcc-tools/src/cc/libbcc.pc.in
prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/include
datarootdir=${prefix}/share

compatdir=${includedir}/bcc/compat

Name: libbcc
Version: @REVISION@
Description: BCC Program library
Requires:
Libs: -L${libdir} -lbcc
Cflags: -I${includedir} -I${compatdir}
BPFTRACE_LINK_SECTION
    90	
    91	# Linking
    92	if(STATIC_LINKING)
    93	  target_link_options(bpftrace BEFORE PRIVATE "-static-libgcc" "-static-libstdc++")
    94	endif(STATIC_LINKING)
    95	
    96	
    97	target_link_libraries(runtime debugfs output tracefs util)
    98	target_link_libraries(runtime ${LIBBPF_LIBRARIES} ${ZLIB_LIBRARIES})
    99	target_link_libraries(libbpftrace parser runtime aot ast arch util cxxdemangler_llvm)
   100	
   101	if(LIBPCAP_FOUND)
   102	  target_link_libraries(libbpftrace ${LIBPCAP_LIBRARIES})
   103	endif(LIBPCAP_FOUND)
   104	
   105	if(HAVE_BFD_DISASM)
   106	  if(STATIC_LINKING OR LIBBFD_STATIC)
   107	    add_library(LIBBFD STATIC IMPORTED)
   108	    set_property(TARGET LIBBFD PROPERTY IMPORTED_LOCATION ${LIBBFD_LIBRARIES})
   109	    target_link_libraries(runtime LIBBFD)
   110	    add_library(LIBOPCODES STATIC IMPORTED)
   111	    set_property(TARGET LIBOPCODES PROPERTY IMPORTED_LOCATION ${LIBOPCODES_LIBRARIES})
   112	    target_link_libraries(runtime LIBOPCODES)
   113	    add_library(LIBIBERTY STATIC IMPORTED)
   114	    set_property(TARGET LIBIBERTY PROPERTY IMPORTED_LOCATION ${LIBIBERTY_LIBRARIES})
   115	    target_link_libraries(runtime LIBIBERTY)
   116	
   117	    add_library(LIBZSTD STATIC IMPORTED)
   118	    if (LIBZSTD_LIBRARIES)
   119	      set_property(TARGET LIBZSTD PROPERTY IMPORTED_LOCATION ${LIBZSTD_LIBRARIES})
   120	      target_link_libraries(runtime LIBZSTD)
   121	    endif(LIBZSTD_LIBRARIES)
   122	
   123	    add_library(LIBSFRAME STATIC IMPORTED)
   124	    if (LIBSFRAME_LIBRARIES)
   125	      set_property(TARGET LIBSFRAME PROPERTY IMPORTED_LOCATION ${LIBSFRAME_LIBRARIES})
   126	      target_link_libraries(runtime LIBSFRAME)
   127	    endif(LIBSFRAME_LIBRARIES)
   128	  else()
   129	    target_link_libraries(runtime ${LIBBFD_LIBRARIES})
   130	    target_link_libraries(runtime ${LIBOPCODES_LIBRARIES})
   131	  endif(STATIC_LINKING OR LIBBFD_STATIC)
   132	endif(HAVE_BFD_DISASM)
   133	
   134	# Link to bcc libraries (without LLVM) if possible
   135	if(LIBBCC_BPF_CONTAINS_RUNTIME)
   136	  target_link_libraries(runtime ${LIBBCC_BPF_LIBRARIES})
   137	else()
   138	  target_link_libraries(runtime ${LIBBCC_LIBRARIES})
   139	endif()
   140	
   141	if(STATIC_LINKING)
   142	  # These are not part of the static libbcc so have to be added separate
   143	  target_link_libraries(runtime ${LIBBCC_BPF_LIBRARIES})
   144	  target_link_libraries(runtime ${LIBBPF_LIBRARIES})
   145	  target_link_libraries(runtime ${LIBBCC_LOADER_LIBRARY_STATIC})
   146	
   147	  find_package(LibLzma)
   148	  add_library(LIBLZMA STATIC IMPORTED)
   149	  set_property(TARGET LIBLZMA PROPERTY IMPORTED_LOCATION ${LIBLZMA_LIBRARIES})
   150	  target_link_libraries(runtime LIBLZMA)
   151	
   152	  add_library(LIBELF STATIC IMPORTED)
   153	  set_property(TARGET LIBELF PROPERTY IMPORTED_LOCATION ${LIBELF_LIBRARIES})
   154	  target_link_libraries(runtime LIBELF)
   155	else()
   156	  target_link_libraries(runtime ${LIBELF_LIBRARIES})
   157	endif(STATIC_LINKING)
   158	
   159	if (LIBDW_FOUND)
   160	  if(STATIC_LINKING)
   161	    find_package(LibBz2)
   162	    find_package(LibEbl)
   163	
   164	    add_library(LIBBZ2 STATIC IMPORTED)
   165	    set_property(TARGET LIBBZ2 PROPERTY IMPORTED_LOCATION ${LIBBZ2_LIBRARIES})
   166	
   167	    add_library(LIBDW STATIC IMPORTED)
   168	    set_property(TARGET LIBDW PROPERTY IMPORTED_LOCATION ${LIBDW_LIBRARIES})
   169	
   170	    set(LIBDW_LIBS LIBBZ2 LIBELF LIBLZMA)
LLVM_SPEC_LIBCXX_ABSENCE
