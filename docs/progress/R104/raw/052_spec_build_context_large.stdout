FILE codes/R104/boost/packaging/boost.spec LINES 420-570
   420	%setup -q -n %{name}_%{version}
   421	cp %{SOURCE1001} .
   422	%{__patch} -p1 < %{SOURCE1004}
   423	#everything in the tarball has the executable flag set ...
   424	find -type f ! \( -name \*.sh -o -name \*.py -o -name \*.pl \) -exec chmod -x {} +
   425	
   426	#stupid build machinery copies .orig files
   427	find . -name \*.orig -exec rm {} +
   428	
   429	%build
   430	CC="%{__cc}"
   431	export LDFLAGS="-Wl,--as-needed ${LDFLAGS}"
   432	%ifarch %arm
   433	CFLAGS="${CFLAGS} -Wp,-D_FILE_OFFSET_BITS=64"
   434	CXXFLAGS="${CXXFLAGS} -Wp,-D_FILE_OFFSET_BITS=64"
   435	%endif
   436	find . -type f -exec chmod u+w {} +
   437	
   438	# Create shared build instructions
   439	cat << \EOF >.build
   440	# Now build it
   441	J_P=%{jobs}
   442	J_G=$(getconf _NPROCESSORS_ONLN)
   443	JOBS=${JOBS-$J_P}
   444	[ $J_G -gt 64 ] && J_G=64
   445	
   446	if test -z "$JOBS"; then
   447	  JOBS=$J_G
   448	else
   449	  test 1 -gt "$JOBS" && JOBS=1
   450	fi
   451	
   452	%if %{disable_long_double}
   453	export LONG_DOUBLE_FLAGS="--disable-long-double"
   454	%endif
   455	BJAM_CONFIG="-d2 -j$JOBS -sICU_PATH=%{_prefix}"
   456	PYTHON_VERSION=$(python3 -c 'import sys; pyVer=sys.version.split(" ")[0].split(".");print("{0}.{1}".format(pyVer[0], pyVer[1]))')
   457	PYTHON_FLAGS=" --with-python-root=/usr/lib/python${PYTHON_VERSION} --with-python-version=${PYTHON_VERSION}"
   458	export REGEX_FLAGS="--with-icu"
   459	export EXPAT_INCLUDE=/usr/include EXPAT_LIBPATH=%{_libdir}
   460	export PYTHON_FLAGS
   461	LIBRARIES_FLAGS=--with-libraries=all
   462	
   463	%if !%{build_context}
   464	# coroutine/coroutine2 depend on context
   465	LIBRARIES_FLAGS="${LIBRARIES_FLAGS} --without-libraries=context,coroutine"
   466	%endif
   467	
   468	%if !%{build_fiber}
   469	LIBRARIES_FLAGS="${LIBRARIES_FLAGS} --without-libraries=fiber"
   470	%endif
   471	
   472	EOF
   473	
   474	touch user-config.jam
   475	
   476	# Read shared build instructions
   477	. ./.build
   478	
   479	%if %build_mpi
   480	# Set PATH, MANPATH and LD_LIBRARY_PATH for mpi
   481	. /var/mpi-selector/data/$(rpm --qf "%{NAME}-%{VERSION}" -q openmpi).sh
   482	%endif
   483	
   484	# use supplied bootstrap.sh instead of mucking with old bjam
   485	# see also: https://svn.boost.org/trac/boost/ticket/9304
   486	./bootstrap.sh $LIBRARIES_FLAGS \
   487	    --prefix=%{_prefix} --exec-prefix=%{_bindir} \
   488	    --libdir=%{_libdir} --includedir=%{_includedir} \
   489	    --with-toolset=${CC##*-}
   490	
   491	# add specific wishes in user-config.jam
   492	%if %build_docs
   493	cat << EOF >user-config.jam
   494	using xsltproc ;
   495	
   496	using boostbook
   497	    : /usr/share/xml/docbook/stylesheet/nwalsh/current
   498	    : /usr/share/xml/docbook/schema/dtd/4.2
   499	    ;
   500	
   501	using doxygen ;
   502	EOF
   503	%endif
   504	
   505	%if %build_mpi
   506	cat << EOF >>user-config.jam
   507	using mpi ;
   508	EOF
   509	%endif
   510	
   511	cat << EOF >>user-config.jam
   512	
   513	using python
   514	    : ${PYTHON_VERSION}
   515	    : /usr/bin/python3
   516	    : %{_includedir}/python${PYTHON_VERSION}
   517	    :
   518	    :
   519	    ;
   520	
   521	EOF
   522	
   523	# perform the compilation
   524	./b2 %{?_smp_mflags} --prefix=%{_prefix} --libdir=%{_libdir} \
   525	    --user-config=./user-config.jam ${CFLAGS:+cflags="$CFLAGS"} \
   526	    ${CXXFLAGS:+cxxflags="$CXXFLAGS"} ${LDFLAGS:+linkflags="$LDFLAGS"} \
   527	    target-os=unix
   528	
   529	
   530	%if %build_docs
   531	cd doc
   532	../b2 --user-config=../user-config.jam --v2 man
   533	%endif
   534	
   535	%if 0%{?run_tests}
   536	BOOST_LIBS="chrono,program_options,thread,system,filesystem,date_time,regex,serialization,iostreams,random,test"
   537	install -m 0755 %{SOURCE1003} ./
   538	echo "RUN run_test.sh"
   539	./run_test.sh %{version} $BOOST_LIBS %{testlogfile} || exit 0
   540	%endif
   541	
   542	%install
   543	
   544	%if 0%{?run_tests}
   545	install -D -m 644 %{testlogfile} $RPM_BUILD_ROOT%{_datadir}/boosttestsuite.log
   546	%endif
   547	
   548	# Read shared build instructions
   549	. ./.build
   550	
   551	%if %build_mpi
   552	# Set PATH, MANPATH and LD_LIBRARY_PATH for mpi
   553	. /var/mpi-selector/data/$(rpm --qf "%{NAME}-%{VERSION}" -q openmpi).sh
   554	%endif
   555	
   556	./b2 install %{?_smp_mflags} \
   557	    --prefix=%{buildroot}%{_prefix} --exec-prefix=%{buildroot}%{_bindir} \
   558	    --libdir=%{buildroot}%{_libdir} --includedir=%{buildroot}%{_includedir} \
   559	    --user-config=./user-config.jam target-os=unix
   560	
   561	# do not install the python module - as long as noone needs it, it requires more fixes
   562	# see https://bugzilla.redhat.com/show_bug.cgi?id=801534 for details
   563	rm -f %{buildroot}%{_libdir}/mpi.so
   564	
   565	mkdir -p %{buildroot}%{_docdir}
   566	
   567	(
   568	cd %{buildroot}%{_libdir}
   569	blibs=$(find . -name \*.so.%{version})
   570	echo $blibs | xargs chrpath -d
