FILE codes/R104/tensorflow2/packaging/tensorflow2.spec LINES 1-90
     1	Name:           tensorflow2
     2	Summary:        TensorFlow 2.x with Lite and XLA AOT support
     3	Version:        2.18.0
     4	Release:        1
     5	License:        Apache-2.0
     6	Source0:        %{name}-%{version}.tar.gz
     7	Source1001:     tensorflow2.manifest
     8	Source1002:     tensorflow2-lite.pc.in
     9	Source1003:     tensorflow2-aot.pc.in
    10	
    11	Source2000:     abseil-cpp.tar.gz
    12	Source2001:     cpuinfo.tar.gz
    13	Source2002:     egl_headers.tar.gz
    14	Source2003:     eigen.tar.gz
    15	Source2004:     farmhash.tar.gz
    16	Source2005:     fft2d.tar.gz
    17	Source2006:     flatbuffers.tar.gz
    18	Source2007:     fp16.tar.gz
    19	Source2008:     gemmlowp.tar.gz
    20	Source2009:     ml_dtypes.tar.gz
    21	Source2010:     neon2sse.tar.gz
    22	Source2011:     opencl_headers.tar.gz
    23	Source2012:     opengl_headers.tar.gz
    24	Source2013:     protobuf.tar.gz
    25	Source2014:     ruy.tar.gz
    26	Source2015:     vulkan_headers.tar.gz
    27	Source2016:     XNNPACK-cpuinfo.tar.gz
    28	Source2017:     XNNPACK-FP16-psimd.tar.gz
    29	Source2018:     XNNPACK-fp16.tar.gz
    30	Source2019:     XNNPACK-fxdiv.tar.gz
    31	Source2020:     XNNPACK-kleidiai.tar.gz
    32	Source2021:     XNNPACK-pthreadpool.tar.gz
    33	Source2022:     xnnpack.tar.gz
    34	
    35	# AOT (Ahead-of-Time) compilation support for LLVM MLGO
    36	# Generated by: scripts/extract_aot_components.sh
    37	Source3000:     tensorflow2-aot.tar.gz
    38	
    39	%define USE_CLANG     "ON"
    40	%define USE_XNNPACK   "ON"
    41	%define USE_OPENCL    "ON"
    42	%define SHARED_LIB    "OFF"
    43	
    44	# clang + armv7hl build fails
    45	%ifarch armv7hl
    46	%define USE_CLANG     "OFF"
    47	%endif
    48	
    49	%if %{USE_CLANG} == "ON"
    50	%ifarch armv7l
    51	BuildRequires: python-accel-armv7l-cross-arm
    52	BuildRequires: clang-accel-armv7l-cross-arm
    53	%endif
    54	
    55	%ifarch armv7hl
    56	BuildRequires: python-accel-armv7hl-cross-arm
    57	BuildRequires: clang-accel-armv7hl-cross-arm
    58	%endif
    59	
    60	%ifarch aarch64
    61	BuildRequires: python-accel-aarch64-cross-aarch64
    62	BuildRequires: clang-accel-aarch64-cross-aarch64
    63	%endif
    64	
    65	%ifarch riscv64
    66	BuildRequires: python-accel-riscv64-cross-riscv64
    67	BuildRequires: clang-accel-riscv64-cross-riscv64
    68	%endif
    69	
    70	BuildRequires: clang
    71	%endif
    72	
    73	BuildRequires: cmake
    74	BuildRequires: ninja
    75	BuildRequires: python3
    76	
    77	%description
    78	This is a standalone package of TensorFlow Lite.
    79	TensorFlow Lite is TensorFlow's lightweight solution for mobile and embedded devices. It enables low-latency inference of on-device machine learning models with a small binary size and fast performance supporting hardware acceleration.
    80	
    81	See the documentation: https://www.tensorflow.org/lite/
    82	
    83	%package lite-devel
    84	Summary: TensorFlow Lite development headers and static library.
    85	
    86	%description lite-devel
    87	TensorFlow Lite development headers and static library.
    88	
    89	%package lite-flatbuf-schema
    90	Summary: TensorFlow Lite schema file
FILE codes/R104/tensorflow2/packaging/tensorflow2.spec LINES 145-270
   145	cp %{SOURCE2018} .
   146	cp %{SOURCE2019} .
   147	cp %{SOURCE2020} .
   148	cp %{SOURCE2021} .
   149	cp %{SOURCE2022} .
   150	popd
   151	
   152	# Extract AOT components for LLVM MLGO support
   153	mkdir -p aot
   154	pushd aot
   155	tar xzf %{SOURCE3000}
   156	popd
   157	
   158	%build
   159	mkdir -p build
   160	pushd build
   161	
   162	%if %{USE_CLANG} == "ON"
   163	%define host_triplet %(echo %{_host} | sed 's/^i686-/i586-/')
   164	CLANG_ASMFLAGS=" --target=%{host_triplet} "
   165	CLANG_CFLAGS=" --target=%{host_triplet} "
   166	CLANG_CXXFLAGS=" --target=%{host_triplet} "
   167	
   168	export ASMFLAGS="${CLANG_ASMFLAGS}"
   169	export CFLAGS="${CLANG_CFLAGS}"
   170	export CXXFLAGS="${CLANG_CXXFLAGS}"
   171	%else # USE_CLANG OFF
   172	%ifarch %arm aarch64
   173	  EXTRA_CFLAGS="${EXTRA_CFLAGS} -funsafe-math-optimizations"
   174	  EXTRA_CXXFLAGS="${EXTRA_CXXFLAGS} -funsafe-math-optimizations"
   175	  %ifarch %arm
   176	    EXTRA_CFLAGS="${EXTRA_CFLAGS} -mno-unaligned-access"
   177	    EXTRA_CXXFLAGS="${EXTRA_CXXFLAGS} -mno-unaligned-access"
   178	  %endif
   179	  %ifarch armv7l
   180	    EXTRA_CFLAGS="${EXTRA_CFLAGS} -mfloat-abi=softfp -march=armv7-a -mfpu=neon-vfpv4 -funsafe-math-optimizations -mfp16-format=ieee"
   181	    EXTRA_CXXFLAGS="${EXTRA_CXXFLAGS} -mfloat-abi=softfp -march=armv7-a -mfpu=neon-vfpv4 -funsafe-math-optimizations -mfp16-format=ieee"
   182	  %endif
   183	  %ifarch armv7hl
   184	    EXTRA_CFLAGS="${EXTRA_CFLAGS} -mfloat-abi=hard -march=armv7-a -mfpu=neon-vfpv4 -funsafe-math-optimizations -mfp16-format=ieee"
   185	    EXTRA_CXXFLAGS="${EXTRA_CXXFLAGS} -mfloat-abi=hard -march=armv7-a -mfpu=neon-vfpv4 -funsafe-math-optimizations -mfp16-format=ieee"
   186	  %endif
   187	%endif
   188	
   189	# VD/TV: Disable a link-time optimization (requested on 2020-06-09)
   190	%if "%{?profile}" == "tv"
   191	  EXTRA_CFLAGS="${EXTRA_CFLAGS} -fno-lto"
   192	  EXTRA_CXXFLAGS="${EXTRA_CXXFLAGS} -fno-lto"
   193	  %ifarch armv7l
   194	    EXTRA_CFLAGS="${EXTRA_CFLAGS} -march=armv7-a -mtune=cortex-a8"
   195	    EXTRA_CXXFLAGS="${EXTRA_CXXFLAGS} -march=armv7-a -mtune=cortex-a8"
   196	    EXTRA_CFLAGS=${EXTRA_CFLAGS/-mcpu=cortex-a53/}
   197	    EXTRA_CXXFLAGS=${EXTRA_CXXFLAGS/-mcpu=cortex-a53/}
   198	  %endif
   199	%endif
   200	%endif # USE_CLANG
   201	
   202	%if %{USE_CLANG} == "ON"
   203	export CC=clang
   204	export CXX=clang++
   205	CC=clang CXX=clang++ \
   206	cmake \
   207	  -DCMAKE_C_COMPILER=clang \
   208	  -DCMAKE_CXX_COMPILER=clang++ \
   209	  -DCMAKE_VERBOSE_MAKEFILE=ON \
   210	  -GNinja \
   211	  -DTFLITE_BUILD_SHARED_LIB="%{SHARED_LIB}" \
   212	  -DTFLITE_ENABLE_XNNPACK="%{USE_XNNPACK}" \
   213	  -DTFLITE_ENABLE_GPU="%{USE_OPENCL}" \
   214	  ../tensorflow/lite
   215	%else # USE_CLANG OFF
   216	cmake \
   217	  -DCMAKE_VERBOSE_MAKEFILE=ON \
   218	  -GNinja \
   219	  -DCMAKE_C_FLAGS="${EXTRA_CFLAGS}" \
   220	  -DCMAKE_CXX_FLAGS="${EXTRA_CXXFLAGS}" \
   221	  -DTFLITE_BUILD_SHARED_LIB="%{SHARED_LIB}" \
   222	  -DTFLITE_ENABLE_XNNPACK="%{USE_XNNPACK}" \
   223	  -DXNNPACK_ENABLE_ARM_BF16=OFF \
   224	  -DXNNPACK_ENABLE_ARM_I8MM=OFF \
   225	  -DTFLITE_ENABLE_GPU="%{USE_OPENCL}" \
   226	  ../tensorflow/lite
   227	%endif # USE_CLANG
   228	
   229	cmake --build . %{?_smp_mflags}
   230	
   231	cmake --build . %{?_smp_mflags} -t benchmark_model
   232	
   233	popd
   234	
   235	# Build AOT runtime library (xla_aot_runtime_src)
   236	# Use the same cross-compilation setup as TFLite build
   237	mkdir -p build-aot
   238	pushd build-aot
   239	
   240	%if %{USE_CLANG} == "ON"
   241	cmake \
   242	  -DCMAKE_C_COMPILER=clang \
   243	  -DCMAKE_CXX_COMPILER=clang++ \
   244	  -DCMAKE_C_FLAGS="${CFLAGS}" \
   245	  -DCMAKE_CXX_FLAGS="${CXXFLAGS}" \
   246	  -DCMAKE_VERBOSE_MAKEFILE=ON \
   247	  -GNinja \
   248	  %{_builddir}/%{name}-%{version}/aot/xla_aot_runtime_src
   249	%else
   250	cmake \
   251	  -DCMAKE_C_FLAGS="${EXTRA_CFLAGS}" \
   252	  -DCMAKE_CXX_FLAGS="${EXTRA_CXXFLAGS}" \
   253	  -DCMAKE_VERBOSE_MAKEFILE=ON \
   254	  -GNinja \
   255	  %{_builddir}/%{name}-%{version}/aot/xla_aot_runtime_src
   256	%endif
   257	
   258	ninja
   259	popd
   260	
   261	%install
   262	mkdir -p %{buildroot}%{_libdir}
   263	mkdir -p %{buildroot}%{_libdir}/pkgconfig
   264	mkdir -p %{buildroot}%{_includedir}/tensorflow2/lite
   265	mkdir -p %{buildroot}%{_includedir}/tensorflow2/compiler/mlir
   266	mkdir -p %{buildroot}%{_bindir}
   267	mkdir -p %{buildroot}%{_datadir}/tensorflow2/lite/schema
   268	pushd %{buildroot}%{_includedir}/tensorflow2
   269	ln -sf . %{buildroot}%{_includedir}/tensorflow2/tensorflow
   270	# TF2Lite users do: #include <tensorflow/FILENAME.h>
