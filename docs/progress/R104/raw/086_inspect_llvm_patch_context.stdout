    32	Name:      llvm
    33	Summary:   The LLVM Project is a collection of modular and reusable compiler and toolchain technologies
    34	Version:   22.1.8
    35	Release:   1
    36	Group:     Development/Toolchain
    37	License:   NCSA
    38	Source0:   %{name}-%{version}.tar.gz
    39	Source1001: llvm.manifest
    40	
    41	# Bundled MLGO AOT assets for the inliner and regalloc models.
    42	# These override build-time AOT compilation, avoiding the need for TensorFlow
    43	# Python in GBS.
    44	Source1002: mlgo_arm_model.tar.gz
    45	Source1003: mlgo_aarch_model.tar.gz
    46	Source1004: mlgo_x86_model.tar.gz
    47	
    48	%{!?mlgo_build_jobs: %define mlgo_build_jobs 6}
    49	%{!?mlgo_verify_configure_only: %define mlgo_verify_configure_only 0}
    50	
    51	BuildRequires: cmake
    52	BuildRequires: python3
    53	BuildRequires: python3-devel
    54	BuildRequires: patchelf
    55	BuildRequires: binutils-devel
    56	BuildRequires: libxml2-devel
    57	%if 0%{llvm_release_build}
    58	BuildRequires: sed
    59	%endif
    60	BuildRequires: ninja
    61	
    62	
    63	Requires: libllvm = %{version}-%{release}
    64	
    65	%description
    66	LLVM is a compiler infrastructure designed for compile-time, link-time, runtime,
    67	and idle-time optimization of programs from arbitrary programming languages.
    68	LLVM is written in C++ and has been developed since 2000 at the University of
    69	Illinois and Apple. It currently supports compilation of C and C++ programs,
    70	using front-ends derived from GCC 4.0.1. A new front-end for the C family of
    71	languages is in development. The compiler infrastructure
    72	includes mirror sets of programming tools as well as libraries with equivalent
    73	functionality.
    74	
    75	%package devel
    76	Summary: Libraries and Header Files for LLVM %{version}
    77	Requires: %{name} = %{version}
    78	
    79	%description devel
    80	This package contains library and header files needed to develop
    81	new native programs that use the LLVM infrastructure.
    82	
    83	%package static-devel
    84	Summary: Static libraries for LLVM
    85	Requires: %{name} = %{version}
    86	
    87	%description static-devel
    88	This package contains static libraries needed to develop new
    89	native programs that use the LLVM infrastructure.
    90	
    91	%package -n libllvm
    92	Summary: LLVM shared libraries
    93	
    94	%description -n libllvm
    95	Shared libraries for the LLVM compiler infrastructure.
    96	
    97	%package -n clang
    98	Summary: Clang %{version} (C Language family frontend for LLVM)
    99	License: NCSA
   100	Requires: llvm = %{version}-%{release}
   101	Provides: libclang.so.%{version}
   102	
   103	%description -n clang
   104	A new front-end for the C family of languages is in development.
   105	
   106	%package -n clang-devel
   107	Summary: Clang %{version} Development Library
   108	Requires: clang = %{version}-%{release}
   109	
   110	%description -n clang-devel
   111	This package contains the clang (C language) frontend for LLVM.
   112	(development files)
   113	
   114	%package -n lldb
   115	Summary: LLDB
   116	License: NCSA
   117	
   118	%description -n lldb
   119	LLDB is a next generation, high-performance debugger. It is built as a set
   120	of reusable components which highly leverage existing libraries in the
   121	larger LLVM Project, such as the Clang expression parser and LLVM
   122	disassembler.
   123	
   124	%package -n lldb-devel
   125	Summary: Development header files for LLDB
   126	Requires: lldb = %{version}-%{release}
   127	
   128	%description -n lldb-devel
   129	The package contains header files for the LLDB debugger.
   130	
   131	%package -n compiler-rt
   132	Summary: Compiler runtime libraries
   133	
   134	%description -n compiler-rt
   135	Compiler runtime libraries
   136	
   137	%package -n libomp
   138	Summary:    OpenMP runtime
   139	
   140	%description -n libomp
   141	OpenMP runtime.
   142	
   143	%package -n libomp-devel
   144	Summary:    Development files for the OpenMP runtime
   145	
   146	%description -n libomp-devel
   147	Development files for the OpenMP runtime.
   148	
   149	%package -n python-clang
   150	Summary: Python bindings to parts of the Clang library
   151	
   152	%description -n python-clang
   153	Python bindings to parts of the Clang library
   154	
   155	%prep
   156	%setup -q
   157	%if %{with mlgo}
   158	mkdir -p mlgo_verify_assets
   159	%ifarch armv7l
   160	tar -C mlgo_verify_assets -xzf %{SOURCE1002}
   161	%endif
   162	%ifarch aarch64
   163	tar -C mlgo_verify_assets -xzf %{SOURCE1003}
   164	%endif
   165	%ifarch x86_64
   166	tar -C mlgo_verify_assets -xzf %{SOURCE1004}
   167	%endif
   168	%endif
   169	
   170	%build
   171	%if 0%{llvm_release_build}
   172	# Not to build debug info
   173	RELCFLAGS=$(echo $CFLAGS | sed -e 's*\(^\|[[:space:]]\)-g\([[:digit:]]\+\|gdb\|dwarf-[[:digit:]]\)\?* *g')
   174	export CFLAGS=${RELCFLAGS}
   175	RELCXXFLAGS=$(echo $CXXFLAGS | sed -e 's*\(^\|[[:space:]]\)-g\([[:digit:]]\+\|gdb\|dwarf-[[:digit:]]\)\?* *g')
   176	export CXXFLAGS=${RELCXXFLAGS}
   177	RELFFLAGS=$(echo $FFLAGS | sed -e 's*\(^\|[[:space:]]\)-g\([[:digit:]]\+\|gdb\)|dwarf-[[:digit:]]\\?* *g')
   178	export FFLAGS=${RELFFLAGS}
   179	%endif
   180	
   181	cp %{SOURCE1001} .
   182	%{?asan:%gcc_unforce_options}
   183	
   184	%ifarch armv7l
   185	export QEMU_RESERVED_VA=0x100000000
   186	%endif
   187	
   188	# Set up MLGO AOT model paths from bundled verify assets
   189	%if %{with mlgo}
   190	MLGO_AOT_DIR="$PWD/mlgo_verify_assets"
   191	MLGO_BUILD_DIR="$PWD/build"
   192	MLGO_RUNTIME_OBJECTS="${MLGO_AOT_DIR}/xla_runtime_objects/xla_compiled_cpu_function.cc.o;${MLGO_AOT_DIR}/xla_runtime_objects/cpu_function_runtime.cc.o;${MLGO_AOT_DIR}/xla_runtime_objects/custom_call_status.cc.o;${MLGO_AOT_DIR}/xla_runtime_objects/executable_run_options.cc.o;${MLGO_AOT_DIR}/xla_runtime_objects/runtime_single_threaded_matmul_f32.cc.o"
   193	MLGO_REQUIRED_RUNTIME_OBJECTS="xla_compiled_cpu_function.cc.o cpu_function_runtime.cc.o custom_call_status.cc.o executable_run_options.cc.o runtime_single_threaded_matmul_f32.cc.o"
   194	%endif
   195	
   196	mkdir -p build
   197	cd build
   198	cmake \
   199	    -G Ninja \
   200	    -DTIZEN=1 \
   201	    -DCMAKE_C_COMPILER=%__cc \
   202	    -DCMAKE_CXX_COMPILER=%__cxx \
   203	    -DLLVM_HOST_TRIPLE=%{_host} \
   204	    -DLLVM_DEFAULT_TARGET_TRIPLE=%{_host} \
   205	    -DLLVM_TARGET_TRIPLE_ENV=%{_host} \
   206	    -DCMAKE_ASM_FLAGS="$CFLAGS" \
   207	    -DCMAKE_C_FLAGS="$CFLAGS" \
   208	    -DCMAKE_CXX_FLAGS="$CXXFLAGS" \
   209	%if %{defined _toolchain}
   210	    -DCMAKE_SHARED_LINKER_FLAGS="-fuse-ld=lld -ffunction-sections -fdata-sections -Wl,--gc-sections" \
   211	    -DCMAKE_EXE_LINKER_FLAGS="-fuse-ld=lld -ffunction-sections -fdata-sections -Wl,--gc-sections" \
   212	    -DLLVM_USE_LINKER=lld \
   213	%endif
   214	    -DLLVM_ENABLE_ASSERTIONS=No \
   215	    -DLLVM_ENABLE_RTTI=ON \
   216	%ifarch x86_64 i686
   217	    -DCMAKE_BUILD_TYPE=Release \
   218	    -DLLVM_TARGETS_TO_BUILD='X86;ARM;AArch64;BPF' \
   219	%endif
   220	%ifarch armv7l
   221	    -DCMAKE_BUILD_TYPE=MinSizeRel \
   222	    -DLLVM_TARGETS_TO_BUILD='ARM;BPF' \
   223	    -DLLVM_TARGET_ARCH="ARM" \
   224	%endif
   225	%ifarch aarch64
   226	    -DCMAKE_BUILD_TYPE=Release \
   227	    -DLLVM_TARGETS_TO_BUILD='AArch64;BPF' \
   228	    -DLLVM_TARGET_ARCH="AArch64" \
   229	%endif
   230	%ifarch riscv64
   231	    -DCMAKE_BUILD_TYPE=Release \
   232	    -DLLVM_TARGETS_TO_BUILD='RISCV;BPF' \
   233	%endif
   234	    -DCLANG_ENABLE_ARCMT=OFF \
   235	    -DLLVM_BUILD_LLVM_DYLIB=ON \
   236	    -DCLANG_BUILD_CLANG_DYLIB=ON \
   237	%if %{defined _toolchain}
   238	    -DLLVM_LINK_LLVM_DYLIB=ON \
   239	    -DCLANG_LINK_CLANG_DYLIB=ON \
   240	%endif
   241	    -DLLVM_ENABLE_PROJECTS="clang;lldb;clang-tools-extra;lld;compiler-rt;openmp" \
   242	    -DLLVM_ENABLE_PER_TARGET_RUNTIME_DIR=OFF \
   243	    -DLLVM_BUILD_EXAMPLES=OFF \
   244	    -DLLVM_INCLUDE_EXAMPLES=OFF \
   245	    -DLLVM_BUILD_TESTS=OFF \
   246	    -DLLVM_INCLUDE_TESTS=OFF \
   247	    -DLLVM_ENABLE_DOXYGEN=OFF \
   248	    -DLLVM_BUILD_DOCS=OFF \
   249	    -DLLVM_INCLUDE_DOCS=OFF \
   250	    -DLLVM_OPTIMIZED_TABLEGEN=ON \
   251	    -DCMAKE_INSTALL_PREFIX=%{_prefix} \
   252	    -DLLVM_LIBDIR_SUFFIX=`echo %{_lib} | sed s/lib//g` \
   253	    -DCLANG_RESOURCE_DIR="../%{_lib}/clang/%{llvm_version}" \
   254	    -DLLVM_BINUTILS_INCDIR=/usr/include \
   255	    -DLLVM_PARALLEL_COMPILE_JOBS=6 \
   256	    -DLLVM_PARALLEL_LINK_JOBS=2 \
   257	%if %{with mlgo}
   258	%ifarch armv7l aarch64 x86_64
   259	    -DTENSORFLOW_AOT_PATH="${MLGO_AOT_DIR}/mlgo_sysroot" \
   260	    -DLLVM_MLGO_EXPORT_TF_XLA_RUNTIME=OFF \
   261	    -DLLVM_MLGO_EMBED_TF_XLA_RUNTIME_OBJECTS="${MLGO_RUNTIME_OBJECTS}" \
   262	    -DLLVM_OVERRIDE_MODEL_HEADER_INLINERSIZEMODEL="${MLGO_AOT_DIR}/InlinerSizeModel.h" \
   263	    -DLLVM_OVERRIDE_MODEL_OBJECT_INLINERSIZEMODEL="${MLGO_AOT_DIR}/InlinerSizeModel.o" \
   264	    -DLLVM_OVERRIDE_MODEL_HEADER_REGALLOCEVICTMODEL="${MLGO_AOT_DIR}/RegAllocEvictModel.h" \
   265	    -DLLVM_OVERRIDE_MODEL_OBJECT_REGALLOCEVICTMODEL="${MLGO_AOT_DIR}/RegAllocEvictModel.o" \
   266	%else
   267	    -DLLVM_INLINER_MODEL_PATH=none \
   268	    -DLLVM_RAEVICT_MODEL_PATH=none \
   269	%endif
   270	%else
   271	    -DLLVM_INLINER_MODEL_PATH=none \
   272	    -DLLVM_RAEVICT_MODEL_PATH=none \
   273	%endif
   274	    ../llvm
   275	
   276	%if 0%{mlgo_verify_configure_only}
   277	  # ---- configure-only probe: guard against §0 traps; check sentinels, GBS exit code non-0 is expected ----
   278	  # Note: %%build does not guarantee set -e, so each assertion explicitly uses '|| { ...; exit 1; }'
   279	  # Assertion 0: MLGO_BUILD_DIR is correct (fail immediately with clear error if wrong)
   280	  test -f CMakeCache.txt || \
   281	    { echo "FATAL: MLGO_BUILD_DIR wrong (CMakeCache.txt not found in $(pwd))"; exit 1; }
   282	%if %{with mlgo}
   283	  # Assertion 1: override actually took effect (COPYONLY artifacts exist from configure stage)
   284	  test -f lib/Analysis/InlinerSizeModel.h || \
   285	    { echo "FATAL: Missing InlinerSizeModel.h (override not effective, likely trap 1: silent fallback to none)"; exit 1; }
   286	  test -f lib/Analysis/InlinerSizeModel.o || \
   287	    { echo "FATAL: Missing InlinerSizeModel.o (override not effective)"; exit 1; }
   288	  test -f lib/CodeGen/RegAllocEvictModel.h || \
   289	    { echo "FATAL: Missing RegAllocEvictModel.h(regalloc override not effective)"; exit 1; }
   290	  test -f lib/CodeGen/RegAllocEvictModel.o || \
   291	    { echo "FATAL: Missing RegAllocEvictModel.o(regalloc override not effective)"; exit 1; }
   292	  for mlgo_runtime_object in ${MLGO_REQUIRED_RUNTIME_OBJECTS}; do
   293	    test -f "${MLGO_AOT_DIR}/xla_runtime_objects/${mlgo_runtime_object}" || \
   294	        { echo "FATAL: missing MLGO runtime object: ${mlgo_runtime_object}"; exit 1; }
   295	  done
   296	  # Assertion 1b: bundled objects must match the target arch.
   297	%ifarch armv7l
   298	  MLGO_EXPECT_MACHINE="ARM"
   299	%endif
   300	%ifarch aarch64
   301	  MLGO_EXPECT_MACHINE="AArch64"
   302	%endif
   303	%ifarch x86_64
   304	  MLGO_EXPECT_MACHINE="X86-64"
   305	%endif
   306	  for mlgo_obj in lib/Analysis/InlinerSizeModel.o lib/CodeGen/RegAllocEvictModel.o; do
   307	    readelf -h "${mlgo_obj}" | grep -q "Machine:.*${MLGO_EXPECT_MACHINE}" || \
   308	      { echo "FATAL: ${mlgo_obj} arch mismatch (expected ${MLGO_EXPECT_MACHINE})"; exit 1; }
   309	  done
   310	  for mlgo_runtime_object in ${MLGO_REQUIRED_RUNTIME_OBJECTS}; do
   311	    mlgo_obj="${MLGO_AOT_DIR}/xla_runtime_objects/${mlgo_runtime_object}"
   312	    readelf -h "${mlgo_obj}" | grep -q "Machine:.*${MLGO_EXPECT_MACHINE}" || \
   313	      { echo "FATAL: ${mlgo_obj} arch mismatch (expected ${MLGO_EXPECT_MACHINE})"; exit 1; }
   314	  done
   315	  # Assertion 2: did not fall into autogenerate mock. Use && short-circuit: file missing => FATAL, don't let '! grep' pass
   316	  test -f CMakeCache.txt && \
   317	    ! grep -qE 'LLVM_INLINER_MODEL_PATH(:[^=]+)?=autogenerate' CMakeCache.txt || \
   318	    { echo "FATAL: Fell into autogenerate mock or CMakeCache missing (trap 2)"; exit 1; }
   319	  test -f CMakeCache.txt && \
   320	    ! grep -qE 'LLVM_RAEVICT_MODEL_PATH(:[^=]+)?=autogenerate' CMakeCache.txt || \
   321	    { echo "FATAL: regalloc fell into autogenerate mock"; exit 1; }
   322	  # Assertion 3: MLGO runtime is embedded and tf_xla_runtime is not exported.
   323	  grep -q '^LLVM_MLGO_EXPORT_TF_XLA_RUNTIME:BOOL=OFF$' "${MLGO_BUILD_DIR}/CMakeCache.txt" || \
   324	    { echo "FATAL: MLGO TensorFlow runtime export is not disabled"; exit 1; }
   325	  for mlgo_runtime_object in ${MLGO_REQUIRED_RUNTIME_OBJECTS}; do
   326	    grep -q "xla_runtime_objects/${mlgo_runtime_object}" "${MLGO_BUILD_DIR}/CMakeCache.txt" || \
   327	      { echo "FATAL: MLGO runtime object is not embedded: ${mlgo_runtime_object}"; exit 1; }
   328	  done
   329	  cmake --build . --target tf_xla_runtime || \
   330	    { echo "FATAL: tf_xla_runtime build failed"; exit 1; }
   331	  MLGO_PROBE_ROOT="$PWD/mlgo_probe_root"
   332	  rm -rf "${MLGO_PROBE_ROOT}"
   333	  mkdir -p "${MLGO_PROBE_ROOT}"
   334	  DESTDIR="${MLGO_PROBE_ROOT}" cmake --install . \
   335	    --prefix /usr --component tf_xla_runtime --verbose
   336	  ! find "${MLGO_PROBE_ROOT}" -name libtf_xla_runtime.a | grep -q . || \
   337	    { echo "FATAL: tf_xla_runtime archive should not be installed"; exit 1; }
   338	%endif
   339	  echo MLGO_VERIFY_CONFIGURE_PASS
   340	  exit 86
   341	%endif
   342	
   343	# Full build using ninja (already in build/ directory after cd build)
   344	ninja -j %{mlgo_build_jobs}
