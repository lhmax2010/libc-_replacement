   346	%install
   347	cd build
   348	cmake -DCMAKE_INSTALL_PREFIX=%{buildroot}/usr -P cmake_install.cmake
   349	ln -sf %{_prefix}/bin/clang++ %{buildroot}%{_prefix}/bin/clang++-%{llvm_version}
   350	
   351	ln -sf clang %{buildroot}%{_prefix}/bin/%{_host}-clang
   352	ln -sf clang++ %{buildroot}%{_prefix}/bin/%{_host}-clang++
   353	# Use host triple and resource dir by default via <lang>.cfg
   354	cat >> %{buildroot}/%{_prefix}/bin/clang.cfg << EOF
   355	-target %{_host}
   356	-resource-dir %{_prefix}/%{_lib}/clang/%{llvm_version}
   357	EOF
   358	ln -sf clang.cfg %{buildroot}/%{_prefix}/bin/clang++.cfg
   359	
   360	# copy lldb for sdk
   361	mkdir -p %{buildroot}%{sdk_bin_dir}
   362	mkdir -p %{buildroot}%{sdk_lib_dir}
   363	
   364	mv %{buildroot}%{_prefix}/bin/lldb %{buildroot}%{sdk_bin_dir}
   365	mv %{buildroot}%{_prefix}/bin/lldb-argdumper %{buildroot}%{sdk_bin_dir}
   366	mv %{buildroot}%{_prefix}/bin/lldb-server %{buildroot}%{sdk_bin_dir}
   367	
   368	ln -sf %{sdk_bin_dir}/lldb %{buildroot}%{_prefix}/bin/
   369	
   370	cp -P %{buildroot}%{_libdir}/liblldb.so* %{buildroot}%{sdk_lib_dir}/
   371	
   372	# Install the clang python bits
   373	mkdir -p %{buildroot}%{python3_sitelib}
   374	cp -a ../clang/bindings/python/clang %{buildroot}%{python3_sitelib}/
   375	
   376	rm -rf %{buildroot}%{_libdir}/debug/*
   377	rm -rf %{buildroot}/usr/lib/libear/*
   378	rm -rf %{buildroot}/usr/lib/libscanbuild/*
   379	
