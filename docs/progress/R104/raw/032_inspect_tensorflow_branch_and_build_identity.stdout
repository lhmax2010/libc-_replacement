223:BuildRequires:	gst-plugins-base-devel
224:BuildRequires:	gst-plugins-bad-devel
225:BuildRequires:	glib2-devel
226:BuildRequires:	meson >= 0.62.0
227-
228-%{?_toolchain:
229-%if %{toolchain_is clang}
230:BuildRequires:	compiler-rt
231-%endif
232-}
233-
234-# To run test cases, we need gst plugins
235:BuildRequires:	gst-plugins-good
236-%if 0%{tizen_version_major} >= 5
237:BuildRequires:	gst-plugins-good-extra
238-%endif
239:BuildRequires:	gst-plugins-base
240-# and gtest
241:BuildRequires:	gtest-devel
242-# a few test cases uses python
243-%if 0%{?check_test}
244:BuildRequires:	python3
245-%endif
246-%if 0%{?python3_support}
247-# for python3 custom filters
248:BuildRequires:	python3-devel
249:BuildRequires:	python3-numpy-devel
250-%endif
251-# Testcase requires bmp2png, which requires libpng
252:BuildRequires:  pkgconfig(libpng)
253-%if 0%{?flatbuf_support}
254-# for flatbuffers
255:BuildRequires: flatbuffers-devel
256-%if 0%{?unit_test}
257:BuildRequires: flatbuffers-python
258-%endif
259-%endif
260:%if 0%{?tensorflow_lite_support}
261:# for tensorflow-lite
262:BuildRequires: tensorflow-lite-devel
263-%endif
264:%if 0%{?tensorflow2_lite_support}
265:# for tensorflow2-lite
266:BuildRequires: tensorflow2-lite-devel
267:# tensorflow2-lite-custom requires scripts for rpm >= 4.9
268:BuildRequires:  rpm >= 4.9
269:%global __requires_exclude ^libtensorflow2-lite-custom.*$
270-%endif
271-# custom_example_opencv filter requires opencv-devel
272:BuildRequires: opencv-devel
273-# For './testAll.sh' time limit.
274:BuildRequires: procps
275-# for protobuf
276-%if 0%{?protobuf_support}
277:BuildRequires: protobuf-devel >= 3.4.0
278-%endif
279:# for tensorflow
280:%if 0%{?tensorflow_support}
281:BuildRequires: tensorflow
282:BuildRequires: tensorflow-devel
283-%endif
284-# for armnn
285-%if 0%{?armnn_support}
286:BuildRequires: armnn-devel
287-%endif
288-
289-%if 0%{?edgetpu_support}
290:BuildRequires:	pkgconfig(edgetpu)
291-%endif
292-
293-%if 0%{?testcoverage}
294-# to be compatible with gcc-9, lcov should have a higher version than 1.14.1
295:BuildRequires: lcov
296:# BuildRequires:	taos-ci-unittest-coverage-assessment
297-%endif
298-
299-%if 0%{mvncsdk2_support}
300:BuildRequires:	pkgconfig(libmvnc)
301-%endif
302-
303-%if 0%{openvino_support}
304:BuildRequires:	pkgconfig(openvino)
305-%endif
306-
307-# for Vivante
308-%if 0%{?vivante_support}
309:BuildRequires:  pkgconfig(ovxlib)
310:BuildRequires:  pkgconfig(amlogic-vsi-npu-sdk)
311-%endif
312-
313-# TensorRT
314-%if 0%{?tensorrt_support}
315:BuildRequires: tensorrt-devel
316-%endif
317-
318-%if 0%{?grpc_support}
319:BuildRequires:  grpc-devel
320-%endif
321-
322-%if %{with tizen}
323:BuildRequires:	pkgconfig(dlog)
324-# For tizen sensor support
325:BuildRequires:	pkgconfig(sensor)
326:BuildRequires:	capi-system-sensor-devel
327-%endif  # tizen
328-
329-%if 0%{?nnfw_support}
330-# Tizen 5.5 M2+ support nn-runtime (nnfw)
331-# As of 2019-09-24, unfortunately, nnfw does not support pkg-config
332:BuildRequires:  nnfw-devel
333-%endif
334-
335-%if 0%{?pytorch_support}
336:BuildRequires:	pytorch-devel
337-%endif
338-
