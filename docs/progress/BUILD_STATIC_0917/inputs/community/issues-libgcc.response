      "title": "Fail with \"Too many open files\" for script with few probes",
      "user": {
        "login": "mkindahl",
        "id": 1175692,
        "node_id": "MDQ6VXNlcjExNzU2OTI=",
        "avatar_url": "https://avatars.githubusercontent.com/u/1175692?v=4",
