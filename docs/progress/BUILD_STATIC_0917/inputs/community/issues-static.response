        "blocking": 0,
        "total_blocking": 0
      },
      "body": "<!--\nNote: bpftrace is under active development and not all distros ship the most\nrecent version yet. Please make sure the bug reproduces on the latest release\nor master.\n-->\n\n### What reproduces the bug? Provide code if possible.\nWhen using bpftrace v0.23.2 to trace SCSI commands, the buf() function fails to correctly capture the contents of dynamic arrays.\n\n    [root@VM-Rocky9-Dev ~]# ./bpftrace.0.23.2 --version\n    bpftrace v0.23.2\n    [root@VM-Rocky9-Dev ~]# ./bpftrace.0.23.2 -e '\n    > tracepoint:scsi:scsi_dispatch_cmd_start {\n    >     $cmnd = buf(args->cmnd, args->cmd_len);\n    >     printf(\"SCSI CMD, pid:%u, lun:%u:%u:%u:%u, opcode:0x%x, data_sglen:%u, prot_op:%u, prot_sglen:%u, cmdlen:%u, cmnd=\\\"%rh\\\"\\n\", \n    >         pid, args->host_no, args->channel, args->id, args->lun,\n    >         args->opcode, args->data_sglen, args->prot_op, args->prot_sglen,\n    >         args->cmd_len, $cmnd); \n    > }'\n    Attaching 1 probe...\n    SCSI CMD, pid:27080, lun:1:0:0:0, opcode:0x4a, data_sglen:2, prot_op:0, prot_sglen:0, cmdlen:10, cmnd=\"00 00 00 00 00 00 00 00 00 00\"\n    SCSI CMD, pid:27080, lun:1:0:0:0, opcode:0x4a, data_sglen:2, prot_op:0, prot_sglen:0, cmdlen:10, cmnd=\"00 00 00 00 00 00 00 00 00 00\"\n    SCSI CMD, pid:27080, lun:1:0:0:0, opcode:0x4a, data_sglen:2, prot_op:0, prot_sglen:0, cmdlen:10, cmnd=\"00 00 00 00 00 00 00 00 00 00\"\n\nHowever, this issue does not occur in the older v0.21.1.\n\n    [root@VM-Rocky9-Dev ~]# bpftrace --version\n    bpftrace v0.21.1\n    [root@VM-Rocky9-Dev ~]# bpftrace -e '\n    > tracepoint:scsi:scsi_dispatch_cmd_start {\n    >     $cmnd = buf(args->cmnd, args->cmd_len);\n    >     printf(\"SCSI CMD, pid:%u, lun:%u:%u:%u:%u, opcode:0x%x, data_sglen:%u, prot_op:%u, prot_sglen:%u, cmdlen:%u, cmnd=\\\"%rh\\\"\\n\", \n    >         pid, args->host_no, args->channel, args->id, args->lun,\n    >         args->opcode, args->data_sglen, args->prot_op, args->prot_sglen,\n    >         args->cmd_len, $cmnd); \n    > }'\n    Attaching 1 probe...\n    SCSI CMD, pid:9164, lun:1:0:0:0, opcode:0x4a, data_sglen:2, prot_op:0, prot_sglen:0, cmdlen:10, cmnd=\"4a 01 00 00 10 00 00 00 08 00\"\n    SCSI CMD, pid:9164, lun:1:0:0:0, opcode:0x4a, data_sglen:2, prot_op:0, prot_sglen:0, cmdlen:10, cmnd=\"4a 01 00 00 10 00 00 00 08 00\"\n    SCSI CMD, pid:9164, lun:1:0:0:0, opcode:0x4a, data_sglen:2, prot_op:0, prot_sglen:0, cmdlen:10, cmnd=\"4a 01 00 00 10 00 00 00 08 00\"\n    SCSI CMD, pid:9164, lun:1:0:0:0, opcode:0x4a, data_sglen:2, prot_op:0, prot_sglen:0, cmdlen:10, cmnd=\"4a 01 00 00 10 00 00 00 08 00\"\n\nPlease confirm whether this is an issue.\n\n### `bpftrace --info` output\n./bpftrace.0.23.2 --version\n    bpftrace v0.23.2\n",
