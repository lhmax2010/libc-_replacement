      "node_id": "I_kwDOCMCh9c7U1Tuz",
      "number": 4800,
      "title": "Bug: crashes when printing an lhist() with only overflow values",
      "user": {
        "login": "HoyeonRhee",
        "id": 226212448,
        "node_id": "U_kgDODXu6YA",
        "avatar_url": "https://avatars.githubusercontent.com/u/226212448?v=4",
        "gravatar_id": "",
        "url": "https://api.github.com/users/HoyeonRhee",
        "html_url": "https://github.com/HoyeonRhee",
        "followers_url": "https://api.github.com/users/HoyeonRhee/followers",
        "following_url": "https://api.github.com/users/HoyeonRhee/following{/other_user}",
        "gists_url": "https://api.github.com/users/HoyeonRhee/gists{/gist_id}",
        "starred_url": "https://api.github.com/users/HoyeonRhee/starred{/owner}{/repo}",
        "subscriptions_url": "https://api.github.com/users/HoyeonRhee/subscriptions",
        "organizations_url": "https://api.github.com/users/HoyeonRhee/orgs",
        "repos_url": "https://api.github.com/users/HoyeonRhee/repos",
        "events_url": "https://api.github.com/users/HoyeonRhee/events{/privacy}",
