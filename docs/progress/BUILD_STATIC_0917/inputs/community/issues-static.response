src/CMakeFiles/runtime.dir/bpftrace.cpp.o\n[  5%] Building CXX object src/CMakeFiles/runtime.dir/bpfbytecode.cpp.o\n[  5%] Building CXX object src/CMakeFiles/runtime.dir/bpfmap.cpp.o\n[  5%] Building CXX object src/CMakeFiles/runtime.dir/bpfprogram.cpp.o\n[  6%] Building CXX object src/CMakeFiles/runtime.dir/btf.cpp.o\n[  6%] Building CXX object src/CMakeFiles/runtime.dir/child.cpp.o\n[  6%] Building CXX object src/CMakeFiles/runtime.dir/config.cpp.o\n[  6%] Building CXX object src/CMakeFiles/runtime.dir/disasm.cpp.o\n[  6%] Building CXX object src/CMakeFiles/runtime.dir/dwarf_parser.cpp.o\n[  6%] Building CXX object src/CMakeFiles/runtime.dir/format_string.cpp.o\n[  6%] Building CXX object src/CMakeFiles/runtime.dir/globalvars.cpp.o\n/home/aris/OpenSource/bpftrace/src/globalvars.cpp: In member function ‘void bpftrace::globalvars::GlobalVars::check_index(const std::string&, const bpftrace::RequiredResources&, size_t) const’:\n/home/aris/OpenSource/bpftrace/src/globalvars.cpp:280:55: warning: unused parameter ‘resources’ [-Wunused-parameter]\n  280 |                              const RequiredResources &resources,\n      |                              ~~~~~~~~~~~~~~~~~~~~~~~~~^~~~~~~~~\n/home/aris/OpenSource/bpftrace/src/globalvars.cpp:281:37: warning: unused parameter ‘index’ [-Wunused-parameter]\n  281 |                              size_t index) const\n      |                              ~~~~~~~^~~~~\n[  6%] Building CXX object src/CMakeFiles/runtime.dir/log.cpp.o\n[  7%] Building CXX object src/CMakeFiles/runtime.dir/probe_matcher.cpp.o\n[  7%] Building CXX object src/CMakeFiles/runtime.dir/probe_types.cpp.o\n[  7%] Building CXX object src/CMakeFiles/runtime.dir/procmon.cpp.o\n[  7%] Building CXX object src/CMakeFiles/runtime.dir/run_bpftrace.cpp.o\n/home/aris/OpenSource/bpftrace/src/run_bpftrace.cpp:16:10: fatal error: version.h: No such file or directory\n   16 | #include \"version.h\"\n      |          ^~~~~~~~~~~\ncompilation terminated.\nmake[2]: *** [src/C