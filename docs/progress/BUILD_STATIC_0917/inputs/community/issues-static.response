      "title": "Avoid C++ static_assert(false) failure with old GCC",
      "user": {
        "login": "danielverkamp",
        "id": 1274088,
        "node_id": "MDQ6VXNlcjEyNzQwODg=",
        "avatar_url": "https://avatars.githubusercontent.com/u/1274088?v=4",
        "gravatar_id": "",
        "url": "https://api.github.com/users/danielverkamp",
        "html_url": "https://github.com/danielverkamp",
        "followers_url": "https://api.github.com/users/danielverkamp/followers",
        "following_url": "https://api.github.com/users/danielverkamp/following{/other_user}",
        "gists_url": "https://api.github.com/users/danielverkamp/gists{/gist_id}",
