    {
      "url": "https://api.github.com/repos/bpftrace/bpftrace/issues/4959",
      "repository_url": "https://api.github.com/repos/bpftrace/bpftrace",
      "labels_url": "https://api.github.com/repos/bpftrace/bpftrace/issues/4959/labels{/name}",
      "comments_url": "https://api.github.com/repos/bpftrace/bpftrace/issues/4959/comments",
