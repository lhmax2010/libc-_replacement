    {
      "url": "https://api.github.com/repos/bpftrace/bpftrace/issues/4773",
      "repository_url": "https://api.github.com/repos/bpftrace/bpftrace",
      "labels_url": "https://api.github.com/repos/bpftrace/bpftrace/issues/4773/labels{/name}",
      "comments_url": "https://api.github.com/repos/bpftrace/bpftrace/issues/4773/comments",
