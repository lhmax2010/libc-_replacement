      "type": {
        "id": 82713,
        "node_id": "IT_kwDOCWTeF84AAUMZ",
        "name": "Feature",
        "description": "A request, idea, or new functionality",
        "color": "blue",
        "created_at": "2024-01-24T13:01:17Z",
        "updated_at": "2024-10-08T08:29:56Z",
        "is_enabled": true
      },
      "active_lock_reason": null,
      "sub_issues_summary": {
