      "author_association": "NONE",
      "issue_field_values": [

      ],
      "type": null,
      "active_lock_reason": null,
      "draft": false,
      "pull_request": {
        "url": "https://api.github.com/repos/bpftrace/bpftrace/pulls/4398",
        "html_url": "https://github.com/bpftrace/bpftrace/pull/4398",
        "diff_url": "https://github.com/bpftrace/bpftrace/pull/4398.diff",
        "patch_url": "https://github.com/bpftrace/bpftrace/pull/4398.patch",
        "merged_at": null
