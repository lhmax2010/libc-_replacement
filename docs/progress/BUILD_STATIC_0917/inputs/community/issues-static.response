      "number": 4909,
      "title": "Re-add static cast to fix build on 32bit systems",
      "user": {
        "login": "jordalgo",
        "id": 1537292,
        "node_id": "MDQ6VXNlcjE1MzcyOTI=",
        "avatar_url": "https://avatars.githubusercontent.com/u/1537292?v=4",
