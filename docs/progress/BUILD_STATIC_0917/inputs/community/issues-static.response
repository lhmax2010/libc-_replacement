      "created_at": "2025-10-10T19:05:29Z",
      "updated_at": "2025-10-13T17:34:57Z",
      "closed_at": "2025-10-13T17:34:57Z",
      "assignee": null,
      "author_association": "NONE",
      "issue_field_values": [

      ],
      "type": null,
      "active_lock_reason": null,
      "sub_issues_summary": {
        "total": 0,
        "completed": 0,
        "percent_completed": 0
