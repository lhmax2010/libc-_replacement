    },
    {
      "url": "https://api.github.com/repos/bpftrace/bpftrace/issues/869",
      "repository_url": "https://api.github.com/repos/bpftrace/bpftrace",
      "labels_url": "https://api.github.com/repos/bpftrace/bpftrace/issues/869/labels{/name}",
      "comments_url": "https://api.github.com/repos/bpftrace/bpftrace/issues/869/comments",
      "events_url": "https://api.github.com/repos/bpftrace/bpftrace/issues/869/events",
