      "number": 4398,
      "title": "ClangParser: fix --include for kernel and C standard headers",
      "user": {
        "login": "bowling233",
        "id": 35755846,
        "node_id": "MDQ6VXNlcjM1NzU1ODQ2",
        "avatar_url": "https://avatars.githubusercontent.com/u/35755846?v=4",
        "gravatar_id": "",
        "url": "https://api.github.com/users/bowling233",
        "html_url": "https://github.com/bowling233",
        "followers_url": "https://api.github.com/users/bowling233/followers",
        "following_url": "https://api.github.com/users/bowling233/following{/other_user}",
        "gists_url": "https://api.github.com/users/bowling233/gists{/gist_id}",
        "starred_url": "https://api.github.com/users/bowling233/starred{/owner}{/repo}",
        "subscriptions_url": "https://api.github.com/users/bowling233/subscriptions",
        "organizations_url": "https://api.github.com/users/bowling233/orgs",
        "repos_url": "https://api.github.com/users/bowling233/repos",
        "events_url": "https://api.github.com/users/bowling233/events{/privacy}",
