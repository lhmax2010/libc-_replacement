      "state_reason": null,
      "pinned_comment": null,
      "score": 1.0
    },
    {
      "url": "https://api.github.com/repos/bpftrace/bpftrace/issues/1349",
      "repository_url": "https://api.github.com/repos/bpftrace/bpftrace",
