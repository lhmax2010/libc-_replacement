      "assignees": [

      ],
      "milestone": null,
      "comments": 14,
      "created_at": "2026-08-24T12:34:58Z",
      "updated_at": "2026-09-08T11:30:15Z",
      "closed_at": "2026-09-08T10:49:42Z",
