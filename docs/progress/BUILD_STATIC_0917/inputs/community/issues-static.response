        "url": "https://api.github.com/users/jordalgo",
        "html_url": "https://github.com/jordalgo",
        "followers_url": "https://api.github.com/users/jordalgo/followers",
        "following_url": "https://api.github.com/users/jordalgo/following{/other_user}",
        "gists_url": "https://api.github.com/users/jordalgo/gists{/gist_id}",
        "starred_url": "https://api.github.com/users/jordalgo/starred{/owner}{/repo}",
        "subscriptions_url": "https://api.github.com/users/jordalgo/subscriptions",
        "organizations_url": "https://api.github.com/users/jordalgo/orgs",
        "repos_url": "https://api.github.com/users/jordalgo/repos",
        "events_url": "https://api.github.com/users/jordalgo/events{/privacy}",
        "received_events_url": "https://api.github.com/users/jordalgo/received_events",
        "type": "User",
        "user_view_type": "public",
