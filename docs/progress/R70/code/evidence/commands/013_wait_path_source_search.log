    40	bool wait_until_at_least(const std::atomic<int>& value, int target) {
    41	  for (int i = 0; i != 2000000; ++i) {
    42	    if (value.load(std::memory_order_acquire) >= target)
    43	      return true;
    44	    sched_yield();
    45	  }
    46	  return false;
    47	}
