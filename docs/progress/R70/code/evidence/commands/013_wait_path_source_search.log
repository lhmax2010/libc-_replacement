    49	int arithmetic_state_case() {
    50	  std::ostringstream stream;
    51	  stream.imbue(std::locale(std::locale::classic(), new cancel_num_put));
    52	  StreamArgument argument{&stream};
    53	  pthread_t thread{};
    54	  const int create_rc = pthread_create(&thread, nullptr, arithmetic_worker, &argument);
    55	  if (create_rc != 0)
    56	    return 10;
    57	  if (!wait_until_at_least(facet_entered, 1))
    58	    return 11;
    59	  const int cancel_rc = pthread_cancel(thread);
    60	  void* joined = nullptr;
    61	  const int join_rc = pthread_join(thread, &joined);
    62	  const int state = static_cast<int>(stream.rdstate());
    63	  const bool canceled = joined == PTHREAD_CANCELED;
    64	  const bool bad = (state & std::ios_base::badbit) != 0;
    65	  std::cout << "CASE=arithmetic_state CREATE_RC=" << create_rc << " CANCEL_RC=" << cancel_rc
    66	            << " JOIN_RC=" << join_rc << " JOIN_CANCELED=" << canceled << " RDSTATE=" << state
    67	            << " BAD=" << bad << " FAIL=" << stream.fail() << '\n';
    68	  return cancel_rc == 0 && join_rc == 0 && canceled && bad ? 0 : 12;
    69	}
