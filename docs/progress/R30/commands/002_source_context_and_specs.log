    62	/*
    63	 * Decorator function that performs frequently repeated exception handling in
    64	 * SS client API functions. Accepts lambda expression as an argument.
    65	 */
    66	template <class F>
    67	int try_catch(F &&f) {
    68	    try {
    69	        return std::forward<F>(f)();
    70	    } catch (abi::__forced_unwind &) {
    71	        throw;
    72	    } catch (const Exception &e) {
    73	        LogError("SecurityManager::Exception " << e.DumpToString());
    74	        std::cerr << "SecurityManager::Exception " << e.DumpToString() << std::endl;
    75	    } catch (const std::bad_alloc &e) {
    76	        LogError("Memory allocation failed: " << e.what());
    77	        std::cerr << "Memory allocation failed: " << e.what() << std::endl;
    78	        return SECURITY_MANAGER_ERROR_MEMORY;
    79	    } catch (const std::system_error &e) {
    80	        LogError("STD system_error: " <<  e.code() << "-" << e.what());
    81	        std::cerr << "STD system_error: " <<  e.code() << "-" << e.what() << std::endl;
    82	    } catch (const std::exception &e) {
    83	        LogError("STD exception " << e.what());
    84	        std::cerr << "STD exception " << e.what() << std::endl;
    85	    } catch (...) {
    86	        LogError("Unknown exception occurred");
    87	        std::cerr << "Unknown exception occurred" << std::endl;
    88	    }
    89	    return SECURITY_MANAGER_ERROR_UNKNOWN;
    90	}
