WORKING_DIRECTORY=/home/toolchain/development/libc++_replacement
COMMAND_BEGIN
sed -n 1\,240p progress/T3R/commands/run_build_arch.sh 
COMMAND_END
#!/usr/bin/env bash
set -uo pipefail

if test "$#" -ne 1; then
  printf 'usage: %s ARCH\n' "$0" >&2
  exit 2
fi

arch=$1
case "$arch" in
  armv7l|aarch64|x86_64) ;;
  *) printf 'unsupported arch: %s\n' "$arch" >&2; exit 2 ;;
esac

root=/home/toolchain/development/libc++_replacement
date_id=20260804
buildroot="$root/tmp/GBS-ROOT/LIBCXX-2218-$arch-$date_id"
conf="$root/progress/T3R/config/gbs_llvm.conf"
source_input=/var/tmp/toolchain-gbs/T3R-obs-input-89bc0b8/libcxx-runtimes

cd "$source_input"
if test -e "$buildroot"; then
  printf 'RED_STOP: requested single-use buildroot already exists: %s\n' "$buildroot"
  exit 90
fi

cmd=(gbs -c "$conf" build -A "$arch" -B "$buildroot" -C --debug --style obs "$source_input")
printf 'WORKING_DIRECTORY=%s\n' "$PWD"
printf 'COMMAND_BEGIN\n'
printf '%q ' "${cmd[@]}"
printf '\nCOMMAND_END\nOUTPUT_BEGIN\n'
"${cmd[@]}"
rc=$?
printf 'OUTPUT_END\nEXIT_CODE=%s\n' "$rc"
exit "$rc"
EXIT_CODE=0
