platform_spec="$source_root/payload/llvm.spec"
version_file="$source_root/unpacked/llvm-22.1.8.tar.gz/llvm-22.1.8/cmake/Modules/LLVMVersion.cmake"
upstream_log="$root/progress/T3R/evidence/upstream_llvmorg_22_1_8_ls_remote.raw.log"
input_root="$root/tmp/T3R/obs-input/libcxx-runtimes"
