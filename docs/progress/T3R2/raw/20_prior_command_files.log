frozen_conf="$root/progress/T3R/config/gbs_llvm.conf"
native_probe="$root/tmp/T3/native_clang_probe"
native_clang_rpm="$native_probe/clang/clang.rpm"
native_clang="$native_probe/clang/payload/usr/bin/clang-22"

cd "$root"
test "$(git branch --show-current)" = main
test "$(git rev-parse HEAD)" = "$main_commit"
test "$(git rev-parse origin/main)" = "$main_commit"
test "$(git status --short)" = '?? gbs_llvm.conf'

printf 'MERGED_MAIN_IDENTITY\n'
printf 'MAIN_COMMIT=%s\nREMOTE_MAIN=%s\n' "$main_commit" "$(git rev-parse origin/main)"
git show -s --format=fuller "$main_commit"
printf 'PRESERVED_FEATURE_COMMITS\n'
for commit in \
  9841aa96783e8bb43685fae976a1d0ce1c68c73f \
  4d04d307e6d7b8da6c5f0ea1ea5168be941b3207 \
  c46342d4877812637a6cbc997c7e1ac6cfe25fb9; do
  git merge-base --is-ancestor "$commit" "$main_commit"
  git show -s --format='%H%x09%s' "$commit"
done

printf 'PACKAGING_MAIN_TREE_SHA256\n'
while IFS= read -r path; do
  printf '%s\t' "$path"
  git show "$main_commit:$path" | sha256sum | awk '{print $1}'
done < <(git ls-tree -r --name-only "$main_commit" packaging | sort)

test "$(git show "$main_commit:packaging/libcxx-runtimes.spec" | sha256sum | awk '{print $1}')" = \
  a8437cca668ee785906ba5349efcd5b4b91a049ffd4b53e5234a6c2c6066af74

mkdir -p "$root/progress/T3R/evidence" "$root/progress/T3R/config"
test ! -e "$input_root"
mkdir -p "$input_packaging"
cp -- "$root/gbs_llvm.conf" "$frozen_conf"
cp -- "$root/packaging/libcxx-runtimes.spec" "$input_packaging/libcxx-runtimes.spec"
cp -- "$root/packaging/libcxx-llvm22.map" "$input_packaging/libcxx-llvm22.map"
cp -- "$root/packaging/libcxx-runtimes.manifest" "$input_packaging/libcxx-runtimes.manifest"
cp -- "$root/packaging/SOURCE_PROVENANCE" "$input_packaging/SOURCE_PROVENANCE"
cp -- "$source_tar" "$input_packaging/llvm-22.1.8.tar.gz"

printf 'FROZEN_OBS_STYLE_INPUT_SHA256\n'
find "$input_packaging" -maxdepth 1 -type f -print0 | sort -z | xargs -0 sha256sum
printf 'FROZEN_GBS_CONF\nPATH=%s\n' "$frozen_conf"
sha256sum "$frozen_conf"
sed -n '1,120p' "$frozen_conf"

test "$(sha256sum "$input_packaging/libcxx-runtimes.spec" | awk '{print $1}')" = \
  a8437cca668ee785906ba5349efcd5b4b91a049ffd4b53e5234a6c2c6066af74
test "$(sha256sum "$input_packaging/libcxx-llvm22.map" | awk '{print $1}')" = \
  e806ab237e86bbe1e1d25c9bedbb129016ed67e9e72acb9259154b4b51a1304d
test "$(sha256sum "$input_packaging/libcxx-runtimes.manifest" | awk '{print $1}')" = \
  db262cd0f01ca668a019b79bf1bb1a9731a100205ff4d4b256d071b3d5304dc3
test "$(sha256sum "$input_packaging/SOURCE_PROVENANCE" | awk '{print $1}')" = \
  1ab73051dc45ee72e681ec0393889bdf527c4d7407df13eb3effa79c7dd4be74
test "$(sha256sum "$input_packaging/llvm-22.1.8.tar.gz" | awk '{print $1}')" = \
  16a932e1bad4e1ed68938b48aa9fe5613992426584a75dd17dacabf2151d122e

printf 'FROZEN_21_1_1_COMMANDS\n'
for arch in armv7l aarch64 x86_64; do
  old="$root/artifacts/archive_2111_salvage/frozen_build_evidence/multiarch/$arch/build/command.txt"
