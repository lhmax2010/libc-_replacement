conclusion	CHAIN_PRESERVED	CHAIN_PRESERVED	NO_RELEVANT_DIFFERENCE	CHAIN_PRESERVED
EOF
cat "$root/progress/T3R/r2_chain_conclusion.tsv"
printf 'R2_CHAIN_RECHECK=CHAIN_PRESERVED\n'
