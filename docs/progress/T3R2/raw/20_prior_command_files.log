  'refs/tags/llvmorg-22.1.8' 'refs/tags/llvmorg-22.1.8^{}' | tee "$upstream_log"
test "$(awk '$2=="refs/tags/llvmorg-22.1.8^{}" {print $1}' "$upstream_log")" = \
  ca7933e47d3a3451d81e72ac174dcb5aa28b59d1

printf 'SOURCE_NUMERIC_VERSION\nPATH=%s\n' "$version_file"
sha256sum "$version_file"
nl -ba "$version_file"
major=$(awk '/set\(LLVM_VERSION_MAJOR / {gsub(/\)/,"",$2); print $2}' "$version_file")
