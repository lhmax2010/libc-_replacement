#!/usr/bin/env bash
set -euo pipefail

root=/home/toolchain/development/libc++_replacement
cd "$root"

available=$(df -B1 --output=avail . | tail -1 | tr -d ' ')
printf 'DISK_AVAILABLE_BYTES=%s\n' "$available"
test "$available" -ge 80000000000

git fetch origin
printf 'BRANCH=%s\nHEAD=%s\n' "$(git branch --show-current)" "$(git rev-parse HEAD)"
printf 'STATUS_BEGIN\n%s\nSTATUS_END\n' "$(git status --short)"
printf 'LOCAL_MAIN=%s\nREMOTE_MAIN=%s\nLOCAL_FEATURE=%s\nREMOTE_FEATURE=%s\n' \
  "$(git rev-parse main)" \
  "$(git rev-parse origin/main)" \
  "$(git rev-parse codex/r3-t3-input-gap-evidence)" \
  "$(git rev-parse origin/codex/r3-t3-input-gap-evidence)"
printf 'COMMITS_TO_MERGE_BEGIN\n'
git log --reverse --format='%H%x09%s' main..codex/r3-t3-input-gap-evidence
printf 'COMMITS_TO_MERGE_END\n'

test "$(git branch --show-current)" = codex/r3-t3-input-gap-evidence
test "$(git status --short)" = '?? gbs_llvm.conf'
test "$(git rev-parse main)" = "$(git rev-parse origin/main)"
test "$(git rev-parse codex/r3-t3-input-gap-evidence)" = "$(git rev-parse origin/codex/r3-t3-input-gap-evidence)"
test "$(git merge-base main codex/r3-t3-input-gap-evidence)" = "$(git rev-parse main)"

started=$(date -Iseconds)
printf 'task\tstatus\tstarted_at\tfinished_at\tdetail\nT3R\tSTARTED\t%s\t\t等待main合并与三架构构建\n' "$started" > progress/state/T3R.tsv
printf 'PREMERGE_AND_DISK_GUARD=PASS\n'
