  sha256sum "$old" | awk '{print $1}'
  sed -n '1,5p' "$old"
done

printf 'COMMAND_ADAPTATION\n'
printf '%s\n' \
  'KEEP:gbs build / -A / -B / -C(--clean) / --debug / --spec' \
  'CHANGE:gbs conf -> progress/T3R/config/gbs_llvm.conf (本次平台仓冻结副本)' \
  'CHANGE:arch 与 buildroot -> LLVM 22.1.8 本次单次根' \
  'CHANGE:source path -> tmp/T3R/obs-input/libcxx-runtimes' \
  'REMOVE:--include-all（仅适用于 Git 工作树导出）' \
  'ADD:--style obs（逐字消费已预导出的 main packaging 与平台原 tarball，禁止 GBS 重打 Source0）'

printf 'ANCHOR_A_TARBALL\nPATH=%s\n' "$source_tar"
stat -c 'SIZE=%s' "$source_tar"
