#!/usr/bin/env bash
set -euo pipefail

root=/home/toolchain/development/libc++_replacement
old_root=/home/toolchain/tmp/GBS-ROOT-WAVE1-CYNARA-CANDIDATE/local/BUILD-ROOTS/scratch.armv7l.0
new_root="$root/tmp/GBS-ROOT/LIBCXX-2218-x86_64-20260804/local/BUILD-ROOTS/scratch.x86_64.0"
out="$root/progress/T3R/R2_chain"
old_macros="$old_root/usr/lib/rpm/macros"
new_macros="$new_root/usr/lib/rpm/macros"
old_tizen="$old_root/usr/lib/rpm/tizen_macros"
new_tizen="$new_root/usr/lib/rpm/tizen_macros"

test -f "$root/tmp/GBS-ROOT/LIBCXX-2218-x86_64-20260804/RETIRED_SINGLE_USE"
test ! -e "$out"
mkdir -p "$out"

printf 'INPUT_IDENTITY\n'
printf 'R2_RECORDED_CHAIN=%s\n' "$root/progress/R2/evidence/macro_chain.raw.log"
sha256sum "$root/progress/R2/evidence/macro_chain.raw.log"
printf 'OLD_21_1_1_ROOT=%s\nNEW_22_1_8_ROOT=%s\n' "$old_root" "$new_root"
sha256sum "$old_macros" "$new_macros" "$old_tizen" "$new_tizen" | tee "$out/input_sha256.tsv"

printf 'NEW_ROOT_RPM_OWNERS\n'
sudo chroot "$new_root" rpm -qf /usr/lib/rpm/macros /usr/lib/rpm/tizen_macros | tee "$out/new_macro_rpm_owners.raw.log"

printf 'OLD_21_1_1_FILE_LINE_EVIDENCE\n'
nl -ba "$old_macros" | sed -n '1043,1060p' | tee "$out/old_21_1_1_set_build_flags.file_line.log"
nl -ba "$old_tizen" | sed -n '229,232p' | tee "$out/old_21_1_1_spec_build_pre.file_line.log"

printf 'NEW_22_1_8_FILE_LINE_EVIDENCE\n'
nl -ba "$new_macros" | sed -n '1043,1060p' | tee "$out/new_22_1_8_set_build_flags.file_line.log"
nl -ba "$new_tizen" | sed -n '229,232p' | tee "$out/new_22_1_8_spec_build_pre.file_line.log"

sed -n '1043,1060p' "$old_macros" > "$out/old_21_1_1_set_build_flags.raw"
sed -n '1043,1060p' "$new_macros" > "$out/new_22_1_8_set_build_flags.raw"
sed -n '229,232p' "$old_tizen" > "$out/old_21_1_1_spec_build_pre.raw"
sed -n '229,232p' "$new_tizen" > "$out/new_22_1_8_spec_build_pre.raw"

printf 'RELEVANT_BLOCK_SHA256\n'
sha256sum "$out"/*.raw
set +e
diff -u "$out/old_21_1_1_set_build_flags.raw" "$out/new_22_1_8_set_build_flags.raw" > "$out/set_build_flags_21_to_22.diff"
set_rc=$?
diff -u "$out/old_21_1_1_spec_build_pre.raw" "$out/new_22_1_8_spec_build_pre.raw" > "$out/spec_build_pre_21_to_22.diff"
pre_rc=$?
set -e
printf 'SET_BUILD_FLAGS_DIFF_EXIT=%s\nSPEC_BUILD_PRE_DIFF_EXIT=%s\n' "$set_rc" "$pre_rc"
test "$set_rc" -eq 0
test "$pre_rc" -eq 0

printf 'NEW_ROOT_EXACT_ASSERTIONS\n'
rg -n -F '%build_cxxflags %{optflags}' "$new_macros"
rg -n -F 'CXXFLAGS="${CXXFLAGS:-%{?build_cxxflags}}" ; export CXXFLAGS ; \' "$new_macros"
rg -n -F 'LDFLAGS="${LDFLAGS:-%{?build_ldflags}}" ; export LDFLAGS' "$new_macros"
rg -n -F '%__spec_build_pre\' "$new_tizen"
rg -n -F '%{set_build_flags};\' "$new_tizen"

printf 'NEW_ROOT_MACRO_EVALUATION\n'
printf 'COMMAND=sudo chroot %s rpm --eval %%{build_cxxflags}\n' "$new_root"
sudo chroot "$new_root" rpm --eval '%{build_cxxflags}' | tee "$out/new_build_cxxflags_eval.raw.log"
printf 'COMMAND=sudo chroot %s rpm --eval %%{build_ldflags}\n' "$new_root"
sudo chroot "$new_root" rpm --eval '%{build_ldflags}' | tee "$out/new_build_ldflags_eval.raw.log"

cat > "$root/progress/T3R/r2_chain_conclusion.tsv" <<'EOF'
item	old_21_1_1	new_22_1_8	comparison	status
tizen_macros_full_sha256	f0f991bd97f44b7bf906ac4a7a45cd34b7444c1acce2358261e4a95b3e68ebc8	f0f991bd97f44b7bf906ac4a7a45cd34b7444c1acce2358261e4a95b3e68ebc8	BYTE_IDENTICAL	PASS
