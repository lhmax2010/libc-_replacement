#!/usr/bin/env bash
set -euo pipefail

root=/home/toolchain/development/libc++_replacement
src="$root/progress/T3R"
dst="$root/docs/progress/T3R"

cd "$root"
test ! -e "$dst"
test "$(du -sb docs/progress | awk '{print $1}')" -lt 200000000
mkdir -p "$dst/commands" "$dst/armv7l" "$dst/aarch64" "$dst/x86_64" "$dst/R2_chain" "$dst/evidence" "$dst/config"

find "$src" -maxdepth 1 -type f \( -name '*.md' -o -name '*.tsv' \) -print0 | while IFS= read -r -d '' file; do
  cp -- "$file" "$dst/$(basename "$file")"
done
find "$src/commands" -maxdepth 1 -type f -name '*.log' -print0 | while IFS= read -r -d '' file; do
  cp -- "$file" "$dst/commands/$(basename "$file")"
done
for sub in armv7l aarch64 x86_64 R2_chain evidence config; do
  find "$src/$sub" -maxdepth 1 -type f -print0 | while IFS= read -r -d '' file; do
    cp -- "$file" "$dst/$sub/$(basename "$file")"
  done
done

printf 'file\tsize_bytes\tsha256\tlocal_path\treason\n' > "$src/EXCLUDED.tsv"

while IFS= read -r -d '' file; do
  rel=${file#"$src/"}
  if ! test -f "$dst/$rel"; then
    printf '%s\t%s\t%s\t%s\t%s\n' \
      "$(basename "$file")" "$(stat -c '%s' "$file")" "$(sha256sum "$file" | awk '{print $1}')" \
      "progress/T3R/$rel" 'LOCAL_FULL_EVIDENCE_NOT_CURATED' >> "$src/EXCLUDED.tsv"
  fi
done < <(find "$src" -type f ! -name MANIFEST.sha256 -print0 | sort -z)

while IFS= read -r -d '' file; do
  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$(basename "$file")" "$(stat -c '%s' "$file")" "$(sha256sum "$file" | awk '{print $1}')" \
    "${file#"$root/"}" 'ARTIFACTS_PROHIBITED_LOCAL_ONLY' >> "$src/EXCLUDED.tsv"
done < <(find "$root/artifacts/rebuild_2218" -type f -print0 | sort -z)

for item in \
  "$root/tmp/corpus/extracted/llvm-22.1.8-18.1.src.rpm/payload/llvm-22.1.8.tar.gz" \
  "$root/tmp/corpus/extracted/llvm-22.1.8-18.1.src.rpm/payload/llvm.spec" \
  /home/toolchain/tmp/GBS-ROOT-WAVE1-CYNARA-CANDIDATE/local/BUILD-ROOTS/scratch.armv7l.0/usr/lib/rpm/macros \
  /home/toolchain/tmp/GBS-ROOT-WAVE1-CYNARA-CANDIDATE/local/BUILD-ROOTS/scratch.armv7l.0/usr/lib/rpm/tizen_macros \
  "$root/tmp/GBS-ROOT/LIBCXX-2218-x86_64-20260804/local/BUILD-ROOTS/scratch.x86_64.0/usr/lib/rpm/macros" \
  "$root/tmp/GBS-ROOT/LIBCXX-2218-x86_64-20260804/local/BUILD-ROOTS/scratch.x86_64.0/usr/lib/rpm/tizen_macros"; do
  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$(basename "$item")" "$(stat -c '%s' "$item")" "$(sha256sum "$item" | awk '{print $1}')" \
    "$item" 'EXTERNAL_OR_TMP_READ_ONLY_INPUT_LOCAL_ONLY' >> "$src/EXCLUDED.tsv"
done

cp -- "$src/EXCLUDED.tsv" "$dst/EXCLUDED.tsv"

find "$src" -type f ! -name MANIFEST.sha256 -print0 | sort -z | xargs -0 sha256sum | \
  sed "s#  $root/##" > "$src/MANIFEST.sha256"
cp -- "$src/MANIFEST.sha256" "$dst/MANIFEST.sha256"

printf 'CURATED_FILES\n'
find "$dst" -type f -printf '%P\t%s\n' | sort
printf 'CURATED_MAX_FILE_BYTES=%s\n' "$(find "$dst" -type f -printf '%s\n' | sort -nr | head -1)"
