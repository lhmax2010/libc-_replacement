#!/usr/bin/env bash
set -euo pipefail

if test "$#" -ne 2; then
  printf 'usage: %s ARCH EXPECTED_CIRCLE_COUNT\n' "$0" >&2
  exit 2
fi
arch=$1
circle_count=$2
case "$arch" in armv7l|aarch64|x86_64) ;; *) exit 2 ;; esac

root=/home/toolchain/development/libc++_replacement
buildroot="$root/tmp/GBS-ROOT/LIBCXX-2218-$arch-20260804"
log="$root/progress/T3R/build_${arch}.full.log"
out="$root/artifacts/rebuild_2218/$arch"
ev="$root/progress/T3R/$arch"
generated_conf=/var/tmp/toolchain-gbs/tizen_unified_standard.conf

test -d "$buildroot"
test -f "$log"
test ! -e "$out"
mkdir -p "$out" "$ev"
rg -n 'start building packages from:|--path=|circle found|some packages failed|EXIT_CODE=' "$log" | tee "$ev/failure_classification.raw.log"
test "$(tail -1 "$log")" = 'EXIT_CODE=1'
rg -q "circle found in ${circle_count} packages, exit" "$log"
if rg -q 'Installed \(but unpackaged\)|File not found:|BUILDREQ_VERSION_FORM' "$log"; then
  printf 'unexpected known red-category marker found\n' >&2
  exit 1
fi

cp -- "$root/progress/T3R/config/gbs_llvm.conf" "$out/gbs_llvm.conf"
test -f "$generated_conf"
cp -- "$generated_conf" "$out/tizen_unified_standard.conf"
sha256sum "$out/gbs_llvm.conf" "$out/tizen_unified_standard.conf" | tee "$ev/config_sha256.tsv"
rg -n 'fetching https://.*repomd.xml|--repository=https://|init_buildsystem.*--repository' "$log" > "$ev/repository_set.raw.log" || true

cat > "$buildroot/RETIRED_SINGLE_USE" <<EOF
状态：RETIRED_SINGLE_USE
架构：$arch
构建退出码：1
红项分类：UNCLASSIFIED
原因：GBS --style obs 受启动工作目录优先级影响扫描仓根全部 spec，依赖图报 circle found in $circle_count packages；未进入 libcxx-runtimes 单包 buildroot 初始化。
禁止复用。
EOF
sha256sum "$buildroot/RETIRED_SINGLE_USE"

cat > "$ev/status.tsv" <<EOF
arch	build_exit	status	red_class	artifacts	toolchain_resolution	buildroot
$arch	1	FAILED	UNCLASSIFIED	NONE	NOT_RESOLVED_BEFORE_SINGLE_PACKAGE_BUILDROOT	/tmp/GBS-ROOT/LIBCXX-2218-$arch-20260804
EOF
cat "$ev/status.tsv"
printf '%s_FAILURE_ARCHIVE=PASS\n' "$arch"
