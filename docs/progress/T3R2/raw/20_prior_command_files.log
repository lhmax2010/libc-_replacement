#!/usr/bin/env bash
set -euo pipefail

root=/home/toolchain/development/libc++_replacement
arch=x86_64
buildroot="$root/tmp/GBS-ROOT/LIBCXX-2218-$arch-20260804"
scratch="$buildroot/local/BUILD-ROOTS/scratch.x86_64.0"
repo="$buildroot/local/repos/tizen_unified_standard/$arch"
log="$root/progress/T3R/build_x86_64.full.log"
out="$root/artifacts/rebuild_2218/$arch"
ev="$root/progress/T3R/$arch"
verify="$root/tmp/T3R/x86_64_srpm_verify"

test -d "$scratch"
test -d "$repo/RPMS"
test "$(tail -1 "$log")" = 'EXIT_CODE=0'
if test -e "$out"; then
  test -d "$out"
  test -z "$(find "$out" -mindepth 1 -maxdepth 1 -print -quit)"
fi
if test -e "$verify"; then
  test -d "$verify"
  test -z "$(find "$verify" -mindepth 1 -maxdepth 1 -print -quit)"
fi
mkdir -p "$out" "$ev" "$verify"

printf 'BUILD_SUCCESS_EVIDENCE\n'
rg -n 'init_buildsystem .*--repository|there is no circle in 1 packages|clang-22\.1\.8-18\.1|Wrote: .*\.rpm|finished building libcxx-runtimes|EXIT_CODE=' "$log" | tee "$ev/build_success.raw.log"

printf 'ACTUALLY_INSTALLED_ALL_RPMS\n'
sudo chroot "$scratch" rpm -qa --qf '%{NEVRA}\n' | LC_ALL=C sort | tee "$ev/installed_all_nevra.tsv"
test "$(sudo chroot "$scratch" rpm -q clang --qf '%{NEVRA}')" = clang-22.1.8-18.1.x86_64

printf 'ACTUALLY_RESOLVED_TOOLCHAIN_RPMS\n'
rg '^(binutils|binutils-libs|clang|cmake|cpp|gcc|gcc-c\+\+|libatomic|libgcc|libllvm|libstdc\+\+|libstdc\+\+-devel|lldb|llvm|llvm-devel|ninja|python3|python3-base|rpm|rpm-build)-' \
  "$ev/installed_all_nevra.tsv" | tee "$ev/toolchain_nevra.tsv"
test "$(wc -l < "$ev/toolchain_nevra.tsv")" -ge 18

printf 'BUILDROOT_CLANG_VERSION\n'
printf 'COMMAND=sudo chroot %s /usr/bin/clang --version\n' "$scratch"
sudo chroot "$scratch" /usr/bin/clang --version | tee "$ev/buildroot_clang_version.raw.log"
test "$(sudo chroot "$scratch" /usr/bin/clang --version | awk 'NR==1 {print $3}')" = 22.1.8

find "$repo/RPMS" "$repo/SRPMS" -maxdepth 1 -type f -name '*.rpm' -print0 | sort -z | while IFS= read -r -d '' rpm_file; do
  cp -- "$rpm_file" "$out/$(basename "$rpm_file")"
done
test "$(find "$out" -maxdepth 1 -type f -name '*.rpm' | wc -l)" -eq 8

cp -- "$root/progress/T3R/config/gbs_llvm.conf" "$out/gbs_llvm.conf"
cp -- "$scratch/tizen_unified_standard.conf" "$out/tizen_unified_standard.conf"

printf 'ARCHIVED_RPM_SHA256\n'
printf 'filename\tnevra\tsize\tsha256\n' > "$ev/rpm_sha256.tsv"
find "$out" -maxdepth 1 -type f -name '*.rpm' -print0 | sort -z | while IFS= read -r -d '' rpm_file; do
  printf '%s\t%s\t%s\t%s\n' \
    "$(basename "$rpm_file")" \
    "$(rpm -qp --qf '%{NEVRA}' "$rpm_file")" \
    "$(stat -c '%s' "$rpm_file")" \
    "$(sha256sum "$rpm_file" | awk '{print $1}')"
done | tee -a "$ev/rpm_sha256.tsv"

printf 'ARCHIVED_CONFIG_SHA256\n'
sha256sum "$out/gbs_llvm.conf" "$out/tizen_unified_standard.conf" | tee "$ev/config_sha256.tsv"
rg -n 'fetching https://.*repomd.xml|--repository=https://|init_buildsystem.*--repository' "$log" > "$ev/repository_set.raw.log"

printf 'BUILT_SRPM_SOURCE0_IDENTITY\n'
srpm="$out/libcxx-runtimes-22.1.8-1.src.rpm"
(cd "$verify" && rpm2cpio "$srpm" | cpio -idm --quiet)
sha256sum "$verify/llvm-22.1.8.tar.gz"
test "$(sha256sum "$verify/llvm-22.1.8.tar.gz" | awk '{print $1}')" = \
  16a932e1bad4e1ed68938b48aa9fe5613992426584a75dd17dacabf2151d122e

