rg -n '^VCS:|^Version:|^Release:|^Source0:' "$platform_spec"
test "$(awk '$1=="VCS:" {print $2}' "$platform_spec")" = \
  platform/upstream/llvm#c12cbe887ff08f04628e1b1165f8d02ce69a9146

printf 'ANCHOR_C_UPSTREAM_PEELED_TAG\n'
