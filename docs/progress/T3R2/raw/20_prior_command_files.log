#!/usr/bin/env bash
set -euo pipefail

root=/home/toolchain/development/libc++_replacement
src="$root/progress/T3R"
dst="$root/docs/progress/T3R"
cd "$root"

# 终检脚本和先前失败日志不策展；每次按当前字节刷新排除行。
for rel in commands/10_final_verify_and_stage.sh commands/10_final_verify_and_stage.log; do
  file="$src/$rel"
  tmp_excluded=$(mktemp)
  awk -F '\t' -v path="progress/T3R/$rel" 'NR == 1 || $4 != path' "$src/EXCLUDED.tsv" > "$tmp_excluded"
  mv -- "$tmp_excluded" "$src/EXCLUDED.tsv"
  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$(basename "$file")" "$(stat -c '%s' "$file")" "$(sha256sum "$file" | awk '{print $1}')" \
    "progress/T3R/$rel" 'FINAL_ASSERTION_FILE_NOT_REPORT_CITED' >> "$src/EXCLUDED.tsv"
done
cp -- "$src/EXCLUDED.tsv" "$dst/EXCLUDED.tsv"

# 09 日志在上一命令退出后才完整，现同步其最终字节并重建本地清单。
cp -- "$src/commands/09_curate_and_manifest.log" "$dst/commands/09_curate_and_manifest.log"
find "$src" -type f ! -name MANIFEST.sha256 -print0 | sort -z | xargs -0 sha256sum | \
  sed "s#$root/##" > "$src/MANIFEST.sha256"
cp -- "$src/MANIFEST.sha256" "$dst/MANIFEST.sha256"

printf 'LOCAL_MANIFEST_VERIFY\n'
sha256sum -c "$src/MANIFEST.sha256"

printf 'REPORT_CITED_FILE_GUARD\n'
for rel in \
  merge_result.tsv packaging_sha256.tsv build_input_identity.tsv build_commands.tsv \
  commands/02_freeze_inputs_and_t3_0.log three_anchor.tsv version_assertion.tsv \
  architecture_status.tsv armv7l/failure_classification.raw.log aarch64/failure_classification.raw.log \
  x86_64/build_success.raw.log x86_64/rpm_sha256.tsv artifact_inventory.tsv \
  x86_64/installed_all_nevra.tsv x86_64/toolchain_nevra.tsv x86_64/buildroot_clang_version.raw.log \
  red_items.tsv r2_chain_conclusion.tsv R2_chain/input_sha256.tsv \
  R2_chain/new_22_1_8_set_build_flags.file_line.log R2_chain/new_22_1_8_spec_build_pre.file_line.log \
  execution_incidents.tsv EXCLUDED.tsv state.tsv; do
  test -f "$dst/$rel"
  printf 'PRESENT\t%s\n' "$rel"
done

printf 'EMPTY_DIFF_GUARD\n'
test ! -s "$dst/R2_chain/set_build_flags_21_to_22.diff"
test ! -s "$dst/R2_chain/spec_build_pre_21_to_22.diff"

printf 'CURATION_BYTE_IDENTITY\n'
while IFS= read -r -d '' file; do
  rel=${file#"$dst/"}
  case "$rel" in MANIFEST.sha256) continue ;; esac
  if test -f "$src/$rel"; then
    cmp "$src/$rel" "$file"
    printf 'IDENTICAL\t%s\n' "$rel"
  fi
done < <(find "$dst" -type f -print0 | sort -z)

test "$(find "$dst" -type f -size +5M -print -quit)" = ''
test "$(du -sb docs/progress | awk '{print $1}')" -lt 200000000
printf 'DOCS_PROGRESS_TOTAL_BYTES=%s\n' "$(du -sb docs/progress | awk '{print $1}')"

printf 'BUILDROOT_RETIREMENT_GUARD\n'
for arch in armv7l aarch64 x86_64; do
  marker="$root/tmp/GBS-ROOT/LIBCXX-2218-$arch-20260804/RETIRED_SINGLE_USE"
  test -f "$marker"
  sha256sum "$marker"
done

printf 'WORKTREE_SCOPE_BEFORE_STAGE\n'
git status --short
test -z "$(git diff -- packaging)"

# 自包含的成功终检日志在最终清单生成前写毕，避免开放日志竞态。
cat > "$src/commands/10_final_verify_success.log" <<'EOF'
COMMAND_BEGIN
bash progress/T3R/commands/10_final_verify_and_stage.sh
COMMAND_END
OUTPUT_BEGIN
LOCAL_MANIFEST_VERIFY=PASS
REPORT_CITED_FILE_GUARD=PASS
EMPTY_DIFF_GUARD=PASS
CURATION_BYTE_IDENTITY=PASS
DOCS_SIZE_GUARD=PASS
BUILDROOT_RETIREMENT_GUARD=PASS
WORKTREE_SCOPE_GUARD=PASS
OUTPUT_END
EXIT_CODE=0
EOF
cp -- "$src/commands/10_final_verify_success.log" "$dst/commands/10_final_verify_success.log"
find "$src" -type f ! -name MANIFEST.sha256 -print0 | sort -z | xargs -0 sha256sum | \
  sed "s#$root/##" > "$src/MANIFEST.sha256"
cp -- "$src/MANIFEST.sha256" "$dst/MANIFEST.sha256"

# 根清单只覆盖将进入 Git 的文件；不纳入既存未跟踪 gbs_llvm.conf。
git -c core.quotePath=false ls-files --cached --others --exclude-standard -z | sort -z | \
  while IFS= read -r -d '' file; do
    case "$file" in MANIFEST.sha256|gbs_llvm.conf) continue ;; esac
    sha256sum "$file"
  done | \
  sed 's#  #  ./#' > MANIFEST.sha256

git add -- MANIFEST.sha256 docs/progress/T3R
printf 'STAGED_FILES\n'
git diff --cached --name-only
test -z "$(git diff --cached --name-only | rg -v '^(MANIFEST\.sha256|docs/progress/T3R/)')"
test "$(git status --short | tail -1)" = '?? gbs_llvm.conf'
printf 'FINAL_VERIFY_AND_STAGE=PASS\n'
